    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_6883_ontServiceDelete(self):
        #$py_TempONTService need provision the ont first (Need execute test_modifyServiceConfig first)
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag != "xont": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        openOntServicePage(self)
        time.sleep(3)
        waitPageIdle(self)
        #Wait service table loaded
        WebDriverWait(self.driver, 60, poll_frequency=0.5).until(
            EC.presence_of_element_located((By.XPATH, "//*[@id=\'provision_service_table\']/div[@class=\'pagination\']/input"))
        )
        entryPosition = getPositionByCols(self, "provision_service_table", {"sn":self.serviceOntSN})
        clickElementWhenReady(self, getElementByPositionCol(self, "provision_service_table", entryPosition , "Modify"))
        #Edit service with $py_TempONTService
        waitSelect(self, (By.ID, "provision_service_onttemplate_combbox"), "$py_TempONTService")
        time.sleep(3)
        waitPageIdle(self)
        waitInput(self, (By.ID, "provision_service_desc_text"), "")
        waitInput(self, (By.ID, "provision_service_dspir_text"), "")
        #Wan Setting
        for ind in range (8):
            waitClick(self, (By.XPATH, "//label[@for=\"provision_service_wan_table_active_" + str(ind + 1) + "\"]"))
        #Wifi Setting
        for ind in range (4):
            waitClick(self, (By.XPATH, "//label[@for=\"provision_service_wify24g_table_active_" + str(ind + 1) + "\"]"))
            waitClick(self, (By.XPATH, "//label[@for=\"provision_service_wify5g_table_active_" + str(ind + 1) + "\"]"))
        #VoIP Setting
        for ind in range (2):
            waitClick(self, (By.XPATH, "//label[@for=\"provision_service_voip_table_active_" + str(ind + 1) + "\"]"))
        #QoS
        #Service T-cont Setting
        waitClick(self, (By.CSS_SELECTOR, "#provision_service_profile_qos_table > .zy_tr_title label"))
        waitClick(self, (By.ID, "provision_service_profile_qos_table_delete"))
        waitClick(self, (By.ID, "provision_save_service_btn"))
        clickUntilHidden(self, (By.CSS_SELECTOR, "#modal_provision_service_message .button"), (By.ID, "modal_provision_service_message"), 120)
        time.sleep(3)
        waitPageIdle(self)
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempONTService"
        #Check in CLI
        checkValue = []
        await setXponSnStyle(self.dutIp, self.dutAdminName, self.dutAdminPwd, "normal")
        serviceOntSNCLI = sn16To12 (self.serviceOntSN)
        #Check neox xont config
        if "NeoX" in self.dutType:
            checkValue = ["Active", "Enable", self.serviceOntPW, serviceOntSNCLI, "", "auto", "none", "$py_TempONTService", "", "", "", "", ""]
        #Check ies xont config
        else:
            checkValue = ["Active", self.serviceOntPW, serviceOntSNCLI, "", "$py_TempONTService", "", "", "", "", ""]
        with assume: assert await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo) == checkValue


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_3633_ontTempPrfAdd(self):
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag != "xont": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        deleteServiceWithProfile(self, "$py_Temp")
        deleteServiceWithSn(self, self.serviceOntSN)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered")
        #Delete profile in profile list
        deleteFileIfExisted(self,"ONT Template","$py_Temp")
        #Delete auto_ profile if the table full
        deleteAutoMaxFileIfTableFull(self,"ONT Template",3000)
        #Create ONT template profile: "$py_Temp"
        createProfile (self, "ONT Template", "$py_Temp")
        Select(self.driver.find_element(By.ID, "ont_template_qos_ds_combobox")).select_by_visible_text("Both (XPON Only,GPON will set with ONT)")
        self.driver.find_element(By.ID, "ont_template_ds_pir_text").send_keys("10000000")
        saveProfile (self)
        #Create service with $py_Temp
        createServiceWithIpSnPwdProfile(self, self.dutIp, self.serviceOntSN, self.serviceOntPW, "$py_Temp")
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_Temp"
        #Check in CLI
        checkValue = []        
        #Check neox or ies xont config and profile    
        await setXponSnStyle(self.dutIp, self.dutAdminName, self.dutAdminPwd, "normal")
        serviceOntSNCLI = sn16To12 (self.serviceOntSN)
        #Check neox xont config
        if "NeoX" in self.dutType:
            checkValue = ["Active", "Enable", self.serviceOntPW, serviceOntSNCLI, "", "auto", "none", "$py_Temp", "", "", "", "", ""]
        else:
            checkValue = ["Active", self.serviceOntPW, serviceOntSNCLI, "", "$py_Temp", "", "", "", "", ""]
        with assume: assert  await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo) == checkValue
        #Check neox temp profile
        if "NeoX" in self.dutType:
            checkValue = ["Template Name: \"$py_Temp\"", "QoS Downstream Option : both", "MAC Learning : enable", "DS PIR : 10000000", "encryption algorithm: aes", "encryption scope: service"]
        #Check ies temp profile
        else:
            checkValue = ["Template Name: \"$py_Temp\"", "QoS Downstream Option : both", "DS PIR : 10000000", "encryption algorithm: aes", "encryption scope: service"]
        with assume: assert await cliShowTempProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_Temp") == checkValue


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5603_ontTempPrfModify(self):
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag != "xont": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        modifyProfile (self, "ONT Template", "$py_Temp")
        time.sleep(3)        
        Select(self.driver.find_element(By.ID, "ont_template_qos_ds_combobox")).select_by_visible_text("OLT")
        self.driver.find_element(By.ID, "ont_template_ds_pir_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_template_ds_pir_text").send_keys(Keys.DELETE) 
        self.driver.find_element(By.ID, "ont_template_ds_pir_text").send_keys("10240")
        self.driver.find_element(By.ID, "provision_profile_save_profile_btn").click()
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep (180)
        #Check in CLI
        checkValue = []        
        #Check neox temp profile
        if "NeoX" in self.dutType:
            checkValue = ["Template Name: \"$py_Temp\"", "QoS Downstream Option : olt", "MAC Learning : enable", "DS PIR : 10240", "encryption algorithm: aes", "encryption scope: service"]
        #Check ies temp profile
        else:
            checkValue = ["Template Name: \"$py_Temp\"", "QoS Downstream Option : olt", "DS PIR : 10240", "encryption algorithm: aes", "encryption scope: service"]
        with assume: assert await cliShowTempProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_Temp") == checkValue


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_3631_ontTempPrfDel(self):
        if self.exeServiceOnt == "": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        deleteServiceWithProfile(self, "$py_TempDel")
        deleteServiceWithSn(self, self.serviceOntSN)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered")
        #Delete profile in profile list
        deleteFileIfExisted(self,"ONT Template","$py_TempDel")
        #Delete auto_ profile if the table full
        deleteAutoMaxFileIfTableFull(self,"ONT Template",3000)
        #Create ONT template profile: "$py_TempDel"
        createProfile (self, "ONT Template", "$py_TempDel")
        saveProfile (self)
        #Create service with $py_TempDel
        createServiceWithIpSnPwdProfile(self, self.dutIp, self.serviceOntSN, self.serviceOntPW, "$py_TempDel")
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(180)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        if self.serviceOntFlag == "xont":
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempDel"
        with assume: assert deleteFileIfExisted(self,"ONT Template","$py_TempDel") == False
        deleteServiceWithSn(self, self.serviceOntSN)
        time.sleep(20)
        with assume: assert deleteFileIfExisted(self,"ONT Template","$py_TempDel")


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5764_5775_5786_qosPrfAdd(self):
        if self.exeServiceGe == "":
            pytest.skip("No GE port is configured for this Provision case")
        deleteGeServiceWithProfile (self, "$py_TempQos")
        deleteServiceWithPort (self, self.dutIp, self.geInfo)
        waitGeUpdate (self, self.dutIp, self.geInfo, "Disable")
        deleteFileIfExisted(self,"GE Template","$py_TempQos")
        deleteAutoMaxFileIfTableFull(self,"GE Template",3000)
        deleteFileIfExisted(self,"Weight Profile","$py_Weight")
        deleteAutoMaxFileIfTableFull(self,"Weight Profile",3000)
        deleteFileIfExisted(self,"Shaping Profile","$py_Shaping")
        deleteAutoMaxFileIfTableFull(self,"Shaping Profile",3000)
        deleteFileIfExisted(self,"Rate Limit Profile","$py_RateLimit")
        deleteAutoMaxFileIfTableFull(self,"Rate Limit Profile",3000)
        #Create Weight profile: "$py_Weight"
        createProfile (self, "Weight Profile", "$py_Weight")
        for i in range(8):
            ind = str(i)
            waitInput(self, (By.ID, "ge_weight_queue" + ind + "_text"), ind)
        saveProfile (self)
        #Create Shaping Profile: "$py_Shaping"
        createProfile (self, "Shaping Profile", "$py_Shaping")
        for i in range(8):
            ind = str(i)
            waitInput(self, (By.ID, "ge_shaping_queue" + ind + "_text"), str(i*1000000))
        saveProfile (self)
        #Create Rate Limit Profile: "$py_RateLimit"
        createProfile (self, "Rate Limit Profile", "$py_RateLimit")
        waitClick(self, (By.XPATH, "//label[@for=\"ge_ratelimit_ingress_checkbox\"]"))
        waitInput(self, (By.ID, "ge_ratelimit_ingress_cir_text"), str(10000000))
        waitInput(self, (By.ID, "ge_ratelimit_ingress_cbs_text"), str(16000000))
        waitInput(self, (By.ID, "ge_ratelimit_ingress_eir_text"), str(10000000))
        waitInput(self, (By.ID, "ge_ratelimit_ingress_ebs_text"), str(16000000))
        waitClick(self, (By.XPATH, "//label[@for=\"ge_ratelimit_egress_checkbox\"]"))
        waitInput(self, (By.ID, "ge_ratelimit_egress_rate_text"), str(10000000))
        waitInput(self, (By.ID, "ge_ratelimit_egress_burst_text"), str(128000))
        saveProfile (self)
        #Create GE Template profile: "$py_TempQos"
        createProfile (self, "GE Template", "$py_TempQos")
        waitSelect(self, (By.ID, "ge_template_ratelimit_combobox"), "$py_RateLimit")
        waitSelect(self, (By.ID, "ge_template_shaping_combobox"), "$py_Shaping")
        waitSelect(self, (By.ID, "ge_template_weight_combobox"), "$py_Weight")
        saveProfile (self)
        #Create service with $py_TempQos
        createGeServiceWithPortProfile (self, self.dutIp, self.geInfo, "$py_TempQos")
        #Wait service finished
        waitGeServiceSuccess (self, self.dutIp, self.geInfo)
        time.sleep (5)
        #Check ge Config in CLI
        geID = "interface ge " + self.geInfo[0] + "-" + self.geInfo[1]
        checkValue = [geID,
                      "enable",
                      "auto-negotiation enable", 
                      "flow-control enable", 
                      "speed 1g-full", 
                      "vlan copy_cpbit enable", 
                      "vlan outer-tpid disable", 
                      "frame-type all", 
                      "qos shaping-profile $py_Shaping",
                      "qos weight-profile $py_Weight",
                      "qos ratelimit-profile $py_RateLimit",
                      "dhcp l2agent snooping dhcp untrust", 
                      "dhcp l2agent snooping dhcpv6 untrust", 
                      "dhcp l2agent opt-ldra-policy linklocal chk-all",
                      "exit"]
        #with assume: assert checkValue == await cliShowGeRunningConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.geInfo)
        for checkItem in checkValue:
            with assume: assert checkItem in (await cliShowGeRunningConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.geInfo))
        #Check qos weight profile in CLI
        checkValue = ["0", "1", "2", "3", "4", "5", "6", "7"]
        with assume: assert checkValue == await cliShowWeightProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_Weight")
        #Check qos shaping profile in CLI
        checkValue = ["0", "1000000", "2000000", "3000000", "4000000", "5000000", "6000000", "7000000"]
        with assume: assert checkValue == await cliShowShapingProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_Shaping")
        #Check qos rate limit profile in CLI
        checkValue = ["Ingress", "Y", "10000000", "16000000", "10000000", "16000000", "Egress", "Y", "10000000", "128000"]
        with assume: assert checkValue == await cliShowRateLimitProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_RateLimit")


