        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        if self.serviceOntFlag == "xont":
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempONTMulticast"
        else:
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "--"
        #Check in CLI
        checkValue = []
        #Check ont or ont-14 config
        if self.serviceOntFlag != "xont":
            ontAid = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] if self.serviceOntFlag == "ont" else "ont-" + ontInfo[1] + "-" + ontInfo[2]
            uniportAid = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] if self.serviceOntFlag == "ont" else "uniport-" + ontInfo[1] + "-" + ontInfo[2]
            checkList = [[ontAid, "no inactive", "sn " + self.serviceOntSN, "password " + self.serviceOntPW
                        , "bwgroup 1 usbwprofname \$py_BandwidthIGMPUpT dsbwprofname \$py_BandwidthIGMPDownT(()|( allocid \d+))"]
                        ,[uniportAid + "-1-1", "no inactive"
                        , "queue tc 0 priority 0 weight 0 usbwprofname \$py_BandwidthIGMPUp dsbwprofname \$py_BandwidthIGMPDown dsoption ont bwsharegroupid 1"
                        , "vlan 101 ((ingprof tc0 network 101 gemport \d+)|(network 101 gemport \d+ ingprof tc0)) aesencrypt disable sharepri 0"
                        , "igmpchannel 101 version IGMPv3 ((group-privilege-prof \$py_IGMPGroupPrivilege1 mvlan 3001 )|())maxgroup 512 txtag replace 1001 maxmsg 64"]
                        ,[uniportAid + "-1-2", "no inactive"
                        , "queue tc 1 priority 0 weight 0 usbwprofname \$py_BandwidthIGMPUp dsbwprofname \$py_BandwidthIGMPDown dsoption ont bwsharegroupid 1"
                        , "vlan 102 ((ingprof tc1 network 102 gemport \d+)|(network 102 gemport \d+ ingprof tc1)) aesencrypt disable sharepri 1"
                        , "igmpchannel 102 version IGMPv3 ((group-privilege-prof \$py_IGMPGroupPrivilege2 mvlan 3002 )|())maxgroup 512 txtag replace 1002 maxmsg 64"]
                        ,[uniportAid + "-1-3", "no inactive"
                        , "queue tc 2 priority 0 weight 0 usbwprofname \$py_BandwidthIGMPUp dsbwprofname \$py_BandwidthIGMPDown dsoption ont bwsharegroupid 1"
                        , "vlan 103 ((ingprof tc2 network 103 gemport \d+)|(network 103 gemport \d+ ingprof tc2)) aesencrypt disable sharepri 2"
                        , "igmpchannel 103 version IGMPv3 ((group-privilege-prof \$py_IGMPGroupPrivilege3 mvlan 3003 )|())maxgroup 512 txtag replace 1003 maxmsg 64"]
                        ,[uniportAid + "-1-4", "no inactive"
                        , "queue tc 3 priority 0 weight 0 usbwprofname \$py_BandwidthIGMPUp dsbwprofname \$py_BandwidthIGMPDown dsoption ont bwsharegroupid 1"
                        , "vlan 104 ((ingprof tc3 network 104 gemport \d+)|(network 104 gemport \d+ ingprof tc3)) aesencrypt disable sharepri 3"
                        , "igmpchannel 104 version IGMPv3 ((group-privilege-prof \$py_IGMPGroupPrivilege4 mvlan 3004 )|())maxgroup 512 txtag replace 1004 maxmsg 64"]]
            resultList = await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo)
            with assume: assert gponOntConfigCheckResult (checkList, resultList)
        #Check neox or ies xont config and profile
        else:
            await setXponSnStyle(self.dutIp, self.dutAdminName, self.dutAdminPwd, "normal")
            serviceOntSNCLI = sn16To12 (self.serviceOntSN)
            #Check neox xont config
            if "NeoX" in self.dutType:
                checkValue = ["Active", "Enable", self.serviceOntPW, serviceOntSNCLI, "", "auto", "none", "$py_TempONTMulticast", "", "", "", "", ""]
            #Check ies xont config
            else:
                checkValue = ["Active", self.serviceOntPW, serviceOntSNCLI, "", "$py_TempONTMulticast", "", "", "", "", ""]
            with assume: assert await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo) == checkValue
            #Check neox temp profile
            if "NeoX" in self.dutType:
                checkValue = ["Template Name: \"$py_TempONTMulticast\"", "Multicast Profile #1: Name \"$py_ONTMulticast1\"", "Multicast Profile #2: Name \"$py_ONTMulticast2\""
                              , "Multicast Profile #3: Name \"$py_ONTMulticast3\"", "Multicast Profile #4: Name \"$py_ONTMulticast4\"", "QoS Downstream Option : ont", "MAC Learning : enable", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            #Check ies temp profile
            else:
                checkValue = ["Template Name: \"$py_TempONTMulticast\"", "Multicast Profile #1: Name \"$py_ONTMulticast1\"", "Multicast Profile #2: Name \"$py_ONTMulticast2\""
