    # System/ Security/ Online User
    @pytest.mark.Unicase
    def test_EMS1_3652_3653_onlineUsr(self):
        # Firefox self.browser can't do this auto script
        if self.browser=="firefox": return
        kickUsr(self, "PyUser")
        newEMSUsr (self, "PyUser", "PyUserPWD", "ReadWrite", "Global")
        self.driver.switch_to.new_window("window")
        self.driver.get(self.emsURL)
        loginEMS (self, "PyUser","PyUserPWD")
        WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID,"index_t_userName")))
        currentTime = datetime.now()
        startTime = currentTime - timedelta(seconds = 10)
        endTime = currentTime + timedelta(seconds = 10)
        entryPosition = getOnlineUsrPosition(self)
        testTimeRaw = getElementByPositionCol(self, "onlineUserTable", entryPosition , "loginTime").text
        testTime = re.sub(r" \(.*$", "",testTimeRaw)
        getTime = datetime.strptime(testTime, self.dateFormat)
        isTimeInRange = (startTime <= getTime <= endTime)
        with assume: assert getElementByPositionCol(self, "onlineUserTable", entryPosition , "userName").text == "PyUser"
        with assume: assert isTimeInRange
        with assume: assert getElementByPositionCol(self, "onlineUserTable", entryPosition , "loginIp").text == getLoginIP()
        getElementByPositionCol(self, "onlineUserTable", entryPosition , "Checkbox").click()
        self.driver.find_element(By.ID, "i_action_delete").click()
        time.sleep (3)
        assert waitMessageText(self) == "Can't force logout yourself."
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep (3)
        p = self.driver.window_handles[0]
        c = waitNewWindowHandle(self)
        logoutEMS (self)
        self.driver.switch_to.window(p)
        if self.driver.find_element(By.LINK_TEXT, "System").get_attribute("className") == "":
            self.driver.find_element(By.LINK_TEXT, "System").click()
            time.sleep (3)
        if self.driver.find_element(By.LINK_TEXT, "Security").get_attribute("className") == "":
            self.driver.find_element(By.LINK_TEXT, "Security").click()
            time.sleep (3)
        if self.driver.find_element(By.ID, "user_online").get_attribute("className") == "":
            self.driver.find_element(By.ID, "user_online").click()
            time.sleep (3)
        self.driver.find_element(By.ID, "i_action_refresh").click()
        time.sleep (3)
        with assume: assert getPositionByColNext (self, "onlineUserTable", "loginTime", testTimeRaw) == [-1, -1]
        delEMSUsr (self, "PyUser")


    # System/ Fault/ Pairwise Correlation
    @pytest.mark.Unicase
    def test_EMS1_3671_6337_pairwiseCorrelationSetting(self):
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "Fault").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "Pairwise Correlation").click()
        time.sleep (3)
        tableId = "pairwise_correlationTable"
        colFirstAlarm = "FirstAlarm"
        colClearAlarm = "ClearAlarm"
        #Check default value
        with assume: assert self.emsFirstAlarmList == getListByCol(self, tableId, colFirstAlarm)
        with assume: assert self.emsClearAlarmList == getListByCol(self, tableId, colClearAlarm)
        with assume: assert all(i == "true" for i in getPairwiseEnableList(self))
        #Change the enable column all alarm item became disable
        clickAllByCol(self, tableId, "Enable")
        time.sleep (5)
        #print(getPairwiseEnableList(self))
        with assume: assert all(i == None for i in getPairwiseEnableList(self))
        #Back to defaul setting
        clickAllByCol(self, tableId, "Enable")
        time.sleep (5)
        #print(getPairwiseEnableList(self))
        with assume: assert all(i == "true" for i in getPairwiseEnableList(self))
        #Check enable setting
        if self.driver.find_element(By.ID, "enable_global_pairwise").get_attribute("checked") == "true":
            self.driver.find_element(By.XPATH, "//label[@for=\"enable_global_pairwise\"]").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "pairwise_button").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            with assume: assert self.driver.find_element(By.ID, "enable_global_pairwise").get_attribute("checked") == None
            self.driver.find_element(By.XPATH, "//label[@for=\"enable_global_pairwise\"]").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "pairwise_button").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            with assume: assert self.driver.find_element(By.ID, "enable_global_pairwise").get_attribute("checked") == "true"
        else:
            self.driver.find_element(By.XPATH, "//label[@for=\"enable_global_pairwise\"]").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "pairwise_button").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            with assume: assert self.driver.find_element(By.ID, "enable_global_pairwise").get_attribute("checked") == "true"
            self.driver.find_element(By.XPATH, "//label[@for=\"enable_global_pairwise\"]").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "pairwise_button").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            with assume: assert self.driver.find_element(By.ID, "enable_global_pairwise").get_attribute("checked") == None


