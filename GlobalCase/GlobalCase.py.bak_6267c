                        with assume: assert ("show interface gpon " + slotID + "-" + portID + " dhcp l2agent snooping statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface gpon " + slotID + "-" + portID + " igmp-mld group") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface gpon " + slotID + "-" + portID + " igmp-mld statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface gpon " + slotID + "-" + portID + " ip source binding") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                case "xPON":
                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " ddmi status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
