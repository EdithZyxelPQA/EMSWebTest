        self.driver.find_element(By.LINK_TEXT, "Download").click()
        time.sleep(10)
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        files = glob.glob(os.path.join(self.downloadpath, "*.txt"))
        latestFile = max(files, key=os.path.getmtime)
        # Ready upload config file from local download path
        configFileName = os.path.basename(latestFile)
        configFilePath = os.path.join(self.downloadpath, configFileName)
