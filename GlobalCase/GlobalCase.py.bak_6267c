        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        if self.serviceOntFlag == "xont":
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempDel"
        else:
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "--"
        #Delete ont 
        deleteServiceWithProfile(self, "$py_TempDel")
        deleteServiceWithSn(self, self.serviceOntSN)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered") 
        #CLI delete device profile
        if self.serviceOntFlag == "ont-14":
            await cliCommandList (self.dutIp, self.dutAdminName, self.dutAdminPwd, ["config", "no qos bwprof $py_BwDel"
                                                               , "no voip-common-profile $py_ComnDel"
                                                               , "no voip-sip-profile $py_SipDel"
                                                               , "no voip-dial-plan $py_DialDel"])
        if self.serviceOntFlag == "xont":
            await cliCommandList (self.dutIp, self.dutAdminName, self.dutAdminPwd, 
                            ["config", "no xpon template $py_TempDel", "no xpon ont-profile $py_OntDel"
                             , "no xpon service-profile $py_ServiceDel", "no xpon qos bwprof $py_BwDel"
                             , "no xpon uni-profile $py_UniDel", "no xpon voip-common-profile $py_ComnDel"
                             , "no xpon voip-sip-profile $py_SipDel", "no xpon voip-dial-plan $py_DialDel"])
        if self.serviceOntFlag == "ont":
            await cliCommandList (self.dutIp, self.dutAdminName, self.dutAdminPwd, 
                            ["config", "no qos bwprof $py_BwDel", "no voip-common-profile $py_ComnDel"
                             , "no voip-sip-profile $py_SipDel", "no voip-dial-plan $py_DialDel"])  
        #Excecuting provision service again
        createServiceWithIpSnPwdProfile(self, self.dutIp, self.serviceOntSN, self.serviceOntPW, "$py_TempDel")       
        #Check result should be fail
        waitOntServiceStatus (self, self.serviceOntSN, "Fail")
        #Delete profile sync status
        self.driver.find_element(By.LINK_TEXT, "Provision").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "Profile").click()
        time.sleep (3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_delete_profile_sync_state > a").click()
        time.sleep(3)
        selecInDelPrfSyncByIP (self, self.dutIp)
        time.sleep(3)
        self.driver.find_element(By.ID, "provision_delete_profile_sync_delete_btn").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "confirm_yes_button").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        #Excecuting provision service again
        self.driver.find_element(By.LINK_TEXT, "Service").click()
        time.sleep(3)
        entryPosition = getPositionByCols(self, "provision_service_table", {"sn": self.serviceOntSN})
        getElementByPositionCol(self, "provision_service_table", entryPosition , "Checkbox").click()
        self.driver.find_element(By.CSS_SELECTOR, "#provision_service_reprovision > a").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        #Check result should be success
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        if self.serviceOntFlag == "xont":
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempDel"
        else:
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "--"


