    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_6882_ontServiceModify(self):
        #$py_TempONTService need provision the ont first (Need execute ontBandwidthServicePrfAdd, ontServiceAdd first)
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag != "xont": return
        #Delete profile in profile list
        deleteFileListIfExisted(self,"ONT QoS Bandwidth Profile","$py_modG", 16)
        deleteFileListIfExisted(self,"ONT QoS Bandwidth Profile","$py_modT", 16)
        #Delete auto_ profile if the table full
        deleteAutoMaxFileIfTableFull(self,"ONT QoS Bandwidth Profile",2968)
        xponPirGem = 361600
        gponPirGem = -5760
        xponPirTcont = 1808000
        gponPirTcont = -57600
        for indPrf in range (16):
            xponPirGem = xponPirGem + 102400
            gponPirGem = gponPirGem + 15360
            xponPirTcont = xponPirTcont + 512000
            gponPirTcont = gponPirTcont + 153600
            #Create ONT QoS Bandwidth Profile: "$py_modG"
            createProfile (self, "ONT QoS Bandwidth Profile", "$py_modG" + str(indPrf+1))
            fillOntQosBandwidthProfile(self, xponPirGem, gponPirGem)
            saveProfile (self)
            #Create ONT QoS Bandwidth Profile: "$py_modT"
            createProfile (self, "ONT QoS Bandwidth Profile", "$py_modT" + str(indPrf+1))
            fillOntQosBandwidthProfile(self, xponPirTcont, gponPirTcont)
            saveProfile (self)
        openOntServicePage(self)
        time.sleep(3)
        waitPageIdle(self)
        entryPosition = getPositionByCols(self, "provision_service_table", {"sn":self.serviceOntSN})
        clickElementWhenReady(self, getElementByPositionCol(self, "provision_service_table", entryPosition , "Modify"))
        #Edit service with $py_TempONTService
        waitSelect(self, (By.ID, "provision_service_onttemplate_combbox"), "$py_TempONTService")
        time.sleep(3)
        waitPageIdle(self)
        waitInput(self, (By.ID, "provision_service_desc_text"), "ForServceModifyTest")
        waitInput(self, (By.ID, "provision_service_dspir_text"), "10240")
        #Wan Setting
        for ind in range (8):
            waitInput(self, (By.ID, "provision_service_wan_table_address_" + str(ind + 1)), "192.10" + str(ind + 1) + ".10.1")
            waitInput(self, (By.ID, "provision_service_wan_table_mask_" + str(ind + 1)), "255.255.0.0")
            waitInput(self, (By.ID, "provision_service_wan_table_gateway_" + str(ind + 1)), "192.10" + str(ind + 1) + ".10.254")
            waitInput(self, (By.ID, "provision_service_wan_table_pridns_" + str(ind + 1)), "11.2.3.4" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wan_table_secdns_" + str(ind + 1)), "55.6.7.8" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wan_table_username_" + str(ind + 1)), "UsrModify" + str(ind + 1) + "@hinet.net")
            waitInput(self, (By.ID, "provision_service_wan_table_password_" + str(ind + 1)), "PwdModify" + str(ind + 1))
        #Wifi Setting
        for ind in range (4):
            waitInput(self, (By.ID, "provision_service_wify24g_table_ssid_" + str(ind + 1)), "SSID24_TestModify" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wify24g_table_password_" + str(ind + 1)), "Password24_TestModify" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wify5g_table_ssid_" + str(ind + 1)), "SSID5_TestModify" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wify5g_table_password_" + str(ind + 1)), "Password5_TestModify" + str(ind + 1))
        #VoIP Setting
        for ind in range (2):
