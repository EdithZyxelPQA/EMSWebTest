# ===== Source: EMSNewCaseTest_20260616/test_ems1_7212_ip_name_server.py =====


class _NewCase15Cases:
    driver = None
    illegal_special = "@#$%.abc"
    illegal_ip_format = "999.999.999.999"
    valid_first = "8.8.8.8"
    valid_second = "168.95.1.1"
    def _newcase_15_setup_browser(self):
        self.driver = create_browser(self.browser, self.downloadpath)
        self.driver.implicitly_wait(self.waitTime)
        self.driver.maximize_window()
        yield
        if "NeoX" in self.dutType:
            self._newcase_15__clear_ip_nameserver_for_current_dut_bug()
        if self.driver:
            close_browser(self.driver)
            self.driver = None


    @pytest.mark.Unicase
    def test_EMS1_7212_ipNameServer(self):
        if "NeoX" not in self.dutType:
            pytest.skip("EMS1-7212 IP Name Server is supported only on NeoX devices.")

        self._newcase_15__clear_ip_nameserver_for_current_dut_bug()

        print("EMS1-7212: login EMS")
        self.driver.get(self.emsURL)
        login_ems(self.driver, self.emsUsr, self.emsPwd)
        print("EMS1-7212: open IP Name Server page")
        open_ip_name_server_page(self.driver, self.dutNodeName)

        print("EMS1-7212: apply two invalid values")
        set_ip_name_servers(self.driver, self.illegal_special, self.illegal_ip_format)
        apply_ip_name_server(self.driver)
        assert_apply_rejected(self.driver)
        print("EMS1-7212: verify invalid values were not applied")
        output = self._newcase_15__show_ip_nameserver()
        assert self.illegal_special not in output
        assert self.illegal_ip_format not in output

        print("EMS1-7212: apply first valid and second invalid value")
        set_ip_name_servers(self.driver, self.valid_first, self.illegal_ip_format)
        apply_ip_name_server(self.driver)
        assert_apply_rejected(self.driver)
        print("EMS1-7212: verify second invalid value was not applied")
        output = self._newcase_15__show_ip_nameserver()
        assert self.illegal_ip_format not in output

        print("EMS1-7212: apply final valid values")
        set_ip_name_servers(self.driver, self.valid_first, self.valid_second)
        apply_ip_name_server(self.driver)
        success_message = wait_apply_success(self.driver)
        assert "Success" in success_message
        print("EMS1-7212: verify final valid values by SSH")
        output = self._newcase_15__show_ip_nameserver()
        assert self.valid_first in output
        assert self.valid_second in output

    def _newcase_15__clear_ip_nameserver_for_current_dut_bug(self):
        # WORKAROUND for current DUT bug:
        # The DUT may keep stale IP name server entries that affect EMS validation/apply.
        # TODO: Remove this pre-clean/post-clean after the DUT bug is fixed and restore normal test setup.
        run_ssh_commands(
            self.dutIp,
            self.dutAdminName,
            self.dutAdminPwd,
            ["configure", "no ip nameserver 1", "no ip nameserver 2"],
        )

    def _newcase_15__show_ip_nameserver(self):
        return run_ssh_command(
            self.dutIp,
            self.dutAdminName,
            self.dutAdminPwd,
            "show ip nameserver",
        )


# ===== Source: EMSNewCaseTest_20260616/test_ems1_7214_device_status_down.py =====





EXPECTED_DOWN_STATUS = "Device Not Responding"
class _NewCase16Cases:
    driver = None
    def _newcase_16_setup_browser(self):
        print("EMS1-7214: create browser", flush=True)
        self.driver = create_browser(self.browser, self.downloadpath)
        print("EMS1-7214: browser created", flush=True)
        self.driver.implicitly_wait(self.waitTime)
        self.driver.set_page_load_timeout(60)
        print("EMS1-7214: maximize browser", flush=True)
        self.driver.maximize_window()
        print("EMS1-7214: browser ready", flush=True)
        yield
        if self.driver:
            close_browser(self.driver)
            self.driver = None


    @pytest.mark.Unicase
    @pytest.mark.skip
    def test_EMS1_7214_deviceStatusDown(self):
        if not self._newcase_16__is_supported_device():
            pytest.skip("EMS1-7214 supports only NeoX and IES devices.")

        disabled = False
        print("EMS1-7214: login EMS")
        self._newcase_16__open_ems()
        login_ems(self.driver, self.emsUsr, self.emsPwd)

        try:
            print("EMS1-7214: verify device status is Up")
            current_status = self._newcase_16__current_device_status()
            if current_status != "Up":
                print(f"EMS1-7214: initial device status is {current_status}; enable all uplink ports first")
                self._newcase_16__set_uplink_ports(enable=True, verify=True)
            self._newcase_16__wait_device_status("Up", timeout=600)

            print("EMS1-7214: disable uplink ports by console")
            self._newcase_16__set_uplink_ports(enable=False)
            disabled = True

            print("EMS1-7214: wait device status Down")
            self._newcase_16__wait_device_status("Down", timeout=600)

            print("EMS1-7214: wait 60 seconds before inventory/dashboard checks")
            time.sleep(60)
            self._newcase_16__check_inventory_down_pages()
            self._newcase_16__check_dashboard_down_status()
        finally:
            if disabled:
                print("EMS1-7214: restore uplink ports by console")
                self._newcase_16__set_uplink_ports(enable=True, verify=True)
                print("EMS1-7214: wait device status back to Up")
                self._newcase_16__wait_device_status("Up", timeout=600)

    def _newcase_16__set_uplink_ports(self, enable, verify=False):
        action = "enable" if enable else "disable"
        interface_type = "nni" if "NeoX" in self.dutType else "genni"
        interface_command = f"interface {interface_type} *"
        if not self.dutConsolePort:
            raise RuntimeError("Console port is required for EMS1-7214 because disabling uplink may break in-band access.")
        commands = ["configure", interface_command, action, "exit", "exit"]
        if verify:
            commands.append(f"show interface {interface_type} * config")
        output = run_console_commands(
            self.dutConsolePort,
            self.dutConsoleBaudrate,
            self.dutConsoleName,
            self.dutConsolePwd,
            commands,
            timeout=90,
        )
        with assume:
            assert "% Invalid" not in output and "Unknown command" not in output, output
        if verify:
            active_statuses = _interface_active_statuses(output)
            with assume:
                assert active_statuses and all(status == "Yes" for status in active_statuses.values()), active_statuses

    def _newcase_16__open_ems(self):
        try:
            self.driver.get(self.emsURL)
        except TimeoutException:
            print("EMS1-7214: EMS page load timeout; continue with current page", flush=True)

    def _newcase_16__current_device_status(self):
        self._newcase_16__filter_device()
        rows = table_rows(self.driver, "dev_inventory_div")
        row = _single_row_for_ip(rows, self.dutIp)
        return _first_value(row, ["DevStatus", "Operational Status", "OperationStatus", "Status"])

    def _newcase_16__wait_device_status(self, expected_status, timeout):
        self._newcase_16__filter_device()
        end_time = time.time() + timeout
        last_status = ""
        while time.time() < end_time:
            rows = table_rows(self.driver, "dev_inventory_div")
            try:
                row = _single_row_for_ip(rows, self.dutIp)
            except AssertionError:
                last_status = f"rows={rows}"
                self._newcase_16__refresh()
                time.sleep(5)
                continue
            status = _first_value(row, ["DevStatus", "Operational Status", "OperationStatus", "Status"])
            last_status = f"{status}, row={row}"
            if status == expected_status:
                return row
            self._newcase_16__refresh()
            time.sleep(5)
        raise AssertionError(f"Device status did not become {expected_status}. Last status: {last_status}")

    def _newcase_16__check_inventory_down_pages(self):
        print("EMS1-7214: check Inventory/Card")
        self._newcase_16__filter_card()
        self._newcase_16__assume_rows_status(
            "Inventory/Card",
            table_rows(self.driver, "card_inventory_div"),
            ["OperationStatus", "Operation Status"],
            require_rows=True,
        )

        for page_name, filter_method, should_exist in self._newcase_16__port_pages_to_check():
            print(f"EMS1-7214: check Inventory/Port/{page_name}")
            filter_method()
            rows = table_rows(self.driver, "port_inventory_div")
            self._newcase_16__assume_rows_status(
                f"Inventory/Port/{page_name}",
                rows,
                ["portOperationStatus", "OperationStatus", "Operation Status"],
                require_rows=should_exist,
            )

        print("EMS1-7214: check Inventory/ONT")
        self._newcase_16__filter_ont()
        self._newcase_16__assume_rows_status(
            "Inventory/ONT",
            table_rows(self.driver, "ont_inventory_div"),
            ["OntOperationStatus", "OperationStatus", "Operation Status"],
            require_rows=False,
        )

    def _newcase_16__check_dashboard_down_status(self):
        print("EMS1-7214: check Dashboard/ONT Status")
        status_count = self._newcase_16__dashboard_status_link_count("ontStatus")
        for index in range(1, status_count + 1):
            navigate_to(self.driver, "Dashboard")
            status_link = self.driver.find_element(
                By.XPATH,
                f"(//div[@id='ontStatus']//a[string-length(normalize-space()) > 0])[{index}]",
            )
            status_text = status_link.text.strip()
            status_link.click()
            time.sleep(2)
            self._newcase_16__select_dashboard_device_if_present()
            with assume:
                assert total_data(self.driver, "All_ontStatusTable") == 0, f"ONT Status {status_text or index}"

        print("EMS1-7214: check Dashboard/Ethernet Access Port Status")
        if self._newcase_16__has_ethernet_access_card():
            navigate_to(self.driver, "Dashboard")
            self.driver.find_element(By.CSS_SELECTOR, "#gePortStatusList a[data-value='99']").click()
            time.sleep(3)
            rows = _try_table_rows(self.driver, "All_gePortStatusTable")
            with assume:
                assert any(self.dutIp in row.values() for row in rows), rows

    def _newcase_16__dashboard_status_link_count(self, status_id):
        navigate_to(self.driver, "Dashboard")
        return len(
            self.driver.find_elements(
                By.XPATH,
                f"//div[@id='{status_id}']//a[string-length(normalize-space()) > 0]",
            )
        )

    def _newcase_16__filter_device(self):
        navigate_to(self.driver, "Inventory", "Device")
        self._newcase_16__open_filter()
        _click_if_present(self.driver, By.ID, "inventory_device_clear_btn")
        _type_if_present(self.driver, By.ID, "ip1", self.dutIp)
        _click_if_present(self.driver, By.ID, "inventory_device_btn")
        _wait_table(self.driver, "dev_inventory_div")

    def _newcase_16__filter_card(self):
        navigate_to(self.driver, "Inventory", "Card")
        self._newcase_16__open_filter()
        _click_if_present(self.driver, By.ID, "inventory_slot_clear_btn")
        _type_if_present(self.driver, By.ID, "deviceName2", self.dutName)
        _type_if_present(self.driver, By.ID, "ip2", self.dutIp)
        _click_if_present(self.driver, By.ID, "inventory_slot_btn")
        _wait_table(self.driver, "card_inventory_div")

    def _newcase_16__filter_all_ports(self):
        navigate_to(self.driver, "Inventory", "Port")
        _click_if_present(self.driver, By.ID, "AllPort")
        self._newcase_16__filter_port_page("all", clear_id="inventory_allport_clear_btn", button_id="inventory_allport_btn")

    def _newcase_16__filter_network_ports(self):
        navigate_to(self.driver, "Inventory", "Port")
        _click_if_present(self.driver, By.LINK_TEXT, "Network Port")
        self._newcase_16__filter_port_page("network")

    def _newcase_16__filter_ethernet_ports(self):
        navigate_to(self.driver, "Inventory", "Port")
        _click_if_present(self.driver, By.LINK_TEXT, "Ethernet Access Port")
        self._newcase_16__filter_port_page("ethernet")

    def _newcase_16__filter_gpon_ports(self):
        navigate_to(self.driver, "Inventory", "Port")
        _click_if_present(self.driver, By.LINK_TEXT, "GPON Port")
        self._newcase_16__filter_port_page("pon")

    def _newcase_16__filter_xpon_ports(self):
        navigate_to(self.driver, "Inventory", "Port")
        _click_if_present(self.driver, By.LINK_TEXT, "xPON Port")
        self._newcase_16__filter_port_page("xpon")

    def _newcase_16__filter_port_page(self, suffix, clear_id=None, button_id=None):
        self._newcase_16__open_filter()
        _click_if_present(self.driver, By.ID, clear_id or f"inventory_{suffix}_clear_btn")
        _type_if_present(self.driver, By.ID, f"deviceName_{suffix}", self.dutName)
        _type_if_present(self.driver, By.ID, f"ip_{suffix}", self.dutIp)
        _click_if_present(self.driver, By.ID, button_id or f"inventory_{suffix}_btn")
        _wait_table(self.driver, "port_inventory_div")

    def _newcase_16__filter_ont(self):
        navigate_to(self.driver, "Inventory", "ONT")
        self._newcase_16__open_filter()
        _click_if_present(self.driver, By.ID, "inventory_allont_clear_btn")
        _type_if_present(self.driver, By.ID, "deviceName_Allont", self.dutName)
        _type_if_present(self.driver, By.ID, "ip_Allont", self.dutIp)
        _click_if_present(self.driver, By.ID, "inventory_allont_btn")
        _wait_table(self.driver, "ont_inventory_div")

    def _newcase_16__port_pages_to_check(self):
        return [
            ("All Ports", self._newcase_16__filter_all_ports, True),
            ("Network Port", self._newcase_16__filter_network_ports, True),
            ("Ethernet Access Port", self._newcase_16__filter_ethernet_ports, self._newcase_16__has_ethernet_access_card()),
            ("GPON Port", self._newcase_16__filter_gpon_ports, self._newcase_16__has_gpon_card()),
            ("xPON Port", self._newcase_16__filter_xpon_ports, self._newcase_16__has_xpon_card()),
        ]

    def _newcase_16__assume_rows_status(self, page_name, rows, status_keys, require_rows):
        matched_rows = [row for row in rows if row.get("IPAddress") == self.dutIp or row.get("DevName") == self.dutName]
        if require_rows:
            with assume:
                assert matched_rows, f"{page_name} should have rows for {self.dutName}/{self.dutIp}. rows={rows}"
        for row in matched_rows:
            status = _first_value(row, status_keys)
            with assume:
                assert status == EXPECTED_DOWN_STATUS, f"{page_name} row status={status}, row={row}"

    def _newcase_16__open_filter(self):
        _click_if_present(self.driver, By.CSS_SELECTOR, "#i_action_filter > a")

    def _newcase_16__refresh(self):
        _click_if_present(self.driver, By.CSS_SELECTOR, "#i_action_refresh > a")

    def _newcase_16__select_dashboard_device_if_present(self):
        try:
            self.driver.find_element(By.CSS_SELECTOR, ".comboTreeArrowBtnImg").click()
            label = self.driver.find_element(By.XPATH, f"//label[contains(.,'{self.dutNodeName}')]")
            label.click()
            time.sleep(2)
        except NoSuchElementException:
            pass

    def _newcase_16__click_dashboard_status(self, section_title, status_text):
        navigate_to(self.driver, "Dashboard")
        candidates = self.driver.find_elements(
            By.XPATH,
            f"//*[normalize-space()='{section_title}']/ancestor::div[contains(@class,'panel') or contains(@class,'box')][1]"
            f"//*[normalize-space()='{status_text}']/following::a[1]",
        )
        if not candidates:
            candidates = self.driver.find_elements(By.XPATH, f"//div[contains(.,'{section_title}')]//a[normalize-space()='{status_text}']")
        with assume:
            assert candidates, f"Cannot find Dashboard/{section_title} status {status_text}"
        if candidates:
            candidates[0].click()
            time.sleep(3)

    def _newcase_16__has_ethernet_access_card(self):
        return any("GLC" in _card_text(key, card) or "NXA" in _card_text(key, card) for key, card in self.dutCardInfo.items())

    def _newcase_16__has_gpon_card(self):
        return "OLT" in self.dutType or any("OLC3416-42A" in _card_text(key, card) for key, card in self.dutCardInfo.items())

    def _newcase_16__has_xpon_card(self):
        return any(
            token in _card_text(key, card)
            for key, card in self.dutCardInfo.items()
            for token in ["OLC3146B", "OLC3416B", "OLC3816", "NXP"]
        )

    def _newcase_16__is_supported_device(self):
        return "NeoX" in self.dutType or "IES" in self.dutType


def _single_row_for_ip(rows, dut_ip):
    for row in rows:
        if row.get("IPAddress") == dut_ip:
            return row
    raise AssertionError(f"Cannot find device IP {dut_ip}. rows={rows}")


def _first_value(row, keys):
    for key in keys:
        if row.get(key):
            return row[key]
    return ""


def _card_text(key, card):
    return f"{key} {card.get('type', '')} {card.get('port_type', '')}"


def _interface_active_statuses(output):
    statuses = {}
    cleaned = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", output)
    for line in cleaned.splitlines():
        match = re.match(r"\s*(\d+)\s+\|\s+(Yes|No)\b", line)
        if match:
            statuses[match.group(1)] = match.group(2)
    return statuses


def _click_if_present(driver, by, value):
    try:
        WebDriverWait(driver, 30).until(EC.element_to_be_clickable((by, value))).click()
        time.sleep(1)
        return True
    except (NoSuchElementException, TimeoutException):
        return False


def _type_if_present(driver, by, value, text):
    try:
        element = WebDriverWait(driver, 10).until(EC.presence_of_element_located((by, value)))
    except TimeoutException:
        return False
    element.clear()
    element.send_keys(text)
    return True


def _wait_table(driver, table_id):
    WebDriverWait(driver, 30).until(EC.presence_of_element_located((By.ID, f"{table_id}_body")))


def _try_table_rows(driver, table_id):
    try:
        return table_rows(driver, table_id)
    except (NoSuchElementException, TimeoutException):
        return []


def _status_count(driver, status_id):
    return len(driver.find_elements(By.XPATH, f"//div[@id='{status_id}']/div"))


# ===== Source: EMSNewCaseTest_20260616/test_ems1_7215_ont_service_edit_vlan.py =====


class _NewCase17Cases:
    driver = None
    def _newcase_17_setup_browser(self):
        self.driver = create_browser(self.browser, self.downloadpath)
        self.driver.implicitly_wait(self.waitTime)
        self.driver.maximize_window()
        yield
        if self.driver:
            close_browser(self.driver)
            self.driver = None


    @pytest.mark.Unicase
    def test_EMS1_7215_ontServiceEditVlan(self):
        if "NeoX" not in self.dutType:
            pytest.skip("EMS1-7215 only supports NeoX devices.")
        if self.serviceOntFlag != "xont":
            pytest.skip("EMS1-7215 only supports xont.")

        sn = self.serviceOntSN
        password = self.serviceOntPW
        slot_id = self.serviceOntSlotID
        port_id = self.serviceOntPortID
        ont_id = self.serviceOntID
        assert sn, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.sn_16"
        assert password, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.pw"

        print("EMS1-7215: unregister ONT by SSH", flush=True)
        unregister_ont_by_flag(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.serviceOntSlotID, self.serviceOntPortID, self.serviceOntID)

        print(f"EMS1-7215: open EMS {self.emsURL}", flush=True)
        self.driver.get(self.emsURL)
        login_ems(self.driver, self.emsUsr, self.emsPwd)

        print("EMS1-7215: delete existing ONT service by SN", flush=True)
        delete_ont_service_if_exists(self.driver, sn)
        print("EMS1-7215: delete existing ONT service by template", flush=True)
        delete_ont_service_by_template_if_exists(self.driver, "$py_OntTempVlan")
        print("EMS1-7215: delete ONT template profile", flush=True)
        delete_profile_if_exists(self.driver, "ONT Template", "$py_OntTempVlan")

        for vlan in range(101, 133):
            print(f"EMS1-7215: recreate ONT Service Profile $py_Service{vlan}_XLAN1", flush=True)
            recreate_ont_service_profile(self.driver, f"$py_Service{vlan}_XLAN1", vlan, "LAN 1")

        print("EMS1-7215: recreate ONT QoS Bandwidth Profile $py_Bandwidth_1G_US", flush=True)
        recreate_ont_qos_bandwidth_profile(self.driver, "$py_Bandwidth_1G_US")
        print("EMS1-7215: recreate ONT QoS Bandwidth Profile $py_Bandwidth_1G_DS", flush=True)
        recreate_ont_qos_bandwidth_profile(self.driver, "$py_Bandwidth_1G_DS")
        print("EMS1-7215: recreate ONT Template Profile $py_OntTempVlan", flush=True)
        recreate_ont_template_vlan_profile(self.driver, "$py_OntTempVlan")

        print("EMS1-7215: confirm no ONT service by SN", flush=True)
        delete_ont_service_if_exists(self.driver, sn)

        print("EMS1-7215: wait Inventory/ONT Unregistered", flush=True)
        filter_inventory_ont_by_sn(self.driver, sn)
        wait_inventory_ont_id(self.driver, sn, lambda found_ont_id: found_ont_id == "Unregistered", timeout=300)

        print("EMS1-7215: create ONT service with template and QoS VLAN translation", flush=True)
        create_ont_service_with_qos_vlan_translation(
            self.driver,
            sn,
            self.dutIp,
            password,
            qos_count=32,
            template_name="$py_OntTempVlan",
        )
        print("EMS1-7215: wait ONT service Success", flush=True)
        wait_ont_service_success(self.driver, sn, timeout=600)

        print("EMS1-7215: wait Inventory/ONT registered", flush=True)
        filter_inventory_ont_by_sn(self.driver, sn)
        inventory_row = wait_inventory_ont_id(
            self.driver,
            sn,
            lambda found_ont_id: found_ont_id != "Unregistered",
            timeout=300,
        )
        actual_ont_id = inventory_row.get("ONT") or ont_id

        print("EMS1-7215: verify xONT config by SSH", flush=True)
        output = show_xont_config(
            self.dutIp,
            self.dutAdminName,
            self.dutAdminPwd,
            slot_id,
            port_id,
            actual_ont_id,
        )
        assert_qos_vlan_translation(output, service_count=32)


# ===== Source: EMSNewCaseTest_20260616/test_ems1_7226_reprovision_in_deleted_device.py =====


class _NewCase18Cases:
    driver = None
    description_before_delete = "beforeDeleteDevice"
    description_after_delete = "afterDeleteDevice"
    def _newcase_18_setup_browser(self):
        self.driver = create_browser(self.browser, self.downloadpath)
        self.driver.implicitly_wait(self.waitTime)
        self.driver.maximize_window()
        yield
        if self.driver:
            close_browser(self.driver)
            self.driver = None


    @pytest.mark.Unicase
    def test_EMS1_7226_reprovisionInDeletedDevice(self):
        sn = self.serviceOntSN
        password = self.serviceOntPW
        flag = self.serviceOntFlag
        assert sn, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.sn_16"
        assert password, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.pw"
        assert flag, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.flag"

        device_settings = default_device_settings(self)
        device_deleted = False

        try:
            print("EMS1-7226: unregister ONT by CLI", flush=True)
            unregister_ont_by_flag(self.dutIp, self.dutAdminName, self.dutAdminPwd, flag, self.serviceOntSlotID, self.serviceOntPortID, self.serviceOntID)

            print("EMS1-7226: login EMS", flush=True)
            self.driver.get(self.emsURL)
            login_ems(self.driver, self.emsUsr, self.emsPwd)

            print("EMS1-7226: ensure device exists in Map Management", flush=True)
            ensure_device_exists(self.driver, device_settings)

            print("EMS1-7226: wait Inventory/ONT Unregistered", flush=True)
            filter_inventory_ont_by_sn(self.driver, sn)
            wait_inventory_ont_id(self.driver, sn, lambda ont_id: ont_id == "Unregistered", timeout=300)

            print("EMS1-7226: delete existing ONT service", flush=True)
            delete_ont_service_if_exists(self.driver, sn)

            print("EMS1-7226: create ONT service before deleting device", flush=True)
            create_ont_service_by_manual_sn(
                self.driver,
                sn,
                password,
                description=self.description_before_delete,
            )

            print("EMS1-7226: wait ONT service Success", flush=True)
            wait_ont_service_success(self.driver, sn, timeout=600)

            print("EMS1-7226: verify Inventory/ONT is registered with before-delete description", flush=True)
            filter_inventory_ont_by_sn(self.driver, sn)
            wait_inventory_ont_id(
                self.driver,
                sn,
                lambda ont_id, row: ont_id != "Unregistered" and row.get("description") == self.description_before_delete,
                timeout=600,
            )

            print("EMS1-7226: remember registered ONT AID from Inventory/ONT", flush=True)
            aid = inventory_ont_aid(self.driver, sn, timeout=600)
            print(f"EMS1-7226: registered ONT AID={aid}", flush=True)

            print("EMS1-7226: remember device settings in Map Management", flush=True)
            device_settings = remember_device_settings_from_edit(self.driver, self.dutIp, device_settings)

            print("EMS1-7226: delete device in Map Management", flush=True)
            device_deleted = True
            delete_device_by_ip(self.driver, self.dutIp)

            print("EMS1-7226: wait ONT service return to Wait", flush=True)
            wait_ont_service_status(self.driver, sn, "Wait", timeout=600)

            print("EMS1-7226: edit Wait service description after device deletion", flush=True)
            edit_ont_service_description(self.driver, sn, self.description_after_delete)

            print("EMS1-7226: add deleted device back in Map Management", flush=True)
            add_device_under_ems(self.driver, device_settings)
            device_deleted = False

            print("EMS1-7226: wait ONT service return to Success", flush=True)
            wait_ont_service_status(self.driver, sn, "Success", timeout=900)

            print("EMS1-7226: verify Inventory/ONT is registered and has edited description", flush=True)
            filter_inventory_ont_by_sn(self.driver, sn)
            wait_inventory_ont_id(
                self.driver,
                sn,
                lambda ont_id, row: ont_id != "Unregistered" and row.get("description") == self.description_after_delete,
                timeout=600,
            )
        finally:
            if device_deleted:
                print("EMS1-7226: restore deleted device in Map Management", flush=True)
                ensure_device_exists(self.driver, device_settings)





