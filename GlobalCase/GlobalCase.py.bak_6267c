    @pytest.mark.Unicase
    def test_EMS1_7067_ethernetAccessPortStatusSort(self):
        print("EMS1-7067: login EMS", flush=True)
        self.driver.get(self.emsURL)
        login_ems(self.driver, self.emsUsr, self.emsPwd)

        entries = ethernet_access_status_entries(self.driver)
        with assume:
            assert entries, "No clickable Dashboard/Ethernet Access Port Status entries found"

        for entry in entries:
            status = entry["name"]
            print(f"EMS1-7067: check Ethernet Access Port Status sort for {status}", flush=True)
            dashboard_count = click_ethernet_access_status_entry(self.driver, entry)
            table_total = total_data(self.driver, GE_PORT_STATUS_TABLE)
            print(
                f"EMS1-7067: Ethernet Access Port Status {status} "
                f"dashboard count={dashboard_count}, table total={table_total}",
                flush=True,
            )

            if table_total == 0:
                print(f"EMS1-7067: skip Ethernet Access Port Status {status} sort because Total data is 0", flush=True)
                continue

            columns = sortable_table_columns(self.driver, GE_PORT_STATUS_TABLE)
            with assume:
                assert columns, f"No sortable columns found for Ethernet Access Port Status {status}"

            for column in columns:
                column_name = column["name"]
                column_label = column.get("label", column_name)
                column_index = column["index"]
                # EMS sorts most columns by value, but power columns as text and state columns
                # by an internal code; check each column with the rule EMS actually uses
                column_rule = {"text_case": "sensitive", "numeric_natural": True, "empty_first": True}
                if column_name in ("txPower", "rxPower"):
                    column_rule["numeric_natural"] = False
                grouped_column = column_name in ("portAdminState", "EnetPortLinkStatus")
                if grouped_column:
                    column_rule = {"grouped_only": True}

                print(f"EMS1-7067: {status} column [{column_label}] direction [ascending]", flush=True)
                ascending_values = None
                with assume:
                    click_table_sort_direction(
                        self.driver,
                        GE_PORT_STATUS_TABLE,
                        column_index,
                        column_name,
                        descending=False,
                    )
                    assert_column_sorted_each_page(
                        self.driver,
                        GE_PORT_STATUS_TABLE,
                        column_name,
                        descending=False,
                        context=f"{status}/column [{column_label}]/direction [ascending]",
                        **column_rule,
                        page_scope="first",
                    )
                    ascending_values = first_page_column_values(self.driver, GE_PORT_STATUS_TABLE, column_name)

                print(f"EMS1-7067: {status} column [{column_label}] direction [descending]", flush=True)
                with assume:
                    click_table_sort_direction(
                        self.driver,
                        GE_PORT_STATUS_TABLE,
                        column_index,
                        column_name,
                        descending=True,
                    )
                    assert_column_sorted_each_page(
                        self.driver,
                        GE_PORT_STATUS_TABLE,
                        column_name,
                        descending=True,
                        context=f"{status}/column [{column_label}]/direction [descending]",
                        **column_rule,
                        page_scope="first",
                    )
                    if ascending_values is not None:
                        # whole-table check with only the first page of each direction
                        assert_sort_direction_extremes(
                            ascending_values, first_page_column_values(self.driver, GE_PORT_STATUS_TABLE, column_name),
                            column_name, context=f"{status}/column [{column_label}]", **column_rule,
                        )


