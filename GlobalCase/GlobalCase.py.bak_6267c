    # Map / Device / ONT Status
    @pytest.mark.Unicase
    def test_EMS1_4367_4368_mapOntStatus(self):
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + self.dutNodeName + "\')]").click()
        time.sleep(3)
        #Check ont each status number
        for status in range(1, self.ontStatusCount+1):
            self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[" + str(status) + "]/div[2]/a").click()
            statusTitle = self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[" + str(status) + "]/div[2]/a").text
            statusData = self.driver.find_element(By.ID, "table_total_data_Dev_ontStatusTable").text.strip("Total data:")
            with assume: assert statusTitle == statusData
        #Check click the inService ONT can switch to ont status page
        self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[1]/div[2]/a").click()
        for index in range(self.ontCount):
            time.sleep(3)
            entryPosition = getPositionByColsAndClickNext(self, "Dev_ontStatusTable", {"sn": self.ontSNList[index]})
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            time.sleep(3)
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_dev").text == self.dutName + " (" + self.dutIp + ")"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_slotid").text == "Slot: " + self.ontSlotIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_portid").text == "Port: " + self.ontPortIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_ontid").text == "ONT: " + self.ontOntIDList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Admin Status") == "Active"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Operation Status") == "IS"
            with assume: assert getAttributeValue (self, "ontStatusTable", "SN") == self.ontSNList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Password") == self.ontPWList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Model") == self.ontModelList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Type") == self.ontTypeList[index]
            self.driver.close()
            self.driver.switch_to.window(p)
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "Slot").text == self.ontSlotIDList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "Port").text == self.ontPortIDList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "ONT").text == self.ontOntIDList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "sn").text == self.ontSNList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "password").text == self.ontPWList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "model").text == self.ontModelList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "OntAdminState").text == "Active"            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "OntOperationStatus").text == "In Service"


