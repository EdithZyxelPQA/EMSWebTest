            self.driver.find_element(By.ID, "manual_script_text").send_keys("exit")
            self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.ENTER)
            time.sleep(3)
            latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-2]
            with assume: assert latestRestulElem.find_element(By.XPATH, "span[3]").text == "ok"
