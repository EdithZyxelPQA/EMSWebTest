    @pytest.mark.Unicase
    def test_EMS1_6089_deviceStatusSort(self):
        print("EMS1-6089: login EMS", flush=True)
        self.driver.get(self.emsURL)
        login_ems(self.driver, self.emsUsr, self.emsPwd)

        available_statuses = device_status_names(self.driver)
        with assume:
            assert all(status in available_statuses for status in self.device_statuses), available_statuses

        for status in self.device_statuses:
            print(f"EMS1-6089: check Device Status sort for {status}", flush=True)
            click_device_status(self.driver, status)
            time.sleep(2)
            table_total = total_data(self.driver, DEVICE_STATUS_TABLE)
            if table_total == 0:
                print(f"EMS1-6089: skip Device Status {status} sort because Total data is 0", flush=True)
                continue

            columns = sortable_table_columns(self.driver, DEVICE_STATUS_TABLE)
            with assume:
                assert columns, f"No sortable columns found for {status}"

            for column in columns:
                column_name = column["name"]
                column_label = column.get("label", column_name)
                column_index = column["index"]
                print(f"EMS1-6089: {status} column [{column_label}] direction [ascending]", flush=True)
                ascending_values = None
                with assume:
                    click_table_sort_direction(
                        self.driver,
                        DEVICE_STATUS_TABLE,
                        column_index,
                        column_name,
                        descending=False,
                    )
                    assert_column_sorted_each_page(
                        self.driver,
                        DEVICE_STATUS_TABLE,
                        column_name,
                        descending=False,
                        context=f"{status}/column [{column_label}]/direction [ascending]",
                        page_scope="first",
                    )
                    ascending_values = first_page_column_values(self.driver, DEVICE_STATUS_TABLE, column_name)

                print(f"EMS1-6089: {status} column [{column_label}] direction [descending]", flush=True)
                with assume:
                    click_table_sort_direction(
                        self.driver,
                        DEVICE_STATUS_TABLE,
                        column_index,
                        column_name,
                        descending=True,
                    )
                    assert_column_sorted_each_page(
                        self.driver,
                        DEVICE_STATUS_TABLE,
                        column_name,
                        descending=True,
                        context=f"{status}/column [{column_label}]/direction [descending]",
                        page_scope="first",
                    )
                    if ascending_values is not None:
                        # whole-table check with only the first page of each direction
                        assert_sort_direction_extremes(
                            ascending_values, first_page_column_values(self.driver, DEVICE_STATUS_TABLE, column_name),
                            column_name, context=f"{status}/column [{column_label}]", **{},
                        )


