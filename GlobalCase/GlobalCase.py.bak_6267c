    # Dashboard / ONT Status / ONT Dashboard / Run Script and ONT Status
    @pytest.mark.Unicase
    def test_EMS1_6077_6885_ontDashboardRunScriptOntStatus(self):
        dateFormat = "%Y-%m-%d_%H:%M:%S"
        createScriptSelectTag (self, "$py_ont", "configure\ninterface remote ont [SLOT]-[PORT]-[ONT]\ndescription [DESC]", ["IES42XX Series", "IES52XX Series"])
        createScriptSelectTag (self, "$py_xont", "configure\ninterface remote xont [SLOT]-[PORT]-[ONT]\ndescription [DESC]", ["NeoX Series","IES42XX Series", "IES52XX Series"])
        createScriptSelectTag (self, "$py_ont-14", "configure\nremote ont ont-[PORT]-[ONT]\ndescription [DESC]", ["OLT14XX Series"])
        ontDashboardTable = self._open_ont_status_table_for_dashboard_case()
        p= self.driver.window_handles[0]
        for index in range(self.ontCount):
            getPositionByColsAndClickNext(self, ontDashboardTable, {"sn": self.ontSNList[index]})
            time.sleep(3)
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            self.driver.find_element(By.XPATH, "//input[@value=\'Run Script\']").click()
            self.driver.find_element(By.XPATH, "//label[@for=\"script_$py_" + self.ontFlagList[index] + "\"]").location_once_scrolled_into_view
            self.driver.find_element(By.XPATH, "//label[@for=\"script_$py_" + self.ontFlagList[index] + "\"]").click()
            runScriptTime = (datetime.now()).strftime(dateFormat)
            self.driver.find_element(By.ID, "DESC").send_keys("runScriptAt_" + runScriptTime)
            self.driver.find_element(By.ID, "popupCallBack").click()
            time.sleep (15)
            self.driver.find_element(By.ID, "console_button").click()
            time.sleep(300)
            self.driver.refresh()
            time.sleep (3)
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_dev").text == self.dutName + " (" + self.dutIp + ")"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_slotid").text == "Slot: " + self.ontSlotIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_portid").text == "Port: " + self.ontPortIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_ontid").text == "ONT: " + self.ontOntIDList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "SN") == self.ontSNList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Model") == self.ontModelList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Admin Status") == "Active"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Operation Status") == "IS"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Type") == self.ontTypeList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Description") == "runScriptAt_" + runScriptTime
            if self.ontFlagList[index] == "xont":
                self.driver.find_element(By.LINK_TEXT, "Click").click()
                time.sleep(15)
                consolePList = []
                consolePElementList = self.driver.find_elements(By.XPATH, "//div[@id=\'exist_console\']/p")
                for consolePElement in consolePElementList:
                    consolePList.append(consolePElement.text)
                showIPHostStatusCmd = "show interface remote xont " + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index] + " ip-host status"
                showIPHostConfigCmd = "show interface remote xont " + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index] + " ip-host config" 
                with assume: assert showIPHostStatusCmd in consolePList[0]
                with assume: assert "AID : ont-" + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index] == consolePList[2] 
                with assume: assert "#" in consolePList[-15] 
                with assume: assert showIPHostConfigCmd in consolePList[-14]
                with assume: assert "AID : ont-" + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index] == consolePList[-12]
                with assume: assert "#" in consolePList[-1] 
                self.driver.find_element(By.ID, "popupCallBack").click()
                time.sleep(3)
            self.driver.close()
            self.driver.switch_to.window(p)
            time.sleep(3)


    # Dashboard / ONT Status / ONT Dashboard / Reboot and Alarm Status
    @pytest.mark.Unicase
    def test_EMS1_6078_6884_ontDashboardRebootAlarm(self):
        # Disable alarm severity and pairwise correlation
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Fault").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Alarm Severity").click()
        time.sleep(3)
        if self.driver.find_element(By.XPATH, "//*[@id=\"EnableSeverityUpLevel\"]").get_attribute("checked"):
            self.driver.find_element(By.XPATH, "//label[@for=\"EnableSeverityUpLevel\"]").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_Alarm_Severity\"]/div/div[2]/input").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Pairwise Correlation").click()
        time.sleep(3)
        if self.driver.find_element(By.XPATH, "//*[@id=\"enable_global_pairwise\"]").get_attribute("checked"):
            self.driver.find_element(By.XPATH, "//label[@for=\"enable_global_pairwise\"]").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//*[@id=\"pairwise_button\"]").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
        ontDashboardTable = self._open_ont_status_table_for_dashboard_case()
        p= self.driver.window_handles[0]
        for index in range(self.ontCount):
            getPositionByColsAndClickNext(self, ontDashboardTable, {"sn": self.ontSNList[index]})
            time.sleep(3)
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            with assume: assert self.driver.find_element(By.ID, "date_now").text == datetime.now().strftime("%Y-%m-%d")
            self.driver.find_element(By.XPATH, "//input[@value=\'Reboot\']").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(300)
            self.driver.refresh()
            totalAlarmCount = 0
            for status in range(2, self.alarmStatusCount +1):
                statusAlarmCount = int(self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[" + str(status) + "]/div[2]/a").text)
                totalAlarmCount += statusAlarmCount
            with assume: assert str(totalAlarmCount) == self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text
            if self.ontFlagList[index] != "ont":
                with assume: assert int(self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text) > 0
            self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").click()
            self.driver.find_element(By.LINK_TEXT, "more...").click()
            c2 = self.driver.window_handles[2]
            self.driver.switch_to.window(c2)
            with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
            #Check the download file
            exportColumnMap = (
                ("Severity", ""),
                ("Ack", "Ack"),
                ("LogTime", "Log Time"),
                ("DevName", "Device Name"),
                ("Description", "Description"),
                ("DevIP", "Device IP"),
                ("SlotID", "Slot ID"),
                ("PortID", "Port ID"),
                ("Ont", "ONT ID"),
                ("AckUser", "Ack by"),
                ("AckTime", "Ack Time"),
                ("Category", "Category"),
                ("Note", "Note"),
            )
            normalizeAlarmValue = lambda value: " ".join(value.split())

            def activeAlarmExportValue(rowIndex, tableColumn):
                cell = getElementByPositionColNoPage(
                    self, "alarm_activeTable", rowIndex, tableColumn
                )
                if tableColumn == "Severity":
                    severityMatch = re.search(
                        r"(?:^|\s)td_(critical|major|minor|warning|info)(?:\s|$)",
                        cell.get_attribute("class") or "",
                        re.IGNORECASE,
                    )
                    assert severityMatch, (
                        "Unknown Active Alarm Severity icon class: "
                        f"{cell.get_attribute('class')!r}"
                    )
                    return severityMatch.group(1).title()
                if tableColumn == "Ack":
                    ackClass = cell.find_element(By.XPATH, ".//a").get_attribute("class") or ""
                    if "ackNotRead" in ackClass.split():
                        return "Not Acknowledged"
                    if "ackRead" in ackClass.split():
                        return "Acknowledged"
                    raise AssertionError(f"Unknown Active Alarm Ack icon class: {ackClass!r}")
                value = normalizeAlarmValue(cell.text)
                if value == "--":
                    if tableColumn in {"SlotID", "PortID", "Ont"}:
                        return "0"
                    if tableColumn in {"AckUser", "AckTime", "Note"}:
                        return ""
                return value

            activeAlarmRows = []
            visibleAlarmRowCount = len(self.driver.find_elements(
                By.XPATH, "//table[@id='alarm_activeTable_body']/tbody/tr"
            ))
            for rowIndex in range(1, visibleAlarmRowCount + 1):
                activeAlarmRows.append(tuple(
                    activeAlarmExportValue(rowIndex, tableColumn)
                    for tableColumn, _ in exportColumnMap
                ))
            minTime = datetime.now()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_export > a").click()
            time.sleep(10)
            maxTime = datetime.now()
            files = glob.glob(os.path.join(self.downloadpath, "*.xls"))
            latestFile = max(files, key=os.path.getmtime)
            latestFileSize = os.path.getsize(latestFile)
            latestFileTimeFloat = os.path.getmtime(latestFile)
            latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
            with assume: assert latestFileSize > 0
            with assume: assert minTime <= latestFileTime <= maxTime

            from collections import Counter
            from html.parser import HTMLParser

            class AlarmExportParser(HTMLParser):
                def __init__(self):
                    super().__init__(convert_charrefs=True)
                    self.rows = []
                    self.currentRow = None
                    self.currentCell = None

                def handle_starttag(self, tag, attrs):
                    if tag.lower() == "tr":
                        self.currentRow = []
                    elif tag.lower() == "td" and self.currentRow is not None:
                        self.currentCell = []

                def handle_data(self, data):
                    if self.currentCell is not None:
                        self.currentCell.append(data)

                def handle_endtag(self, tag):
                    if tag.lower() == "td" and self.currentCell is not None:
                        self.currentRow.append(normalizeAlarmValue("".join(self.currentCell)))
                        self.currentCell = None
                    elif tag.lower() == "tr" and self.currentRow is not None:
                        self.rows.append(self.currentRow)
                        self.currentRow = None

            alarmExportParser = AlarmExportParser()
            with open(latestFile, encoding="utf-8-sig") as exportFile:
                alarmExportParser.feed(exportFile.read())
            assert alarmExportParser.rows, f"No table data found in {latestFile}"

            exportHeader = alarmExportParser.rows[0]
            if not activeAlarmRows:
                # EMS exports an empty table as an empty <tr> without any <td>
                # cells. Accept that format only when the Web table also has no
                # visible Active Alarm rows.
                nonEmptyExportRows = [
                    row for row in alarmExportParser.rows
                    if any(normalizeAlarmValue(value) for value in row)
                ]
                assert not nonEmptyExportRows, (
                    "Active Alarm Web table is empty, but the export contains "
                    f"data: {nonEmptyExportRows[:5]}"
                )
                exportAlarmRows = []
            else:
                assert exportHeader, (
                    "Active Alarm Web table contains rows, but the export header "
                    f"is empty: {latestFile}"
                )
                exportColumnIndexes = []
                for _, exportColumn in exportColumnMap:
                    assert exportColumn in exportHeader, (
                        f"Export column {exportColumn!r} not found. Header: {exportHeader}"
                    )
                    exportColumnIndexes.append(exportHeader.index(exportColumn))
                exportAlarmRows = [
                    tuple(row[columnIndex] for columnIndex in exportColumnIndexes)
                    for row in alarmExportParser.rows[1:]
                ]
            missingAlarmRows = Counter(activeAlarmRows) - Counter(exportAlarmRows)
            with assume: assert not missingAlarmRows, (
                "ONT Dashboard Active Alarm table and export file differ. "
                f"Missing rows: {list(missingAlarmRows.elements())[:5]}"
            )
            # Alarm page function
            if self.ontFlagList[index] != "ont":
                self.driver.find_element(By.XPATH, "//table[@id=\'alarm_activeTable_head\']/thead/tr/th[2]/div/label").click()
                self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
                time.sleep(3)
                self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
                time.sleep(3)
                self.driver.find_element(By.CSS_SELECTOR, "#i_action_ack > a").click()
                time.sleep(3)
                self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
                time.sleep(3)
                self.driver.find_element(By.XPATH, "//table[@id=\'alarm_activeTable_head\']/thead/tr/th[2]/div/label").click()
                self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
                time.sleep(3)
                clearTime = (datetime.now()).strftime(self.dateFormat)
                self.driver.find_element(By.ID, "alarm_clear_note_text").send_keys("$py_clearTime: " + clearTime)
                self.driver.find_element(By.ID, "alarm_clear_note_save_btn").click()
                time.sleep(3)
                self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
                time.sleep(3)
            self.driver.close()
            self.driver.switch_to.window(c)
            self.driver.refresh()
            # Check ont alarm status in ont dashboard
            with assume: assert int(self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text) == 0
            self.driver.close()
            self.driver.switch_to.window(p)
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep(3)
