# ===== Source: Provision.py =====

# Generated by Selenium IDE

class _ProvisionCases():
    checkValue = []
    mvlanList = ["3001", "3002", "3003", "3004"]

    driver = None
    def _inject_config(self, request, test_config):
        cls = request.cls
        # 1. 將 conftest.py 的設備配置給 cls 類別物件
        for key, value in vars(test_config).items():
            setattr(cls, key, value) 
    def setup_browser(self, request):
        cls = request.cls

        current_test = request.node.name
        is_incognito_case = bool(re.search(r"onlineUsr|maxUsrAccess", current_test))
        
        # 【修改】既然每次都要重開，若上一個 case 有殘留的 driver（正常狀況下會是 None），先做安全清理
        if cls.driver is not None:
            try:
                cls.driver.quit()
            except Exception:
                pass
            cls.driver = None

        # 每次執行 case 都必定會進來啟動新瀏覽器與登入
        print(f"\n正在啟動獨立瀏覽器並登入 EMS... (當前 Case: {current_test})")
        match cls.browser:
            case "chrome":
                options = webdriver.ChromeOptions()
                options.add_argument('ignore-certificate-errors')
                if is_incognito_case: 
                    print("啟用 Chrome 無痕模式")
                    options.add_argument('--incognito')
                prefs = {
                    "download.default_directory": cls.downloadpath,
                    "download.prompt_for_download": False,
                    "download.directory_upgrade": True
                }
                options.add_experimental_option("prefs", prefs)
                cls.driver = webdriver.Chrome(options)
                
            case "edge":
                options = webdriver.EdgeOptions()
                options.add_argument('ignore-certificate-errors')
                if is_incognito_case: 
                    print("啟用 Edge 無痕模式")
                    options.add_argument('--inprivate')
                prefs = {
                    "download.default_directory": cls.downloadpath,
                    "download.prompt_for_download": False,
                    "download.directory_upgrade": True
                }
                options.add_experimental_option("prefs", prefs)
                cls.driver = webdriver.Edge(options) 
                
            case "firefox":
                options = webdriver.FirefoxOptions()
                options.add_argument('-ignore-certificate-errors')
                if is_incognito_case:
                    print("啟用 Firefox 無痕模式")
                    options.set_preference("browser.privatebrowsing.autostart", True)
                options.set_preference("browser.download.folderList", 2)
                options.set_preference("browser.download.dir", cls.downloadpath)
                cls.driver = webdriver.Firefox(options) 

        cls.driver.implicitly_wait(cls.waitTime)
        cls.driver.maximize_window()
        cls.driver.get(cls.emsURL)
        loginEMS(cls, cls.emsUsr, cls.emsPwd)
        time.sleep(3)

        # ----------------------------------------
        yield  # 執行測試案件主體
        # ----------------------------------------

        # 【修改】核心變更：不論測試結果如何，案子跑完一律直接關閉瀏覽器並重置變數
        print(f"\nCase [{current_test}] 執行完畢，正在關閉並清理瀏覽器環境...")
        if cls.driver:
            try:
                cls.driver.quit()
            except Exception as e:
                print(f"關閉瀏覽器時發生異常: {e}")
            finally:
                cls.driver = None  # 確保下次執行新 case 時，cls.driver 一定是 None


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5708_ontAlarmPrfAdd(self):
        if self.exeServiceOnt == "": return
        deleteServiceWithProfile(self, "$py_TempONTAlarm")
        deleteServiceWithSn(self, self.serviceOntSN)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered")
        #Delete profile in profile list
        deleteFileIfExisted(self,"ONT Template","$py_TempONTAlarm")
        deleteFileIfExisted(self,"ONT Alarm Profile","$py_ONTAlarm")
        #Delete auto_ profile if the table full
        deleteAutoMaxFileIfTableFull(self,"ONT Template",3000)
        deleteAutoMaxFileIfTableFull(self,"ONT Alarm Profile",3000)
        #Create ONT alarm profile: "$py_ONTAlarm"
        createProfile (self, "ONT Alarm Profile", "$py_ONTAlarm")
        self.driver.find_element(By.ID, "ont_alarm_lowC_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_alarm_lowC_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_alarm_lowC_text").send_keys("0")
        self.driver.find_element(By.ID, "ont_alarm_upC_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_alarm_upC_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_alarm_upC_text").send_keys("79")
        self.driver.find_element(By.ID, "ont_alarm_lowrxpower_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_alarm_lowrxpower_text").send_keys(Keys.DELETE)
