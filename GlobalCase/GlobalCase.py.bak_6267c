            with assume: assert getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "ClearNote").text == "$py_clearTime: " + clearTime
            clearTimeInHistoryZone = getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "ClearTime").text
            clearTimeInHistory = re.sub(r" \(.*$", "",clearTimeInHistoryZone,flags = re.DOTALL)
            clearTimeInHistoryRaw = datetime.strptime(clearTimeInHistory, self.dateFormat)
