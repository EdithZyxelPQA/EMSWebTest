    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5618_5608_ontBandwidthServicePrfAdd(self):
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag != "xont": return
        deleteServiceWithProfile(self, "$py_TempONTService")
        deleteServiceWithSn(self, self.serviceOntSN)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered")
        #Delete profile in profile list
        deleteFileIfExisted(self,"ONT Template","$py_TempONTService")
        deleteFileListIfExisted(self,"ONT Service Profile","$py_ONTService", 8)
        deleteFileListIfExisted(self,"ONT QoS Bandwidth Profile","$py_ONTQoSBandwidthG", 16)
        deleteFileListIfExisted(self,"ONT QoS Bandwidth Profile","$py_ONTQoSBandwidthT", 16)
        #Delete auto_ profile if the table full
        deleteAutoMaxFileIfTableFull(self,"ONT Template",3000)
        deleteAutoMaxFileIfTableFull(self,"ONT Service Profile",2992)
        deleteAutoMaxFileIfTableFull(self,"ONT QoS Bandwidth Profile",2968)
        xponPirGem = 361600
        gponPirGem = -5760        
        xponPirTcont = 1808000
        gponPirTcont = -57600
        for indPrf in range (16):
            xponPirGem = xponPirGem + 102400
            gponPirGem = gponPirGem + 15360
            xponPirTcont = xponPirTcont + 512000
            gponPirTcont = gponPirTcont + 153600
            #Create ONT QoS Bandwidth Profile: "$py_ONTQoSBandwidthG"
            createProfile (self, "ONT QoS Bandwidth Profile", "$py_ONTQoSBandwidthG" + str(indPrf+1))
            self.driver.find_element(By.NAME, "bwprofile_sir").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_sir").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_sir").send_keys("0")
            self.driver.find_element(By.NAME, "bwprofile_air").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_air").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_air").send_keys("0")
            self.driver.find_element(By.NAME, "bwprofile_pir").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_pir").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_pir").send_keys(str(xponPirGem))
            self.driver.find_element(By.NAME, "bwprofile_gpon_sir").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_gpon_sir").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_gpon_sir").send_keys("0")
            self.driver.find_element(By.NAME, "bwprofile_gpon_air").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_gpon_air").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_gpon_air").send_keys("0")
            self.driver.find_element(By.NAME, "bwprofile_gpon_pir").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_gpon_pir").send_keys(Keys.DELETE)
            self.driver.find_element(By.NAME, "bwprofile_gpon_pir").send_keys(str(gponPirGem))
            saveProfile (self)
            #Create ONT QoS Bandwidth Profile: "$py_ONTQoSBandwidthT"
            createProfile (self, "ONT QoS Bandwidth Profile", "$py_ONTQoSBandwidthT" + str(indPrf+1))
            self.driver.find_element(By.NAME, "bwprofile_sir").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_sir").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_sir").send_keys("0")
            self.driver.find_element(By.NAME, "bwprofile_air").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_air").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_air").send_keys("0")
            self.driver.find_element(By.NAME, "bwprofile_pir").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_pir").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_pir").send_keys(str(xponPirTcont))
            self.driver.find_element(By.NAME, "bwprofile_gpon_sir").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_gpon_sir").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_gpon_sir").send_keys("0")
            self.driver.find_element(By.NAME, "bwprofile_gpon_air").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_gpon_air").send_keys(Keys.DELETE) 
            self.driver.find_element(By.NAME, "bwprofile_gpon_air").send_keys("0")
            self.driver.find_element(By.NAME, "bwprofile_gpon_pir").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.NAME, "bwprofile_gpon_pir").send_keys(Keys.DELETE)
            self.driver.find_element(By.NAME, "bwprofile_gpon_pir").send_keys(str(gponPirTcont))
            saveProfile (self)
        #Create ONT Service Profile: "$py_ONTService"
        for indPrf in range (8):
            createProfile (self, "ONT Service Profile", "$py_ONTService" + str(indPrf+1))
            self.driver.find_element(By.ID, "ont_service_vlan_text").send_keys(str(indPrf+101))
            self.driver.find_element(By.XPATH, "//label[contains(.,\'Bridge\')]").click()
            self.driver.find_element(By.XPATH, "//label[contains(.,\'XLAN\')]").click()
            Select(self.driver.find_element(By.ID, "ont_service_xlan_combobox")).select_by_visible_text("XLAN " + str(indPrf+1))
            saveProfile (self)
        #Create ONT Template Profile: "$py_TempONTService"
        createProfile (self, "ONT Template", "$py_TempONTService")
        for ind in range (8):
            self.driver.find_element(By.XPATH, "//label[@for=\"ont_template_service_enable_checkbox" + str(ind + 1) + "\"]").click()
            selectProfile(self,"ont_template_service_combobox" + str(ind + 1), "$py_ONTService" + str(ind + 1))
            Select(self.driver.find_element(By.ID, "ont_template_service_combobox" + str(ind + 1))).select_by_visible_text("$py_ONTService" + str(ind + 1))
            Select(self.driver.find_element(By.ID, "ont_template_service_shared_combobox" + str(ind + 1))).select_by_visible_text(str(ind))
            selectProfile(self,"ont_template_service_us_bw_combobox" + str(ind + 1), "$py_ONTQoSBandwidthG" + str(ind+1))
            Select(self.driver.find_element(By.ID, "ont_template_service_us_bw_combobox" + str(ind + 1))).select_by_visible_text("$py_ONTQoSBandwidthG" + str(ind+1))
            selectProfile(self,"ont_template_service_ds_bw_combobox" + str(ind + 1), "$py_ONTQoSBandwidthG" + str(ind+9))
            Select(self.driver.find_element(By.ID, "ont_template_service_ds_bw_combobox" + str(ind + 1))).select_by_visible_text("$py_ONTQoSBandwidthG" + str(ind+9))
            self.driver.find_element(By.XPATH, "//label[@for=\"ont_template_tcont_enable_checkbox" + str(ind + 1) + "\"]").click()
            Select(self.driver.find_element(By.ID, "ont_template_tcont_combobox" + str(ind + 1))).select_by_visible_text(str(ind+1))
            selectProfile(self,"ont_template_tcont_us_bw_combobox" + str(ind + 1), "$py_ONTQoSBandwidthT" + str(ind+1))
            Select(self.driver.find_element(By.ID, "ont_template_tcont_us_bw_combobox" + str(ind + 1))).select_by_visible_text("$py_ONTQoSBandwidthT" + str(ind+1))
            selectProfile(self,"ont_template_tcont_ds_bw_combobox" + str(ind + 1), "$py_ONTQoSBandwidthT" + str(ind+9))
            Select(self.driver.find_element(By.ID, "ont_template_tcont_ds_bw_combobox" + str(ind + 1))).select_by_visible_text("$py_ONTQoSBandwidthT" + str(ind+9))
            Select(self.driver.find_element(By.ID, "ont_template_tcont_type_combobox" + str(ind + 1))).select_by_visible_text("Best-Effort")
        saveProfile (self)
        #Create service with "$py_TempONTService"
        createServiceWithIpSnPwdProfile(self, self.dutIp, self.serviceOntSN, self.serviceOntPW, "$py_TempONTService")
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempONTService"
