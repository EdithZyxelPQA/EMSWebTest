                        with assume: assert ("show interface genni " + portID + " errdisable statistic") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface genni " + portID + " igmp-mld statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface genni " + portID + " lldp statistic") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    else:
                        with assume: assert ("show interface nni " + portID + " status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface nni " + portID + " ddmi status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface nni " + portID + " statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
