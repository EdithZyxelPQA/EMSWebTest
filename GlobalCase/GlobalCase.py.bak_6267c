    # Map / Device / Alarm Status
    @pytest.mark.Unicase
    def test_EMS1_4369_6147_alarmStatusExport(self):
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + self.dutNodeName + "\')]").click()
        time.sleep(3)
        #Check alarm status
        totalAlarmCount = 0
        for status in range(2, self.alarmStatusCount+1):
            statusAlarmCount = int(self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[" + str(status) + "]/div[2]/a").text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text
        with assume: assert self.driver.find_element(By.ID, "date_now").text == datetime.now().strftime("%Y-%m-%d")
        self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").click()
        self.driver.find_element(By.ID, "dashboard_dev_alarm_card_more").click()
        time.sleep(3)
        p= self.driver.window_handles[0]
        c = waitNewWindowHandle(self)
        self.driver.switch_to.window(c)
        with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
        self.driver.close()
        self.driver.switch_to.window(p)
        elementScrolledIntoView(self, self.driver.find_element(By.LINK_TEXT, "Click here for more alarms..."))
        self.driver.find_element(By.LINK_TEXT, "Click here for more alarms...").click()
        match self.browser:
            case "chrome":
                c = waitNewWindowHandle(self)
                self.driver.switch_to.window(c)
            case "edge":
                c = self.driver.window_handles[2]
                self.driver.switch_to.window(c)
            case "firefox":
                c = waitNewWindowHandle(self)
                self.driver.switch_to.window(c)
        with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
        #Check the download file
        minTime = datetime.now()
        exportTableSnapshot = capture_table_and_export(self.driver, "alarm_activeTable")
        time.sleep(10)
        maxTime = datetime.now()
        files = glob.glob(os.path.join(self.downloadpath, "*.xls"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime
        assert_export_matches(latestFile, exportTableSnapshot, "Map Device Active Alarm")


    # Map / Device / Clear Alarm
    @pytest.mark.Unicase
    def test_EMS1_4495_3481_clearAlarm(self):
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + self.dutNodeName + "\')]").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        with assume: assert self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text == "0"
        time.sleep(150)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        time.sleep(3)
        severityCounts = []
        for statusIndex in range(2, 6):
            statusText = self.driver.find_element(
                By.XPATH,
                "//div[@id='alarmStatus']/div[" + str(statusIndex) + "]/div[2]/a",
            ).text.strip()
            severityCounts.append(int(statusText or "0"))

        criticalCount, majorCount, minorCount, infoCount = severityCounts
        if criticalCount > 0:
            expectedIconClass = "icon node-icon icon-dev-5"
        elif majorCount > 0:
            expectedIconClass = "icon node-icon icon-dev-4"
        elif minorCount > 0:
            expectedIconClass = "icon node-icon icon-dev-3"
        elif infoCount > 0:
            expectedIconClass = "icon node-icon icon-dev-2"
        else:
            expectedIconClass = "icon node-icon icon-dev-1"

        colorElement = self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + self.dutNodeName + "\')]/span[contains(@class,\'node-icon\')]")
        actualIconClass = colorElement.get_attribute("class")
        with assume:
            assert actualIconClass == expectedIconClass, (
                f"Tree icon does not match current device alarm severity. "
                f"Critical/Major/Minor/Info={severityCounts}, "
                f"expected={expectedIconClass}, actual={actualIconClass}"
            )


