            self.driver.find_element(By.LINK_TEXT, "Alarm").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "History").click()
            time.sleep(3)
            # Check the target alarm in History alarm
            entryPosition = getAlarmPositionByIndex (self, "alarm_historyAlarmTable", {"index_1":targetIndex1, "index_2":targetIndex2, "index_3":targetIndex3})
