        if tableIsEmpty(self, "schedule_backup_config_table"):
            assert False
        leftTableRows = self.driver.find_elements(By.XPATH,"//table[@id=\'schedule_backup_config_table\']/tbody/tr")
        break_out_flag = False
        for leftTableRow in range(len(leftTableRows)):
            leftRowIndex = leftTableRow + 1
            if self.driver.find_element(By.XPATH, "//table[@id=\'schedule_backup_config_table\']/tbody/tr[" + str(leftRowIndex) + "]/td[2]").text == scheduleBackupName:
                self.driver.find_element(By.XPATH, "//table[@id=\'schedule_backup_config_table\']/tbody/tr[" + str(leftRowIndex) + "]/td[1]/label/span").click()
                if tableIsEmpty(self, "restore_device_table"):
                    continue
                rightTableRows = self.driver.find_elements(By.XPATH,"//table[@id=\'restore_device_table\']/tbody/tr")
                for rightTableRow in range(len(rightTableRows)):
                    rightRowIndex = rightTableRow + 1
                    if self.driver.find_element(By.XPATH, "//table[@id=\'restore_device_table\']/tbody/tr[" + str(rightRowIndex) + "]/td[2]").text == self.dutName:
                        self.driver.find_element(By.XPATH, "//table[@id=\'restore_device_table\']/tbody/tr[" + str(rightRowIndex) + "]/td[1]/label").click()
