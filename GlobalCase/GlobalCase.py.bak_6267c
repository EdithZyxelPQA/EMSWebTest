                        with assume: assert ("show interface nni " + portID + " igmp-mld statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface nni " + portID + " lldp statistic") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
