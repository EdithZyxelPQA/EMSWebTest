    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_6279_ontServiceAdd(self):
        #$py_TempONTService need provision the ont first (Need execute test_ontBandwidthServicePrfAdd first)
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag != "xont": return
        deleteServiceWithProfile(self, "$py_TempONTService")
        deleteServiceWithSn(self, self.serviceOntSN)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered")
        #Delete profile in profile list
        deleteFileIfExisted(self,"ONT Template","$py_TempONTService")
        deleteFileListIfExisted(self,"ONT Service Profile","$py_ONTService", 8)
        deleteFileListIfExisted(self,"ONT QoS Bandwidth Profile","$py_ONTQoSBandwidthG", 16)
        deleteFileListIfExisted(self,"ONT QoS Bandwidth Profile","$py_ONTQoSBandwidthT", 16)
        #Delete auto_ profile if the table full
        deleteAutoMaxFileIfTableFull(self,"ONT Template",3000)
        deleteAutoMaxFileIfTableFull(self,"ONT Service Profile",2992)
        deleteAutoMaxFileIfTableFull(self,"ONT QoS Bandwidth Profile",2968)
        xponPirGem = 361600
        gponPirGem = -5760
        xponPirTcont = 1808000
        gponPirTcont = -57600
        for indPrf in range (16):
            xponPirGem = xponPirGem + 102400
            gponPirGem = gponPirGem + 15360
            xponPirTcont = xponPirTcont + 512000
            gponPirTcont = gponPirTcont + 153600
            #Create ONT QoS Bandwidth Profile: "$py_ONTQoSBandwidthG"
            createProfile (self, "ONT QoS Bandwidth Profile", "$py_ONTQoSBandwidthG" + str(indPrf+1))
            fillOntQosBandwidthProfile(self, xponPirGem, gponPirGem)
            saveProfile (self)
            #Create ONT QoS Bandwidth Profile: "$py_ONTQoSBandwidthT"
            createProfile (self, "ONT QoS Bandwidth Profile", "$py_ONTQoSBandwidthT" + str(indPrf+1))
            fillOntQosBandwidthProfile(self, xponPirTcont, gponPirTcont)
            saveProfile (self)
        #Create ONT Service Profile: "$py_ONTService"
        for indPrf in range (8):
            createProfile (self, "ONT Service Profile", "$py_ONTService" + str(indPrf+1))
            waitInput(self, (By.ID, "ont_service_vlan_text"), str(indPrf+101))
            waitClick(self, (By.XPATH, "//label[contains(.,\'Bridge\')]"))
            waitClick(self, (By.XPATH, "//label[contains(.,\'XLAN\')]"))
            waitSelect(self, (By.ID, "ont_service_xlan_combobox"), "XLAN " + str(indPrf+1))
            saveProfile (self)
        #Create ONT Template Profile: "$py_TempONTService"
        createProfile (self, "ONT Template", "$py_TempONTService")
        for ind in range (8):
            waitClick(self, (By.XPATH, "//label[@for=\"ont_template_service_enable_checkbox" + str(ind + 1) + "\"]"))
            selectProfile(self,"ont_template_service_combobox" + str(ind + 1), "$py_ONTService" + str(ind + 1))
            waitSelect(self, (By.ID, "ont_template_service_shared_combobox" + str(ind + 1)), str(ind))
            selectProfile(self,"ont_template_service_us_bw_combobox" + str(ind + 1), "$py_ONTQoSBandwidthG" + str(ind+1))
            selectProfile(self,"ont_template_service_ds_bw_combobox" + str(ind + 1), "$py_ONTQoSBandwidthG" + str(ind+9))
            waitClick(self, (By.XPATH, "//label[@for=\"ont_template_tcont_enable_checkbox" + str(ind + 1) + "\"]"))
            waitSelect(self, (By.ID, "ont_template_tcont_combobox" + str(ind + 1)), str(ind+1))
            selectProfile(self,"ont_template_tcont_us_bw_combobox" + str(ind + 1), "$py_ONTQoSBandwidthT" + str(ind+1))
            selectProfile(self,"ont_template_tcont_ds_bw_combobox" + str(ind + 1), "$py_ONTQoSBandwidthT" + str(ind+9))
            waitSelect(self, (By.ID, "ont_template_tcont_type_combobox" + str(ind + 1)), "Best-Effort")
        saveProfile (self)
        #Create service with "$py_TempONTService"
        createServiceWithIpSnPwdProfile(self, self.dutIp, self.serviceOntSN, self.serviceOntPW, "$py_TempONTService")
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])

        #Delete profile in profile list
        deleteFileListIfExisted(self,"ONT QoS Bandwidth Profile","$py_newG", 16)
        deleteFileListIfExisted(self,"ONT QoS Bandwidth Profile","$py_newT", 16)
        #Delete auto_ profile if the table full
        deleteAutoMaxFileIfTableFull(self,"ONT QoS Bandwidth Profile",2968)
        xponPirGem = 361600
        gponPirGem = -5760
        xponPirTcont = 1808000
        gponPirTcont = -57600
        for indPrf in range (16):
            xponPirGem = xponPirGem + 102400
            gponPirGem = gponPirGem + 15360
            xponPirTcont = xponPirTcont + 512000
            gponPirTcont = gponPirTcont + 153600
            #Create ONT QoS Bandwidth Profile: "$py_newG"
            createProfile (self, "ONT QoS Bandwidth Profile", "$py_newG" + str(indPrf+1))
            fillOntQosBandwidthProfile(self, xponPirGem, gponPirGem)
            saveProfile (self)
            #Create ONT QoS Bandwidth Profile: "$py_newT"
            createProfile (self, "ONT QoS Bandwidth Profile", "$py_newT" + str(indPrf+1))
            fillOntQosBandwidthProfile(self, xponPirTcont, gponPirTcont)
            saveProfile (self)
        openOntServicePage(self)
        time.sleep(3)
        waitPageIdle(self)
        entryPosition = getPositionByCols(self, "provision_service_table", {"sn":self.serviceOntSN})
        clickElementWhenReady(self, getElementByPositionCol(self, "provision_service_table", entryPosition , "Modify"))
        #Edit service with $py_TempONTService
        waitSelect(self, (By.ID, "provision_service_onttemplate_combbox"), "$py_TempONTService")
        time.sleep(3)
        waitPageIdle(self)
        waitInput(self, (By.ID, "provision_service_desc_text"), "ForServceTest")
        waitInput(self, (By.ID, "provision_service_dspir_text"), "10000000")
        #Wan Setting
        for ind in range (8):
            waitClick(self, (By.XPATH, "//label[@for=\"provision_service_wan_table_active_" + str(ind + 1) + "\"]"))
            waitInput(self, (By.ID, "provision_service_wan_table_address_" + str(ind + 1)), "192.168.10" + str(ind + 1) + ".1")
            waitInput(self, (By.ID, "provision_service_wan_table_mask_" + str(ind + 1)), "255.255.255.0")
            waitInput(self, (By.ID, "provision_service_wan_table_gateway_" + str(ind + 1)), "192.168.10" + str(ind + 1) + ".254")
            waitInput(self, (By.ID, "provision_service_wan_table_pridns_" + str(ind + 1)), "1.2.3.4" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wan_table_secdns_" + str(ind + 1)), "5.6.7.8" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wan_table_username_" + str(ind + 1)), "Usr" + str(ind + 1) + "@hinet.net")
            waitInput(self, (By.ID, "provision_service_wan_table_password_" + str(ind + 1)), "Pwd" + str(ind + 1))
        #Wifi Setting
        for ind in range (4):
            waitClick(self, (By.XPATH, "//label[@for=\"provision_service_wify24g_table_active_" + str(ind + 1) + "\"]"))
            waitInput(self, (By.ID, "provision_service_wify24g_table_ssid_" + str(ind + 1)), "SSID24_Test" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wify24g_table_password_" + str(ind + 1)), "Password24_Test" + str(ind + 1))
            waitClick(self, (By.XPATH, "//label[@for=\"provision_service_wify5g_table_active_" + str(ind + 1) + "\"]"))
            waitInput(self, (By.ID, "provision_service_wify5g_table_ssid_" + str(ind + 1)), "SSID5_Test" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_wify5g_table_password_" + str(ind + 1)), "Password5_Test" + str(ind + 1))
        #VoIP Setting
        for ind in range (2):
            waitClick(self, (By.XPATH, "//label[@for=\"provision_service_voip_table_active_" + str(ind + 1) + "\"]"))
            waitSelect(self, (By.ID, "provision_service_voip_table_uniport_" + str(ind + 1)), str(ind + 1))
            waitInput(self, (By.ID, "provision_service_voip_table_username_" + str(ind + 1)), "VoIPUsr" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_voip_table_password_" + str(ind + 1)), "VoIPPwd" + str(ind + 1))
            waitInput(self, (By.ID, "provision_service_voip_table_aor_" + str(ind + 1)), "+88603123456" + str(ind + 1))
        #QoS
        #Service T-cont Setting
        qosEntries = []
        for ind in range (8):
            qosEntries.append(("service" + str(ind + 1), "$py_newG" + str(ind + 1), "$py_newG" + str(ind + 9)))
            qosEntries.append(("tcont" + str(ind + 1), "$py_newT" + str(ind + 1), "$py_newT" + str(ind + 9)))
        for qosName, usBandwidth, dsBandwidth in qosEntries:
            waitClick(self, (By.ID, "provision_service_profile_qos_table_new"))
            waitSelect(self, (By.ID, "provision_service_qos_tcont_combbox"), qosName)
            waitSelect(self, (By.ID, "provision_service_qos_usbandwidth_combbox"), usBandwidth)
            waitSelect(self, (By.ID, "provision_service_qos_dsbandwidth_combbox"), dsBandwidth)
            clickUntilHidden(self, (By.CSS_SELECTOR, "#modal_provision_service_qos .button"), (By.ID, "modal_provision_service_qos"))
            time.sleep(1)
        waitClick(self, (By.ID, "provision_save_service_btn"))
        clickUntilHidden(self, (By.CSS_SELECTOR, "#modal_provision_service_message .button"), (By.ID, "modal_provision_service_message"), 120)
        time.sleep(3)
        waitPageIdle(self)
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempONTService"
