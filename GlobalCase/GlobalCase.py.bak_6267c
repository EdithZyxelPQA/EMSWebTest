    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5633_ontMulticastPrfModify(self):
        #Need execute test_ontMulticastPrfAdd test first.
        #Modify ONT multicast profile: "$py_ONTMulticast"
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag != "xont": return
        for indPrf in range (4):
            modifyProfile (self, "ONT Multicast Profile", "$py_ONTMulticast"+str(indPrf + 1))
            time.sleep(3)
            Select(self.driver.find_element(By.ID, "ont_multicast_igmp_version_combobox")).select_by_visible_text("IGMPv2")
            Select(self.driver.find_element(By.ID, "ont_multicast_txmode_combobox")).select_by_visible_text("untag")
            self.driver.find_element(By.ID, "ont_multicast_txmode_text").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ont_multicast_txmode_text").send_keys(Keys.DELETE) 
            self.driver.find_element(By.ID, "ont_multicast_txmode_text").send_keys(str(indPrf + 101)) 
            self.driver.find_element(By.ID, "ont_multicast_maxgroup_text").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ont_multicast_maxgroup_text").send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "ont_multicast_maxgroup_text").send_keys("100")
            self.driver.find_element(By.ID, "ont_multicast_maxmessage_text").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ont_multicast_maxmessage_text").send_keys(Keys.DELETE)  
            self.driver.find_element(By.ID, "ont_multicast_mvlan_text").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ont_multicast_mvlan_text").send_keys(Keys.DELETE)
            saveProfile (self)
        time.sleep (180)
        #Check ont multicast profile
        for ind in range(1,5):
            i = str(ind)
            #Check neox ont multicast profile
            if "NeoX" in self.dutType:
                checkValue = ["10"+i, "IGMPv2", "untag", "10"+i, i, "$py_IGMPGroupPrivilege"+i, "100", "0", "enable"]
            #Check ies ont multicast profile
            else:
                checkValue = ["10"+i, "IGMPv2", "untag", "10"+i, i, "$py_IGMPGroupPrivilege"+i, "100", "0"]
            with assume: assert await cliShowMulticastProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_ONTMulticast"+ i) == checkValue


