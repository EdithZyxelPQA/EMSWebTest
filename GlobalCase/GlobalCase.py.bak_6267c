            self.dutDesc, self.dutAdminName, self.dutAdminPwd, self.dutType, self.dutSet, self.dutGet, 
            self.dutSnmpVer, self.dutSnmp3Auth, self.dutSnmp3Hash, self.dutSnmp3Encrypt, self.dutAddr, self.dutSlotCount,
            self.dutAllCardID, self.dutAllCardPortID, self.cardTypeName, self.cardPortTypeName, self.cardPortTypeSpeed, 
            self.cardFwVersion, self.fwUploadName, self.fwUploadFileName,
            self.ontCount, self.ontSlotIDList, self.ontPortIDList, self.ontOntIDList, self.ontSNList, 
            self.ontPWList, self.ontModelList, self.ontTypeList, self.ontFlagList, self.exeUpgradeONT, 
            self.upgradeOntFW, self.upgradeOntFlag, self.upgradeOntModel, self.upgradeOntSlotID, 
            self.upgradeOntPortID, self.upgradeOntOntID,
            self.deviceStatusCount, self.ontStatusCount, self.alarmStatusCount, self.alarmStatus, 
            self.emsLink, self.dateFormat, self.timeZone
        )        
        self.driver.find_element(By.LINK_TEXT, "Inventory").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Port").click()
        time.sleep(3)
        minTime = datetime.now()
        exportTableSnapshot = capture_table_and_export(self.driver, "port_inventory_div")
        time.sleep(30)
        maxTime = datetime.now()
        #Check the download file
        files = glob.glob(os.path.join(downloadpath, "*.xls"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime
        assert_export_matches(latestFile, exportTableSnapshot, "Icat Inventory Port")
        #Check the port inventory filter
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        for cardType in range(len(dutAllCardID)):
            if dutAllCardID[cardType] == "0":
                continue
            self.driver.find_element(By.ID, "AllPort").click()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            self.driver.find_element(By.ID, "inventory_allport_clear_btn").click()
            self.driver.find_element(By.ID, "deviceName_all").send_keys(dutName)
            self.driver.find_element(By.ID, "ip_all").send_keys(dutIp)
            if dutSlotCount != "0":
                self.driver.find_element(By.ID, "slot_all").send_keys(dutAllCardID[cardType])
            self.driver.find_element(By.ID, "inventory_allport_btn").click()
            entryPosition = getPositionByCol(self, "port_inventory_div", "PortID", dutAllCardPortID[cardType])
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "SubmapName").text == "EMS", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "DevName").text == dutName, f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "IPAddress").text == dutIp, f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "SlotID").text == dutAllCardID[cardType], f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "PortID").text == dutAllCardPortID[cardType], f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "PortType").text == cardPortTypeName[cardType], f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "portOperationStatus").text == "Up", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "portAdminState").text == "Enable", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "txPower").text != "--", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "rxPower").text != "--", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            #Enter each port type page
            self.driver.find_element(By.LINK_TEXT, cardPortTypeName[cardType] + " Port").click()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            match cardPortTypeName[cardType]:
                case "Network":
                    self.driver.find_element(By.ID, "inventory_network_clear_btn").click()
                    self.driver.find_element(By.ID, "ip_network").send_keys(dutIp)
                    if dutSlotCount != "0":
                        self.driver.find_element(By.ID, "slot_network").send_keys(dutAllCardID[cardType])
                    self.driver.find_element(By.ID, "port_network").send_keys(dutAllCardPortID[cardType])
                    self.driver.find_element(By.ID, "inventory_network_btn").click()
                case "Ethernet Access":
                    self.driver.find_element(By.ID, "inventory_ethernet_clear_btn").click()
                    self.driver.find_element(By.ID, "ip_ethernet").send_keys(dutIp)
                    if dutSlotCount != "0":
                        self.driver.find_element(By.ID, "slot_ethernet").send_keys(dutAllCardID[cardType])
                    self.driver.find_element(By.ID, "port_ethernet").send_keys(dutAllCardPortID[cardType])
                    self.driver.find_element(By.ID, "inventory_ethernet_btn").click()      
                case "GPON":
                    self.driver.find_element(By.ID, "inventory_pon_clear_btn").click()
                    self.driver.find_element(By.ID, "ip_pon").send_keys(dutIp)
                    if dutSlotCount != "0":
                        self.driver.find_element(By.ID, "slot_pon").send_keys(dutAllCardID[cardType])
                    self.driver.find_element(By.ID, "port_pon").send_keys(dutAllCardPortID[cardType])
                    self.driver.find_element(By.ID, "inventory_pon_btn").click()
                case "xPON":
                    self.driver.find_element(By.ID, "inventory_xpon_clear_btn").click()
                    self.driver.find_element(By.ID, "ip_xpon").send_keys(dutIp)
                    if dutSlotCount != "0":
                        self.driver.find_element(By.ID, "slot_xpon").send_keys(dutAllCardID[cardType])
                    self.driver.find_element(By.ID, "port_xpon").send_keys(dutAllCardPortID[cardType])
                    self.driver.find_element(By.ID, "inventory_xpon_btn").click()
            minTime = datetime.now()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_export > a").click()
            time.sleep(10)
            maxTime = datetime.now()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
            entryPosition = [1,1]
            time.sleep(3)
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "SubmapName").text == "EMS", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "DevName").text == dutName, f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "IPAddress").text == dutIp, f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "SlotID").text == dutAllCardID[cardType], f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "PortID").text == dutAllCardPortID[cardType], f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "portOperationStatus").text == "Up", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "portAdminState").text == "Enable", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "ProvStatus").text == "In-service", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "EnetPortLinkStatus").text == cardPortTypeSpeed[cardType], f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "txPower").text != "--", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            with assume: assert getElementByPositionCol(self, "port_inventory_div", entryPosition , "rxPower").text != "--", f"Slot {dutAllCardID[cardType]}, Port {dutAllCardPortID[cardType]}"
            #Check the download file
            files = glob.glob(os.path.join(downloadpath, "*.xls"))
            latestFile = max(files, key=os.path.getmtime)
            latestFileSize = os.path.getsize(latestFile)
            latestFileTimeFloat = os.path.getmtime(latestFile)
            latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
            with assume: assert latestFileSize > 0
            with assume: assert minTime <= latestFileTime <= maxTime


