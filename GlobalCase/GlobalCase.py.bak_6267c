        time.sleep(3)
        #Run existed script
        self.driver.find_element(By.ID, "topology_script_runexistscript").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//label[@for=\"script_$py_remoteControl\"]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[@for=\"script_$py_remoteControl\"]").click()
        self.driver.find_element(By.ID, "popupCallBack").click()
        time.sleep(45)
        latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-2]
        with assume: assert latestRestulElem.find_element(By.XPATH, "span[3]").text == "ok"
        latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-1]
        with assume: assert latestRestulElem.find_element(By.XPATH, "span[2]").text == "#"
        #Reset console test
        self.driver.find_element(By.ID, "topology_script_resetconsole").click()
        time.sleep(6)
        with assume: assert waitMessageText(self) == "Connection closed, reconnect."
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-1]
        with assume: assert latestRestulElem.find_element(By.XPATH, "span[2]").text == "#"
        with assume: assert len(self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")) == 1
        # OLT14 skips only the idle-timeout check; manual Reset Console is still tested.
        if "OLT14" in str(self.dutType).upper():
            print("OLT14: skipping the 310-second idle wait and timeout message check.")
        else:
            time.sleep(310)
            with assume: assert waitMessageText(self) == "Connection closed, reconnect."


    # Map / Card
    @pytest.mark.Unicase
    def test_EMS1_6159_6160_6182_6183_6184_6161_cardMap(self):
        # Precondition: the GE (Ethernet Access) port must match the environment file
        # (speed / enable); GE provisioning cases may have changed it.
        for cardType in range(len(self.dutAllCardID)):
            if self.dutAllCardID[cardType] != "0" and self.cardPortTypeName[cardType] == "Ethernet Access":
                ensureGePortSetting(self, self.dutAllCardID[cardType], self.dutAllCardPortID[cardType], self.cardPortTypeSpeed[cardType])
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        #Check the linecard display normally in tree panel
        for ind, cardID in enumerate(self.dutAllCardID):
            if cardID in ("0", "--"):
                continue
            expandElement = self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + self.dutNodeName + "\')]/span[contains(@class,\'expand-icon\')]")
            expandStatus = expandElement.get_attribute("class")
            if expandStatus == "icon expand-icon oi oi-plus":
                expandElement.click()
            dutNodeId = int(self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + self.dutNodeName + "\')]").get_attribute("data-nodeid"))
            cardNodeId = dutNodeId + int(cardID)
            with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(@data-nodeid,\'" + str(cardNodeId) + "\')]").text == cardID + " - " + self.cardTypeName[ind]
            self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(@data-nodeid,\'" + str(cardNodeId) + "\')]").click()
            WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.ID, "slotStatusTable")))
            time.sleep(3)
            #Check the card status
            with assume: assert self.cardFwVersion[ind] in getAttributeValue (self, "slotStatusTable", "Boot up FW Version")
            #HW status check
            self.driver.find_element(By.ID, "dashboard_hw_status_cpu_image").click()
            if self.driver.find_element(By.ID, "dashboard_hw_status_cpu_image").get_attribute("class") == "style_img icon_hwstatus_cpu_normal item_select":
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
            else:
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
            self.driver.find_element(By.ID, "dashboard_hw_status_memory_image").click()
            if self.driver.find_element(By.ID, "dashboard_hw_status_memory_image").get_attribute("class") == "style_img icon_hwstatus_memory_normal item_select":
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
            else:
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
            self.driver.find_element(By.ID, "dashboard_hw_status_temperature_image").click()
            if self.driver.find_element(By.ID, "dashboard_hw_status_temperature_image").get_attribute("class") == "style_img icon_hwstatus_temperature_normal item_select":
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
            else:
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
            self.driver.find_element(By.ID, "dashboard_hw_status_voltage_image").click()
            if self.driver.find_element(By.ID, "dashboard_hw_status_voltage_image").get_attribute("class") == "style_img icon_hwstatus_voltage_normal item_select":
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
            else:
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
            #Check alarm status
            totalAlarmCount = 0
            for status in range(2, self.alarmStatusCount+1):
                statusAlarmCount = int(self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[" + str(status) + "]/div[2]/a").text)
                totalAlarmCount += statusAlarmCount
            with assume: assert str(totalAlarmCount) == self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text
            with assume: assert self.driver.find_element(By.ID, "date_now").text == datetime.now().strftime("%Y-%m-%d")
            self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").click()
            self.driver.find_element(By.LINK_TEXT, "more...").click()
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
            self.driver.close()
            self.driver.switch_to.window(p)
            elementScrolledIntoView(self, self.driver.find_element(By.LINK_TEXT, "Click here for more alarms..."))
            self.driver.find_element(By.LINK_TEXT, "Click here for more alarms...").click()
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
            self.driver.close()
            self.driver.switch_to.window(p)
            #Check port status
            with assume: assert getElementByPositionColNoPage(self, "Slot_portStatusTable", self.dutAllCardPortID[ind] , "portOperationStatus").text == "Up", f"Slot {cardID} Port {self.dutAllCardPortID[ind]}"
            with assume: assert getElementByPositionColNoPage(self, "Slot_portStatusTable", self.dutAllCardPortID[ind] , "PortType").text == self.cardPortTypeName[ind], f"Slot {self.cardPortTypeName[ind]} Port {self.dutAllCardPortID[ind]}"


    # Map / Card / ONT Map
    @pytest.mark.Unicase
    def test_EMS1_6162_6163_6164_6165_ontMap(self):
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        #Check ont status 
        for index in range(self.ontCount):
            ontTableType = "Slot"
            if self.dutSlotCount == "0":
                self.driver.find_element(By.XPATH, "//li[contains(.,\'" + self.dutNodeName + "\')]").click()
                time.sleep(3)
                ontTableType = "Dev"
            else:
                expandElement = self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + self.dutNodeName + "\')]/span[contains(@class,\'expand-icon\')]")
                expandStatus = expandElement.get_attribute("class")
                if expandStatus == "icon expand-icon oi oi-plus":
                    expandElement.click()  
                dutNodeId = int(self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + self.dutNodeName + "\')]").get_attribute("data-nodeid"))
                cardNodeId = dutNodeId + int(self.ontSlotIDList[index])
                self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(@data-nodeid,\'" + str(cardNodeId) + "\')]").click()
            #Check ont each status number
            for status in range(1, self.ontStatusCount+1):
                self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[" + str(status) + "]/div[2]/a").click()
                statusTitle = self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[" + str(status) + "]/div[2]/a").text
                statusData = self.driver.find_element(By.ID, "table_total_data_" + ontTableType + "_ontStatusTable").text.strip("Total data:")
                with assume: assert statusTitle == statusData
            #Check click the inService ONT can switch to ont status page
            self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[1]/div[2]/a").click()
            time.sleep(3)
            entryPosition = getPositionByColsAndClickNext(self, ontTableType + "_ontStatusTable", {"sn": self.ontSNList[index]})
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            time.sleep(3)
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_dev").text == self.dutName + " (" + self.dutIp + ")"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_slotid").text == "Slot: " + self.ontSlotIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_portid").text == "Port: " + self.ontPortIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_ontid").text == "ONT: " + self.ontOntIDList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Admin Status") == "Active"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Operation Status") == "IS"
            with assume: assert getAttributeValue (self, "ontStatusTable", "SN") == self.ontSNList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Password") == self.ontPWList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Model") == self.ontModelList[index]
            self.driver.close()
            self.driver.switch_to.window(p)
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "Port").text == self.ontPortIDList[index]                       
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "ONT").text == self.ontOntIDList[index]            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "sn").text == self.ontSNList[index]            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "password").text == self.ontPWList[index]            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "model").text == self.ontModelList[index]            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "OntAdminState").text == "Active"            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "OntOperationStatus").text == "In Service"
            #Check ont map
            #Add ont and capture
            entryPosition = getPositionByColNoPage(self, ontTableType + "_portStatusTable", "PortID" , self.ontPortIDList[index])
            getElementByPositionColNoPage(self, ontTableType + "_portStatusTable", entryPosition , "OntMapTree").find_element(By.XPATH,"./a").location_once_scrolled_into_view
            getElementByPositionColNoPage(self, ontTableType + "_portStatusTable", entryPosition , "OntMapTree").find_element(By.XPATH,"./a").click() 
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            time.sleep(3)
            try:
                self.driver.find_element(By.CSS_SELECTOR, ".node:nth-of-type(2) > text").click()
                self.driver.find_element(By.LINK_TEXT, "Delete").click()
            except NoSuchElementException:
                pass
            Select(self.driver.find_element(By.ID, "ont_map_splitter_type")).select_by_visible_text("1:2")
            self.driver.find_element(By.ID, "ont_map_splitter_name_text").send_keys("SplitterA")
            self.driver.find_element(By.ID, "ont_map_add_splitter").click()
            time.sleep(3)
            Select(self.driver.find_element(By.ID, "ont_map_splitter_type")).select_by_visible_text("1:256")
            self.driver.find_element(By.ID, "ont_map_splitter_name_text").send_keys("SplitterB")
            self.driver.find_element(By.ID, "ont_map_add_splitter").click()
            time.sleep(3)
            Select(self.driver.find_element(By.ID, "ont_map_addont_parents")).select_by_visible_text("SplitterB : 1:256")
            #clickOntInMap(self,ontOntIDList[index])
            self.driver.find_element(By.CSS_SELECTOR, ".zy_col_1 > label").click()
            self.driver.find_element(By.ID, "ont_map_ont_add_button").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "ont_map_panel").screenshot("./report/ONT_" + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index]+"-"+ self.ontOntIDList[index] + "_MapAdd.png")
            self.driver.close()
            self.driver.switch_to.window(p)
            #Delete ont and capture
            getElementByPositionColNoPage(self, ontTableType + "_portStatusTable", entryPosition , "OntMapTree").click()
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, ".node:nth-of-type(2) > text").click()
            self.driver.find_element(By.LINK_TEXT, "Delete").click()
            self.driver.find_element(By.ID, "ont_map_panel").screenshot("./report/ONT_" + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index]+"-"+ self.ontOntIDList[index] + "_MapDelete.png")
            self.driver.close()
            self.driver.switch_to.window(p)  


    # Alarm / Active / Severity and Export
    @pytest.mark.Unicase
    def test_EMS1_3496_3502_alarmActive(self):
        self.driver.find_element(By.LINK_TEXT, "Alarm").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Active").click()
        totalAlarmCount = 0
        for status in range(1, self.alarmStatusCount):
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.ID, "alarm_total").text
        for status in range(self.alarmStatusCount):
            self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).click()
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).text)
            strLastPageNumber = self.driver.find_element(By.CSS_SELECTOR, "#alarm_activeAlarmTable > div.pagination > a.last").get_attribute("href")
            lastPageNumber = int(strLastPageNumber.replace(self.emsLink,""))
            expectPageCount = (statusAlarmCount//100 + 1)
            if statusAlarmCount%100 == 0 and statusAlarmCount > 0:
                expectPageCount = expectPageCount - 1
            with assume: assert lastPageNumber == expectPageCount
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
        self.driver.find_element(By.ID, "fault_active_clear_btn").click()
        self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .arrow").click()
        self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .collapsed").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
        self.driver.find_element(By.ID, "fault_active_btn").click()
        #Check the download file
        minTime = datetime.now()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_export > a").click()
        time.sleep(30)
        maxTime = datetime.now()
        files = glob.glob(os.path.join(self.downloadpath, "*.xls"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime
        totalAlarmCount = 0
        for status in range(1, self.alarmStatusCount):
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.ID, "alarm_total").text


    # Alarm / Active / Alarm ACK and Clear
    @pytest.mark.Unicase
    def test_EMS1_3499_3500_alarmAckClearActive(self):
        self.driver.find_element(By.LINK_TEXT, "Alarm").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Active").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
        self.driver.find_element(By.ID, "fault_active_clear_btn").click()
        self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .arrow").click()
        self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .collapsed").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
        self.driver.find_element(By.ID, "fault_active_btn").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        time.sleep(3)
        if self.driver.find_element(By.ID, "alarm_total").text != "0":
            # Check ACK Function
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_ack > a").click()
            time.sleep(3)
            assert waitMessageText(self) == "Please select at least one alarm."
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
            time.sleep(3)
            assert waitMessageText(self) == "Please select at least one alarm."
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            entryPosition = [1,1]
            getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Checkbox").find_element(By.XPATH,"div/label").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
            time.sleep(3)
            assert waitMessageText(self) == "There are some alarm NOT acknowledged,please check."
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_ack > a").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            # Check the target alarm in Active alarm
            targetAlarmSeverityActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Severity").get_attribute("class")
            targetAlarmAckActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Ack").find_element(By.XPATH, "a").get_attribute("class")
            targetAlarmLogTimeActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "LogTime").text
            targetAlarmDevNameActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "DevName").text
            targetAlarmDescriptionActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Description").text
            targetAlarmDevIPActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "DevIP").text
            targetAlarmSlotIDActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "SlotID").text
            targetAlarmPortIDActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "PortID").text
            targetAlarmOntActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Ont").text
            targetAlarmAckUserActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "AckUser").text
            targetAlarmAckTimeActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "AckTime").text
            targetAlarmCategoryActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Category").text
            targetAlarmNoteActive = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Note").text
            with assume: assert targetAlarmAckActive == "ackRead"
            with assume: assert targetAlarmAckUserActive == "admin"
            targetAlarm = getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Ack").find_element(By.XPATH,"..")
            targetIndex1 = targetAlarm.get_attribute("index_1")
            targetIndex2 = targetAlarm.get_attribute("index_2")
            targetIndex3 = targetAlarm.get_attribute("index_3")
            # Check Clear Function
            getElementByPositionCol(self, "alarm_activeAlarmTable", entryPosition , "Checkbox").find_element(By.XPATH,"div/label").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
            time.sleep(3)
            clearTime = (datetime.now()).strftime(self.dateFormat)
            self.driver.find_element(By.ID, "alarm_clear_note_text").send_keys("$py_clearTime: " + clearTime)
            self.driver.find_element(By.ID, "alarm_clear_note_save_btn").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "History").click()
            time.sleep(3)
            #if self.driver.find_element(By.ID, "alarm_total").text != "0":
            # Check the target alarm in History alarm
            entryPosition = getAlarmPositionByIndex (self, "alarm_historyAlarmTable", {"index_1":targetIndex1, "index_2":targetIndex2, "index_3":targetIndex3})
            with assume: assert getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "Clear").text == "1"
            with assume: assert targetAlarmSeverityActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "Severity").get_attribute("class")
            with assume: assert targetAlarmLogTimeActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "LogTime").text
            with assume: assert targetAlarmDevNameActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "DevName").text
            with assume: assert targetAlarmDescriptionActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "Description").text
            with assume: assert targetAlarmDevIPActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "DevIP").text
            with assume: assert targetAlarmSlotIDActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "SlotID").text
            with assume: assert targetAlarmPortIDActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "PortID").text
            with assume: assert targetAlarmOntActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "Ont").text
            with assume: assert targetAlarmAckUserActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "AckUser").text
            #with assume: assert targetAlarmAckTimeActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "AckTime").text
            with assume: assert targetAlarmCategoryActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "Category").text
            with assume: assert targetAlarmNoteActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "Note").text
            with assume: assert getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "ClearNote").text == "$py_clearTime: " + clearTime
            clearTimeInHistoryZone = getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "ClearTime").text
            clearTimeInHistory = re.sub(r" \(.*$", "",clearTimeInHistoryZone,flags = re.DOTALL)
            clearTimeInHistoryRaw = datetime.strptime(clearTimeInHistory, self.dateFormat) + timedelta(seconds = 5)
            clearTimeRaw = datetime.strptime(clearTime, self.dateFormat)
            clearTimeRawMax = clearTimeRaw + timedelta(seconds = 8)
            with assume: assert clearTimeRaw <= clearTimeInHistoryRaw <= clearTimeRawMax


    # Alarm / Active / Alarm detail
    @pytest.mark.Unicase
    def test_EMS1_3577_3497_alarmDetailActive(self):
        self.driver.find_element(By.LINK_TEXT, "Alarm").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Active").click()
        time.sleep(3)
