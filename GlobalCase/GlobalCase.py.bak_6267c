                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " pm-counter current") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " ontstatus") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " dhcp l2agent snooping database") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " dhcp l2agent snooping statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " igmp-mld group") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " igmp-mld statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface xpon " + slotID + "-" + portID + " ip source binding") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
            self.driver.find_element(By.XPATH,"/html/body/div[2]/div[1]/button/span[1]").click()
            time.sleep(3)


