    @pytest.mark.Unicase
    def test_EMS1_6067_6068_dashboardAlarmAckClear(self):
        self.driver.find_element(By.LINK_TEXT, "Dashboard").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "dashboard_all_alarm_card_more").click()
        p= self.driver.window_handles[0]
        c = waitNewWindowHandle(self)
        self.driver.switch_to.window(c)
        alarmNum = len(self.driver.find_elements(By.XPATH, "//*[@id=\"alarm_activeTable_body\"]/tbody/tr[1]"))
        if alarmNum != 0:
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
            time.sleep(3)
            entryPosition = getPositionByColClassNext (self, "alarm_activeTable", "Ack", "ackNotRead")
            if entryPosition == [-1,-1]: return
            targetAlarm = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Ack").find_element(By.XPATH,"..")
            targetIndex1 = targetAlarm.get_attribute("index_1")
            targetIndex2 = targetAlarm.get_attribute("index_2")
            targetIndex3 = targetAlarm.get_attribute("index_3")
            # Check the target alarm in Active alarm
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_ack > a").click()
            time.sleep(3)
            assert waitMessageText(self) == "Please select at least one alarm."
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
            time.sleep(3)
            assert waitMessageText(self) == "Please select at least one alarm."
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Checkbox").find_element(By.XPATH,"div/label").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
            time.sleep(3)
            assert waitMessageText(self) == "There are some alarm NOT acknowledged,please check."
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_ack > a").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            entryPosition = getAlarmPositionByIndex (self, "alarm_activeTable", {"index_1":targetIndex1, "index_2":targetIndex2, "index_3":targetIndex3})
            # Check ACK Function
            targetAlarmSeverityActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Severity").get_attribute("class")
            targetAlarmAckActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Ack").find_element(By.XPATH, "a").get_attribute("class")
            targetAlarmLogTimeActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "LogTime").text
            targetAlarmDevNameActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "DevName").text
            targetAlarmDescriptionActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Description").text
            targetAlarmDevIPActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "DevIP").text
            targetAlarmSlotIDActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "SlotID").text
            targetAlarmPortIDActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "PortID").text
            targetAlarmOntActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Ont").text
            targetAlarmAckUserActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "AckUser").text
            targetAlarmAckTimeActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "AckTime").text
            targetAlarmCategoryActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Category").text
            targetAlarmNoteActive = getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Note").text
            with assume: assert targetAlarmAckActive == "ackRead"
            with assume: assert targetAlarmAckUserActive == "admin"
            # Check Clear Function
            getElementByPositionCol(self, "alarm_activeTable", entryPosition , "Checkbox").find_element(By.XPATH,"div/label").click()
