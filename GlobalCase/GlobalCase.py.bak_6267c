    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5740_geTempPrfDel(self):
        if self.exeServiceGe == "":
            pytest.skip("No GE port is configured for this Provision case")
        deleteGeServiceWithProfile (self, "$py_TempGeDel")
        deleteServiceWithPort (self, self.dutIp, self.geInfo)
        waitGeUpdate (self, self.dutIp, self.geInfo, "Disable")
        deleteFileIfExisted(self,"GE Template","$py_TempGeDel")
        deleteAutoMaxFileIfTableFull(self,"GE Template",3000)
        #Create GE template profile: "$py_TempGeDel"
        createProfile (self, "GE Template", "$py_TempGeDel")
        saveProfile (self)
        #Create service with $py_TempGeDel
        createGeServiceWithPortProfile (self, self.dutIp, self.geInfo, "$py_TempGeDel")
        #Wait service finished
        waitGeServiceSuccess (self, self.dutIp, self.geInfo)
        time.sleep (3)
        with assume: assert deleteFileIfExisted(self,"GE Template","$py_TempGeDel") == False
        deleteServiceWithSn(self, self.serviceOntSN)
        with assume: assert deleteFileIfExisted(self,"ONT Template","$py_TempGeDel")


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_6646_addIpHost(self):
        if self.exeServiceOnt == "": return
        deleteServiceWithSn(self, self.serviceOntSN)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered")
        createServiceWithIpSnPwdProfileWait (self, self.dutIp, self.serviceOntSN, self.serviceOntPW, "")
        #IP-Host setting
        self.driver.find_element(By.ID, "provision_service_hostip_vlan_text").send_keys("4094")
        self.driver.find_element(By.ID, "provision_service_hostip_pbit_text").send_keys("7")
        Select(self.driver.find_element(By.ID, "provision_service_hostip_mode_combbox")).select_by_visible_text("Static")
        self.driver.find_element(By.ID, "provision_service_hostip_staticip_text").send_keys("192.168.123.4")
        self.driver.find_element(By.ID, "provision_service_hostip_mask_text").send_keys("255.255.255.0")
        self.driver.find_element(By.ID, "provision_service_hostip_gateway_text").send_keys("192.168.123.254")
        self.driver.find_element(By.ID, "provision_service_hostip_pridns_text").send_keys("1.2.3.4")
        self.driver.find_element(By.ID, "provision_service_hostip_secdns_text").send_keys("5.6.7.8")
        self.driver.find_element(By.ID, "provision_save_service_btn").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//input[@value=\'Save\']").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(5)
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "--"
        action = ActionChains(self.driver)
        action.double_click(getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn")).perform()
        time.sleep (3)
        #getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").click()
        time.sleep(3)
        main_window = self.driver.current_window_handle
        c = waitNewWindowHandle(self)
        self.driver.switch_to.window(c)
        #Check the ip host config in result
        if self.serviceOntFlag == "xont":
            self.driver.find_element(By.LINK_TEXT, "Click").click()
            time.sleep(15)
            consolePList = []
            consolePElementList = self.driver.find_elements(By.XPATH, "//div[@id=\'exist_console\']/p")
            for consolePElement in consolePElementList:
                consolePList.append(consolePElement.text)
            showIPHostStatusCmd = "show interface remote xont " + ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] + " ip-host status"
            showIPHostConfigCmd = "show interface remote xont " + ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] + " ip-host config" 
            with assume: assert showIPHostStatusCmd in consolePList[0]
            with assume: assert "AID : ont-" + ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] == consolePList[2] 
            with assume: assert "#" in consolePList[-15] 
            with assume: assert showIPHostConfigCmd in consolePList[-14]
            with assume: assert "AID : ont-" + ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] == consolePList[-12]
            with assume: assert "vlan Id-config : 4094/7" == consolePList[-10]
            with assume: assert "IP type-config : static" == consolePList[-9]
            with assume: assert "IP address : 192.168.123.4" == consolePList[-8]
            with assume: assert "IP mask : 255.255.255.0" == consolePList[-7]
            with assume: assert "IP gateway : 192.168.123.254" == consolePList[-6]
            with assume: assert "IP Primary DNS : 1.2.3.4" == consolePList[-5]
            with assume: assert "IP Secondary DNS : 5.6.7.8" == consolePList[-4]
            with assume: assert "#" in consolePList[-1] 
            self.driver.find_element(By.ID, "popupCallBack").click()
            time.sleep(3)
            self.driver.close()
            self.driver.switch_to.window(main_window)
        #Check in CLI
        checkValue = []
        #Check ont or ont-14 config
        if self.serviceOntFlag != "xont":
            aid = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] if self.serviceOntFlag == "ont" else "ont-" + ontInfo[1] + "-" + ontInfo[2]
            checkValue = [aid, "no inactive", "sn " + self.serviceOntSN, "password " + self.serviceOntPW]
            for checkInd in checkValue:
                with assume: assert checkInd in (await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo))[0]
        #Check neox or ies xont config and profile
        else:
            await setXponSnStyle(self.dutIp, self.dutAdminName, self.dutAdminPwd, "normal")
            serviceOntSNCLI = sn16To12 (self.serviceOntSN)
            #Check neox xont config
            if "NeoX" in self.dutType:
                checkValue = ["Active", "Enable", self.serviceOntPW, serviceOntSNCLI, "", "auto", "none", "", "", "", "", "", ""]
            #Check ies xont config
            else:
                checkValue = ["Active", self.serviceOntPW, serviceOntSNCLI, "", "", "", "", "", "", ""]
            with assume: assert await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo) == checkValue
            #Check ip host in CLI
            checkValue = ['4094/7', 'static', '192.168.123.4', '255.255.255.0', '192.168.123.254', '1.2.3.4', '5.6.7.8']
            with assume: assert await cliShowXontIpHost(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.ontInfo)


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_6880_modifyIpHost(self):
        #Need provision the Ip Host first (Need execute test_EMS1_6646_addIpHost first)
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag != "xont": return
        self.driver.find_element(By.LINK_TEXT, "Provision").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "Service").click()
        self.driver.find_element(By.ID, "service_tab_ont").click()
        time.sleep(5)
        entryPosition = getPositionByCols(self, "provision_service_table", {"sn":self.serviceOntSN})
        getElementByPositionCol(self, "provision_service_table", entryPosition , "Modify").click()
        time.sleep(3)
        #Modify IP-Host setting
        self.driver.find_element(By.ID, "provision_service_hostip_vlan_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "provision_service_hostip_vlan_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "provision_service_hostip_vlan_text").send_keys("1")
        self.driver.find_element(By.ID, "provision_service_hostip_pbit_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "provision_service_hostip_pbit_text").send_keys(Keys.DELETE)
        Select(self.driver.find_element(By.ID, "provision_service_hostip_mode_combbox")).select_by_visible_text("Dynamic")
        self.driver.find_element(By.ID, "provision_service_hostip_gateway_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "provision_service_hostip_gateway_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "provision_service_hostip_pridns_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "provision_service_hostip_pridns_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "provision_service_hostip_pridns_text").send_keys("11.22.33.44")
        self.driver.find_element(By.ID, "provision_service_hostip_secdns_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "provision_service_hostip_secdns_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "provision_service_hostip_secdns_text").send_keys("55.66.77.88")
        self.driver.find_element(By.ID, "provision_save_service_btn").click()
        time.sleep(3)
