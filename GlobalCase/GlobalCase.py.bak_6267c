    # System/ Security/ Map Management
    @pytest.mark.asyncio
    @pytest.mark.Unicase
    async def test_EMS1_7026_mapManagementV3AuthMethod(self):
        try:
            testVersion = "V3"
            testVersionLower = testVersion.lower()
            authLevel = "Authentication and privacy"
            authLevelSimple = "priv"
            authHashList = ["MD5", "SHA"]
            authEncryptList = ["AES", "DES"]
            for authHash in authHashList:
                for authEncrypt in authEncryptList:
                    self.driver.find_element(By.LINK_TEXT, "System").click()
                    time.sleep(3)
                    self.driver.find_element(By.LINK_TEXT, "Security").click()
                    time.sleep(3)
                    self.driver.find_element(By.LINK_TEXT, "Map Management").click()
                    time.sleep(3)
                    # Delete node
                    try:
                        self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").location_once_scrolled_into_view
                        self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").click()
                        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
                        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Delete\"]").click()
                        time.sleep(20)
                        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
                        time.sleep(3)
                    except NoSuchElementException:
                        pass
                    # Set v3 auth hash and encrypt in CLI
                    if "OLT" in self.dutType:
                        snmpUsrCmd = "snmp-server username " + self.dutAdminName + " sec-level " + authLevelSimple + " auth " + authHash.lower() + " auth-password " + self.dutAdminPwd + " priv " + authEncrypt.lower() + " priv-password " + self.dutAdminPwd + " group readwrite"
                    else:
                        snmpUsrCmd = "snmp-server username " + self.dutAdminName + " sec-level " + authLevelSimple + " auth " + authHash.lower() + " priv " + authEncrypt.lower()
                    commandList = ["config", "snmp-server version " + testVersionLower, snmpUsrCmd]
                    await cliCommandList (self.dutIp, self.dutAdminName, self.dutAdminPwd, commandList)
                    time.sleep(3)
                    # Create v3 auth hash and encrypt node in EMS
                    self.driver.find_element(By.ID, "node_id_0").click()
                    self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_device > a").click()
                    self.driver.find_element(By.CSS_SELECTOR, ".col-md-5:nth-child(1) span").click()
                    self.driver.find_element(By.ID, "deviceName").clear()
                    self.driver.find_element(By.ID, "deviceName").send_keys(self.dutName)
                    self.driver.find_element(By.ID, "description").clear()
                    self.driver.find_element(By.ID, "description").send_keys(self.dutDesc)
                    self.driver.find_element(By.ID, "deviceIP").clear()
                    self.driver.find_element(By.ID, "deviceIP").send_keys(self.dutIp)
                    self.driver.find_element(By.ID, "userName").clear()
                    self.driver.find_element(By.ID, "userName").send_keys(self.dutAdminName)
                    self.driver.find_element(By.ID, "dev_password").clear()
                    self.driver.find_element(By.ID, "dev_password").send_keys(self.dutAdminPwd)
                    Select(self.driver.find_element(By.ID, "snmpVersion")).select_by_visible_text("SNMP " + testVersion)
                    Select(self.driver.find_element(By.ID, "snmpv3level")).select_by_visible_text(authLevel)
                    Select(self.driver.find_element(By.ID, "snmpv3hash")).select_by_visible_text(authHash)
                    Select(self.driver.find_element(By.ID, "snmpv3encrypt")).select_by_visible_text(authEncrypt)
                    self.driver.find_element(By.ID, "setCommunity").clear()
                    self.driver.find_element(By.ID, "setCommunity").send_keys(self.dutSet)
                    self.driver.find_element(By.ID, "getCommunity").clear()
                    self.driver.find_element(By.ID, "getCommunity").send_keys(self.dutGet)
                    self.driver.find_element(By.ID, "geoPosition").clear()
                    self.driver.find_element(By.ID, "geoPosition").send_keys(self.dutAddr)
                    time.sleep(3)
                    try:
                        self.driver.find_element(By.ID, "geoPositionSearch").click()
                        time.sleep(3)
                    except ElementNotInteractableException:
                        pass
                    self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Apply\"]").click()
                    time.sleep(20)
                    self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
                    time.sleep(120)
                    self.driver.find_element(By.LINK_TEXT, "Inventory").click()
                    WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.LINK_TEXT, "Device")))
                    time.sleep(3)
                    entryPosition = getPositionByColNext(self, "dev_inventory_div", "IPAddress", self.dutIp)
                    with assume: assert getElementByPositionCol(self, "dev_inventory_div", entryPosition , "DevStatus").text == "Up"
                    time.sleep(3)
            # Device node back to original setting
            # Setup snmp version in CLI
            testVersion = self.dutSnmpVer.removeprefix("SNMP ")
            testVersionLower = testVersion.lower()
            snmpUsrCmd = ""
            dutSnmp3AuthSimple = ""
            match self.dutSnmp3Auth:
                case "Authentication and privacy":
                    dutSnmp3AuthSimple = "priv"
                case "Authentication and no privacy":
                    dutSnmp3AuthSimple = "auth"
                case "No authentication and no privacy":
                    dutSnmp3AuthSimple = "noauth"
            self.dutSnmp3HashLower = self.dutSnmp3Hash.lower()
            self.dutSnmp3EncryptLower = self.dutSnmp3Encrypt.lower()
            if "OLT" in self.dutType:
                snmpUsrCmd = "snmp-server username " + self.dutAdminName + " sec-level " + dutSnmp3AuthSimple + " auth " + self.dutSnmp3HashLower + " auth-password " + self.dutAdminPwd + " priv " + self.dutSnmp3EncryptLower + " priv-password " + self.dutAdminPwd + " group readwrite"
            else:
                snmpUsrCmd = "snmp-server username " + self.dutAdminName + " sec-level " + dutSnmp3AuthSimple + " auth " + self.dutSnmp3HashLower + " priv " + self.dutSnmp3EncryptLower
            commandList = ["config", "snmp-server version " + testVersionLower, snmpUsrCmd]
            await cliCommandList (self.dutIp, self.dutAdminName, self.dutAdminPwd, commandList)
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "System").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Security").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Map Management").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").location_once_scrolled_into_view
            self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").click()
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
            self.driver.find_element(By.CSS_SELECTOR, ".comboTreeArrowBtnImg").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//label[@data-name=\'EMS\']").click()
            self.driver.find_element(By.ID, "deviceName").clear()
            self.driver.find_element(By.ID, "deviceName").send_keys(self.dutName)
            self.driver.find_element(By.ID, "description").clear()
            self.driver.find_element(By.ID, "description").send_keys(self.dutDesc)
            self.driver.find_element(By.ID, "deviceIP").clear()
            self.driver.find_element(By.ID, "deviceIP").send_keys(self.dutIp)
            self.driver.find_element(By.ID, "userName").clear()
            self.driver.find_element(By.ID, "userName").send_keys(self.dutAdminName)
