    # Maintenance / Schedule / ConfigBackup Immediately with special charaters node name
    @pytest.mark.asyncio
    @pytest.mark.Unicase
    async def test_EMS1_6387_configBackupSpecialChar(self):
        # Modify the device node name as special characters name
        specailName = "~!@#$%^&*()_+{}|:<>?-=[]."
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Security").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Map Management").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//small[contains(.,\'("+ self.dutIp +")\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//small[contains(.,\'("+ self.dutIp +")\')]").click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
        self.driver.find_element(By.ID, "deviceName").clear()
        self.driver.find_element(By.ID, "deviceName").send_keys(specailName)
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Save\"]").click()
        WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.ID, "message_text")))
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        # Executin Configuration Backup
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Schedule").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
        time.sleep(3)
        Select(self.driver.find_element(By.ID, "schedule_type")).select_by_visible_text("Configuration backup")
        time.sleep(3)
        self.driver.find_element(By.ID, "schedule_name").click()
        exeTime = (datetime.now()).strftime("%Y-%m-%d_%H:%M:%S")
        scheduleName = "$py_" + exeTime
        setScheduleName(self, scheduleName)
        self.driver.find_element(By.XPATH, "//label[contains(.,\'Immediately\')]").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'("+ self.dutIp +")\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'("+ self.dutIp +")\')]").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'Save config before backup\')]").click()
        self.driver.find_element(By.ID, "schedule_config_backup_save_btn").click()
        time.sleep(90)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        waitScheduleSuccess (self, entryPosition)
        time.sleep(30)
        scheduleTime = getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleTime").text.removesuffix(self.timeZone) 
        # Download the config
        openScheduleResult(self, entryPosition)
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Download").click()
        time.sleep(10)
        with assume: assert getScheduleResultByCol (self, "Index") == "1"
        with assume: assert getScheduleResultByCol (self, "Schedule Name") == scheduleName
        minTime = datetime.strptime(scheduleTime, self.dateFormat)
        maxTime = minTime + timedelta(seconds = 600)
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        time.sleep(3)
        # Check the download config file
        files = glob.glob(os.path.join(self.downloadpath, "*.txt"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime
        # Modify the device node name back to node name
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Security").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Map Management").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//small[contains(.,\'("+ self.dutIp +")\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//small[contains(.,\'("+ self.dutIp +")\')]").click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
        self.driver.find_element(By.ID, "deviceName").clear()
        self.driver.find_element(By.ID, "deviceName").send_keys(self.dutName)
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Save\"]").click()
        WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.ID, "message_text")))
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        # Download the config again
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Schedule").click()
        time.sleep(3)
        openScheduleResult(self, entryPosition)
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Download").click()
        time.sleep(10)
        with assume: assert getScheduleResultByCol (self, "Index") == "1"
        with assume: assert getScheduleResultByCol (self, "Schedule Name") == scheduleName
        minTime = datetime.strptime(scheduleTime, self.dateFormat)
        maxTime = minTime + timedelta(seconds = 600)
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        time.sleep(3)
        # Check the latest download config file
        files = glob.glob(os.path.join(self.downloadpath, "*.txt"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime


    # Maintenance / Schedule / Filter
    @pytest.mark.Unicase
    def test_EMS1_3865_scheduleFilter(self):
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Schedule").click()
        time.sleep(3)
        filterTypeElementList = self.driver.find_elements(By.XPATH, "//*[@id=\"profile_filtertype\"]/option")
        for filterTypeElement in filterTypeElementList:
            filterType = filterTypeElement.text
            scheduleType = ""
            match filterType:
                case "Select schedule type ...": continue
                case "Configuration backup": scheduleType = "Config Backup"
                case "Configuration restore": scheduleType = "Config Restore"
                case "Device reboot": scheduleType = "Reboot"
                case "Firmware upgrade": scheduleType = "Firmware Upgrade"
                case "ONT firmware upgrade": scheduleType = "ONT Firmware Upgrade"
                case "ONT reboot": scheduleType = "ONT Reboot"
                case "ONT configure default": scheduleType = "ONT Load Default"
            Select(self.driver.find_element(By.ID, "profile_filtertype")).select_by_visible_text(filterType)
            time.sleep(3)
            tableId = "schedule_table"
            colName = "Type"
            typeList = getListByCol(self, tableId, colName)
            with assume: assert checkAllElementInListAre (typeList, scheduleType)


