    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_6995_igmpGroupPrivilegePrfAddGe(self):
        if self.exeServiceGe == "":
            pytest.skip("No GE port is configured for this Provision case")
        deleteGeServiceWithProfile (self, "$py_TempIGMP")
        deleteServiceWithPort (self, self.dutIp, self.geInfo)
        waitGeUpdate (self, self.dutIp, self.geInfo, "Disable")
        deleteFileIfExisted(self,"GE Template","$py_TempIGMP")
        deleteFileIfExisted(self,"IGMP Group Privilege Profile","$py_IGMP")
        deleteAutoMaxFileIfTableFull(self,"GE Template",3000)
        deleteAutoMaxFileIfTableFull(self,"IGMP Group Privilege Profile",3000)
        #Create IGMP Group Privilege profile: "py_IGMP"
        createProfile (self, "IGMP Group Privilege Profile", "$py_IGMP")
        time.sleep(3)
        for indGrp in range (16):
            elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//label[@for=\"ge_igmp_enable_checkbox" + str(indGrp + 1) + "\"]"))
            self.driver.find_element(By.XPATH, "//label[@for=\"ge_igmp_enable_checkbox" + str(indGrp + 1) + "\"]").click()
            self.driver.find_element(By.ID, "ge_igmp_bandwidth_text" + str(indGrp + 1) + "").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ge_igmp_bandwidth_text" + str(indGrp + 1) + "").send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "ge_igmp_bandwidth_text" + str(indGrp + 1) + "").send_keys("100")
            self.driver.find_element(By.ID, "ge_igmp_startip_text" + str(indGrp + 1) + "").send_keys("225.1." + str(indGrp + 1) + ".1")
            self.driver.find_element(By.ID, "ge_igmp_endip_text" + str(indGrp + 1) + "").send_keys("225.1." + str(indGrp + 1) + ".20")
            elementScrolledIntoView(self, self.driver.find_element(By.ID, "ge_igmp_privilege_combobox" + str(indGrp + 1) + ""))
            Select(self.driver.find_element(By.ID, "ge_igmp_privilege_combobox" + str(indGrp + 1) + "")).select_by_visible_text("Preview")
            self.driver.find_element(By.ID, "ge_igmp_preview_length_text" + str(indGrp + 1) + "").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ge_igmp_preview_length_text" + str(indGrp + 1) + "").send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "ge_igmp_preview_length_text" + str(indGrp + 1) + "").send_keys("300")
            self.driver.find_element(By.ID, "ge_igmp_preview_interval_text" + str(indGrp + 1) + "").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ge_igmp_preview_interval_text" + str(indGrp + 1) + "").send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "ge_igmp_preview_interval_text" + str(indGrp + 1) + "").send_keys("180")
            self.driver.find_element(By.ID, "ge_igmp_preview_count_text" + str(indGrp + 1) + "").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ge_igmp_preview_count_text" + str(indGrp + 1) + "").send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "ge_igmp_preview_count_text" + str(indGrp + 1) + "").send_keys("10")
            self.driver.find_element(By.ID, "ge_igmp_preview_reset_text" + str(indGrp + 1) + "").send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "ge_igmp_preview_reset_text" + str(indGrp + 1) + "").send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "ge_igmp_preview_reset_text" + str(indGrp + 1) + "").send_keys("86400")
        saveProfile (self)
        #Create GE Template profile: "$py_TempIGMP"
        createProfile (self, "GE Template", "$py_TempIGMP")
        self.driver.find_element(By.ID, "ge_template_maxgroup_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ge_template_maxgroup_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ge_template_maxgroup_text").send_keys("16")
        self.driver.find_element(By.ID, "ge_template_maxmessage_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ge_template_maxmessage_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ge_template_maxmessage_text").send_keys("32")
        self.driver.find_element(By.XPATH, "//label[@for=\"ge_template_groupenable_checkbox\"]").click()
        Select(self.driver.find_element(By.ID, "ge_template_igmp_combobox")).select_by_visible_text("$py_IGMP")
        saveProfile (self)
        #Create service with $py_TempIGMP
        createGeServiceWithPortProfile (self, self.dutIp, self.geInfo, "$py_TempIGMP")
        #Wait service finished
        waitGeServiceSuccess (self, self.dutIp, self.geInfo)
        time.sleep (5)
        #Check ge Config in CLI
        geID = "interface ge " + self.geInfo[0] + "-" + self.geInfo[1]
        checkValue = [geID,
                      "enable",
                      "auto-negotiation enable", 
                      "flow-control enable", 
                      "speed 1g-full",
                      "igmp-mld max-group 16",
                      "igmp-mld group-privilege-profile $py_IGMP",
                      "igmp-mld group-privilege",
                      "igmp-mld max-message 32",
                      "vlan copy_cpbit enable", 
                      "vlan outer-tpid disable", 
                      "frame-type all", 
                      "dhcp l2agent snooping dhcp untrust", 
                      "dhcp l2agent snooping dhcpv6 untrust", 
                      "dhcp l2agent opt-ldra-policy linklocal chk-all",
                      "exit"]
        for checkItem in checkValue:
            with assume: assert checkItem in (await cliShowGeRunningConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.geInfo))
        #Check ont igmp group privilege profile in CLI
        checkValue = [['1', '225.1.1.1', '225.1.1.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['2', '225.1.2.1', '225.1.2.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['3', '225.1.3.1', '225.1.3.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['4', '225.1.4.1', '225.1.4.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['5', '225.1.5.1', '225.1.5.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['6', '225.1.6.1', '225.1.6.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['7', '225.1.7.1', '225.1.7.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['8', '225.1.8.1', '225.1.8.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['9', '225.1.9.1', '225.1.9.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['10', '225.1.10.1', '225.1.10.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['11', '225.1.11.1', '225.1.11.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['12', '225.1.12.1', '225.1.12.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['13', '225.1.13.1', '225.1.13.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['14', '225.1.14.1', '225.1.14.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['15', '225.1.15.1', '225.1.15.20', '100', 'preview', '300', '180', '10', '86400']
                        , ['16', '225.1.16.1', '225.1.16.20', '100', 'preview', '300', '180', '10', '86400']]
        result = await cliShowGroupPrivilegeProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_IGMP")
        for checkInd, checkElem in enumerate(checkValue):
            for elem in checkElem:
