PROFILE_NAME = "$py_filterTest"
DESCRIPTION = "testForFilter"
SERVICE_TABLE = "provision_service_table"
class _NewCase06Cases:
    driver = None
    def _newcase_06_setup_browser(self):
        self.driver = create_browser(self.browser, self.downloadpath)
        self.driver.implicitly_wait(self.waitTime)
        self.driver.maximize_window()
