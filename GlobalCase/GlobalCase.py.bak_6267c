    @pytest.mark.Unicase
    def test_EMS1_7106_defaultScrip(self):
        self.driver.find_element(By.LINK_TEXT, "Script").click()
        time.sleep (3)
        defaultScriptList = ["[Default]OLT140X Series - PORT", "[Default]OLT140X Series - ONT", "[Default]OLT140X Series - NNI PORT", "[Default]OLT140X Series - Device Info"
                             , "[Default]NeoX Series - XPON ONT", "[Default]NeoX Series - PON PORT", "[Default]NeoX Series - NNI PORT", "[Default]NeoX Series - GE PORT", "[Default]NeoX Series - Device Info"
                             , "[Default]IES52XX Series - XPON PORT", "[Default]IES52XX Series - XPON ONT", "[Default]IES52XX Series - NNI PORT", "[Default]IES52XX Series - GPON PORT"
                             , "[Default]IES52XX Series - GPON ONT", "[Default]IES52XX Series - GE PORT", "[Default]IES52XX Series - Device Info"]
        for defaultScript in defaultScriptList:
            entryPosition = getPositionByCol(self, "script_table", "Name", defaultScript)
            # Check default script default content
            getElementByPositionCol(self, "script_table", entryPosition , "Modify").click()
            time.sleep (3)
            # The script dialog is filled in asynchronously
            try:
                WebDriverWait(self.driver, 30, poll_frequency=0.5).until(
                    lambda driver: driver.find_element(By.ID, "script_name").get_attribute("value") == defaultScript
                    and driver.find_element(By.ID, "script_content").get_attribute("innerText")
                )
            except TimeoutException:
                pass
            with assume: assert self.driver.find_element(By.ID, "script_name").get_attribute("value") == defaultScript
            match defaultScript:
                case "[Default]OLT140X Series - PORT":
                    with assume: assert self.driver.find_element(By.ID, "script_content").get_attribute("innerText") == "show interfaces pon-[PORT]\nshow interfaces olt pon-[PORT] status\nshow interfaces olt pon-[PORT] count"
