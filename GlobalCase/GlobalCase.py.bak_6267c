        for ind, groupItem in enumerate(groupItemList):
            accessValue = ind%3
            match accessValue:
                case 0: accessText = "No access"
                case 1: accessText = "Read only"
                case 2: accessText = "Read write"
            Select(self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_Template_create\"]//div[text()=\'" + groupItem + "\']/following-sibling::div[1]/select")).select_by_visible_text(accessText)
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_Template_create\"]//input[@value=\"Create\"]").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        newEMSUsr(self, usrName, usrPwd, groupName, "Global", [self.dutName])
        logoutEMS(self)
        loginEMS(self, usrName, usrPwd)
        pageList = ["Dashboard", "Map", "Alarm", "Active", "History", "Inventory", "Device", "Card", "Port", "All Ports", "Network Port"
                    , "Ethernet Access Port", "GPON Port", "xPON Port", "ONT", "Performance", "Current", "History", "Maintenance"
                    , "Schedule", "Result Log", "Firmware File Management", "Provision", "Service", "Profile", "Configuration"
                    , "Script", "Script", "Task", "Default Setting", "System", "Security", "User", "Region", "Group", "Map Management"
                    , "Access Log", "Online User", "Password Rule", "Fault", "Alarm Severity", "Pairwise Correlation", "Duplicate Correlation"
                    , "Alarm Template", "Alarm Filter", "Alarm Action", "System Properties", "System Setting", "Server Monitor"
                    , "Alarm Notification", "EMS Database Backup/Restore", "System Storage"]  
        for page in pageList:
            print (page)
            if page == "Region": continue
            self.driver.find_element(By.LINK_TEXT, page).click()
            time.sleep(3)
            match page:
                case ("Dashboard"|"Configuration"|"Script"|"Inventory"|"Device"|"Card"|"Port"|"All Ports"|"Network Port"
                      |"Ethernet Access Port"|"GPON Port"|"xPON Port"|"ONT"|"Firmware File Management"|"Access Log"|"Alarm Severity"
                      |"Alarm Template"|"System Properties"|"System Setting"|"System Storage"):
                    if page == "Configuration":
                        with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"privision_noprivilege_label\"]/div[1]").text.strip() == "No privilege to access this page"
                        with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"privision_noprivilege_label\"]/div[2]").text.strip() == "You are not allow to access this page.\nPlease contact system administrator if you have any problem." 
                    else:
                        with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"No_Privilege\"]/div/div[1]").text.strip() == "No privilege to access this page", f"{page}"
                        with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"No_Privilege\"]/div/div[2]").text.strip() == "You are not allow to access this page.\nPlease contact system administrator if you have any problem.", f"{page}"
                case ("Map"|"Performance"|"Current"|"History"|"Provision"|"Service"|"Task"|"System"|"Security"|"User"|"Map Management"
                      |"Pairwise Correlation"|"Alarm Filter"|"Server Monitor"):
                    elementXpathList = []
                    if self.driver.find_element(By.LINK_TEXT, "Map").get_attribute("className") != "":
                        elementXpathList = ["//*[@id=\"i_action_zoomin\"]", "//*[@id=\"i_action_zoomout\"]", "//*[@id=\"i_action_polling\"]", "//*[@id=\"i_action_linksetting\"]", "//*[@id=\"i_action_clear\"]", "//*[@id=\"i_action_background_change\"]", "//*[@id=\"i_action_connection_test\"]"]
                    elif self.driver.find_element(By.LINK_TEXT, "Performance").get_attribute("className") != "":
                        elementXpathList = ["//*[@id=\"i_action_create_demand\"]"]
                    elif page in ["Provision","Service"]:
                        subpageList = ["ONT", "GE"]
                        for subpage in subpageList:
                            self.driver.find_element(By.LINK_TEXT, subpage).click()
                            time.sleep(3)
                            closeElementXpath = ""
                            if subpage == "ONT": 
                                elementXpath = "//*[@id=\"provision_save_service_btn\"]"
                                closeElementXpath = "//div[@id=\"modal_service_profile_info\"]//button/span"
                            else: 
                                elementXpath = "//*[@id=\"provision_geserviceinfo_save_btn\"]"
                                closeElementXpath = "//div[@id=\"modal_geservice_profile_info\"]//button/span"
                            if tableIsEmpty (self, "provision_service_table") == False:
                                getElementByPositionCol(self, "provision_service_table", [1,1] , "Modify").click()
                                time.sleep(3)
                                with assume : "none" in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                                self.driver.find_element(By.XPATH, closeElementXpath).click()
                            time.sleep(3)
                        elementXpathList = ["//*[@id=\"provision_service_create\"]", "//*[@id=\"provision_service_delete\"]", "//*[@id=\"provision_service_reprovision\"]"]
                    elif page == "Task":
                        elementXpathList = ["//*[@id=\"i_action_delete\"]"]
                    elif page in ["System","Security","User"]:
                        elementXpathList = ["//*[@id=\"i_action_create_user\"]", "//*[@id=\"tab_content_User\"]/div[2]/div[2]"]
                    elif page == "Map Management":
                        elementXpathList = ["//*[@id=\"i_action_create_device\"]", "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]"]
                    elif page == "Pairwise Correlation":
                        elementXpath = "//*[@id=\"pairwise_button\"]"
                        with assume: assert "hidden" in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                    elif page == "Alarm Filter":
                        elementXpathList = ["//*[@id=\"i_action_create_collector\"]", "//*[@id=\"i_action_delete\"]"]
                    elif page == "Server Monitor": 
                        elementXpathList = ["//*[@id=\"tab_content_System_Monitor\"]/div/div/div[1]/div[2]/div[3]"]
                    for elementXpath in elementXpathList:
                        with assume : assert "none" in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                case ("Alarm"|"Profile"|"Default Setting"|"Maintenance"|"Schedule"|"Group"|"Online User"|"Duplicate Correlation"|"Alarm Action"|"EMS Database Backup"):
                    elementXpathList = []
                    if self.driver.find_element(By.LINK_TEXT, "Alarm").get_attribute("className") != "":
                        if page == "Active": elementXpathList = ["//*[@id=\"i_action_ack\"]", "//*[@id=\"i_action_clear\"]"]
                        elif page == "History": elementXpathList = ["//*[@id=\"i_action_delete\"]"]
                    elif page == "Profile":
                        prfTypeElementList = self.driver.find_elements(By.XPATH, "//select[@id=\'profile_filtertype\']/option")
                        prfTypeList = [prfTypeElement.text for prfTypeElement in prfTypeElementList]
                        for prfType in prfTypeList:
                            Select(self.driver.find_element(By.ID, "profile_filtertype")).select_by_visible_text(prfType)
                            time.sleep(3)
                            if tableIsEmpty (self, "profile_table") == False:
                                try:
                                    getElementByPositionCol(self, "profile_table", [1,1] , "Modify")
                                    with assume: assert True, f"{page}"
                                except NoSuchElementException:
                                    with assume: assert False
                                time.sleep(3)
                        elementXpathList = ["//*[@id=\"i_action_create_collector\"]", "//*[@id=\"i_action_delete\"]", "//*[@id=\"i_action_delete_profile_sync_state\"]"]
                    elif page == "Default Setting":
                        if tableIsEmpty (self, "DefaultSetting_table") == False:
                            getElementByPositionCol(self, "DefaultSetting_table", [1,1] , "Modify").click()
                            time.sleep(3)
                            with assume: assert "hidden" not in self.driver.find_element(By.XPATH, "//*[@id=\"create_DefaultSetting_background\"]/div[2]/input").get_attribute("Style"), f"{page}"
                            self.driver.find_element(By.XPATH, "//*[@id=\"create_DefaultSetting_background\"]/div[1]/a").click()
                            time.sleep(3)
                    elif page in ["Maintenance", "Schedule"]:
                       if tableIsEmpty (self, "schedule_table") == False:
                            getElementByPositionCol(self, "schedule_table", [1,1] , "Modify").click()
                            time.sleep(3)
                            with assume : assert "none" not in self.driver.find_element(By.XPATH, "//input[@value=\'Save\']").get_attribute("Style"), f"{page}"
                            self.driver.find_element(By.XPATH, "//*[@id=\"create_schedule_background\"]/div[1]/a").click()
                            time.sleep(3)
                    elif page == "Group":
                        elementXpathList = ["//*[@id=\"i_action_create_collector\"]"]
                    elif page == "Online User":
                        elementXpathList = ["//*[@id=\"i_action_delete\"]"]
                    elif page == "Duplicate Correlation":
                        elementXpath = "//*[@id=\"duplicate_button\"]"
                        with assume: assert "hidden" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                        continue
                    elif page == "EMS Database Backup/Restore":
                        elementXpathList = ["//*[@id=\"sys_dbbackup_conf_btn\"]", "//*[@id=\"sys_dbbackup_restore_function_btn\"]", "//*[@id=\"sys_dbbackup_delete_btn\"]"]
                        for elementXpath in elementXpathList:
                            with assume: assert "hidden" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                        continue
                    if page in ["Maintenance", "Schedule","Default Setting", "Alarm Action"]:
                        elementXpathList = ["//*[@id=\"i_action_create_collector\"]", "//*[@id=\"i_action_delete\"]"]
                    for elementXpath in elementXpathList:
                        with assume : assert "block" in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"


