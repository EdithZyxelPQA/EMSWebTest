            with assume: assert targetAlarmOntActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "Ont").text
            with assume: assert targetAlarmAckUserActive == getElementByPositionCol(self, "alarm_historyAlarmTable", entryPosition , "AckUser").text
