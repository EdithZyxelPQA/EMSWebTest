    # System/ System Properties/ System Storage/ Alarm Purge
    @pytest.mark.Unicase
    def test_EMS1_6363_alarmPurgeDownload(self):
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "System Properties").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "System Storage").click()
        time.sleep (3)
        if self.driver.find_element(By.LINK_TEXT, "Alarm Purge").get_attribute("className") == "":
            self.driver.find_element(By.LINK_TEXT, "Alarm Purge").click()
            time.sleep (3)
        self.driver.find_element(By.ID, "Download_button").click()
        time.sleep (3)
        with assume: assert waitMessageText(self) == "Please select one file."
        time.sleep (3)
        self.driver.find_element(By.XPATH, "//*[@id=\"message_diag\"]/div/div/div[3]/button ").click()
        time.sleep (3)
        minTime = datetime.now()
        try:
            self.driver.find_element(By.XPATH, "//label[@for=\"sys_accesslog_backup_check0\"]").click()
            time.sleep (3)
            self.driver.find_element(By.ID, "Download_button").click()
            time.sleep(10)
        except NoSuchElementException:
            return
        maxTime = datetime.now()
        files = glob.glob(os.path.join(self.downloadpath, "*.csv"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime


