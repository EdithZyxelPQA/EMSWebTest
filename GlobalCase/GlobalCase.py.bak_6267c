            self.driver.switch_to.window(c)
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_dev").text == dutName + " (" + dutIp + ")"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_slotid").text == "Slot: " + ontSlotIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_portid").text == "Port: " + ontPortIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_ontid").text == "ONT: " + ontOntIDList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "SN") == ontSNList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Model") == ontModelList[index]
            if ontFlagList[index] == "xont":
                self.driver.find_element(By.LINK_TEXT, "Click").click()
                time.sleep(15)
                consolePList = []
                consolePElementList = self.driver.find_elements(By.XPATH, "//div[@id=\'exist_console\']/p")
                for consolePElement in consolePElementList:
                    consolePList.append(consolePElement.text)
                showIPHostStatusCmd = "show interface remote xont " + ontSlotIDList[index] + "-" + ontPortIDList[index] + "-" + ontOntIDList[index] + " ip-host status"
                showIPHostConfigCmd = "show interface remote xont " + ontSlotIDList[index] + "-" + ontPortIDList[index] + "-" + ontOntIDList[index] + " ip-host config" 
                with assume: assert showIPHostStatusCmd in consolePList[0]
                with assume: assert "AID : ont-" + ontSlotIDList[index] + "-" + ontPortIDList[index] + "-" + ontOntIDList[index] == consolePList[2] 
                with assume: assert "#" in consolePList[-15] 
                with assume: assert showIPHostConfigCmd in consolePList[-14]
                with assume: assert "AID : ont-" + ontSlotIDList[index] + "-" + ontPortIDList[index] + "-" + ontOntIDList[index] == consolePList[-12] 
                with assume: assert "#" in consolePList[-1] 
                self.driver.find_element(By.ID, "popupCallBack").click()
                time.sleep(3)
            self.driver.close()
            self.driver.switch_to.window(p)
            time.sleep(3)


    @pytest.mark.Icat
    def test_EMS1_5491_alarmStatus(self):
        (
            waitTime, uploadPath, downloadpath, browser, emsURL, emsVer, 
            emsUsr, emsPwd, node_name, dutName, dutIp, dutNodeName, 
            dutDesc, dutAdminName, dutAdminPwd, dutType, dutSet, dutGet, 
            dutSnmpVer, dutSnmp3Auth, dutSnmp3Hash, dutSnmp3Encrypt, dutAddr, dutSlotCount,
            dutAllCardID, dutAllCardPortID, cardTypeName, cardPortTypeName, cardPortTypeSpeed, 
            cardFwVersion, fwUploadName, fwUploadFileName,
            ontCount, ontSlotIDList, ontPortIDList, ontOntIDList, ontSNList, 
            ontPWList, ontModelList, ontTypeList, ontFlagList, exeUpgradeONT, 
            upgradeOntFW, upgradeOntFlag, upgradeOntModel, upgradeOntSlotID, 
            upgradeOntPortID, upgradeOntOntID,
            deviceStatusCount, ontStatusCount, alarmStatusCount, alarmStatus, 
            emsLink, dateFormat, timeZone
        ) = (
            self.waitTime, self.uploadPath, self.downloadpath, self.browser, self.emsURL, self.emsVer, 
            self.emsUsr, self.emsPwd, self.node_name, self.dutName, self.dutIp, self.dutNodeName, 
            self.dutDesc, self.dutAdminName, self.dutAdminPwd, self.dutType, self.dutSet, self.dutGet, 
            self.dutSnmpVer, self.dutSnmp3Auth, self.dutSnmp3Hash, self.dutSnmp3Encrypt, self.dutAddr, self.dutSlotCount,
            self.dutAllCardID, self.dutAllCardPortID, self.cardTypeName, self.cardPortTypeName, self.cardPortTypeSpeed, 
            self.cardFwVersion, self.fwUploadName, self.fwUploadFileName,
            self.ontCount, self.ontSlotIDList, self.ontPortIDList, self.ontOntIDList, self.ontSNList, 
            self.ontPWList, self.ontModelList, self.ontTypeList, self.ontFlagList, self.exeUpgradeONT, 
            self.upgradeOntFW, self.upgradeOntFlag, self.upgradeOntModel, self.upgradeOntSlotID, 
            self.upgradeOntPortID, self.upgradeOntOntID,
            self.deviceStatusCount, self.ontStatusCount, self.alarmStatusCount, self.alarmStatus, 
            self.emsLink, self.dateFormat, self.timeZone
        )        
        self.driver.find_element(By.LINK_TEXT, "Dashboard").click()
        time.sleep(3)
        totalAlarmCount = 0
        for status in range(2,alarmStatusCount+1):
            statusAlarmCount = int(self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[" + str(status) + "]/div[2]/a").text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text
        with assume: assert self.driver.find_element(By.ID, "date_now").text == datetime.now().strftime("%Y-%m-%d")
        self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").click()
        self.driver.find_element(By.ID, "dashboard_all_alarm_card_more").click()
        p= self.driver.window_handles[0]
        c = waitNewWindowHandle(self)
        self.driver.switch_to.window(c)
        with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
        #Check the download file
        exportColumnMap = (
            ("Severity", ""),
            ("Ack", "Ack"),
            ("LogTime", "Log Time"),
            ("DevName", "Device Name"),
            ("Description", "Description"),
            ("DevIP", "Device IP"),
            ("SlotID", "Slot ID"),
            ("PortID", "Port ID"),
            ("Ont", "ONT ID"),
            ("AckUser", "Ack by"),
            ("AckTime", "Ack Time"),
            ("Category", "Category"),
            ("Note", "Note"),
        )
        normalizeAlarmValue = lambda value: " ".join(value.split())

        def activeAlarmExportValue(rowIndex, tableColumn):
            cell = getElementByPositionColNoPage(
                self, "alarm_activeTable", rowIndex, tableColumn
            )
            if tableColumn == "Severity":
                severityMatch = re.search(
                    r"(?:^|\s)td_(critical|major|minor|warning|info)(?:\s|$)",
                    cell.get_attribute("class") or "",
                    re.IGNORECASE,
                )
                assert severityMatch, (
                    "Unknown Active Alarm Severity icon class: "
                    f"{cell.get_attribute('class')!r}"
                )
                return severityMatch.group(1).title()
            if tableColumn == "Ack":
                ackClass = cell.find_element(By.XPATH, ".//a").get_attribute("class") or ""
                if "ackNotRead" in ackClass.split():
                    return "Not Acknowledged"
                if "ackRead" in ackClass.split():
                    return "Acknowledged"
                raise AssertionError(f"Unknown Active Alarm Ack icon class: {ackClass!r}")
            value = normalizeAlarmValue(cell.text)
            if value == "--":
                if tableColumn in {"SlotID", "PortID", "Ont"}:
                    return "0"
                if tableColumn in {"AckUser", "AckTime", "Note"}:
                    return ""
            return value

        activeAlarmRows = []
        visibleAlarmRowCount = len(self.driver.find_elements(
            By.XPATH, "//table[@id='alarm_activeTable_body']/tbody/tr"
        ))
        for rowIndex in range(1, visibleAlarmRowCount + 1):
            activeAlarmRows.append(tuple(
                activeAlarmExportValue(rowIndex, tableColumn)
                for tableColumn, _ in exportColumnMap
            ))
        minTime = datetime.now()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_export > a").click()
        time.sleep(30)
        if pageCount (self, "alarm_activeTable")>1000:
            with assume: assert waitMessageText(self) == "Too many alarms; please close this page and click on \"Alarm\" function in main function list.\nAdd filter conditions to limit the alarm less than 100,000 entries."
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep (3)
        else:
            maxTime = datetime.now()
            files = glob.glob(os.path.join(downloadpath, "*.xls"))
            latestFile = max(files, key=os.path.getmtime)
            latestFileSize = os.path.getsize(latestFile)
            latestFileTimeFloat = os.path.getmtime(latestFile)
            latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
            with assume: assert latestFileSize > 0
            with assume: assert minTime <= latestFileTime <= maxTime
            from collections import Counter
            from html.parser import HTMLParser

            class IcatAlarmExportParser(HTMLParser):
                def __init__(self):
                    super().__init__(convert_charrefs=True)
                    self.rows = []
                    self.currentRow = None
                    self.currentCell = None

                def handle_starttag(self, tag, attrs):
                    if tag.lower() == "tr":
                        self.currentRow = []
                    elif tag.lower() in {"td", "th"} and self.currentRow is not None:
                        self.currentCell = []

                def handle_data(self, data):
                    if self.currentCell is not None:
                        self.currentCell.append(data)

                def handle_endtag(self, tag):
                    if tag.lower() in {"td", "th"} and self.currentCell is not None:
                        self.currentRow.append(normalizeAlarmValue("".join(self.currentCell)))
                        self.currentCell = None
                    elif tag.lower() == "tr" and self.currentRow is not None:
                        if self.currentRow:
                            self.rows.append(self.currentRow)
                        self.currentRow = None

            alarmExportParser = IcatAlarmExportParser()
            with open(latestFile, encoding="utf-8-sig") as exportFile:
                alarmExportParser.feed(exportFile.read())
            assert alarmExportParser.rows, f"No table data found in {latestFile}"

            exportHeader = alarmExportParser.rows[0]
            exportColumnIndexes = []
            for _, exportColumn in exportColumnMap:
                assert exportColumn in exportHeader, (
                    f"Export column {exportColumn!r} not found. Header: {exportHeader}"
                )
                exportColumnIndexes.append(exportHeader.index(exportColumn))
            exportAlarmRows = [
                tuple(row[columnIndex] for columnIndex in exportColumnIndexes)
                for row in alarmExportParser.rows[1:]
                if len(row) > max(exportColumnIndexes)
            ]
            missingAlarmRows = Counter(activeAlarmRows) - Counter(exportAlarmRows)
            with assume: assert not missingAlarmRows, (
                "Icat Active Alarm table and export file differ. "
                f"Missing rows: {list(missingAlarmRows.elements())[:5]}"
            )
        self.driver.close()
        self.driver.switch_to.window(p)
        time.sleep(3)
        elementScrolledIntoView(self, self.driver.find_element(By.LINK_TEXT, "Click here for more alarms..."))
        self.driver.find_element(By.LINK_TEXT, "Click here for more alarms...").click()
        match browser:
            case "chrome":
                c = waitNewWindowHandle(self)
                self.driver.switch_to.window(c)
            case "edge":
                c = self.driver.window_handles[2]
                self.driver.switch_to.window(c)
            case "firefox":
                c = waitNewWindowHandle(self)
                self.driver.switch_to.window(c)
        with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
        self.driver.close()
        self.driver.switch_to.window(p)


