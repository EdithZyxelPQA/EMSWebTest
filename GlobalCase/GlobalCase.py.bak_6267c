            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == dutIp, f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "Slot").text == ontSlotIDList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "Port").text == ontPortIDList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "ONT").text == ontOntIDList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == ontSNList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == ontPWList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "model").text == ontModelList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "OntAdminState").text == "Active", f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "OntOperationStatus").text == "In Service", f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "txPower").text != "--", f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "rxPower").text != "--", f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "ONTType").text == ontTypeList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            time.sleep(3)
            minTime = datetime.now()
            exportTableSnapshot = capture_table_and_export(self.driver, "ont_inventory_div")
            time.sleep(20)
            maxTime = datetime.now()
            #Check the download file
            files = glob.glob(os.path.join(downloadpath, "*.xls"))
            latestFile = max(files, key=os.path.getmtime)
            latestFileSize = os.path.getsize(latestFile)
            latestFileTimeFloat = os.path.getmtime(latestFile)
            latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
            with assume: assert latestFileSize > 0
            with assume: assert minTime <= latestFileTime <= maxTime
            assert_export_matches(latestFile, exportTableSnapshot, "Icat Inventory ONT")
            #Check ont dashboard page
            getPositionByColsAndClickNext(self, "ont_inventory_div", {"sn": ontSNList[index]})
            time.sleep(3)
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_dev").text == dutName + " (" + dutIp + ")", f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_slotid").text == "Slot: " + ontSlotIDList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_portid").text == "Port: " + ontPortIDList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_ontid").text == "ONT: " + ontOntIDList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Admin Status") == "Active", f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Operation Status") == "IS", f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "SN") == ontSNList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Password") == ontPWList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Model") == ontModelList[index], f"Slot {ontSlotIDList[index]}, Port {ontPortIDList[index]}, Ont {ontOntIDList[index]}"
            #Check ip host
            if ontFlagList[index] == "xont":
                self.driver.find_element(By.LINK_TEXT, "Click").click()
                time.sleep(15)
                consolePList = []
                consolePElementList = self.driver.find_elements(By.XPATH, "//div[@id=\'exist_console\']/p")
                for consolePElement in consolePElementList:
                    consolePList.append(consolePElement.text)
                showIPHostStatusCmd = "show interface remote xont " + ontSlotIDList[index] + "-" + ontPortIDList[index] + "-" + ontOntIDList[index] + " ip-host status"
                showIPHostConfigCmd = "show interface remote xont " + ontSlotIDList[index] + "-" + ontPortIDList[index] + "-" + ontOntIDList[index] + " ip-host config" 
                with assume: assert showIPHostStatusCmd in consolePList[0]
                with assume: assert "AID : ont-" + ontSlotIDList[index] + "-" + ontPortIDList[index] + "-" + ontOntIDList[index] == consolePList[2] 
                with assume: assert "#" in consolePList[-15] 
                with assume: assert showIPHostConfigCmd in consolePList[-14]
                with assume: assert "AID : ont-" + ontSlotIDList[index] + "-" + ontPortIDList[index] + "-" + ontOntIDList[index] == consolePList[-12] 
                with assume: assert "#" in consolePList[-1] 
                self.driver.find_element(By.ID, "popupCallBack").click()
                time.sleep(3)
            self.driver.close()
            self.driver.switch_to.window(p)


    @pytest.mark.Icat
    def test_EMS1_5493_5498_deviceMap(self):
        (
            waitTime, uploadPath, downloadpath, browser, emsURL, emsVer, 
            emsUsr, emsPwd, node_name, dutName, dutIp, dutNodeName, 
            dutDesc, dutAdminName, dutAdminPwd, dutType, dutSet, dutGet, 
            dutSnmpVer, dutSnmp3Auth, dutSnmp3Hash, dutSnmp3Encrypt, dutAddr, dutSlotCount,
            dutAllCardID, dutAllCardPortID, cardTypeName, cardPortTypeName, cardPortTypeSpeed, 
            cardFwVersion, fwUploadName, fwUploadFileName,
            ontCount, ontSlotIDList, ontPortIDList, ontOntIDList, ontSNList, 
            ontPWList, ontModelList, ontTypeList, ontFlagList, exeUpgradeONT, 
            upgradeOntFW, upgradeOntFlag, upgradeOntModel, upgradeOntSlotID, 
            upgradeOntPortID, upgradeOntOntID,
            deviceStatusCount, ontStatusCount, alarmStatusCount, alarmStatus, 
            emsLink, dateFormat, timeZone
        ) = (
            self.waitTime, self.uploadPath, self.downloadpath, self.browser, self.emsURL, self.emsVer, 
            self.emsUsr, self.emsPwd, self.node_name, self.dutName, self.dutIp, self.dutNodeName, 
            self.dutDesc, self.dutAdminName, self.dutAdminPwd, self.dutType, self.dutSet, self.dutGet, 
            self.dutSnmpVer, self.dutSnmp3Auth, self.dutSnmp3Hash, self.dutSnmp3Encrypt, self.dutAddr, self.dutSlotCount,
            self.dutAllCardID, self.dutAllCardPortID, self.cardTypeName, self.cardPortTypeName, self.cardPortTypeSpeed, 
            self.cardFwVersion, self.fwUploadName, self.fwUploadFileName,
            self.ontCount, self.ontSlotIDList, self.ontPortIDList, self.ontOntIDList, self.ontSNList, 
            self.ontPWList, self.ontModelList, self.ontTypeList, self.ontFlagList, self.exeUpgradeONT, 
            self.upgradeOntFW, self.upgradeOntFlag, self.upgradeOntModel, self.upgradeOntSlotID, 
            self.upgradeOntPortID, self.upgradeOntOntID,
            self.deviceStatusCount, self.ontStatusCount, self.alarmStatusCount, self.alarmStatus, 
            self.emsLink, self.dateFormat, self.timeZone
        )        
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        #Connection test
        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + dutNodeName + "\')]").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_connection_test > a").click()
        time.sleep(10)
        self.driver.find_element(By.CSS_SELECTOR, ".ui-button-icon").click()
        self.driver.find_element(By.ID, "navside_icon").click()
        #Device panel not yet
        #HW status check
        self.driver.find_element(By.ID, "dashboard_hw_status_cpu_image").click()
        if self.driver.find_element(By.ID, "dashboard_hw_status_cpu_image").get_attribute("class") == "style_img icon_hwstatus_cpu_normal item_select":
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
        else:
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
        self.driver.find_element(By.ID, "dashboard_hw_status_memory_image").click()
        if self.driver.find_element(By.ID, "dashboard_hw_status_memory_image").get_attribute("class") == "style_img icon_hwstatus_memory_normal item_select":
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
        else:
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
        self.driver.find_element(By.ID, "dashboard_hw_status_fan_image").click()
        if self.driver.find_element(By.ID, "dashboard_hw_status_fan_image").get_attribute("class") == "style_img icon_hwstatus_fan_normal item_select":
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
        else:
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
        self.driver.find_element(By.ID, "dashboard_hw_status_temperature_image").click()
        if self.driver.find_element(By.ID, "dashboard_hw_status_temperature_image").get_attribute("class") == "style_img icon_hwstatus_temperature_normal item_select":
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
        else:
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
        self.driver.find_element(By.ID, "dashboard_hw_status_voltage_image").click()
        if self.driver.find_element(By.ID, "dashboard_hw_status_voltage_image").get_attribute("class") == "style_img icon_hwstatus_voltage_normal item_select":
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
        else:
            with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
        #Check ont each status number
        for status in range(1,ontStatusCount+1):
            self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[" + str(status) + "]/div[2]/a").click()
            statusTitle = self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[" + str(status) + "]/div[2]/a").text
            statusData = self.driver.find_element(By.ID, "table_total_data_Dev_ontStatusTable").text.strip("Total data:")
            with assume: assert statusTitle == statusData
        #Check click the inService ONT can switch to ont status page
        self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[1]/div[2]/a").click()
        for index in range(ontCount):
            time.sleep(3)
            entryPosition = getPositionByColsAndClickNext(self, "Dev_ontStatusTable", {"sn": ontSNList[index]})
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_dev").text == dutName + " (" + dutIp + ")"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_slotid").text == "Slot: " + ontSlotIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_portid").text == "Port: " + ontPortIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_ontid").text == "ONT: " + ontOntIDList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Admin Status") == "Active"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Operation Status") == "IS"
            with assume: assert getAttributeValue (self, "ontStatusTable", "SN") == ontSNList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Password") == ontPWList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Model") == ontModelList[index]
            self.driver.close()
            self.driver.switch_to.window(p)
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "Slot").text == ontSlotIDList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "Port").text == ontPortIDList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "ONT").text == ontOntIDList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "sn").text == ontSNList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "password").text == ontPWList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "model").text == ontModelList[index]            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "OntAdminState").text == "Active"            
            with assume: assert getElementByPositionCol(self, "Dev_ontStatusTable", entryPosition , "OntOperationStatus").text == "In Service"
        #Check alarm status
        totalAlarmCount = 0
        for status in range(2,alarmStatusCount+1):
            statusAlarmCount = int(self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[" + str(status) + "]/div[2]/a").text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text
        with assume: assert self.driver.find_element(By.ID, "date_now").text == datetime.now().strftime("%Y-%m-%d")
        self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").click()
        self.driver.find_element(By.ID, "dashboard_dev_alarm_card_more").click()
        time.sleep(3)
        p= self.driver.window_handles[0]
        c = waitNewWindowHandle(self)
        self.driver.switch_to.window(c)
        with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
        self.driver.close()
        self.driver.switch_to.window(p)
        elementScrolledIntoView(self, self.driver.find_element(By.LINK_TEXT, "Click here for more alarms..."))
        self.driver.find_element(By.LINK_TEXT, "Click here for more alarms...").click()
        time.sleep(3)
        c = waitNewWindowHandle(self)
        self.driver.switch_to.window(c)
        with assume: assert self.driver.find_element(By.ID, "alarm_activeTable").is_displayed()
        #Check the download file
        minTime = datetime.now()
        exportTableSnapshot = capture_table_and_export(self.driver, "alarm_activeTable")
        time.sleep(30)
        maxTime = datetime.now()
        files = glob.glob(os.path.join(downloadpath, "*.xls"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime
        assert_export_matches(latestFile, exportTableSnapshot, "Device Map Active Alarm")
        self.driver.close()
        self.driver.switch_to.window(p)
        #Check refresh function
        self.driver.find_element(By.ID, "navside_icon").click()
        elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//li[contains(.,\'" + dutNodeName + "\')]"))
        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + dutNodeName + "\')]").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        with assume: assert self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").is_displayed
        #Check polling function
        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + dutNodeName + "\')]").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_polling > a").click()
        self.driver.find_element(By.ID, "confirm_yes_button").click()
        time.sleep(3)
        with assume: assert waitMessageText(self) == "Success"
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(15)
        #Check alarm clear function
        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + dutNodeName + "\')]").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
        time.sleep(3)
        with assume: assert waitMessageText(self) == "Success."
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        assert self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text == "0"


    @pytest.mark.Icat
    def test_EMS1_5494_5495_cardMap(self):
        (
            waitTime, uploadPath, downloadpath, browser, emsURL, emsVer, 
            emsUsr, emsPwd, node_name, dutName, dutIp, dutNodeName, 
            dutDesc, dutAdminName, dutAdminPwd, dutType, dutSet, dutGet, 
            dutSnmpVer, dutSnmp3Auth, dutSnmp3Hash, dutSnmp3Encrypt, dutAddr, dutSlotCount,
            dutAllCardID, dutAllCardPortID, cardTypeName, cardPortTypeName, cardPortTypeSpeed, 
            cardFwVersion, fwUploadName, fwUploadFileName,
            ontCount, ontSlotIDList, ontPortIDList, ontOntIDList, ontSNList, 
            ontPWList, ontModelList, ontTypeList, ontFlagList, exeUpgradeONT, 
            upgradeOntFW, upgradeOntFlag, upgradeOntModel, upgradeOntSlotID, 
            upgradeOntPortID, upgradeOntOntID,
            deviceStatusCount, ontStatusCount, alarmStatusCount, alarmStatus, 
            emsLink, dateFormat, timeZone
        ) = (
            self.waitTime, self.uploadPath, self.downloadpath, self.browser, self.emsURL, self.emsVer, 
            self.emsUsr, self.emsPwd, self.node_name, self.dutName, self.dutIp, self.dutNodeName, 
            self.dutDesc, self.dutAdminName, self.dutAdminPwd, self.dutType, self.dutSet, self.dutGet, 
            self.dutSnmpVer, self.dutSnmp3Auth, self.dutSnmp3Hash, self.dutSnmp3Encrypt, self.dutAddr, self.dutSlotCount,
            self.dutAllCardID, self.dutAllCardPortID, self.cardTypeName, self.cardPortTypeName, self.cardPortTypeSpeed, 
            self.cardFwVersion, self.fwUploadName, self.fwUploadFileName,
            self.ontCount, self.ontSlotIDList, self.ontPortIDList, self.ontOntIDList, self.ontSNList, 
            self.ontPWList, self.ontModelList, self.ontTypeList, self.ontFlagList, self.exeUpgradeONT, 
            self.upgradeOntFW, self.upgradeOntFlag, self.upgradeOntModel, self.upgradeOntSlotID, 
            self.upgradeOntPortID, self.upgradeOntOntID,
            self.deviceStatusCount, self.ontStatusCount, self.alarmStatusCount, self.alarmStatus, 
            self.emsLink, self.dateFormat, self.timeZone
        )        
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        #Check the linecard display normally in tree panel
        for cardType in range(len(dutAllCardID)):
            if dutAllCardID[cardType] == "0" or dutAllCardID[cardType] == "--":
                continue
            expandElement = self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + dutNodeName + "\')]/span[contains(@class,\'expand-icon\')]")
            expandStatus = expandElement.get_attribute("class")
            if expandStatus == "icon expand-icon oi oi-plus":
                expandElement.click()
            dutNodeId = int(self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + dutNodeName + "\')]").get_attribute("data-nodeid"))
            cardNodeId = dutNodeId + int(dutAllCardID[cardType])
            with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(@data-nodeid,\'" + str(cardNodeId) + "\')]").text == dutAllCardID[cardType] + " - " + cardTypeName[cardType]
            self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(@data-nodeid,\'" + str(cardNodeId) + "\')]").click()
            WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.ID, "slotStatusTable")))
            time.sleep(3)
            #Check the card status
            with assume: assert cardFwVersion[cardType] in getAttributeValue (self, "slotStatusTable", "Boot up FW Version")
            #HW status check
            self.driver.find_element(By.ID, "dashboard_hw_status_cpu_image").click()
            if self.driver.find_element(By.ID, "dashboard_hw_status_cpu_image").get_attribute("class") == "style_img icon_hwstatus_cpu_normal item_select":
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
            else:
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
            self.driver.find_element(By.ID, "dashboard_hw_status_memory_image").click()
            if self.driver.find_element(By.ID, "dashboard_hw_status_memory_image").get_attribute("class") == "style_img icon_hwstatus_memory_normal item_select":
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
            else:
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
            self.driver.find_element(By.ID, "dashboard_hw_status_temperature_image").click()
            if self.driver.find_element(By.ID, "dashboard_hw_status_temperature_image").get_attribute("class") == "style_img icon_hwstatus_temperature_normal item_select":
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
            else:
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
            self.driver.find_element(By.ID, "dashboard_hw_status_voltage_image").click()
            if self.driver.find_element(By.ID, "dashboard_hw_status_voltage_image").get_attribute("class") == "style_img icon_hwstatus_voltage_normal item_select":
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text == "Normal"
            else:
                with assume: assert self.driver.find_element(By.CSS_SELECTOR, "#hw_warning > .dashboard-text-md").text != "Normal"
            #Check alarm status
            totalAlarmCount = 0
            for status in range(2,alarmStatusCount+1):
                statusAlarmCount = int(self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[" + str(status) + "]/div[2]/a").text)
                totalAlarmCount += statusAlarmCount
            with assume: assert str(totalAlarmCount) == self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text
            with assume: assert self.driver.find_element(By.ID, "date_now").text == datetime.now().strftime("%Y-%m-%d")
            self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").click()
            self.driver.find_element(By.LINK_TEXT, "more...").click()
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
