    @pytest.mark.Unicase
    def test_EMS1_3471_changePassword(self):
        deselectAllPasswordRule (self)
        kickUsr(self, "PyUser")
        newEMSUsr (self, "PyUser", "PyUserPWD", "ReadWrite", "Global")
        logoutEMS (self)
        loginEMS (self, "PyUser","PyUserPWD")
        time.sleep(3)
        with assume: self.driver.find_element(By.ID, "index_t_userName").text == "PyUser"
        self.driver.find_element(By.ID, "index_t_userName").click()
        self.driver.find_element(By.ID, "index_change_password").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "index_old_password").send_keys("1234")
        self.driver.find_element(By.ID, "index_new_password").send_keys("123456789")
        self.driver.find_element(By.ID, "index_confirm_new_password").send_keys("0123456789")
        self.driver.find_element(By.CSS_SELECTOR, "#change_password_diag .button_green").click()
        time.sleep(3)
        with assume: assert waitMessageText(self) == "Old password is wrong."
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "index_old_password").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "index_old_password").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "index_old_password").send_keys("PyUserPWD")
        self.driver.find_element(By.ID, "index_new_password").send_keys("123456789")
        self.driver.find_element(By.ID, "index_confirm_new_password").send_keys("0123456789**")
        self.driver.find_element(By.CSS_SELECTOR, "#change_password_diag .button_green").click()
        time.sleep(3)
        with assume: assert waitMessageText(self) == "The password and confirm password are different."
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "index_new_password").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "index_new_password").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "index_new_password").send_keys("0123456789**")
        self.driver.find_element(By.ID, "index_confirm_new_password").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "index_confirm_new_password").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "index_confirm_new_password").send_keys("0123456789**")
        self.driver.find_element(By.CSS_SELECTOR, "#change_password_diag .button_green").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        logoutEMS (self)
        loginEMS (self, "PyUser","PyUserPWD")
        time.sleep(3)
        with assume: assert waitMessageText(self) == "Login fail.\ninvalid password."
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        loginEMS (self, "PyUser","0123456789**")
        with assume: self.driver.find_element(By.ID, "index_t_userName").text == "PyUser"
        logoutEMS (self)
        time.sleep(3)
        loginEMS(self, self.emsUsr, self.emsPwd)


