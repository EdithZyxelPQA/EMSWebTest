    # Inventory / Ont
    @pytest.mark.Unicase
    def test_EMS1_4507_4510_ontInfo(self):
        self.driver.find_element(By.LINK_TEXT, "Inventory").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "ONT").click()
        time.sleep(3)
        for index in range(self.ontCount):
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            self.driver.find_element(By.ID, "inventory_allont_clear_btn").click()
            self.driver.find_element(By.ID, "ip_Allont").send_keys(self.dutIp)
            self.driver.find_element(By.ID, "slot_Allont").send_keys(self.ontSlotIDList[index])
            self.driver.find_element(By.ID, "port_Allont").send_keys(self.ontPortIDList[index])
            self.driver.find_element(By.ID, "ontid_Allont").send_keys(self.ontOntIDList[index])
            self.driver.find_element(By.ID, "inventory_allont_btn").click()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
            entryPosition = [1,1]
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS", f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName, f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp, f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "Slot").text == self.ontSlotIDList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "Port").text == self.ontPortIDList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "ONT").text == self.ontOntIDList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.ontSNList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.ontPWList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "model").text == self.ontModelList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "OntAdminState").text == "Active", f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "OntOperationStatus").text == "In Service", f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "txPower").text != "--", f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "rxPower").text != "--", f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "ONTType").text == self.ontTypeList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            time.sleep(3)
            minTime = datetime.now()
            inventoryOntSnapshot = capture_table_and_export(
                self.driver, "ont_inventory_div"
            )
            time.sleep(20)
            maxTime = datetime.now()
            #Check the download file
            files = glob.glob(os.path.join(self.downloadpath, "*.xls"))
            latestFile = max(files, key=os.path.getmtime)
            latestFileSize = os.path.getsize(latestFile)
            latestFileTimeFloat = os.path.getmtime(latestFile)
            latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
            with assume: assert latestFileSize > 0
            with assume: assert minTime <= latestFileTime <= maxTime
            assert_export_matches(
                latestFile, inventoryOntSnapshot, "Inventory ONT"
            )
            #Check ont dashboard page
            getPositionByColsAndClickNext(self, "ont_inventory_div", {"sn": self.ontSNList[index]})
            time.sleep(3)
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_dev").text == self.dutName + " (" + self.dutIp + ")", f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_slotid").text == "Slot: " + self.ontSlotIDList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_portid").text == "Port: " + self.ontPortIDList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_ontid").text == "ONT: " + self.ontOntIDList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Admin Status") == "Active", f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Operation Status") == "IS", f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "SN") == self.ontSNList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Password") == self.ontPWList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Model") == self.ontModelList[index], f"Slot {self.ontSlotIDList[index]}, Port {self.ontPortIDList[index]}, Ont {self.ontOntIDList[index]}"
            #Check ip host
            if self.ontFlagList[index] == "xont":
                self.driver.find_element(By.LINK_TEXT, "Click").click()
                time.sleep(15)
                consolePList = []
                consolePElementList = self.driver.find_elements(By.XPATH, "//div[@id=\'exist_console\']/p")
                for consolePElement in consolePElementList:
                    consolePList.append(consolePElement.text)
                showIPHostStatusCmd = "show interface remote xont " + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index] + " ip-host status"
                showIPHostConfigCmd = "show interface remote xont " + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index] + " ip-host config" 
                with assume: assert showIPHostStatusCmd in consolePList[0]
                with assume: assert "AID : ont-" + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index] == consolePList[2] 
                with assume: assert "#" in consolePList[-15] 
                with assume: assert showIPHostConfigCmd in consolePList[-14]
                with assume: assert "AID : ont-" + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index] == consolePList[-12]
                with assume: assert "#" in consolePList[-1] 
                self.driver.find_element(By.ID, "popupCallBack").click()
                time.sleep(3)
            self.driver.close()
            self.driver.switch_to.window(p)


    # Inventory / Ont / Status
    @pytest.mark.Unicase
    def test_EMS1_7099_statusOntTest(self):
        self.driver.find_element(By.LINK_TEXT, "Inventory").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "ONT").click()
        time.sleep(3)
        for index in range(self.ontCount):
            slotID = self.ontSlotIDList[index]
            portID = self.ontPortIDList[index]
            ontID = self.ontOntIDList[index]
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            self.driver.find_element(By.ID, "inventory_allont_clear_btn").click()
            self.driver.find_element(By.ID, "ip_Allont").send_keys(self.dutIp)
            self.driver.find_element(By.ID, "slot_Allont").send_keys(self.ontSlotIDList[index])
            self.driver.find_element(By.ID, "port_Allont").send_keys(self.ontPortIDList[index])
            self.driver.find_element(By.ID, "ontid_Allont").send_keys(self.ontOntIDList[index])
            self.driver.find_element(By.ID, "inventory_allont_btn").click()
            time.sleep(3)
            entryPosition = [1,1]
            getElementByPositionCol(self, "ont_inventory_div", entryPosition , "Information").click()
            time.sleep(20)
            match self.ontFlagList[index]:
                case "xont":
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " ddmi current") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " counter") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " pm-counter current") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " fdb address-table") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " wan-status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " wifi-status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " video status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " acl-service") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " igmp-mld group") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " ip-host status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote xont " + slotID + "-" + portID + "-" + ontID + " pppoe statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                case "ont-14":
                    with assume: assert ("show remote ont ont-" + portID + "-" + ontID) in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interfaces transceiver ont-" + portID + "-" + ontID) in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show remote ont ont-" + portID + "-" + ontID + " counter") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show remote ont ont-" + portID + "-" + ontID + " ontWan-status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show remote ont ont-" + portID + "-" + ontID + " ontWifi status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show remote ont ont-" + portID + "-" + ontID + " video status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show remote ont ont-" + portID + "-" + ontID + " acl-service") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                case "ont":
                    with assume: assert ("show interface remote ont " + slotID + "-" + portID + "-" + ontID + " status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote ont " + slotID + "-" + portID + "-" + ontID + " ddmi current") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote ont " + slotID + "-" + portID + "-" + ontID + " counter") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote ont " + slotID + "-" + portID + "-" + ontID + " ontWan-status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote ont " + slotID + "-" + portID + "-" + ontID + " ontWifi status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote ont " + slotID + "-" + portID + "-" + ontID + " video status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface remote ont " + slotID + "-" + portID + "-" + ontID + " acl-service") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
