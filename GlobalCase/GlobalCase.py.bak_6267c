                        with assume: assert ("show interface nni " + portID + " ddmi status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface nni " + portID + " statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show interface nni " + portID + " performance current") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                        with assume: assert ("show fdb address-table sort-option mac port " + portID) in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
