    @pytest.mark.Unicase
    def test_EMS1_3675_3508_alarmHistory(self):
        self.driver.find_element(By.LINK_TEXT, "Alarm").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "History").click()
        totalAlarmCount = 0
        for status in range(1, self.alarmStatusCount):
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.ID, "alarm_total").text
        for status in range(self.alarmStatusCount):
            self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).click()
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).text)
            strLastPageNumber = self.driver.find_element(By.CSS_SELECTOR, "#alarm_historyAlarmTable > div.pagination > a.last").get_attribute("href")
            lastPageNumber = int(strLastPageNumber.replace(self.emsLink,""))
            expectPageCount = (statusAlarmCount//100 + 1)
            if statusAlarmCount%100 == 0 and statusAlarmCount != 0:
                expectPageCount = expectPageCount - 1
            with assume: assert lastPageNumber == expectPageCount
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
        self.driver.find_element(By.ID, "fault_history_clear_btn").click()
        self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .arrow").click()
        self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .collapsed").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
        self.driver.find_element(By.ID, "fault_history_btn").click()
        #Check the download file
        minTime = datetime.now()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_export > a").click()
        time.sleep(30)
        maxTime = datetime.now()
        files = glob.glob(os.path.join(self.downloadpath, "*.xls"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime
        totalAlarmCount = 0
        for status in range(1, self.alarmStatusCount):
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.ID, "alarm_total").text


