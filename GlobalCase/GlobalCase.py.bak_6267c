    # Maintenance / Schedule / Card Reboot
    @pytest.mark.asyncio
    @pytest.mark.Unicase
    async def test_EMS1_6381_RebootCard(self):
        if self.dutSlotCount == "0": return
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Schedule").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
        time.sleep(3)
        Select(self.driver.find_element(By.ID, "schedule_type")).select_by_visible_text("Device reboot")
        time.sleep(3)
        self.driver.find_element(By.ID, "schedule_name").click()
        exeTime = (datetime.now()).strftime("%Y-%m-%d_%H:%M:%S")
        scheduleName = "$py_" + exeTime
        setScheduleName(self, scheduleName)
        self.driver.find_element(By.XPATH, "//label[contains(.,\'Immediately\')]").click()
        self.driver.find_element(By.XPATH, "//span[contains(.,\'Card\')]").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
        if self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]/preceding-sibling::div").get_attribute("class")=="arrow collapsed":
            self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
        nodeRel = self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]/..").get_attribute("rel")
        exeCardList = []
        for cardID in self.dutAllCardID:
            if cardID == "0":
                continue
            self.driver.find_element(By.XPATH, "//li[@rel=\'" + nodeRel + " - " + cardID + "\']/label").click()
            exeCardList.append(cardID)
        self.driver.find_element(By.XPATH, "//input[@value=\'Save\']").click()
        time.sleep(3)
        with assume: assert "is Not Support Slot Reboot." in waitMessageText(self) 
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        for ind,cardName in enumerate(self.cardTypeName):
            if ("MSC" in cardName or "NXC" in cardName) and self.dutAllCardID[ind]!= "0":
                self.driver.find_element(By.XPATH, "//li[@rel=\'" + nodeRel + " - " + self.dutAllCardID[ind] + "\']/label").click()
                exeCardList.remove(self.dutAllCardID[ind])
        exeCardList.sort()
        self.driver.find_element(By.XPATH, "//input[@value=\'Save\']").click()
        time.sleep(3)
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        waitScheduleSuccess (self, entryPosition)
        time.sleep(30)
        #Maintanence table detail 1 assert
        openScheduleResult(self, entryPosition)
        time.sleep(3)
        with assume: assert getScheduleResultByCol (self, "Index") == "1"
        with assume: assert getScheduleResultByCol (self, "Schedule Name") == scheduleName
        scheduleTime = getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleTime").text.removesuffix(self.timeZone) 
        minTime = datetime.strptime(scheduleTime, self.dateFormat)
        maxTime = minTime + timedelta(seconds = 600)
        with assume: assert minTime <= datetime.strptime(getScheduleResultByCol (self, "Execute Time").removesuffix(self.timeZone) , self.dateFormat) <= maxTime
        resultSummary = getScheduleResultByCol (self, "Result Summary")
        resultSummaryList = resultSummary.split(",")
        resultSummaryList = [re.sub(r"^.*:", "", i,flags = re.DOTALL) for i in resultSummaryList]
        with assume: assert int(resultSummaryList[0]) >= 0
        with assume: assert int(resultSummaryList[1]) == 0
        #Maintanence table detail 2 assert
        detailScheduleNameList = getScheduleResultDetailListByCol (self, "ScheduleName")
        detailExecuteDateList = getScheduleResultDetailListByCol (self, "Date")
        detailDeviceNameList = getScheduleResultDetailListByCol (self, "DeviceName")
        detailSlotList = getScheduleResultDetailListByCol (self, "SlotID")
        detailPortList = getScheduleResultDetailListByCol (self, "PortID")
        detailONTList = getScheduleResultDetailListByCol (self, "OntID")
        detailResultList = getScheduleResultDetailListByCol (self, "Result ")
        detailCauseList = getScheduleResultDetailListByCol (self, "Cause ")
        with assume: assert checkAllElementInListAre (detailScheduleNameList, scheduleName)
        with assume: assert checkAllElementInListPartialMatch (detailExecuteDateList, scheduleTime)
        with assume: assert checkAllElementInListAre (detailDeviceNameList, self.dutName)
        with assume: assert detailSlotList == exeCardList
        with assume: assert checkAllElementInListAre (detailPortList, "--")
        with assume: assert checkAllElementInListAre (detailONTList, "--")
        with assume: assert checkAllElementInListAre (detailResultList, "Success")
        with assume: assert checkAllElementInListPartialMatch (detailCauseList, "Success")
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        #Maintanence table summary assert
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleStatus").text == "Finish"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Type").text == "Reboot"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleType").text == "Immediately"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Result_Hyperlink").text == "Success"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Toggletype").text == "Slot"
        time.sleep(300)
        # Telent to Device check the card up time
        for ind,cardID in enumerate(self.dutAllCardID):
            if (cardID == "0") or ("MSC" in self.cardTypeName[ind]) or ("NXC" in self.cardTypeName[ind]):
                continue
            with assume: assert await checkSystemUptime(self.dutIp, self.dutAdminName, self.dutAdminPwd, cardID) <= 1800


    # Maintenance / Schedule / Port Reboot
    @pytest.mark.asyncio
    @pytest.mark.Unicase
    @pytest.mark.skip
    async def test_EMS1_6382_RebootPort(self):
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Schedule").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
        time.sleep(3)
        Select(self.driver.find_element(By.ID, "schedule_type")).select_by_visible_text("Device reboot")
        time.sleep(3)
        self.driver.find_element(By.ID, "schedule_name").click()
        exeTime = (datetime.now()).strftime("%Y-%m-%d_%H:%M:%S")
        scheduleName = "$py_" + exeTime
        setScheduleName(self, scheduleName)
        self.driver.find_element(By.XPATH, "//label[contains(.,\'Immediately\')]").click()
        self.driver.find_element(By.XPATH, "//span[contains(.,\'Port\')]").click()
        emsArrow = self.driver.find_element(By.XPATH, "//ul[@id=\'tree\']/ul/li/div")
        if emsArrow.get_attribute("class") == "arrow collapsed":
            emsArrow.click()
        exePortList = []
        nodeRel = self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]/..").get_attribute("rel")
        dutDevArrow = self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]/preceding-sibling::div")
        if dutDevArrow.get_attribute("class") == "arrow collapsed":
            dutDevArrow.location_once_scrolled_into_view
            dutDevArrow.click()
        for ind,cardID in enumerate(self.dutAllCardID):
            if cardID == "0":
                continue
            if cardID == "--":
                self.driver.find_element(By.XPATH, "//li[@rel=\'" + nodeRel + "\']/ul/li[" + self.dutAllCardPortID[ind] + "]/label").click()
            else:
                dutCardArrow = self.driver.find_element(By.XPATH, "//li[@rel=\'" + nodeRel + " - " + cardID + "\']/div")
                if dutCardArrow.get_attribute("class")=="arrow collapsed":
                    dutCardArrow.location_once_scrolled_into_view
                    dutCardArrow.click()
                self.driver.find_element(By.XPATH, "//li[@rel=\'" + nodeRel + " - " + cardID + " - " + self.dutAllCardPortID[ind] + "\']/label").click()
            exePortList.append([cardID, self.dutAllCardPortID[ind]])
        exePortListSort = sorted(exePortList, key=lambda x: x[0])
        self.driver.find_element(By.XPATH, "//input[@value=\'Save\']").click()
        time.sleep(3)
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        waitScheduleSuccess (self, entryPosition)
        time.sleep(30)
        #Maintanence table detail 1 assert
        openScheduleResult(self, entryPosition)
        time.sleep(3)
        with assume: assert getScheduleResultByCol (self, "Index") == "1"
        with assume: assert getScheduleResultByCol (self, "Schedule Name") == scheduleName
        scheduleTime = getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleTime").text.removesuffix(self.timeZone) 
        minTime = datetime.strptime(scheduleTime, self.dateFormat)
        maxTime = minTime + timedelta(seconds = 600)
        with assume: assert minTime <= datetime.strptime(getScheduleResultByCol (self, "Execute Time").removesuffix(self.timeZone) , self.dateFormat) <= maxTime
        resultSummary = getScheduleResultByCol (self, "Result Summary")
        resultSummaryList = resultSummary.split(",")
        resultSummaryList = [re.sub(r"^.*:", "", i,flags = re.DOTALL) for i in resultSummaryList]
        with assume: assert int(resultSummaryList[0]) >= 0
        with assume: assert int(resultSummaryList[1]) == 0
        #Maintanence table detail 2 assert
        detailScheduleNameList = getScheduleResultDetailListByCol (self, "ScheduleName")
        detailExecuteDateList = getScheduleResultDetailListByCol (self, "Date")
        detailDeviceNameList = getScheduleResultDetailListByCol (self, "DeviceName")
        detailSlotList = getScheduleResultDetailListByCol (self, "SlotID")
        detailPortList = getScheduleResultDetailListByCol (self, "PortID")
        detailONTList = getScheduleResultDetailListByCol (self, "OntID")
        detailResultList = getScheduleResultDetailListByCol (self, "Result ")
        detailCauseList = getScheduleResultDetailListByCol (self, "Cause ")
        with assume: assert checkAllElementInListAre (detailScheduleNameList, scheduleName)
        with assume: assert checkAllElementInListPartialMatch (detailExecuteDateList, scheduleTime)
        with assume: assert checkAllElementInListAre (detailDeviceNameList, self.dutName)
        if "OLT" not in self.dutType:
            with assume: assert detailSlotList == [i[0]for i in exePortListSort]
            with assume: assert detailPortList == [i[1]for i in exePortListSort]
        with assume: assert checkAllElementInListAre (detailONTList, "--")
        with assume: assert checkAllElementInListAre (detailResultList, "Success")
        with assume: assert checkAllElementInListPartialMatch (detailCauseList, "Success")
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        #Maintanence table summary assert
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleStatus").text == "Finish"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Type").text == "Reboot"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleType").text == "Immediately"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Result_Hyperlink").text == "Success"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Toggletype").text == "Port"


