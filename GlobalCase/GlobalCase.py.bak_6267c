    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5663_ontOntPrfModify(self):
        if self.exeServiceOnt == "": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        #Modify ONT ONT Profile: "$py_ONTONT"
        modifyProfile (self, "ONT ONT Profile", "$py_ONTONT")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_lcmp_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_lcmp_combobox")).select_by_visible_text("LAN and WAN")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_ftp_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_ftp_combobox")).select_by_visible_text("LAN and WAN")
        self.driver.find_element(By.ID, "ont_ont_ftpport_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_ont_ftpport_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_ont_ftpport_text").send_keys("21")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_http_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_http_combobox")).select_by_visible_text("Disable")
        self.driver.find_element(By.ID, "ont_ont_httpport_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_ont_httpport_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_ont_httpport_text").send_keys("80")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_https_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_https_combobox")).select_by_visible_text("LAN and WAN")
        self.driver.find_element(By.ID, "ont_ont_httpsport_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_ont_httpsport_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_ont_httpsport_text").send_keys("443")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_snmp_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_snmp_combobox")).select_by_visible_text("Disable")
        self.driver.find_element(By.ID, "ont_ont_snmpport_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_ont_snmpport_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_ont_snmpport_text").send_keys("161")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_telnet_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_telnet_combobox")).select_by_visible_text("LAN and WAN")
        self.driver.find_element(By.ID, "ont_ont_telnetport_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_ont_telnetport_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_ont_telnetport_text").send_keys("23")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_ssh_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_ssh_combobox")).select_by_visible_text("LAN and WAN")
        self.driver.find_element(By.ID, "ont_ont_sshport_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_ont_sshport_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_ont_sshport_text").send_keys("22")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_firewall_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_firewall_combobox")).select_by_visible_text("IPv4")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_firewalllevel_combobox"))
        Select(self.driver.find_element(By.ID, "ont_ont_firewalllevel_combobox")).select_by_visible_text("Medium")
        elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_dmzip_text"))
        self.driver.find_element(By.ID, "ont_ont_dmzip_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_ont_dmzip_text").send_keys(Keys.DELETE)
