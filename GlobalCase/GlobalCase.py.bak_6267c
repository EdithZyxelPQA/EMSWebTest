                subpageList = ["parameter_system", "parameter_ftp", "parameter_rddn_svr"]
                for subpage in subpageList:
                    self.driver.find_element(By.ID, subpage).click()
                    time.sleep(3)
                    if subpage == "parameter_system": elementXpathList = ["//*[@id=\"systme_test_button\"]", "//*[@id=\"systme_save_button\"]"]
                    elif subpage == "parameter_ftp": elementXpathList = ["//*[@id=\"ftp_test_button\"]", "//*[@id=\"ftp_save_button\"]"]
                    else: elementXpathList = ["//*[@id=\"ftp_test_button\"]", "//*[@id=\"rddnsvr_save_button\"]"]
                    for elementXpath in elementXpathList:
                        with assume: assert "hidden" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                continue
            elif page == "Server Monitor": elementXpathList = ["//*[@id=\"tab_content_System_Monitor\"]/div/div/div[1]/div[2]/div[3]"]
            elif page == "Alarm Notification":
                try:
                    self.driver.find_element(By.XPATH, "//*[@id=\"alarm_noti_btn\"]")
                    with assume: assert True, f"{page}"
                except NoSuchElementException:
                    with assume: assert False, f"{page}"
                continue   
            elif page == "EMS Database Backup/Restore":
                elementXpathList = ["//*[@id=\"sys_dbbackup_conf_btn\"]", "//*[@id=\"sys_dbbackup_restore_function_btn\"]", "//*[@id=\"sys_dbbackup_delete_btn\"]"]
                for elementXpath in elementXpathList:
                    with assume: assert "hidden" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                continue
            elif page == "System Storage":
                subpageList = ["Alarm Purge", "Access Log Purge"]
                for subpage in subpageList:
                    self.driver.find_element(By.LINK_TEXT, subpage).click()
                    time.sleep(3)
                    if subpage == "Alarm Purge": elementXpathList = ["//*[@id=\"sys_alarmpurge_save_btn\"]", "//*[@id=\"Download_button\"]"]
                    if subpage == "Access Log Purge": elementXpathList = ["//*[@id=\"sys_accesslogpurge_save_btn\"]", "//*[@id=\"Download_button\"]"]
                    for elementXpath in elementXpathList:
                        with assume: assert "hidden" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                continue
            if page in ["Maintenance", "Schedule", "Firmware File Management", "Default Setting", "Alarm Template", "Alarm Filter", "Alarm Action"]:
                elementXpathList = ["//*[@id=\"i_action_create_collector\"]", "//*[@id=\"i_action_delete\"]"]
            elif page in ["Result Log", "Task", "Online User"]:
                elementXpathList = ["//*[@id=\"i_action_delete\"]"]
            for elementXpath in elementXpathList:
                with assume : assert "block" in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"


    # System/ Security/ User
    @pytest.mark.Unicase
    def test_EMS1_4029_6305_usrNodePermission(self):
        def first_page_alarm_columns(table_id):
            if pageCurrent(self, table_id) != 1:
                self.driver.find_element(By.CSS_SELECTOR, "#" + table_id + " .first").click()
                WebDriverWait(self.driver, 15).until(lambda _: pageCurrent(self, table_id) == 1)
            headers = self.driver.find_elements(By.XPATH, "//table[@id='" + table_id + "_head']/thead/tr/th")
            names = [header.get_attribute("name") for header in headers]
            columns = {}
            for name in ("DevName", "DevIP"):
                column = names.index(name) + 1
                columns[name] = [cell.text for cell in self.driver.find_elements(
                    By.XPATH, "//table[@id='" + table_id + "_body']/tbody/tr/td[" + str(column) + "]"
                )]
            return columns["DevName"], columns["DevIP"]

        usrName = "usrNodePermitFunction"
        usrPwd = "usrNodePermitFunction123**"
        kickUsr(self, usrName)
        delEMSUsr (self, usrName)
        time.sleep (3)
        newEMSUsr (self, usrName, usrPwd, "ReadWrite", "Global", [self.dutName])
        time.sleep (3)
        logoutEMS (self)
        time.sleep (3)
        loginEMS (self, usrName, usrPwd)
        time.sleep (3)
        with assume: assert self.driver.find_element(By.ID, "index_t_userName").text == usrName
        time.sleep (3)
        # Disable notifications for the test account before checking node permissions.
        for menu in ("System", "System Properties", "Alarm Notification"):
            WebDriverWait(self.driver, 15).until(
                EC.element_to_be_clickable((By.LINK_TEXT, menu))
            ).click()
        notification_ids = ("enable_sound", "notify_Critical", "notify_Major", "notify_Minor", "notify_Info")
        for field_id in notification_ids:
            field = WebDriverWait(self.driver, 15).until(
                EC.visibility_of_element_located((By.ID, field_id))
            )
            Select(field).select_by_visible_text("OFF")
        self.driver.find_element(By.ID, "alarm_noti_btn").click()
        WebDriverWait(self.driver, 15).until(
            EC.element_to_be_clickable((By.CSS_SELECTOR, "#message_diag .button"))
        ).click()
        WebDriverWait(self.driver, 15).until(
            EC.invisibility_of_element_located((By.ID, "message_diag"))
        )
        for field_id in notification_ids:
            with assume: assert Select(self.driver.find_element(By.ID, field_id)).first_selected_option.text == "OFF"
        #Check account node permission state in every page
        pageList = ["Dashboard", "Map", "Alarm", "Inventory", "Device", "Card", "Port", "All Ports", "Network Port", "Ethernet Access Port", "GPON Port", "xPON Port", "ONT"
                    , "Performance", "Maintenance", "Schedule", "Provision", "Service", "Profile", "Configuration", "Script", "Script", "Default Setting"
                    , "System", "Security", "User", "Region", "Group", "Map Management", "Fault", "Alarm Filter", "Alarm Action"]
        for page in pageList:
            self.driver.find_element(By.LINK_TEXT, page).click()
            time.sleep(3)
            match page:
                case "Dashboard":
                    entryPosition = [1,1]
                    with assume: assert self.driver.find_element(By.XPATH, "//div[@id=\'devStatus\']/div[1]/div[2]/a").text == "1"
                    with assume: assert totalData (self, "All_devStatusTable") == 1
                    with assume: assert getElementByPositionCol (self, "All_devStatusTable", entryPosition , "IPAddress").text == self.dutIp
                    with assume: assert getElementByPositionCol (self, "All_devStatusTable", entryPosition , "DevName").text == self.dutName
                    time.sleep(3)
                    self.driver.find_element(By.ID, "dashboard_all_alarm_card_more").click()
                    time.sleep(3)
                    p= self.driver.window_handles[0]
                    c = waitNewWindowHandle(self)
                    self.driver.switch_to.window(c)
                    time.sleep(3)
                    if tableIsEmpty (self, "alarm_activeTable") == False:
                        deviceNameList, deviceIpList = first_page_alarm_columns("alarm_activeTable")
                        with assume: assert all(i == self.dutName or i == "EMS" for i in deviceNameList)
                        with assume: assert all(i == self.dutIp or i == "" for i in deviceIpList)
                    self.driver.close()
                    self.driver.switch_to.window(p)
                case "Map":
                    self.driver.find_element(By.ID, "navside_icon").click()
                    time.sleep(3)
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"navMenuTree\"]/ul/li")
                    with assume: assert len(nodeList) == 2
                case "Alarm":
                    subPageList = ["Active", "History"]
                    alarmTableList = ["alarm_activeAlarmTable", "alarm_historyAlarmTable"]
                    for ind, subPage in enumerate(subPageList):
                        self.driver.find_element(By.LINK_TEXT, subPage).click()
                        time.sleep(3)
                        if tableIsEmpty (self, alarmTableList[ind]) == False:
                            deviceNameList, deviceIpList = first_page_alarm_columns(alarmTableList[ind])
                            #with assume: assert all(i == self.dutName or i == "EMS" for i in deviceNameList)
                            with assume: assert all(i == self.dutIp or i == "" for i in deviceIpList)
                case "Device":
                    entryPosition = [1,1]
                    with assume: assert totalData (self, "dev_inventory_div") == 1
                    with assume: assert getElementByPositionCol (self, "dev_inventory_div", entryPosition , "DevName").text == self.dutName
                    with assume: assert getElementByPositionCol (self, "dev_inventory_div", entryPosition , "IPAddress").text == self.dutIp
                case "Card":
                    with assume: assert self.dutSlotCount == str(totalData (self, "card_inventory_div"))
                case "All Ports"|"Network Port":
                    deviceNameList = getListByCol(self, "port_inventory_div", "DevName")
                    deviceIpList = getListByCol(self, "port_inventory_div", "IPAddress")
                    with assume: assert all(i == self.dutName or i == "EMS" for i in deviceNameList)
                    with assume: assert all(i == self.dutIp or i == "" for i in deviceIpList)
                case "Ethernet Access Port"|"GPON Port"|"xPON Port":
                    if tableIsEmpty (self, "port_inventory_div") == False:
                        deviceNameList = getListByCol(self, "port_inventory_div", "DevName")
                        deviceIpList = getListByCol(self, "port_inventory_div", "IPAddress")
                        with assume: assert all(i == self.dutName or i == "EMS" for i in deviceNameList)
                        with assume: assert all(i == self.dutIp or i == "" for i in deviceIpList)
                case "ONT":
                    if tableIsEmpty (self, "ont_inventory_div") == False:
                        deviceNameList = getListByCol(self, "ont_inventory_div", "DevName")
                        deviceIpList = getListByCol(self, "ont_inventory_div", "IPAddress")
                        with assume: assert all(i == self.dutName or i == "EMS" for i in deviceNameList)
                        with assume: assert all(i == self.dutIp or i == "" for i in deviceIpList)
                case "Performance":
                    subPageList = ["Current", "History"]
                    for ind, subPage in enumerate(subPageList):
                        self.driver.find_element(By.LINK_TEXT, subPage).click()
                        time.sleep(3)
                        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_demand > a").click()
                        time.sleep(3)
                        perfTypeElementList = self.driver.find_elements(By.XPATH, "//select[@id=\'create_performance_select\']/option")
                        perfTypeList = [perfTypeElement.text for perfTypeElement in perfTypeElementList]
                        for perfType in perfTypeList:
                            Select(self.driver.find_element(By.ID, "create_performance_select")).select_by_visible_text(perfType)
                            time.sleep (3)
                            if self.driver.find_element(By.XPATH, "//*[@id=\"tree_demand\"]/ul/li/div[1]").get_attribute("className") == "arrow collapsed":
                                self.driver.find_element(By.XPATH, "//*[@id=\"tree_demand\"]/ul/li/div[1]").click()
                                time.sleep (3)
                            nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"tree_demand\"]/ul/li/ul/li")
                            with assume: assert len(nodeList) == 1
                    time.sleep(3)
                case "Schedule":
                    self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
                    time.sleep(3)
                    scheduleTypeElementList = self.driver.find_elements(By.XPATH, "//select[@id=\'schedule_type\']/option")
                    scheduleTypeList = [scheduleTypeElement.text for scheduleTypeElement in scheduleTypeElementList]
                    for scheduleType in scheduleTypeList:
                        Select(self.driver.find_element(By.ID, "schedule_type")).select_by_visible_text(scheduleType)
                        time.sleep (3)
                        match scheduleType:
                            case "Configuration backup"|"Device reboot":
                                nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"tree\"]/ul/li/ul/li")
                                with assume: assert len(nodeList) == 1
                            case "Configuration restore":
                                self.driver.find_element(By.XPATH, "//input[@type=\'image\']").click()
                                Select(self.driver.find_element(By.ID, "devtype")).select_by_visible_text(self.dutType)
                                nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"tree\"]/ul/li/ul/li/ul/li")
                                with assume: assert len(nodeList) == 1 
                            case "Firmware upgrade":
                                self.driver.find_element(By.ID, "add_row").click()
                                elementScrolledIntoView(self, self.driver.find_element(By.ID, "devtype"))
                                Select(self.driver.find_element(By.ID, "devtype")).select_by_visible_text(self.dutType)
                                nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"tree\"]/ul/li/ul/li")
                                with assume: assert len(nodeList) == 1
                            case "ONT firmware upgrade"|"ONT reboot"|"ONT configure default":
                                self.driver.find_element(By.ID, "add_row").click()
                                nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"tree\"]/ul/li/ul/li")
                                with assume: assert len(nodeList) == 1
                case "Configuration":
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"navMenuTree\"]/ul/li")
                    with assume: assert len(nodeList) == 2
                case "Script":
                    defaultTagList = ["IES42XX Series", "IES52XX Series", "NeoX Series", "OLT14XX Series"]
                    scriptName = "$py_UsrPermit"
                    createScriptSelectTag (self, scriptName, "show system", defaultTagList)
                    entryPosition = getPositionByCol(self, "script_table", "Name", scriptName)
                    getElementByPositionCol(self, "script_table", entryPosition , "Checkbox").find_element(By.TAG_NAME, "label").location_once_scrolled_into_view
                    getElementByPositionCol(self, "script_table", entryPosition , "Checkbox").find_element(By.TAG_NAME, "label").click()
                    self.driver.find_element(By.CSS_SELECTOR, "#i_action_applytodev > a").click()
                    time.sleep (3)
                    self.driver.find_element(By.XPATH, "//*[@id=\"apply_script_background\"]/div[1]/div[4]/div[2]/div[2]/input[1]").click()
                    time.sleep (3)
                    self.driver.find_element(By.XPATH, "//*[@id=\"tree\"]/ul/li/div[1]").click()
                    time.sleep (3)
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"tree\"]/ul/li/ul/li")
                    with assume: assert len(nodeList) == 1
                    self.driver.find_element(By.XPATH, "//*[@id=\"selectNode\"]/div/div/div[1]/button").click()
                    time.sleep (3)
                case "Default Setting":
                    self.driver.find_element(By.XPATH, "//*[@id=\"i_action_create_collector\"]").click()
                    time.sleep (3)
                    with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"filter_device\"]/ul/li/ul/li/div").get_attribute("class") == "arrow nochildren"
                case "User":
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"user_accesstree\"]/ul/li/ul/li")
                    with assume: assert len(nodeList) == 1
                    self.driver.find_element(By.XPATH, "//*[@id=\"i_action_create_user\"]").click()
                    time.sleep (3)
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"add_accesstree\"]/ul/li/ul/li")
                    with assume: assert len(nodeList) == 1
                    self.driver.find_element(By.XPATH, "//*[@id=\"create_user\"]/div[1]/a").click()
                    time.sleep (3)
                case "Region":
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"add_accessDeviceTree\"]/ul/li/ul/li")
                    with assume: assert len(nodeList) == 1
                    self.driver.find_element(By.XPATH, "//*[@id=\"i_action_create_region\"]").click()
                    time.sleep (3)
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"create_accessDeviceTree\"]/ul/li/ul/li")
                    with assume: assert len(nodeList) == 1
                    self.driver.find_element(By.XPATH, "//*[@id=\"create_region\"]/div[1]/a").click()
                    time.sleep (3)
                case "Map Management":
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"ul_0\"]/li")
                    with assume: assert len(nodeList) == 1
                case "Alarm Filter":
                    self.driver.find_element(By.XPATH, "//*[@id=\"i_action_create_collector\"]").click()
                    time.sleep (3)
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"add_accessEmsTree\"]/ul/li/ul/li")
                    with assume: assert len(nodeList) == 1
                    self.driver.find_element(By.XPATH, "//*[@id=\"create_background\"]/a").click()
                    time.sleep (3)
                case "Alarm Action":
                    self.driver.find_element(By.XPATH, "//*[@id=\"i_action_create_collector\"]").click()
                    time.sleep (3)
                    nodeList = self.driver.find_elements(By.XPATH, "//*[@id=\"add_accessEmsTree\"]/ul/li/ul/li[1]")
                    with assume: assert len(nodeList) == 1
                    self.driver.find_element(By.XPATH, "//*[@id=\"create_background\"]/a").click()
                    time.sleep (3)


    # System/ Security/ Group
    @pytest.mark.Unicase
    def test_EMS1_3641_groupCreate(self):
        groupNameInvalid = "A ~!@#$%^&*()_+{}|:<>a/][=-`,.;01"
        groupName = "A ~!@#$%^&*()_+{}|:<>a/][=-`,.;0"
        usrName =  "usrGroupFunction"
        usrPwd =  "usrGroupFunction123**"
        kickUsr(self, usrName)
        delEMSUsr (self, usrName)
        delEMSGroup (self, groupName)
        # Group create with invalid name
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Security").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Group").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//*[@id=\"i_action_create_collector\"]").click()
        time.sleep (3)
        self.driver.find_element(By.ID, "create_group_name").send_keys(groupNameInvalid)
        Select(self.driver.find_element(By.ID, "User_Dashboard_all_select")).select_by_visible_text("Read only")
        Select(self.driver.find_element(By.ID, "User_Maintenance_all_select")).select_by_visible_text("Read only")
        Select(self.driver.find_element(By.ID, "User_Script_all_select")).select_by_visible_text("Read only")
        Select(self.driver.find_element(By.ID, "User_Topology_all_select")).select_by_visible_text("Read only")
        Select(self.driver.find_element(By.ID, "User_Provision_all_select")).select_by_visible_text("Read only")
        Select(self.driver.find_element(By.ID, "User_Security_all_select")).select_by_visible_text("Read only")
        Select(self.driver.find_element(By.ID, "User_Fault_all_select")).select_by_visible_text("Read only")
        Select(self.driver.find_element(By.ID, "User_Inventory_all_select")).select_by_visible_text("Read only")
        Select(self.driver.find_element(By.ID, "User_Performance_all_select")).select_by_visible_text("Read only")
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_Template_create\"]//input[@value=\"Create\"]").click()
        time.sleep (3)
        assert waitMessageText(self) == "[Invalid parameter] Group Name: Maximum length is 32"
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        # Group create with valid name
        self.driver.find_element(By.ID, "create_group_name").clear()
        self.driver.find_element(By.ID, "create_group_name").send_keys(groupName)
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_Template_create\"]//input[@value=\"Create\"]").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        self.driver.find_element(By.ID, groupName).click()
        time.sleep (3)
        groupItemList = ["Dashboard", "Service", "Profile", "Configuration", "Topology", "Alarm Log", "Edit Script", "Script Task", "Default Setting"
                         , "Search", "Demand", "Edit Schedule", "Firmware Management", "User", "Group", "Access log", "Map management", "Online Users"
                         , "Alarm Severity", "Pairwise Correlation", "Duplicate Correlation", "Alarm Template", "Alarm Filter", "Alarm Action"
                         , "System Setting", "Server Monitor", "EMS Database Backup", "System Storage"]
        for groupItem in groupItemList:
            with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_Template\"]//div[text()=\'" + groupItem + "\']/following-sibling::div[1]/select").get_attribute("value") == "ReadOnly"
        newEMSUsr (self, usrName, usrPwd, groupName, "Global", [self.dutName])
        self.driver.find_element(By.ID, usrName).click()
        time.sleep (3)
        with assume: assert self.driver.find_element(By.ID, "user_name").get_attribute("value") == usrName
        with assume: assert self.driver.find_element(By.ID, "template").get_attribute("value") == groupName


