    # Map / Device / Remote Control
    @pytest.mark.Unicase
    def test_EMS1_4443_4438_4437_4439_remoteControl(self):
        dateFormat = "%Y-%m-%d_%H:%M:%S"
        deleteScriptIfExisted (self, "$py_remoteControl")
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + self.dutNodeName + "\')]").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Remote Control").click()
        time.sleep(6)
        #Check connection ok
        latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-1]
        with assume: assert latestRestulElem.find_element(By.XPATH, "span[2]").text == "#"
        #Check show system command ok
        self.driver.find_element(By.ID, "manual_script_text").send_keys("show system")
        self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.TAB)
        time.sleep(3)
        self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.ENTER)
        time.sleep(3)
        latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-2]
        with assume: assert latestRestulElem.find_element(By.XPATH, "span[3]").text == "ok"
        latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-1]
        with assume: assert latestRestulElem.find_element(By.XPATH, "span[2]").text == "#"
        time.sleep(3)
        self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.UP)
        time.sleep(3)
        self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.ENTER)
        time.sleep(3)
        latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-2]
        with assume: assert latestRestulElem.find_element(By.XPATH, "span[3]").text == "ok"
        latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-1]
        with assume: assert latestRestulElem.find_element(By.XPATH, "span[2]").text == "#"
        #Check setting in different interface ok
        #ont interface
        self.driver.find_element(By.ID, "manual_script_text").send_keys("configure")
        self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.TAB)
        time.sleep(3)
        self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.ENTER)
        for index in range(self.ontCount):
            time.sleep(3)
            match self.ontFlagList[index]:
                case "xont":
                    ontInterface = "interface remote xont " + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index]
                case "ont":
                    ontInterface = "interface remote ont " + self.ontSlotIDList[index] + "-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index]
                case "ont-14":
                    ontInterface = "remote ont ont-" + self.ontPortIDList[index] + "-" + self.ontOntIDList[index]
            self.driver.find_element(By.ID, "manual_script_text").send_keys(ontInterface)
            self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.ENTER)
            time.sleep(3)
            latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-2]
            with assume: assert latestRestulElem.find_element(By.XPATH, "span[3]").text == "ok"
            latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-1]
            with assume: assert latestRestulElem.find_element(By.XPATH, "span[2]").text == "#"
            scriptTime = (datetime.now()).strftime(dateFormat)
            self.driver.find_element(By.ID, "manual_script_text").send_keys("description script_" + scriptTime)
            self.driver.find_element(By.ID, "manual_script_text").send_keys(Keys.ENTER)
            time.sleep(3)
            latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-2]
            with assume: assert latestRestulElem.find_element(By.XPATH, "span[3]").text == "ok"
            latestRestulElem = self.driver.find_elements(By.XPATH, "//div[@id=\'console\']/p")[-1]
