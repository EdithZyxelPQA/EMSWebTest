        self.driver.find_element(By.ID, "ont_voip_dial_plan_ctimeout_text").send_keys("8000")
        self.driver.find_element(By.ID, "ont_voip_dial_plan_ptimeout_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_voip_dial_plan_ptimeout_text").send_keys(Keys.DELETE)
