            upgradeOntPortID, upgradeOntOntID,
            deviceStatusCount, ontStatusCount, alarmStatusCount, alarmStatus, 
            emsLink, dateFormat, timeZone
        ) = (
            self.waitTime, self.uploadPath, self.downloadpath, self.browser, self.emsURL, self.emsVer, 
            self.emsUsr, self.emsPwd, self.node_name, self.dutName, self.dutIp, self.dutNodeName, 
            self.dutDesc, self.dutAdminName, self.dutAdminPwd, self.dutType, self.dutSet, self.dutGet, 
            self.dutSnmpVer, self.dutSnmp3Auth, self.dutSnmp3Hash, self.dutSnmp3Encrypt, self.dutAddr, self.dutSlotCount,
            self.dutAllCardID, self.dutAllCardPortID, self.cardTypeName, self.cardPortTypeName, self.cardPortTypeSpeed, 
            self.cardFwVersion, self.fwUploadName, self.fwUploadFileName,
            self.ontCount, self.ontSlotIDList, self.ontPortIDList, self.ontOntIDList, self.ontSNList, 
            self.ontPWList, self.ontModelList, self.ontTypeList, self.ontFlagList, self.exeUpgradeONT, 
            self.upgradeOntFW, self.upgradeOntFlag, self.upgradeOntModel, self.upgradeOntSlotID, 
            self.upgradeOntPortID, self.upgradeOntOntID,
            self.deviceStatusCount, self.ontStatusCount, self.alarmStatusCount, self.alarmStatus, 
            self.emsLink, self.dateFormat, self.timeZone
        )        
        self.driver.find_element(By.LINK_TEXT, "Map").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "navside_icon").click()
        time.sleep(3)
        #Check ont status 
        for index in range(ontCount):
            ontTableType = "Slot"
            if dutSlotCount == "0":
                self.driver.find_element(By.XPATH, "//li[contains(.,\'" + dutNodeName + "\')]").click()
                time.sleep(3)
                ontTableType = "Dev"
            else:
                expandElement = self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + dutNodeName + "\')]/span[contains(@class,\'expand-icon\')]")
                expandStatus = expandElement.get_attribute("class")
                if expandStatus == "icon expand-icon oi oi-plus":
                    expandElement.click()  
                dutNodeId = int(self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + dutNodeName + "\')]").get_attribute("data-nodeid"))
                cardNodeId = dutNodeId + int(ontSlotIDList[index])
                self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(@data-nodeid,\'" + str(cardNodeId) + "\')]").click()
            #Check ont each status number
            for status in range(1,ontStatusCount+1):
                self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[" + str(status) + "]/div[2]/a").click()
                statusTitle = self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[" + str(status) + "]/div[2]/a").text
                statusData = self.driver.find_element(By.ID, "table_total_data_" + ontTableType + "_ontStatusTable").text.strip("Total data:")
                with assume: assert statusTitle == statusData
            #Check click the inService ONT can switch to ont status page
            self.driver.find_element(By.XPATH, "//div[@id=\'ontStatus\']/div[1]/div[2]/a").click()
            time.sleep(3)
            entryPosition = getPositionByColsAndClickNext(self, ontTableType + "_ontStatusTable", {"sn": ontSNList[index]})
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            time.sleep(3)
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_dev").text == dutName + " (" + dutIp + ")"
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_slotid").text == "Slot: " + ontSlotIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_portid").text == "Port: " + ontPortIDList[index]
            with assume: assert self.driver.find_element(By.ID, "dashboard_ont_title_ontid").text == "ONT: " + ontOntIDList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Admin Status") == "Active"
            with assume: assert getAttributeValue (self, "ontStatusTable", "Operation Status") == "IS"
            with assume: assert getAttributeValue (self, "ontStatusTable", "SN") == ontSNList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Password") == ontPWList[index]
            with assume: assert getAttributeValue (self, "ontStatusTable", "Model") == ontModelList[index]
            self.driver.close()
            self.driver.switch_to.window(p)
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "Port").text == ontPortIDList[index]                       
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "ONT").text == ontOntIDList[index]            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "sn").text == ontSNList[index]            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "password").text == ontPWList[index]            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "model").text == ontModelList[index]            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "OntAdminState").text == "Active"            
            with assume: assert getElementByPositionCol(self, ontTableType + "_ontStatusTable", entryPosition , "OntOperationStatus").text == "In Service"
            #Check ont map
            #Add ont and capture
            entryPosition = getPositionByColNoPage(self, ontTableType + "_portStatusTable", "PortID" , ontPortIDList[index])
            getElementByPositionColNoPage(self, ontTableType + "_portStatusTable", entryPosition , "OntMapTree").find_element(By.XPATH,"./a").location_once_scrolled_into_view
            getElementByPositionColNoPage(self, ontTableType + "_portStatusTable", entryPosition , "OntMapTree").find_element(By.XPATH,"./a").click() 
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            time.sleep(3)
            try:
                self.driver.find_element(By.CSS_SELECTOR, ".node:nth-of-type(2) > text").click()
                self.driver.find_element(By.LINK_TEXT, "Delete").click()
            except NoSuchElementException:
                pass
            Select(self.driver.find_element(By.ID, "ont_map_splitter_type")).select_by_visible_text("1:2")
            self.driver.find_element(By.ID, "ont_map_splitter_name_text").send_keys("SplitterA")
            self.driver.find_element(By.ID, "ont_map_add_splitter").click()
            time.sleep(3)
            Select(self.driver.find_element(By.ID, "ont_map_splitter_type")).select_by_visible_text("1:256")
            self.driver.find_element(By.ID, "ont_map_splitter_name_text").send_keys("SplitterB")
            self.driver.find_element(By.ID, "ont_map_add_splitter").click()
            time.sleep(3)
            Select(self.driver.find_element(By.ID, "ont_map_addont_parents")).select_by_visible_text("SplitterB : 1:256")
            #clickOntInMap(self,ontOntIDList[index])
            self.driver.find_element(By.CSS_SELECTOR, ".zy_col_1 > label").click()
            self.driver.find_element(By.ID, "ont_map_ont_add_button").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "ont_map_panel").screenshot("./report/ONT_" + ontSlotIDList[index] + "-" + ontPortIDList[index]+"-"+ontOntIDList[index] + "_MapAdd.png")
            self.driver.close()
            self.driver.switch_to.window(p)
            #Delete ont and capture
            getElementByPositionColNoPage(self, ontTableType + "_portStatusTable", entryPosition , "OntMapTree").click()
            p= self.driver.window_handles[0]
            c = waitNewWindowHandle(self)
            self.driver.switch_to.window(c)
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, ".node:nth-of-type(2) > text").click()
            self.driver.find_element(By.LINK_TEXT, "Delete").click()
            self.driver.find_element(By.ID, "ont_map_panel").screenshot("./report/ONT_" + ontSlotIDList[index] + "-" + ontPortIDList[index]+"-"+ontOntIDList[index] + "_MapDelete.png")
            self.driver.close()
            self.driver.switch_to.window(p)            


    @pytest.mark.Icat
    def test_EMS1_5503_alarmActive(self):
        (
            waitTime, uploadPath, downloadpath, browser, emsURL, emsVer, 
            emsUsr, emsPwd, node_name, dutName, dutIp, dutNodeName, 
            dutDesc, dutAdminName, dutAdminPwd, dutType, dutSet, dutGet, 
            dutSnmpVer, dutSnmp3Auth, dutSnmp3Hash, dutSnmp3Encrypt, dutAddr, dutSlotCount,
            dutAllCardID, dutAllCardPortID, cardTypeName, cardPortTypeName, cardPortTypeSpeed, 
            cardFwVersion, fwUploadName, fwUploadFileName,
            ontCount, ontSlotIDList, ontPortIDList, ontOntIDList, ontSNList, 
            ontPWList, ontModelList, ontTypeList, ontFlagList, exeUpgradeONT, 
            upgradeOntFW, upgradeOntFlag, upgradeOntModel, upgradeOntSlotID, 
            upgradeOntPortID, upgradeOntOntID,
            deviceStatusCount, ontStatusCount, alarmStatusCount, alarmStatus, 
            emsLink, dateFormat, timeZone
        ) = (
            self.waitTime, self.uploadPath, self.downloadpath, self.browser, self.emsURL, self.emsVer, 
            self.emsUsr, self.emsPwd, self.node_name, self.dutName, self.dutIp, self.dutNodeName, 
            self.dutDesc, self.dutAdminName, self.dutAdminPwd, self.dutType, self.dutSet, self.dutGet, 
            self.dutSnmpVer, self.dutSnmp3Auth, self.dutSnmp3Hash, self.dutSnmp3Encrypt, self.dutAddr, self.dutSlotCount,
            self.dutAllCardID, self.dutAllCardPortID, self.cardTypeName, self.cardPortTypeName, self.cardPortTypeSpeed, 
            self.cardFwVersion, self.fwUploadName, self.fwUploadFileName,
            self.ontCount, self.ontSlotIDList, self.ontPortIDList, self.ontOntIDList, self.ontSNList, 
            self.ontPWList, self.ontModelList, self.ontTypeList, self.ontFlagList, self.exeUpgradeONT, 
            self.upgradeOntFW, self.upgradeOntFlag, self.upgradeOntModel, self.upgradeOntSlotID, 
            self.upgradeOntPortID, self.upgradeOntOntID,
            self.deviceStatusCount, self.ontStatusCount, self.alarmStatusCount, self.alarmStatus, 
            self.emsLink, self.dateFormat, self.timeZone
        )        
        self.driver.find_element(By.LINK_TEXT, "Alarm").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Active").click()
        totalAlarmCount = 0
        for status in range(1,alarmStatusCount):
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + alarmStatus[status]).text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.ID, "alarm_total").text
        for status in range(alarmStatusCount):
            self.driver.find_element(By.ID, "alarm_" + alarmStatus[status]).click()
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + alarmStatus[status]).text)
            strLastPageNumber = self.driver.find_element(By.CSS_SELECTOR, "#alarm_activeAlarmTable > div.pagination > a.last").get_attribute("href")
            lastPageNumber = int(strLastPageNumber.replace(emsLink,""))
            expectPageCount = (statusAlarmCount//100 + 1)
            if statusAlarmCount%100 == 0 and statusAlarmCount > 0:
                expectPageCount = expectPageCount - 1
            with assume: assert lastPageNumber == expectPageCount
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
        self.driver.find_element(By.ID, "fault_active_clear_btn").click()
        self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .arrow").click()
        self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .collapsed").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + dutNodeName + "\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + dutNodeName + "\')]").click()
        self.driver.find_element(By.ID, "fault_active_btn").click()
        #Check the download file
        minTime = datetime.now()
        exportTableSnapshot = capture_table_and_export(self.driver, "alarm_activeTable")
        time.sleep(30)
        maxTime = datetime.now()
        files = glob.glob(os.path.join(downloadpath, "*.xls"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime
        assert_export_matches(latestFile, exportTableSnapshot, "Icat Active Alarm")
        totalAlarmCount = 0
        for status in range(1,alarmStatusCount):
            statusAlarmCount = int(self.driver.find_element(By.ID, "alarm_" + alarmStatus[status]).text)
            totalAlarmCount += statusAlarmCount
        with assume: assert str(totalAlarmCount) == self.driver.find_element(By.ID, "alarm_total").text


