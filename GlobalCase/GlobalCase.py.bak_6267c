        for status in range(1, self.alarmStatusCount):
            devAlarmStatusCountList.append(int(self.driver.find_element(By.ID, "alarm_" + self.alarmStatus[status]).text))
        self.driver.find_element(By.LINK_TEXT, "Map").click()
