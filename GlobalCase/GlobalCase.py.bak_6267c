                            , "queue tc 1 priority 0 weight 0 usbwprofname \$py_BandwidthUNIUp2 dsbwprofname \$py_BandwidthUNIDown2 dsoption ont bwsharegroupid 2"
                            , "vlan 102 ((ingprof tc1 txtag untag gemport \d+)|(txtag untag gemport \d+ ingprof tc1)) aesencrypt disable sharepri 1", "protocol-based arp vlan 102 def-pbit 1"]
