    # System/ Security/ User
    @pytest.mark.asyncio
    @pytest.mark.Unicase
    async def test_EMS1_4499_usrPrivilegeNoAccess(self):
        #Create account with privilege No Access
        pageList = ["Dashboard", "Map", "Alarm", "Active", "History", "Inventory", "Device", "Card", "Port", "All Ports", "Network Port"
                    , "Ethernet Access Port", "GPON Port", "xPON Port", "ONT", "Performance", "Current", "History", "Maintenance"
                    , "Schedule", "Result Log", "Firmware File Management", "Provision", "Service", "Profile", "Configuration"
                    , "Script", "Script", "Task", "Default Setting", "System", "Security", "User", "Region", "Group", "Map Management"
                    , "Access Log", "Online User", "Password Rule", "Fault", "Alarm Severity", "Pairwise Correlation", "Duplicate Correlation"
                    , "Alarm Template", "Alarm Filter", "Alarm Action", "System Properties", "System Setting", "Server Monitor"
                    , "Alarm Notification", "EMS Database Backup/Restore", "System Storage"]
        usrName = "usrNoAccess"
        usrPwd = "usrNoAccess123**"
        kickUsr(self, usrName)
        delEMSUsr (self, usrName)
        time.sleep (3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_user > a").click()
        WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.ID, "create_user_name")))
        self.driver.find_element(By.ID, "create_user_name").send_keys(usrName)
        self.driver.find_element(By.ID, "create_password").send_keys(usrPwd)
        self.driver.find_element(By.ID, "create_repeatpassword").send_keys(usrPwd)
        Select(self.driver.find_element(By.ID, "create_template")).select_by_visible_text("NoAccess")
        Select(self.driver.find_element(By.ID, "create_regionName")).select_by_visible_text("Global")
        self.driver.find_element(By.XPATH,"//*[@id=\"add_accesstree\"]/ul/li/div[2]").click()
        time.sleep (1)
        self.driver.find_element(By.XPATH,"//*[@id=\"add_accesstree\"]/ul/li/div[2]").click()
        time.sleep (1)
        self.driver.find_element(By.XPATH,"//*[@id=\"add_accesstree\"]/ul/li//label[contains(.,\'"+ self.dutNodeName +"\')]/../div[2]").click()
        time.sleep (3)
        self.driver.find_element(By.CSS_SELECTOR, "#create_user .button").click()
        time.sleep (3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep (3)
        logoutEMS (self)
        loginEMS (self, usrName, usrPwd)
        with assume: assert self.driver.find_element(By.ID, "index_t_userName").text == usrName
        time.sleep (3)
        for page in pageList:
            if page == "Region": continue 
            self.driver.find_element(By.LINK_TEXT, page).click()
            time.sleep(3)
            if page == "Alarm Notification": 
                elementXpath = "//*[@id=\"alarm_noti_btn\"]"
                with assume: assert "hidden" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
            elif page in ["Provision", "Service", "Profile", "Configuration"]:
                with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"privision_noprivilege_label\"]/div[1]").text.strip() == "No privilege to access this page"
                with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"privision_noprivilege_label\"]/div[2]").text.strip() == "You are not allow to access this page.\nPlease contact system administrator if you have any problem." 
            else:
                with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"No_Privilege\"]/div/div[1]").text.strip() == "No privilege to access this page", f"{page}"
