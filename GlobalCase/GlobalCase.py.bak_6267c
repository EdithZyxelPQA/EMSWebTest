        deleteFileIfExisted(self,"GE Template","$py_Temp_Ge")
        deleteAutoMaxFileIfTableFull(self,"GE Template",3000)
        #Create GE template profile: "$py_Temp_Ge"
        createProfile (self, "GE Template", "$py_Temp_Ge")
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//label[@for=\"ge_template_autonego_checkbox\"]").click()
        self.driver.find_element(By.XPATH, "//label[@for=\"ge_template_flowctrl_checkbox\"]").click()
