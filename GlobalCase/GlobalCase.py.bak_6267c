            #Check alarm clear function
            #self.driver.find_element(By.CSS_SELECTOR, "#i_action_clear > a").click()
            #time.sleep(3)
            #with assume: assert waitMessageText(self) == "Success."
            #self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            #time.sleep(3)
            #with assume: assert self.driver.find_element(By.XPATH, "//div[@id=\'alarmStatus\']/div[1]/div[2]/a").text == "0", f"Slot {dutAllCardID[index]}"
            #Check port status
            with assume: assert getElementByPositionColNoPage(self, "Slot_portStatusTable", dutAllCardPortID[cardType] , "portOperationStatus").text == "Up"
            with assume: assert getElementByPositionColNoPage(self, "Slot_portStatusTable", dutAllCardPortID[cardType] , "PortType").text == cardPortTypeName[cardType]


