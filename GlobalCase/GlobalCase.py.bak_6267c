    @pytest.mark.Unicase
    def test_EMS1_6259_6260_filterOntService(self):
        sn = self.serviceOntSN
        password = self.serviceOntPW
        flag = self.serviceOntFlag
        assert sn, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.sn_16"
        assert password, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.pw"
        assert flag, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.flag"

        print("EMS1-6259: unregister ONT by CLI", flush=True)
        unregister_ont_by_flag(self.dutIp, self.dutAdminName, self.dutAdminPwd, flag, self.serviceOntSlotID, self.serviceOntPortID, self.serviceOntID)

        print("EMS1-6259: login EMS", flush=True)
        self.driver.get(self.emsURL)
        login_ems(self.driver, self.emsUsr, self.emsPwd)

        print("EMS1-6259: wait Inventory/ONT unregistered", flush=True)
        filter_inventory_ont_by_sn(self.driver, sn)
        wait_inventory_ont_id(self.driver, sn, lambda ont_id: ont_id == "Unregistered")

        print("EMS1-6259: delete existing ONT service", flush=True)
        delete_ont_service_if_exists(self.driver, sn)

        print("EMS1-6259: recreate empty ONT Template Profile", flush=True)
        recreate_empty_ont_template_profile(self.driver, PROFILE_NAME)

        print("EMS1-6259: create ONT service for filter test", flush=True)
        create_ont_service_by_select_sn(self.driver, sn, self.dutIp, password, DESCRIPTION, template_name=PROFILE_NAME)
        wait_ont_service_success(self.driver, sn, timeout=600)

        print("EMS1-6259: read Success detail", flush=True)
        detail = get_ont_service_success_detail(self.driver, sn)
        expected = {
            "Device Name": _value(detail, "DevName", "Device Name"),
            "Device IP": _value(detail, "IPAddress", "Device IP", "IP Address"),
            "Slot": _value(detail, "Slot"),
            "Port": _value(detail, "Port"),
            "ONT": _value(detail, "ONT"),
            "SN": _value(detail, "sn", "SN"),
            "Password": _value(detail, "password", "Password"),
            "Template": _value(detail, "ontTemplate", "Template"),
            "Status": _value(detail, "state", "Status"),
            "ONT Description": DESCRIPTION,
        }
        print(f"EMS1-6259: remembered service values {expected}", flush=True)

        all_total = reset_ont_service_filter(self.driver)
        with assume:
            assert all_total >= 1, f"Service table should have data after reset, total={all_total}"

        self._newcase_06__verify_exact_single_filter("SN", expected["SN"], ["sn", "SN"])
        self._newcase_06__reset_and_verify_total(all_total)
        self._newcase_06__verify_all_rows_filter("Device Name", expected["Device Name"], ["DevName", "Device Name"])
        self._newcase_06__reset_and_verify_total(all_total)
        self._newcase_06__verify_all_rows_filter("Device IP", expected["Device IP"], ["IPAddress", "Device IP", "IP Address"])
        self._newcase_06__reset_and_verify_total(all_total)
        self._newcase_06__verify_all_rows_filter("Status", expected["Status"], ["state", "Status"])
        self._newcase_06__reset_and_verify_total(all_total)
        self._newcase_06__verify_all_rows_filter("ONT Description", expected["ONT Description"], ["description", "ONT Description"])
        self._newcase_06__reset_and_verify_total(all_total)

        if expected["Slot"] not in {"", "--", "0"}:
            self._newcase_06__verify_all_rows_filter("Slot", expected["Slot"], ["Slot", "slot"])
            self._newcase_06__reset_and_verify_total(all_total)
        else:
            print(f"EMS1-6259: skip Slot filter because Slot={expected['Slot']!r}", flush=True)

        self._newcase_06__verify_all_rows_filter("Port", expected["Port"], ["Port", "port"])
        self._newcase_06__reset_and_verify_total(all_total)
        self._newcase_06__verify_all_rows_filter("ONT", expected["ONT"], ["ONT", "ont"])
        self._newcase_06__reset_and_verify_total(all_total)
        self._newcase_06__verify_all_rows_filter("Template", expected["Template"], ["ontTemplate", "Template"])
        self._newcase_06__reset_and_verify_total(all_total)

    def _newcase_06__verify_exact_single_filter(self, field, expected_value, keys):
        print(f"EMS1-6259: filter {field}={expected_value}", flush=True)
        rows = filter_ont_service(self.driver, field, expected_value)
        with assume:
            assert len(rows) == 1, f"{field} filter should return one row. rows={rows}"
        if rows:
            actual = _value(rows[0], *keys)
            with assume:
                assert actual == expected_value, f"{field} expected={expected_value}, actual={actual}, row={rows[0]}"

    def _newcase_06__verify_all_rows_filter(self, field, expected_value, keys):
        print(f"EMS1-6259: filter {field}={expected_value}", flush=True)
        rows = filter_ont_service(self.driver, field, expected_value)
        with assume:
            assert rows, f"{field} filter should return at least one row."
        for index, row in enumerate(rows, start=1):
            actual = _value(row, *keys)
            if actual == "":
                print(
                    f"EMS1-6259: {field} is not displayed in service table row {index}; "
                    "verified the filter returned rows only.",
                    flush=True,
                )
                continue
            with assume:
                assert actual == expected_value, (
                    f"{field} row {index} expected={expected_value}, actual={actual}, row={row}"
                )

    def _newcase_06__reset_and_verify_total(self, expected_min_total):
        total = reset_ont_service_filter(self.driver)
        rows = table_rows(self.driver, SERVICE_TABLE)
        with assume:
            assert total >= expected_min_total, f"Reset total should be >= original total. total={total}, original={expected_min_total}"
        with assume:
            assert rows or total == 0, f"Reset should show service rows when total is not 0. total={total}"


def _value(row, *keys):
    for key in keys:
        value = row.get(key)
        if value not in {None, ""}:
            return value
    return ""


