        self.driver.find_element(By.XPATH, "//label[contains(.,\'Reboot ONT after successful firmware upgrade\')]").click()
        self.driver.find_element(By.ID, "add_row").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + dutNodeName + "\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + dutNodeName + "\')]").click()
        self.driver.find_element(By.XPATH, "//input[@value=\'Search ONT\']").click()
        time.sleep(3)
        clickBySlotPortOnt(self, dutName, upgradeOntSlotID, upgradeOntPortID, upgradeOntOntID)
        self.driver.find_element(By.XPATH, "//input[@value=\'Add\']").click()
        self.driver.find_element(By.XPATH, "//input[@value=\'Save\']").click()
        time.sleep(5)
        entryPosition = getPositionByCol(self, "schedule_table", "ScheduleTime", scheduleTime + timeZone)
        waitScheduleSuccess (self, entryPosition)
        openScheduleResult(self, entryPosition)
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement .modal-content").screenshot("./report/OntUpgradeDetail.png")
        #Maintanence table detail 1 assert
        with assume: assert getScheduleResultByCol (self, "Index") == "1"
        with assume: assert getScheduleResultByCol (self, "Schedule Name") == "AutoTest_ONTUpgrade"
        scheduleTime = getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleTime").text.removesuffix(timeZone) 
        minTime = datetime.strptime(scheduleTime, dateFormat)
        maxTime = minTime + timedelta(seconds = 600)
        timeResult = getScheduleResultByCol (self, "Execute Time").removesuffix(timeZone) 
        with assume: assert minTime <= datetime.strptime(timeResult, dateFormat) <= maxTime
        resultSummary = getScheduleResultByCol (self, "Result Summary")
        resultSummaryList = resultSummary.split(",")
        resultSummaryList = [re.sub(r"^.*:", "", i,flags = re.DOTALL) for i in resultSummaryList]
        with assume: assert int(resultSummaryList[0]) >= 0
        with assume: assert int(resultSummaryList[1]) == 0
        #Maintanence table detail 2 assert
        detailScheduleNameList = getScheduleResultDetailListByCol (self, "ScheduleName")
        detailExecuteDateList = getScheduleResultDetailListByCol (self, "Date")
        detailDeviceNameList = getScheduleResultDetailListByCol (self, "DeviceName")
        detailSlotList = getScheduleResultDetailListByCol (self, "SlotID")
        detailPortList = getScheduleResultDetailListByCol (self, "PortID")
        detailONTList = getScheduleResultDetailListByCol (self, "OntID")
        detailResultList = getScheduleResultDetailListByCol (self, "Result ")
        detailCauseList = getScheduleResultDetailListByCol (self, "Cause ")
        with assume: assert checkAllElementInListAre (detailScheduleNameList, "AutoTest_ONTUpgrade")
        with assume: assert checkAllElementInListPartialMatch (detailExecuteDateList, scheduleTime)
        with assume: assert checkAllElementInListAre (detailDeviceNameList, dutName)
        with assume: assert detailSlotList == [upgradeOntSlotID]
        with assume: assert detailPortList == [upgradeOntPortID]
        with assume: assert detailONTList == [upgradeOntOntID]
        with assume: assert checkAllElementInListAre (detailResultList, "Success")
        with assume: assert checkAllElementInListPartialMatch (detailCauseList, "Success")
        #Maintanence table detail 3 assert
        ontResultRow = 1
        if "NeoX" not in dutType:
            with assume: assert getOntBatchTableValueByPositionCol (self, 1 , "DeviceName") == dutName
            with assume: assert getOntBatchTableValueByPositionCol (self, 1 , "DeviceIP") == dutIp
            with assume: assert getOntBatchTableValueByPositionCol (self, 1 , "LastActionResult") == "Success"
            ontResultRow = 2
        with assume: assert getOntBatchTableValueByPositionCol (self, ontResultRow , "DeviceName") == dutName
        with assume: assert getOntBatchTableValueByPositionCol (self, ontResultRow , "DeviceIP") == dutIp
        with assume: assert getOntBatchTableValueByPositionCol (self, ontResultRow , "SlotID") == upgradeOntSlotID
        with assume: assert getOntBatchTableValueByPositionCol (self, ontResultRow , "PortID") == upgradeOntPortID
        with assume: assert getOntBatchTableValueByPositionCol (self, ontResultRow , "OntID") == upgradeOntOntID
        with assume: assert "Upgrade success" in getOntBatchTableValueByPositionCol (self, ontResultRow , "UpgradeStatus")
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        time.sleep(3)
        #Maintanence table summary assert
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleStatus").text == "Finish"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Name").text == "AutoTest_ONTUpgrade"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Type").text == "ONT Firmware Upgrade"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleType").text == "Once"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Result_Hyperlink").text == "Success"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Timeout").text == "180"
        #Check the ont just reboot 
        time.sleep(150)
        with assume: assert await checkOntUptime(dutIp, dutAdminName, dutAdminPwd, upgradeOntFlag, exeOntInfo) <= 1200
        #Check the ont current version in Inventory 
        time.sleep(150)
        upgradeOntFWVersion = re.sub(r"\..*$", "", upgradeOntFW,flags = re.DOTALL)
        with assume: assert upgradeOntFWVersion == ontCurrentVerByAIDInventory (self, dutIp, exeOntInfo)


