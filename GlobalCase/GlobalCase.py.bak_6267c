            self.dutSnmpVer, self.dutSnmp3Auth, self.dutSnmp3Hash, self.dutSnmp3Encrypt, self.dutAddr, self.dutSlotCount,
            self.dutAllCardID, self.dutAllCardPortID, self.cardTypeName, self.cardPortTypeName, self.cardPortTypeSpeed, 
            self.cardFwVersion, self.fwUploadName, self.fwUploadFileName,
            self.ontCount, self.ontSlotIDList, self.ontPortIDList, self.ontOntIDList, self.ontSNList, 
