                checkValue = ["Template Name: \"$py_TempONTAlarm\"", "Alarm Profile #1: Name \"$py_ONTAlarm\"", "QoS Downstream Option : ont", "MAC Learning : enable", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            #Check ies template profile
            else:
                checkValue = ["Template Name: \"$py_TempONTAlarm\"", "Alarm Profile #1: Name \"$py_ONTAlarm\"", "QoS Downstream Option : ont", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            with assume: assert await cliShowTempProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_TempONTAlarm") == checkValue
            #Check ont alarm profile in CLI
            checkValue = ["2.80", "0", "-40", "-15.3", "-127.0", "3.59", "79", "100", "6.5", "0.0"]
            with assume: assert await cliShowAlarmProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, "$py_ONTAlarm") == checkValue


