                    with assume: assert getElementByPositionCol(self, "Slot_ontStatusTable", entryPosition , "OntAdminState").text == self.rOntrowstatusDic.get(rOntrowstatus, "Unknow"), f"Slot {rSlot}, Port {rPort}, Ont {rOntid}"
