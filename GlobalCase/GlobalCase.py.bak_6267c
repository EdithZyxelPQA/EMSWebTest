                        continue
                    if page in ["Maintenance", "Schedule", "Alarm Action"]:
                        elementXpathList = ["//*[@id=\"i_action_create_collector\"]", "//*[@id=\"i_action_delete\"]"]
                    for elementXpath in elementXpathList:
                        with assume : assert "none" in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                case ("Configuration"|"Script"|"Inventory"|"Device"|"Card"|"Port"|"All Ports"|"Network Port"
                      |"Ethernet Access Port"|"GPON Port"|"xPON Port"|"ONT"|"Firmware File Management"|"Access Log"|"Alarm Severity"
                      |"Alarm Template"|"System Properties"|"System Setting"|"System Storage"):
                    elementXpathList = []
                    if page == "Dashboard":
                        self.driver.find_element(By.ID, "dashboard_all_alarm_card_more").click()
                        time.sleep(3)
                        p= self.driver.window_handles[0]
                        c = waitNewWindowHandle(self)
                        self.driver.switch_to.window(c)
                        time.sleep(3)
                        elementXpathList = ["//*[@id=\"i_action_ack\"]", "//*[@id=\"i_action_clear\"]"]
                        for elementXpath in elementXpathList:
                            with assume : assert "none" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                        self.driver.close()
                        self.driver.switch_to.window(p)
                        continue
                    elif page == "Configuration":
                        try:
                            self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + self.dutNodeName + "\')]").click()
                            with assume: assert True
                        except NoSuchElementException:
                            with assume: assert False, f"{page}"
                        continue
                    elif page == "Script":
                        if tableIsEmpty (self, "script_table") == False:
                            getElementByPositionCol(self, "script_table", [1,1] , "Modify").click()
                            time.sleep(3)
                            with assume: assert "hidden" not in self.driver.find_element(By.XPATH, "//*[@id=\"modify_script_background\"]/div[2]/input").get_attribute("Style"), f"{page}"
                            self.driver.find_element(By.XPATH, "//*[@id=\"modify_script_background\"]/div[1]/a").click()
                            time.sleep(3)
                        elementXpathList = ["//*[@id=\"i_action_create_collector\"]", "//*[@id=\"i_action_delete\"]", "//*[@id=\"i_action_applytodev\"]"]
                    elif self.driver.find_element(By.LINK_TEXT, "Inventory").get_attribute("className") != "":
                        elementXpathList = ["//*[@id=\"i_action_filter\"]", "//*[@id=\"i_action_refresh\"]", "//*[@id=\"i_action_export\"]"]
                    elif page == "Access Log":
                        elementXpathList = ["//*[@id=\"i_action_filter\"]", "//*[@id=\"i_action_refresh\"]", "//*[@id=\"i_action_export\"]"]
                    elif page in ["Fault", "Alarm Severity"]:
                        elementXpath = "//*[@id=\"tab_content_Alarm_Severity\"]/div/div[2]/input"
                        with assume: assert "display" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("class"), f"{page}"
                        continue
                    elif page in ["System Properties", "System Setting"]:
                        subpageList = ["parameter_system", "parameter_ftp", "parameter_rddn_svr"]
                        for subpage in subpageList:
                            self.driver.find_element(By.ID, subpage).click()
                            time.sleep(3)
                            if subpage == "parameter_system": elementXpathList = ["//*[@id=\"systme_test_button\"]", "//*[@id=\"systme_save_button\"]"]
                            elif subpage == "parameter_ftp": elementXpathList = ["//*[@id=\"ftp_test_button\"]", "//*[@id=\"ftp_save_button\"]"]
                            else: elementXpathList = ["//*[@id=\"ftp_test_button\"]", "//*[@id=\"rddnsvr_save_button\"]"]
                            for elementXpath in elementXpathList:
                                with assume: assert "hidden" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                        continue
                    elif page == "System Storage":
                        subpageList = ["Alarm Purge", "Access Log Purge"]
                        for subpage in subpageList:
                            self.driver.find_element(By.LINK_TEXT, subpage).click()
                            time.sleep(3)
                            if subpage == "Alarm Purge": elementXpathList = ["//*[@id=\"sys_alarmpurge_save_btn\"]", "//*[@id=\"Download_button\"]"]
                            if subpage == "Access Log Purge": elementXpathList = ["//*[@id=\"sys_accesslogpurge_save_btn\"]", "//*[@id=\"Download_button\"]"]
                            for elementXpath in elementXpathList:
                                with assume: assert "hidden" not in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"
                        continue
                    if page in ["Firmware File Management", "Alarm Template"]:
                        elementXpathList = ["//*[@id=\"i_action_create_collector\"]", "//*[@id=\"i_action_delete\"]"]
                    for elementXpath in elementXpathList:
                        with assume : assert "block" in self.driver.find_element(By.XPATH, elementXpath).get_attribute("Style"), f"{page}"


