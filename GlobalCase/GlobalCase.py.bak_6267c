            self.driver.find_element(By.ID, "provision_service_wan_table_pridns_" + str(ind + 1)).send_keys("11.2.3.4" + str(ind + 1))
            self.driver.find_element(By.ID, "provision_service_wan_table_secdns_" + str(ind + 1)).send_keys("55.6.7.8" + str(ind + 1))
