        action = ActionChains(self.driver)
        self.driver.find_element(By.XPATH, "//*[@id=\"EditTable\"]/div[2]/table/tbody/tr/td[4]").click()
        action.key_down(Keys.CONTROL).send_keys('c').key_up(Keys.CONTROL).perform()
        for ind, fakeSn in enumerate(fakeSnList):
            i = str(ind+1)
            elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//*[@id=\"EditTable\"]/div[2]/table/tbody/tr[" + i + "]/td[2]"))
            action.double_click(self.driver.find_element(By.XPATH, "//*[@id=\"EditTable\"]/div[2]/table/tbody/tr[" + i + "]/td[2]")).send_keys(fakeSn).perform()
            action.double_click(self.driver.find_element(By.XPATH, "//*[@id=\"EditTable\"]/div[2]/table/tbody/tr[" + i + "]/td[3]")).send_keys(fakePw).perform()
            if ind > 0:
                self.driver.find_element(By.XPATH, "//*[@id=\"EditTable\"]/div[2]/table/tbody/tr[" + i + "]/td[4]").click()
                action.key_down(Keys.CONTROL).send_keys('v').key_up(Keys.CONTROL).perform()
            if ind+1 != len(fakeSnList):
                elementScrolledIntoView(self, self.driver.find_element(By.XPATH,"//*[@id=\"EditTable\"]/div[6]/input[1]"))
                action.move_to_element(self.driver.find_element(By.XPATH,"//*[@id=\"EditTable\"]/div[6]/input[1]")).click().perform()
            time.sleep (3)
        minTime = datetime.now()
        self.driver.find_element(By.XPATH, "//*[@id=\"create_service_background\"]/div[1]/div[3]/div[2]/input[2]").click()
        time.sleep(10)        
        self.driver.find_element(By.XPATH, "//*[@id=\"create_service_background\"]/div[2]/input").click()
        time.sleep(30)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        maxTime = datetime.now()
        files = glob.glob(os.path.join(self.downloadpath, "*.csv"))
        latestFile = max(files, key=os.path.getmtime)
        latestFileSize = os.path.getsize(latestFile)
        latestFileTimeFloat = os.path.getmtime(latestFile)
        latestFileTime = datetime.fromtimestamp(latestFileTimeFloat)
        with assume: assert latestFileSize > 0
        with assume: assert minTime <= latestFileTime <= maxTime
        serviceExportNormalCsv = pandas.read_csv(os.path.join(self.downloadpath, "serviceExportNormal_" + str(maxCount) + ".csv"))
        serviceExportTestCsv = pandas.read_csv(latestFile)
        with assume: assert serviceExportNormalCsv.equals(serviceExportTestCsv)
        #Test Import
        deleteServiceWithSn(self, "FAFAFAfa00")
        deleteServiceWithProfile(self, "$$py_TempONTServiceExport")
        #Create service list with import function"
        self.driver.find_element(By.LINK_TEXT, "Provision").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "Service").click()
        time.sleep (3)
        self.driver.find_element(By.ID, "service_tab_ont").click()
        time.sleep (3)
        self.driver.find_element(By.CSS_SELECTOR, "#provision_service_create > a").click()
        time.sleep (3)
        self.driver.find_element(By.XPATH, "//*[@id=\"create_service_background\"]/div[1]/div[3]/div[2]/button").click()
        time.sleep (3)
        self.driver.find_element(By.ID, "csvInput").send_keys(self.uploadPath + os.sep + "serviceExportNormal_" + str(maxCount) + ".csv")
        time.sleep (3)
        self.driver.find_element(By.XPATH, "//*[@id=\"create_service_background\"]/div[2]/input").click()
        time.sleep (30)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep (3)
        def queryFakeServices():
            self.driver.find_element(By.CSS_SELECTOR, "#provision_service_filter > a").click()
            self.driver.find_element(By.ID, "provision_service_filter_reset_btn").click()
            self.driver.find_element(By.XPATH, "//label[@for=\'provision_filter_ont_sn_checkbox\']").click()
            self.driver.find_element(By.ID, "provision_filter_ont_sn_text").send_keys("FAFAFAfa00")
            self.driver.find_element(By.ID, "provision_service_filter_query_btn").click()
            time.sleep(5)
        queryFakeServices()
        # Opening the Modify dialog 120 times in one page makes Chrome run out of memory and the
        # browser dies: reload the page every 20 services and query again.
        reloadEvery = 20
        for snIndex, fakeSn in enumerate(fakeSnList):
            if snIndex and snIndex % reloadEvery == 0:
                print(f"EMS1-6267: reload the page after {snIndex} services", flush=True)
                self.driver.refresh()
                waitPageIdle(self)
                openMenu(self, "Provision")
                openMenu(self, "Service")
                self.driver.find_element(By.ID, "service_tab_ont").click()
                time.sleep(3)
                queryFakeServices()
            print ("SN : " + fakeSn)
            entryPosition = getPositionByCol(self, "provision_service_table", "sn", fakeSn)
            with assume: assert getElementByPositionCol(self, "provision_service_table", entryPosition , "ontTemplate").text == "$py_TempONTServiceExport"
            with assume: assert getElementByPositionCol(self, "provision_service_table", entryPosition , "password").text == fakePw
            with assume: assert getElementByPositionCol(self, "provision_service_table", entryPosition , "state").text == "Wait"
            getElementByPositionCol(self, "provision_service_table", entryPosition , "Modify").click()
            time.sleep(3)
            with assume: assert self.driver.find_element(By.ID, "provision_service_active_checkbox").get_attribute("checked")
            with assume: assert self.driver.find_element(By.ID, "provision_service_desc_text").get_attribute("value") == "ForExportTest"
            with assume: assert self.driver.find_element(By.ID, "provision_service_onttemplate_combbox").get_attribute("value") == "$py_TempONTServiceExport"
            with assume: assert self.driver.find_element(By.ID, "provision_service_dspir_text").get_attribute("value") == "10000000"
            # Check wan setting
            for ind in range (8):
                with assume: assert self.driver.find_element(By.ID, "provision_service_wan_table_active_" + str(ind + 1)).get_attribute("checked")
                with assume: assert self.driver.find_element(By.ID, "provision_service_wan_table_address_" + str(ind + 1)).get_attribute("value") == "192.168.10" + str(ind + 1) + ".1"
                with assume: assert self.driver.find_element(By.ID, "provision_service_wan_table_mask_" + str(ind + 1)).get_attribute("value") == "255.255.255.0"
                with assume: assert self.driver.find_element(By.ID, "provision_service_wan_table_gateway_" + str(ind + 1)).get_attribute("value") == "192.168.10" + str(ind + 1) + ".254"
                with assume: assert self.driver.find_element(By.ID, "provision_service_wan_table_pridns_" + str(ind + 1)).get_attribute("value") == "1.2.3.4" + str(ind + 1)
                with assume: assert self.driver.find_element(By.ID, "provision_service_wan_table_secdns_" + str(ind + 1)).get_attribute("value") == "5.6.7.8" + str(ind + 1)
                with assume: assert self.driver.find_element(By.ID, "provision_service_wan_table_username_" + str(ind + 1)).get_attribute("value") == "Usr" + str(ind + 1) + "@hinet.net"
                with assume: assert self.driver.find_element(By.ID, "provision_service_wan_table_password_" + str(ind + 1)).get_attribute("value") == "Pwd" + str(ind + 1)
            # Check Wifi Setting
            for ind in range (4):
                with assume: assert self.driver.find_element(By.ID, "provision_service_wify24g_table_active_" + str(ind + 1)).get_attribute("checked")
                with assume: assert self.driver.find_element(By.ID, "provision_service_wify24g_table_ssid_" + str(ind + 1)).get_attribute("value") == "SSID24_Test" + str(ind + 1)
                with assume: assert self.driver.find_element(By.ID, "provision_service_wify24g_table_password_" + str(ind + 1)).get_attribute("value") == "Password24_Test" + str(ind + 1)
                with assume: assert self.driver.find_element(By.ID, "provision_service_wify5g_table_active_" + str(ind + 1)).get_attribute("checked")
                with assume: assert self.driver.find_element(By.ID, "provision_service_wify5g_table_ssid_" + str(ind + 1)).get_attribute("value") == "SSID5_Test" + str(ind + 1)
                with assume: assert self.driver.find_element(By.ID, "provision_service_wify5g_table_password_" + str(ind + 1)).get_attribute("value") == "Password5_Test" + str(ind + 1)
            # Check VoIP Setting
            for ind in range (2):
                with assume: assert self.driver.find_element(By.ID, "provision_service_voip_table_uniport_" + str(ind + 1)).get_attribute("value") == str(ind + 1)
                with assume: assert self.driver.find_element(By.ID, "provision_service_voip_table_active_" + str(ind + 1)).get_attribute("checked")
                with assume: assert self.driver.find_element(By.ID, "provision_service_voip_table_username_" + str(ind + 1)).get_attribute("value") == "VoIPUsr" + str(ind + 1)
                with assume: assert self.driver.find_element(By.ID, "provision_service_voip_table_password_" + str(ind + 1)).get_attribute("value") == "VoIPPwd" + str(ind + 1)
                with assume: assert self.driver.find_element(By.ID, "provision_service_voip_table_aor_" + str(ind + 1)).get_attribute("value") == "+88603123456" + str(ind + 1)
            # Check QoS Setting
            # The QoS rows are below the visible part of the dialog, where WebElement.text is '',
            # and they are redrawn while the dialog loads: read textContent once they are filled in.
            qosRowTexts = WebDriverWait(self.driver, 30, poll_frequency=0.5).until(lambda driver: (lambda rows: rows if rows and all(row and row[0] for row in rows) else False)(driver.execute_script(
                "return Array.from(document.querySelectorAll('div.zy_tr')).filter(r => r.className.trim() === 'zy_tr provision_service_profile_qos_table_row')"
                ".map(r => Array.from(r.querySelectorAll(':scope > div')).slice(0, 3).map(c => c.textContent.trim()));")))
            with assume: assert len(qosRowTexts) == 16, f"QoS rows: {qosRowTexts}"
            for ind, qosRow in enumerate(qosRowTexts):
                if ind%2 == 0:
                    with assume: assert qosRow[0] == "service" + str((ind//2) + 1)
                    with assume: assert qosRow[1] == "$py_newExportG" + str((ind//2) + 1)
                    with assume: assert qosRow[2] == "$py_newExportG" + str((ind//2) + 9)
                else:
                    with assume: assert qosRow[0] == "tcont" + str((ind//2) + 1)
                    with assume: assert qosRow[1] == "$py_newExportT" + str((ind//2) + 1)
                    with assume: assert qosRow[2] == "$py_newExportT" + str((ind//2) + 9)
            # Check IP Host
            with assume: assert self.driver.find_element(By.ID, "provision_service_hostip_vlan_text").get_attribute("value") == "4094"
            with assume: assert self.driver.find_element(By.ID, "provision_service_hostip_pbit_text").get_attribute("value") == "7"
            with assume: assert self.driver.find_element(By.ID, "provision_service_hostip_mode_combbox").get_attribute("value") == "2"
            with assume: assert self.driver.find_element(By.ID, "provision_service_hostip_staticip_text").get_attribute("value") == "192.168.123.4"
            with assume: assert self.driver.find_element(By.ID, "provision_service_hostip_mask_text").get_attribute("value") == "255.255.255.0"
            with assume: assert self.driver.find_element(By.ID, "provision_service_hostip_gateway_text").get_attribute("value") == "192.168.123.254"
            with assume: assert self.driver.find_element(By.ID, "provision_service_hostip_pridns_text").get_attribute("value") == "1.2.3.4"
            with assume: assert self.driver.find_element(By.ID, "provision_service_hostip_secdns_text").get_attribute("value") == "5.6.7.8"
            self.driver.find_element(By.XPATH, "//*[@id=\"alarm_clear_note_dialog\"]/div[1]/button/span").click()
            time.sleep(3)


