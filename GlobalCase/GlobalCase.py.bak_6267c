    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5648_ontSecurityPrfAdd(self):
        if self.exeServiceOnt == "": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        deleteServiceWithProfile(self, "$py_TempONTSecurity")
        deleteServiceWithSn(self, self.serviceOntSN)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered") 
        #Delete profile in profile list
        deleteFileIfExisted(self,"ONT Template","$py_TempONTSecurity")
        deleteFileIfExisted(self,"ONT Security Profile","$py_ONTSecurity")
        #Delete auto_ profile if the table full
        deleteAutoMaxFileIfTableFull(self,"ONT Template",3000)
        deleteAutoMaxFileIfTableFull(self,"ONT Security Profile",3000)
        #Create ONT security profile: "$py_ONTSecurity"
        createProfile (self, "ONT Security Profile", "$py_ONTSecurity")
        self.driver.find_element(By.XPATH, "//label[@for=\"ont_security_ams_enable_checkbox\"]").click()
        self.driver.find_element(By.ID, "ont_security_maxfdb_text").send_keys("1023")
        saveProfile (self)
        #Create ONT temp profile: "$py_TempONTSecurity"
        createProfile (self, "ONT Template", "$py_TempONTSecurity")
        selectProfile(self,"ont_template_security_profile_combobox", "$py_ONTSecurity")
        #Select(self.driver.find_element(By.ID, "ont_template_security_profile_combobox")).select_by_visible_text("$py_ONTSecurity")
        saveProfile (self)
        #Create service with "$py_TempONTSecurity"
        createServiceWithIpSnPwdProfile(self, self.dutIp, self.serviceOntSN, self.serviceOntPW, "$py_TempONTSecurity")
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        #with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        if self.serviceOntFlag == "xont":
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempONTSecurity"
        else:
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "--"
        #Check in CLI
        checkValue = []
        #Check ont or ont-14 config
        if self.serviceOntFlag != "xont":
            aid = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] if self.serviceOntFlag == "ont" else "ont-" + ontInfo[1] + "-" + ontInfo[2]
            checkValue = [aid, "no inactive", "sn " + self.serviceOntSN, "password " + self.serviceOntPW, "no anti-mac-spoofing inactive"]
            for checkInd in checkValue:
                with assume: assert checkInd in (await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo))[0]
        #Check neox or ies xont config and profile
        else:
            await setXponSnStyle(self.dutIp, self.dutAdminName, self.dutAdminPwd, "normal")
            serviceOntSNCLI = sn16To12 (self.serviceOntSN)
            #Check neox xont config
            if "NeoX" in self.dutType:
                checkValue = ["Active", "Enable", self.serviceOntPW, serviceOntSNCLI, "", "auto", "none", "$py_TempONTSecurity", "", "", "", "", ""]
            #Check ies xont config
            else:
                checkValue = ["Active", self.serviceOntPW, serviceOntSNCLI, "", "$py_TempONTSecurity", "", "", "", "", ""]
            with assume: assert await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo) == checkValue
            #Check neox temp profile
            if "NeoX" in self.dutType:
                checkValue = ["Template Name: \"$py_TempONTSecurity\"", "Security Profile #1: Name \"$py_ONTSecurity\"", "QoS Downstream Option : ont", "MAC Learning : enable", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            #Check ies temp profile
            else:
                checkValue = ["Template Name: \"$py_TempONTSecurity\"", "Security Profile #1: Name \"$py_ONTSecurity\"", "QoS Downstream Option : ont", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            with assume: assert await cliShowTempProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_TempONTSecurity") == checkValue
            #Check xpon security profile
            checkValue = ['enable', '1023']
            with assume: assert await cliShowSecurityProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_ONTSecurity") == checkValue


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5653_ontSecurityPrfModify(self):
        if self.exeServiceOnt == "": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        #Modify ONT Security Profile: "$py_ONTSecurity"
        modifyProfile (self, "ONT Security Profile", "$py_ONTSecurity")
        if self.driver.find_element(By.ID, "ont_security_ams_enable_checkbox").is_selected():
            self.driver.find_element(By.XPATH, "//label[@for=\"ont_security_ams_enable_checkbox\"]").click()
        self.driver.find_element(By.ID, "ont_security_maxfdb_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ont_security_maxfdb_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ont_security_maxfdb_text").send_keys("1")
        saveProfile (self)
        time.sleep (180)
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Check in CLI
        checkValue = []
        #Check ont or ont-14 config
        if self.serviceOntFlag != "xont":
            aid = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] if self.serviceOntFlag == "ont" else "ont-" + ontInfo[1] + "-" + ontInfo[2]
            checkValue = [aid, "no inactive", "sn " + self.serviceOntSN, "password " + self.serviceOntPW, "anti-mac-spoofing inactive"]
            for checkInd in checkValue:
                with assume: assert checkInd in (await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo))[0]
        #Check neox or ies xont config and profile
        else:
            await setXponSnStyle(self.dutIp, self.dutAdminName, self.dutAdminPwd, "normal")
            serviceOntSNCLI = sn16To12 (self.serviceOntSN)
            #Check neox xont config
            if "NeoX" in self.dutType:
                checkValue = ["Active", "Enable", self.serviceOntPW, serviceOntSNCLI, "", "auto", "none", "$py_TempONTSecurity", "", "", "", "", ""]
            #Check ies xont config
            else:
                checkValue = ["Active", self.serviceOntPW, serviceOntSNCLI, "", "$py_TempONTSecurity", "", "", "", "", ""]
            with assume: assert await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo) == checkValue
            #Check neox ont temp profile
            if "NeoX" in self.dutType:
                checkValue = ["Template Name: \"$py_TempONTSecurity\"", "Security Profile #1: Name \"$py_ONTSecurity\"", "QoS Downstream Option : ont", "MAC Learning : enable", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            #Check ies ont temp profile
            else:
                checkValue = ["Template Name: \"$py_TempONTSecurity\"", "Security Profile #1: Name \"$py_ONTSecurity\"", "QoS Downstream Option : ont", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            with assume: assert await cliShowTempProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_TempONTSecurity") == checkValue
            #Check xpon ont security profile
            checkValue = ['disable', '1']
            with assume: assert await cliShowSecurityProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_ONTSecurity") == checkValue


