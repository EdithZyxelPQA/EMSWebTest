        self.driver.find_element(By.ID, "navside_icon").click()
        for ontIndex in range(self.ontCount):
            rSlot = str(self.rOntInfo[ontIndex]["slot"])
            rPort = str(self.rOntInfo[ontIndex]["port"])
            rOntid = str(self.rOntInfo[ontIndex]["ontid"])
