    @pytest.mark.Unicase
    def test_EMS1_6271_ontServiceUntilOntOnline(self):
        sn = self.serviceOntSN
        password = self.serviceOntPW
        flag = self.serviceOntFlag
        assert sn, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.sn_16"
        assert password, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.pw"
        assert flag, "Missing ZYXEL_DUT.<node>.ONT.<exe_provision_ont>.flag"

        pon_disabled = False
        try:
            print("EMS1-6271: unregister ONT by CLI", flush=True)
            unregister_ont_by_flag(self.dutIp, self.dutAdminName, self.dutAdminPwd, flag, self.serviceOntSlotID, self.serviceOntPortID, self.serviceOntID)

            print("EMS1-6271: disable PON port by CLI", flush=True)
            set_pon_port_inactive_by_flag(
                self.dutIp,
                self.dutAdminName,
                self.dutAdminPwd,
                flag,
                self.serviceOntSlotID,
                self.serviceOntPortID,
                inactive=True,
            )
            pon_disabled = True

            print("EMS1-6271: login EMS", flush=True)
            self.driver.get(self.emsURL)
            login_ems(self.driver, self.emsUsr, self.emsPwd)

            print("EMS1-6271: wait Inventory/ONT SN absent by 16-digit and 12-digit SN", flush=True)
            wait_inventory_ont_absent(self.driver, sn, timeout=300)

            print("EMS1-6271: delete existing ONT service", flush=True)
            delete_ont_service_if_exists(self.driver, sn)

            print("EMS1-6271: create ONT service by manual SN/password", flush=True)
            create_ont_service_by_manual_sn(self.driver, sn, password)

            print("EMS1-6271: verify service stays Wait for at least 1 minute", flush=True)
            assert_ont_service_wait_for_duration(self.driver, sn, duration=60)

            print("EMS1-6271: enable PON port by CLI", flush=True)
            set_pon_port_inactive_by_flag(
                self.dutIp,
                self.dutAdminName,
                self.dutAdminPwd,
                flag,
                self.serviceOntSlotID,
                self.serviceOntPortID,
                inactive=False,
            )
            pon_disabled = False

            print("EMS1-6271: wait ONT service Success", flush=True)
            wait_ont_service_success(self.driver, sn, timeout=900)

            print("EMS1-6271: verify Inventory/ONT registered", flush=True)
            filter_inventory_ont_by_sn(self.driver, sn)
            wait_inventory_ont_id(self.driver, sn, lambda ont_id: ont_id != "Unregistered", timeout=600)
        finally:
            if pon_disabled:
                print("EMS1-6271: restore PON port by CLI", flush=True)
                set_pon_port_inactive_by_flag(
                    self.dutIp,
                    self.dutAdminName,
                    self.dutAdminPwd,
                    flag,
                    self.serviceOntSlotID,
                    self.serviceOntPortID,
                    inactive=False,
                )


# ===== Source: EMSNewCaseTest_20260616/test_ems1_6309_performance_current_interface.py =====



class _NewCase11Cases:
    driver = None
    def _newcase_11_setup_browser(self):
        print("EMS1-6309: create browser", flush=True)
        self.driver = create_browser(self.browser, self.downloadpath)
        self.driver.implicitly_wait(self.waitTime)
        self.driver.set_page_load_timeout(60)
        print("EMS1-6309: maximize browser", flush=True)
        self.driver.maximize_window()
        print("EMS1-6309: browser ready", flush=True)
        yield
        if self.driver:
            close_browser(self.driver)
            self.driver = None


    @pytest.mark.Unicase
    def test_EMS1_6309_peformanceCurrentInterface(self):
        cards = self._newcase_11__interface_cards()
        if not cards:
            pytest.skip("EMS1-6309 requires non-zero interface-card slots in environment_parameter.json CARDINFO.")

        self._newcase_11__open_ems()
        login_ems(self.driver, self.emsUsr, self.emsPwd)
        close_all_current_charts(self.driver)

        try:
            for performance_type in ["Interface(Accumulation)", "Interface(Rate)"]:
                for card_index, card in enumerate(cards, start=1):
                    print(
                        f"EMS1-6309: test {performance_type}, card {card_index}/{len(cards)} "
                        f"slot={card['slot_id']} card={card['type']}",
                        flush=True,
                    )
                    targets, initial_probe_count = self._newcase_11__discover_card_targets(
                        performance_type,
                        card,
                    )
                    self._newcase_11__create_and_verify_card_ports(
                        performance_type,
                        targets,
                        initial_probe_count,
                    )
                    close_all_current_charts(self.driver)
        finally:
            close_create_demand(self.driver)
            close_all_current_charts(self.driver)
    def _newcase_11__discover_card_targets(self, performance_type, card):
        print(
            f"EMS1-6309: open Create for {performance_type}, "
            f"slot={card['slot_id']} card={card['type']}",
            flush=True,
        )
        open_create_demand(self.driver)
        time.sleep(2)
        initial_probe_count = available_probe_count(self.driver)
        assert initial_probe_count > 0, (
            "The currently available number of probes must be greater than 0 "
            f"before the first Create. actual={initial_probe_count}"
        )
        try:
            ports = interface_port_options(
                self.driver,
                performance_type,
                self.dutNodeName,
                card["slot_id"],
                card["type"],
            )
        except Exception:
            close_create_demand(self.driver)
            raise
        targets = [{**card, "port_id": port_id} for port_id in ports]
        assert targets, (
            f"No Performance/Current port options found for {performance_type} "
            f"slot={card['slot_id']} card={card['type']}"
        )
        print(
            f"EMS1-6309: ports={ports}, initial probes={initial_probe_count}",
            flush=True,
        )
        return targets, initial_probe_count
    def _newcase_11__create_and_verify_card_ports(
        self,
        performance_type,
        targets,
        initial_probe_count,
    ):
        # Create every port of the card back to back (no wait / check between Creates),
        # then verify once for the whole card: N new charts and exactly N fewer probes.
        count = len(targets)
        port_ids = [target["port_id"] for target in targets]
        assert initial_probe_count >= count, (
            "Not enough probes for all ports of the card. "
            f"available={initial_probe_count}, ports={count}"
        )
        charts_before = len(self.driver.find_elements(By.XPATH, "//*[starts-with(@id,'pm_')]"))
        print(
            f"EMS1-6309: create {count} {performance_type} charts continuously "
            f"(slot={targets[0]['slot_id']}, ports={port_ids}), probes={initial_probe_count}",
            flush=True,
        )
        create_interface_current_charts_in_open_dialog(
            self.driver,
            performance_type,
            self.dutNodeName,
            targets[0]["slot_id"],
            targets[0]["type"],
            port_ids,
        )
        close_create_demand(self.driver)

        # New charts only appear on the Current page after a refresh
        expected_charts = charts_before + count
        charts_after = current_chart_count_after_refresh(self.driver, expected_charts)
        print(f"EMS1-6309: charts before={charts_before}, after={charts_after}, expected={expected_charts}", flush=True)
        with assume:
            assert charts_after == expected_charts, (
                f"{performance_type}: every Create should add one chart. "
                f"before={charts_before}, after={charts_after}, created={count}"
            )

        open_create_demand(self.driver)
        time.sleep(2)
        expected_probe_count = initial_probe_count - count
        final_probe_count = available_probe_count(
            self.driver,
            timeout=60,
            expected=expected_probe_count,
        )
        print(
            f"EMS1-6309: probes before={initial_probe_count}, after={final_probe_count}, "
            f"expected={expected_probe_count}",
            flush=True,
        )
        assert final_probe_count == expected_probe_count, (
            "The currently available number of probes must decrease by exactly the number of "
            f"created charts. before={initial_probe_count}, created={count}, actual={final_probe_count}"
        )
        close_create_demand(self.driver)

        time.sleep(10)
        refresh_current_page(self.driver)
        # every chart is scrolled into view before reading (charts off screen are not rendered);
        # polling is 1 minute, so allow a few polling cycles for the data to arrive
        chart_states = wait_for_all_charts_with_frontend_data_scrolled(
            self.driver,
            expected_count=count,
            timeout=180,
        )
        print(
            f"EMS1-6309: {performance_type} charts with data: "
            f"{len([s for s in chart_states if s.get('has_frontend_data')])}/{count}",
            flush=True,
        )
        close_all_current_charts(self.driver)
    def _newcase_11__interface_cards(self):
        if "OLT14" in str(self.dutType).upper():
            return [{"slot_id": "--", "type": self.dutType}]
        cards = []
        for card in self.dutCardInfo.values():
            slot_id = str(card.get("slot_id", "")).strip()
            card_type = str(card.get("type", "")).strip()
            if slot_id and slot_id not in {"0", "--"} and card_type:
                cards.append({"slot_id": slot_id, "type": card_type})
        return sorted(
            cards,
            key=lambda card: int(card["slot_id"]) if card["slot_id"].isdigit() else card["slot_id"],
        )
    def _newcase_11__target_names(self, performance_type, targets):
        return [
            f"{performance_type} : {self.dutNodeName} - {target['type']}({target['slot_id']}) - "
            f"{target['port_id']}, Polling : 1 Minutes"
            for target in targets
        ]

    def _newcase_11__open_ems(self):
        try:
            self.driver.get(self.emsURL)
        except TimeoutException:
            print("EMS1-6309: EMS page load timeout; continue with current page", flush=True)


# ===== Source: EMSNewCaseTest_20260616/test_ems1_7065_7066_7068_ethernet_access_port_status.py =====


class _NewCase12Cases:
    driver = None
    ethernet_access_statuses = ["Up", "Down", "Device Not Responding"]
    def _newcase_12_setup_browser(self):
        self.driver = create_browser(self.browser, self.downloadpath)
        self.driver.implicitly_wait(self.waitTime)
        self.driver.set_page_load_timeout(60)
        self.driver.maximize_window()
        yield
        if self.driver:
            close_browser(self.driver)
            self.driver = None


    @pytest.mark.Unicase
    def test_EMS1_7065_7066_7068_ethernetAccessPortStatus(self):
        print("EMS1-7065/7066/7068: login EMS")
        self.driver.get(self.emsURL)
        login_ems(self.driver, self.emsUsr, self.emsPwd)

        available_statuses = ethernet_access_status_names(self.driver)
        with assume:
            assert all(status in available_statuses for status in self.ethernet_access_statuses), available_statuses

        for status in self.ethernet_access_statuses:
            print(f"EMS1-7065/7066/7068: check Ethernet Access Port Status {status}")
            # Port data keeps changing (e.g. simulator devices), so the numbers read at different
            # moments may differ.  Read again (up to 3 times) until they agree.
            attempts = []
            for attempt in range(1, 4):
                dashboard_count = click_ethernet_access_status(self.driver, status)
                table_total = ethernet_access_status_table_total(self.driver)
                # Only the first and the last page are read (the table can have hundreds of pages)
                first_rows, last_rows, page_total = table_rows_first_last_pages(self.driver, GE_PORT_STATUS_TABLE)
                total_after_read = ethernet_access_status_table_total(self.driver)
                counted = len(first_rows) if page_total == 1 else len(first_rows) * (page_total - 1) + len(last_rows)
                attempts.append(
                    f"#{attempt}: dashboard={dashboard_count}, total={table_total}, total after paging={total_after_read}, "
                    f"first page={len(first_rows)}, last page={len(last_rows)}, pages={page_total}, counted={counted}"
                )
                dashboard_ok = dashboard_count == table_total
                rows_ok = counted in (table_total, total_after_read)
                if dashboard_ok and rows_ok:
                    break
                print(f"EMS1-7065/7066/7068: {status} numbers changed while reading, read again ({attempts[-1]})", flush=True)
                time.sleep(3)
            with assume:
                assert dashboard_ok, (
                    f"Dashboard count and table Total data mismatch for {status} in every attempt: " + "; ".join(attempts)
                )
            with assume:
                assert rows_ok, (
                    f"Row count from first/last page does not match table Total data for {status} in every attempt: "
                    + "; ".join(attempts)
                )
            rows = first_rows + (last_rows if page_total > 1 else [])

            for index, row in enumerate(rows, start=1):
                operation_status = row_operation_status(row)
                with assume:
                    assert operation_status == status, (
                        f"Unexpected Operation Status on {status} page row {index}: "
                        f"{operation_status}; row={row}"
                    )


