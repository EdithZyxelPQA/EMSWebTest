    @pytest.mark.Unicase
    def test_EMS1_6090_ontStatusSort(self):
        print("EMS1-6090: login EMS", flush=True)
        self.driver.get(self.emsURL)
        login_ems(self.driver, self.emsUsr, self.emsPwd)

        entries = ont_status_entries(self.driver)
        with assume:
            assert entries, "No clickable Dashboard/ONT Status entries found"

        for entry in entries:
            status = entry["name"]
            print(f"EMS1-6090: check ONT Status sort for {status}", flush=True)
            dashboard_count = click_ont_status(self.driver, entry)
            table_total = total_data(self.driver, ONT_STATUS_TABLE)
            print(
                f"EMS1-6090: ONT Status {status} dashboard count={dashboard_count}, table total={table_total}",
                flush=True,
            )

            if table_total == 0:
                print(f"EMS1-6090: skip ONT Status {status} sort because Total data is 0", flush=True)
                continue

            columns = sortable_table_columns(self.driver, ONT_STATUS_TABLE)
            with assume:
                assert columns, f"No sortable columns found for ONT Status {status}"

            for column in columns:
                column_name = column["name"]
                column_label = column.get("label", column_name)
                column_index = column["index"]
                # Slot "0" means "no slot" (e.g. OLT ONTs); EMS keeps those rows on top in both directions
                slot_rule = {"empty_values": ("0",), "empty_always_first": True} if column_label == "Slot" else {}

                print(f"EMS1-6090: {status} column [{column_label}] direction [ascending]", flush=True)
                ascending_values = None
                with assume:
                    click_table_sort_direction(
                        self.driver,
                        ONT_STATUS_TABLE,
                        column_index,
                        column_name,
                        descending=False,
                    )
                    assert_column_sorted_each_page(
                        self.driver,
                        ONT_STATUS_TABLE,
                        column_name,
                        descending=False,
                        context=f"{status}/column [{column_label}]/direction [ascending]",
                        text_case="sensitive",
                        numeric_natural=True,
                        empty_first=True,
                        **slot_rule,
                        page_scope="first",
                    )
                    ascending_values = first_page_column_values(self.driver, ONT_STATUS_TABLE, column_name)

                print(f"EMS1-6090: {status} column [{column_label}] direction [descending]", flush=True)
                with assume:
                    click_table_sort_direction(
                        self.driver,
                        ONT_STATUS_TABLE,
                        column_index,
                        column_name,
                        descending=True,
                    )
                    assert_column_sorted_each_page(
                        self.driver,
                        ONT_STATUS_TABLE,
                        column_name,
                        descending=True,
                        context=f"{status}/column [{column_label}]/direction [descending]",
                        text_case="sensitive",
                        numeric_natural=True,
                        empty_first=True,
                        **slot_rule,
                        page_scope="first",
                    )
                    if ascending_values is not None:
                        # whole-table check with only the first page of each direction
                        assert_sort_direction_extremes(
                            ascending_values, first_page_column_values(self.driver, ONT_STATUS_TABLE, column_name),
                            column_name, context=f"{status}/column [{column_label}]", **{"text_case": "sensitive", "numeric_natural": True, "empty_first": True, **slot_rule},
                        )


