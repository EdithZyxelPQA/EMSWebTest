    # Maintenance / Firmware File Management
    @pytest.mark.Unicase
    def test_EMS1_3615_3616_FirmwareUploadDelete(self):
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Firmware File Management").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
        time.sleep(3)
        p = self.driver.window_handles[0]
        c = waitNewWindowHandle(self)
        self.driver.switch_to.window(c)
        minTime = datetime.now()
        maxTime = minTime + timedelta(seconds = 600)
        self.driver.find_element(By.ID, "loadfile").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "load").send_keys(self.uploadPath + os.sep + "ABC abc.tar.gz")
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, ".button").click()
        time.sleep(180)
        #with assume: assert self.driver.switch_to.alert.text == "Upload Success"
        #self.driver.switch_to.alert.accept()
        self.driver.switch_to.window(p)
        entryPosition = getPositionByCol(self, "schedule_fw_table", "name", "ABC abc.tar.gz")
        uploadTimeStr = getElementByPositionCol (self, "schedule_fw_table", entryPosition , "time").text.removesuffix(self.timeZone) 
        uploadTime = parser.parse(uploadTimeStr)
        with assume: assert minTime <= uploadTime <= maxTime
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        time.sleep(3)
        getElementByPositionCol (self, "schedule_fw_table", entryPosition , "Checkbox").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_delete > a").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        time.sleep(3)
        with assume: assert [-1,-1] == getPositionByCol(self, "schedule_fw_table", "name", "ABC abc.tar.gz")


    # Provision/ Service/ Ont
    @pytest.mark.asyncio
    @pytest.mark.Unicase
    async def test_EMS1_6261_serviceManualInput(self):
        if self.exeServiceOnt == "": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        deleteServiceWithSn(self, self.serviceOntSN)
        await cliNoOnt(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo)
        waitOntIdUpdate(self, self.serviceOntSN, "Unregistered")
        self.driver.find_element(By.LINK_TEXT, "Provision").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "Service").click()
        time.sleep (3)
        self.driver.find_element(By.ID, "service_tab_ont").click()
        time.sleep (3)
        self.driver.find_element(By.CSS_SELECTOR, "#provision_service_create > a").click()
        time.sleep (3)
        action = ActionChains(self.driver)
        action.double_click(self.driver.find_element(By.XPATH, "//*[@id=\"EditTable\"]/div[2]/table/tbody/tr/td[2]")).send_keys(self.serviceOntSN).perform()
        time.sleep (3)
