        waitInfoUpdateByCol (self, "dev_inventory_div", entryPosition, "Location", locationInfo)
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Schedule").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
        time.sleep(3)
        Select(self.driver.find_element(By.ID, "schedule_type")).select_by_visible_text("Configuration restore")
        time.sleep(3)
        self.driver.find_element(By.ID, "schedule_name").click()
        setScheduleName(self, "AutoTest_ConfigurationRestore")
        self.driver.find_element(By.XPATH, "//input[@type=\'image\']").click()
        self.driver.find_element(By.XPATH, "//span[contains(.,\'Select File On Server\')]").click()
        self.driver.find_element(By.ID, "loadfile").click()
        time.sleep(3)
        try:
            self.driver.find_element(By.XPATH,"//table[@id=\'schedule_backup_config_table\']/tbody/tr").location_once_scrolled_into_view
        except NoSuchElementException:
            assert False
        leftTableRows = self.driver.find_elements(By.XPATH,"//table[@id=\'schedule_backup_config_table\']/tbody/tr")
        break_out_flag = False
        for leftTableRow in range(len(leftTableRows)):
            leftRowIndex = leftTableRow + 1
            if self.driver.find_element(By.XPATH, "//table[@id=\'schedule_backup_config_table\']/tbody/tr[" + str(leftRowIndex) + "]/td[2]").text == "AutoTest_ConfigurationBackup":
                self.driver.find_element(By.XPATH, "//table[@id=\'schedule_backup_config_table\']/tbody/tr[" + str(leftRowIndex) + "]/td[1]/label").click()
                try:
                    self.driver.find_element(By.XPATH,"//table[@id=\'restore_device_table\']/tbody/tr").location_once_scrolled_into_view
                except NoSuchElementException:
                    assert False
                rightTableRows = self.driver.find_elements(By.XPATH,"//table[@id=\'restore_device_table\']/tbody/tr")
                for rightTableRow in range(len(rightTableRows)):
                    rightRowIndex = rightTableRow + 1
                    if self.driver.find_element(By.XPATH, "//table[@id=\'restore_device_table\']/tbody/tr[" + str(rightRowIndex) + "]/td[2]").text == dutName:
                        self.driver.find_element(By.XPATH, "//table[@id=\'restore_device_table\']/tbody/tr[" + str(rightRowIndex) + "]/td[1]/label").click()
                        break_out_flag = True
                        break
                if break_out_flag:
                    break
        self.driver.find_element(By.XPATH, "(//input[@value=\'Add\'])[2]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "(//input[@value=\'Add\'])[2]").click()
        time.sleep(3)
        self.driver.find_element(By.ID, "time").click()
        scheduleTime = (datetime.now() + timedelta(seconds = 5)).strftime(dateFormat)
        self.driver.find_element(By.ID, "time").clear()
        self.driver.find_element(By.ID, "time").send_keys(scheduleTime)
        self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
        self.driver.find_element(By.CSS_SELECTOR, ".button_center").click()
        time.sleep(3)
        entryPosition = getPositionByCol(self, "schedule_table", "ScheduleTime", scheduleTime + timeZone)
        waitScheduleSuccess (self, entryPosition)
        openScheduleResult(self, entryPosition)
        time.sleep(2)
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement .modal-content").screenshot("./report/ConfigRestoreDetail.png")
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        #Maintanence table summary assert
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleStatus").text == "Finish"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Name").text == "AutoTest_ConfigurationRestore"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleType").text == "Once"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Result_Hyperlink").text == "Success"
        #Maintanence table detail 1 assert
        openScheduleResult(self, entryPosition)
        time.sleep(3)
        with assume: assert getScheduleResultByCol (self, "Index") == "1"
        with assume: assert getScheduleResultByCol (self, "Schedule Name") == "AutoTest_ConfigurationRestore"
        minTime = datetime.strptime(scheduleTime, dateFormat)
        maxTime = minTime + timedelta(seconds = 600)
        timeResult = getScheduleResultByCol (self, "Execute Time").removesuffix(timeZone) 
        with assume: assert minTime <= datetime.strptime(timeResult, dateFormat) <= maxTime
        resultSummary = getScheduleResultByCol (self, "Result Summary")
        resultSummaryList = resultSummary.split(",")
        resultSummaryList = [re.sub(r"^.*:", "", i,flags = re.DOTALL) for i in resultSummaryList]
        with assume: assert int(resultSummaryList[0]) >= 0
        with assume: assert int(resultSummaryList[1]) == 0
        #Maintanence table detail 2 assert
        detailScheduleNameList = getScheduleResultDetailListByCol (self, "ScheduleName")
        detailExecuteDateList = getScheduleResultDetailListByCol (self, "Date")
        detailDeviceNameList = getScheduleResultDetailListByCol (self, "DeviceName")
        detailSlotList = getScheduleResultDetailListByCol (self, "SlotID")
        detailPortList = getScheduleResultDetailListByCol (self, "PortID")
        detailONTList = getScheduleResultDetailListByCol (self, "OntID")
        detailResultList = getScheduleResultDetailListByCol (self, "Result ")
        detailCauseList = getScheduleResultDetailListByCol (self, "Cause ")
        with assume: assert checkAllElementInListAre (detailScheduleNameList, "AutoTest_ConfigurationRestore")
        with assume: assert checkAllElementInListPartialMatch (detailExecuteDateList, scheduleTime)
        with assume: assert checkAllElementInListAre (detailDeviceNameList, dutName)
        with assume: assert checkAllElementInListAre (detailSlotList, "--")
        with assume: assert checkAllElementInListAre (detailPortList, "--")
        with assume: assert checkAllElementInListAre (detailONTList, "--")
        with assume: assert checkAllElementInListAre (detailResultList, "Success")
        with assume: assert checkAllElementInListPartialMatch (detailCauseList, "Success")
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        time.sleep(3)
        #Maintanence table detail assert
        getElementByPositionCol(self, "schedule_table", entryPosition , "Modify").click()
        time.sleep(3)
        with assume: assert self.driver.find_element(By.ID, "schedule_type").get_attribute("value") == "maintenance/config_restore"
        with assume: assert self.driver.find_element(By.ID, "schedule_name").get_attribute("value") == "AutoTest_ConfigurationRestore"
        self.driver.find_element(By.CSS_SELECTOR, ".exit").click()
        time.sleep(300)
        self.driver.find_element(By.LINK_TEXT, "Inventory").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Device").click()
        time.sleep(3)
        #Check the config restore
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
        self.driver.find_element(By.ID, "inventory_device_clear_btn").click()
        self.driver.find_element(By.ID, "ip1").send_keys(dutIp)
        self.driver.find_element(By.ID, "inventory_device_btn").click()
        entryPosition = getPositionByCol(self, "dev_inventory_div", "IPAddress", dutIp)
        with assume: assert getElementByPositionCol(self, "dev_inventory_div", entryPosition , "Location").text != locationInfo


    @pytest.mark.asyncio
