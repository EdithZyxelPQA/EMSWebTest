        time.sleep (180)
        for prfIndx in range(8):
            checkValue = ["4", "0", "0", str((prfIndx+1)*10240)]
            with assume: assert await cliShowBandwidthProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, "$py_BandwidthUNIUp" + str(prfIndx+1)) == checkValue
            with assume: assert await cliShowBandwidthProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, "$py_BandwidthUNIDown" + str(prfIndx+1)) == checkValue
            with assume: assert await cliShowBandwidthProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, "$py_BandwidthUNIUpT" + str(prfIndx+1)) == checkValue
            with assume: assert await cliShowBandwidthProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, "$py_BandwidthUNIDownT" + str(prfIndx+1)) == checkValue


