        Select(self.driver.find_element(By.ID, "ge_template_speed_combobox")).select_by_visible_text("Auto")
        self.driver.find_element(By.ID, "ge_template_mtu_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ge_template_mtu_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ge_template_mtu_text").send_keys("9200")
        self.driver.find_element(By.ID, "ge_template_pvid_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ge_template_pvid_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ge_template_pvid_text").send_keys("4094")
        self.driver.find_element(By.ID, "ge_template_pbit_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "ge_template_pbit_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "ge_template_pbit_text").send_keys("7")
        elementScrolledIntoView(self, self.driver.find_element(By.NAME, "getmplateprofile_frametype"))
        Select(self.driver.find_element(By.NAME, "getmplateprofile_frametype")).select_by_visible_text("Tagged only")
        self.driver.find_element(By.XPATH, "//label[@for=\"ge_template_copycpbit_checkbox\"]").click()
        self.driver.find_element(By.XPATH, "//label[@for=\"ge_template_outertpid_checkbox\"]").click()
        # VLAN add
        self.driver.find_element(By.ID, "ge_template_vlantable_vlan_add").click()
        WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID,"ge_template_vid_text")))
        self.driver.find_element(By.ID, "ge_template_vid_text").send_keys("101")
        Select(self.driver.find_element(By.ID, "ge_template_mode_combobox")).select_by_visible_text("Forbidden")
        self.driver.find_element(By.ID, "popupCallBack").click()
        WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID,"ge_template_vlantable_vlan_add")))
        self.driver.find_element(By.ID, "ge_template_vlantable_vlan_add").click()
        WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID,"ge_template_vid_text")))
        self.driver.find_element(By.ID, "ge_template_vid_text").send_keys("102")
        Select(self.driver.find_element(By.ID, "ge_template_mode_combobox")).select_by_visible_text("Fix")
        self.driver.find_element(By.ID, "popupCallBack").click()
        WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID,"ge_template_vlantable_vlan_add")))
        self.driver.find_element(By.ID, "ge_template_vlantable_vlan_add").click()
        WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID,"ge_template_vid_text")))
        self.driver.find_element(By.ID, "ge_template_vid_text").send_keys("103")
        Select(self.driver.find_element(By.ID, "ge_template_mode_combobox")).select_by_visible_text("Normal")
        self.driver.find_element(By.ID, "popupCallBack").click()
        WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID,"ge_template_vlantable_vlan_add")))
        self.driver.find_element(By.ID, "ge_template_vlantable_vlan_add").click()
