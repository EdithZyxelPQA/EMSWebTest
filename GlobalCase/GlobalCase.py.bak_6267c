        self.driver.find_element(By.ID, "ont_fw_upgrade_starttime").click()
        testTime = (datetime.now() + timedelta(hours = 3))
        scheduleTimeStart = testTime.strftime("%H:%M:%S")
        self.driver.find_element(By.ID, "ont_fw_upgrade_starttime").click()
        self.driver.find_element(By.ID, "ont_fw_upgrade_starttime").clear()
        self.driver.find_element(By.ID, "ont_fw_upgrade_starttime").send_keys(scheduleTimeStart)
        self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
        self.driver.find_element(By.ID, "ont_fw_upgrade_endtime").click()
        scheduleTimeEnd = (testTime + timedelta(minutes = 40)).strftime("%H:%M:%S")
        self.driver.find_element(By.ID, "ont_fw_upgrade_endtime").clear()
        self.driver.find_element(By.ID, "ont_fw_upgrade_endtime").send_keys(scheduleTimeEnd)
        self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'Reboot ONT after successful firmware upgrade\')]").click()
        self.driver.find_element(By.ID, "add_row").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
        self.driver.find_element(By.XPATH, "//input[@value=\'Search ONT\']").click()
        time.sleep(3)
        clickBySlotPortOnt(self, self.dutName, self.upgradeOntSlotID, self.upgradeOntPortID, self.upgradeOntOntID)
        self.driver.find_element(By.XPATH, "//input[@value=\'Add\']").click()
        self.driver.find_element(By.XPATH, "//input[@value=\'Save\']").click()
        time.sleep(5)
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        waitInfoUpdateByCol (self, "schedule_table", entryPosition, "ScheduleStatus", "Wait")
        getElementByPositionCol(self, "schedule_table", entryPosition , "Modify").click()
        time.sleep(3)
        with assume: assert self.driver.find_element(By.ID, "schedule_tittle").text == "Modify Schedule"
        # ONT firmware upgrade modify in processing
        testTime = (datetime.now() + timedelta(seconds = 5))
        scheduleTimeStart = testTime.strftime("%H:%M:%S")
        self.driver.find_element(By.ID, "ont_fw_upgrade_starttime").click()
        self.driver.find_element(By.ID, "ont_fw_upgrade_starttime").clear()
        self.driver.find_element(By.ID, "ont_fw_upgrade_starttime").send_keys(scheduleTimeStart)
        self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
        self.driver.find_element(By.ID, "ont_fw_upgrade_endtime").click()
        scheduleTimeEnd = (testTime + timedelta(minutes = 40)).strftime("%H:%M:%S")
        self.driver.find_element(By.ID, "ont_fw_upgrade_endtime").clear()
        self.driver.find_element(By.ID, "ont_fw_upgrade_endtime").send_keys(scheduleTimeEnd)
        self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
        self.driver.find_element(By.CSS_SELECTOR, ".button_center").click()
        time.sleep(10)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        waitInfoUpdateByCol (self, "schedule_table", entryPosition, "ScheduleStatus", "Processing")
        getElementByPositionCol(self, "schedule_table", entryPosition , "Modify").click()
        time.sleep(3)
        with assume: assert waitMessageText(self) == "Cannot modify processing schedule task."
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        #  ONT firmware upgrade modify in success
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        waitInfoUpdateByCol (self, "schedule_table", entryPosition, "ScheduleStatus", "Finish")
        getElementByPositionCol(self, "schedule_table", entryPosition , "Modify").click()
        time.sleep(3)
        with assume: assert self.driver.find_element(By.ID, "schedule_tittle").text == "Modify Schedule"
        self.driver.find_element(By.CSS_SELECTOR, ".exit").click()
        time.sleep(3)
        # Check in Result Log
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        openScheduleResult(self, entryPosition)
        time.sleep(3)
        executeTime = getScheduleResultByCol (self, "Execute Time")
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        time.sleep(3)
        scheduleType = getElementByPositionCol(self, "schedule_table", entryPosition , "Type").text
        scheduleResult = getElementByPositionCol(self, "schedule_table", entryPosition , "Result_Hyperlink").text
        self.driver.find_element(By.LINK_TEXT, "Result Log").click()
        time.sleep(3)
        entryPosition = getPositionByCol(self, "schedule_result_table", "Date", executeTime)
        with assume: assert getElementByPositionCol(self, "schedule_result_table", entryPosition , "Type").text == scheduleType
        with assume: assert getElementByPositionCol(self, "schedule_result_table", entryPosition , "Result").text == scheduleResult
        with assume: assert getElementByPositionCol(self, "schedule_result_table", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "schedule_result_table", entryPosition , "IPAddress").text == self.dutIp
        expectedSlotId = "--" if "OLT" in self.dutType else self.upgradeOntSlotID
        with assume: assert getElementByPositionCol(self, "schedule_result_table", entryPosition , "SlotID").text == expectedSlotId
        with assume: assert getElementByPositionCol(self, "schedule_result_table", entryPosition , "PortID").text == self.upgradeOntPortID


