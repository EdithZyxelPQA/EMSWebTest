    # Maintenance / Schedule / Delete Config Backup
    @pytest.mark.Unicase
    def test_EMS1_6967_scheduleDeleteConfigBackup(self):
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Schedule").click()
        time.sleep(3)
        # Config backup delete in wait
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
        time.sleep(3)
        Select(self.driver.find_element(By.ID, "schedule_type")).select_by_visible_text("Configuration backup")
        time.sleep(3)
        self.driver.find_element(By.ID, "schedule_name").click()
        exeTime = (datetime.now()).strftime("%Y-%m-%d_%H:%M:%S")
        scheduleName = "$py_" + exeTime
        setScheduleName(self, scheduleName)
        self.driver.find_element(By.XPATH, "//span[contains(.,\'Once\')]").click()
        self.driver.find_element(By.ID, "time").click()
        scheduleTime = (datetime.now() + timedelta(hours = 3)).strftime("%Y-%m-%d %H:%M:%S")
        self.driver.find_element(By.ID, "time").clear()
        self.driver.find_element(By.ID, "time").send_keys(scheduleTime)
        self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
        self.driver.find_element(By.CSS_SELECTOR, ".button_center").click()
        time.sleep(3)
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        waitInfoUpdateByCol (self, "schedule_table", entryPosition, "ScheduleStatus", "Wait")
        getElementByPositionCol (self, "schedule_table", entryPosition , "Checkbox").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_delete > a").click()
        time.sleep(3)
        # Cancel while "Delete "Backup Schedule" will also delete backup files , are you sure ?"
        assert self.driver.find_element(By.ID, "confirm_message_text").text == "Delete \"Backup Schedule\" will also delete backup files , are you sure ?" 
        self.driver.find_element(By.ID, "confirm_no_button").click()
