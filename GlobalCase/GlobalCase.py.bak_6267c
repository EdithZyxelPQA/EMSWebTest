                    with assume: assert ("show interface ge " + slotID + "-" + portID + " ddmi status") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show interface ge " + slotID + "-" + portID + " statistics") in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                    with assume: assert ("show fdb address-table sort-option mac port " + slotID + "-" + portID) in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
                case "GPON":
                    if "OLT14" in self.dutType:
                        with assume: assert ("show interfaces pon-" + portID ) in self.driver.find_element(By.ID, "inventory_status_message").get_attribute("value")
