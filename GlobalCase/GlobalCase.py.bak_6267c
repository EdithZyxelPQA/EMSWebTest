        ontAid = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] if self.serviceOntFlag == "ont" else "ont-" + ontInfo[1] + "-" + ontInfo[2]
        uniportAid = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] if self.serviceOntFlag == "ont" else "uniport-" + ontInfo[1] + "-" + ontInfo[2]
        checkList = [[ontAid, 'no inactive', 'sn ' + self.serviceOntSN, 'password ' + self.serviceOntPW, 'description ForServceGponTest'
                    , 'alarm-profile DEFVAL', 'anti-mac-spoofing inactive'
                    , 'bwgroup 1 usbwprofname \$py_Bw_G dsbwprofname \$py_Bw_G(()|( allocid \d+))'
                    , 'ontWan 1\n vlan 101 priority 0 mvlan 101\n connection-type pppoe username Usr1@hinet.net password Pwd1\n ip static 192.168.101.1 255.255.255.0 192.168.101.254 11.2.3.41 55.6.7.81\n enable\n exit'
                    , 'ontWan 2\n vlan 102 priority 1 mvlan 102\n connection-type pppoe username Usr2@hinet.net password Pwd2\n ip static 192.168.102.1 255.255.255.0 192.168.102.254 11.2.3.42 55.6.7.82\n enable\n exit'
                    , 'ontWan 3\n vlan 103 priority 2 mvlan 103\n connection-type pppoe username Usr3@hinet.net password Pwd3\n ip static 192.168.103.1 255.255.255.0 192.168.103.254 11.2.3.43 55.6.7.83\n enable\n exit'
                    , 'ontWan 4\n vlan 104 priority 3 mvlan 104\n connection-type pppoe username Usr4@hinet.net password Pwd4\n ip static 192.168.104.1 255.255.255.0 192.168.104.254 11.2.3.44 55.6.7.84\n enable\n exit'
                    , 'ontWan 5\n vlan 105 priority 4 mvlan 105\n connection-type pppoe username Usr5@hinet.net password Pwd5\n ip static 192.168.105.1 255.255.255.0 192.168.105.254 11.2.3.45 55.6.7.85\n enable\n exit'
                    , 'ontWan 6\n vlan 106 priority 5 mvlan 106\n connection-type pppoe username Usr6@hinet.net password Pwd6\n ip static 192.168.106.1 255.255.255.0 192.168.106.254 11.2.3.46 55.6.7.86\n enable\n exit'
                    , 'ontWan 7\n vlan 107 priority 6 mvlan 107\n connection-type pppoe username Usr7@hinet.net password Pwd7\n ip static 192.168.107.1 255.255.255.0 192.168.107.254 11.2.3.47 55.6.7.87\n enable\n exit'
                    , 'ontWan 8\n vlan 108 priority 7 mvlan 108\n connection-type pppoe username Usr8@hinet.net password Pwd8\n ip static 192.168.108.1 255.255.255.0 192.168.108.254 11.2.3.48 55.6.7.88\n enable\n exit'
                    , 'ontWifi 2.4g 1\n enable 1\n ssid Test24SSID_1\n password Test24PWD_1\n exit'
                    , 'ontWifi 2.4g 2\n enable 1\n ssid Test24SSID_2\n password Test24PWD_2\n exit'
                    , 'ontWifi 2.4g 3\n enable 1\n ssid Test24SSID_3\n password Test24PWD_3\n exit'
                    , 'ontWifi 2.4g 4\n enable 1\n ssid Test24SSID_4\n password Test24PWD_4\n exit'
                    , 'ontWifi 5g 1\n enable 1\n ssid Test5SSID_1\n password Test5PWD_1\n exit'
                    , 'ontWifi 5g 2\n enable 1\n ssid Test5SSID_2\n password Test5PWD_2\n exit'
                    , 'ontWifi 5g 3\n enable 1\n ssid Test5SSID_3\n password Test5PWD_3\n exit'
                    , 'ontWifi 5g 4\n enable 1\n ssid Test5SSID_4\n password Test5PWD_4\n exit']
                    ,[uniportAid + '-2-1', 'no inactive', 'no pmenable'
                    , 'queue tc 0 priority 0 weight 0 usbwprofname \$py_Bw_G dsbwprofname \$py_Bw_G dsoption ont bwsharegroupid 1'
                    , 'vlan 101 ((ingprof tc0 network 101 gemport \d+)|(network 101 gemport \d+ ingprof tc0)) aesencrypt disable sharepri 0']
                    ,[uniportAid + '-3-1', 'no inactive', 'no pmenable'
                    , 'voip-service mode sip vlan 101 common-profile \$py_Comn_G sip-profile \$py_SIP_G dial-plan \$py_Dial_G aor \+886031234561 disp-name pyName1001 vmail-uri 200.0.10.31(( roh-timer 15)|())'
                    , 'voip-service username VoIPUsr1'
                    , 'voip-service password VoIPPwd1']
                    ,[uniportAid + '-3-2', 'no inactive', 'no pmenable'
                    , 'voip-service mode sip vlan 101 common-profile \$py_Comn_G sip-profile \$py_SIP_G dial-plan \$py_Dial_G aor \+886031234562 disp-name pyName1002 vmail-uri 200.0.10.32(( roh-timer 15)|())'
                    , 'voip-service username VoIPUsr2'
                    , 'voip-service password VoIPPwd2']]
        resultList = await cliShowOntFullConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo)
        with assume: assert gponOntConfigCheckResult (checkList, resultList)


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_6998_ontServiceModifyGpon(self):
        if self.exeServiceOnt == "": return
        if self.serviceOntFlag == "xont": return
        #Need execute test_ontServiceAddGpon test first.
        self.driver.find_element(By.LINK_TEXT, "Provision").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Service").click()
        entryPosition = getPositionByCols(self, "provision_service_table", {"sn":self.serviceOntSN})
        getElementByPositionCol(self, "provision_service_table", entryPosition , "Modify").click()
        time.sleep(3)
        #Edit service with $py_Temp_G
        #Select(self.driver.find_element(By.ID, "provision_service_onttemplate_combbox")).select_by_visible_text("$py_Temp_G")
        #time.sleep(5)
        self.driver.find_element(By.ID, "provision_service_desc_text").send_keys(Keys.CONTROL + "a")
        self.driver.find_element(By.ID, "provision_service_desc_text").send_keys(Keys.DELETE)
        self.driver.find_element(By.ID, "provision_service_desc_text").send_keys("ForServceGponModifyTest")
        #Wan Setting
        for ind in range (8):
            self.driver.find_element(By.ID, "provision_service_wan_table_address_" + str(ind + 1)).send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "provision_service_wan_table_address_" + str(ind + 1)).send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "provision_service_wan_table_address_" + str(ind + 1)).send_keys("192.10" + str(ind + 1) + ".10.1")
            self.driver.find_element(By.ID, "provision_service_wan_table_mask_" + str(ind + 1)).send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "provision_service_wan_table_mask_" + str(ind + 1)).send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "provision_service_wan_table_mask_" + str(ind + 1)).send_keys("255.255.0.0")
            self.driver.find_element(By.ID, "provision_service_wan_table_gateway_" + str(ind + 1)).send_keys(Keys.CONTROL + "a")
            self.driver.find_element(By.ID, "provision_service_wan_table_gateway_" + str(ind + 1)).send_keys(Keys.DELETE)
            self.driver.find_element(By.ID, "provision_service_wan_table_gateway_" + str(ind + 1)).send_keys("192.10" + str(ind + 1) + ".10.254")
