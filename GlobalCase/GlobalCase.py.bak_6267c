        self.driver.find_element(By.XPATH, "//li[contains(.,\'" + self.dutNodeName + "\')]").click()
        time.sleep(3)
        colorElement = self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + self.dutNodeName + "\')]/span[contains(@class,\'node-icon\')]")
        colorStatus = colorElement.get_attribute("class")
        if devStatus == "Unmanaged":
            with assume: assert colorStatus == "icon node-icon icon-dev-0"
        elif devStatus == "Up" and devAlarmStatusCountList[0] > 0:
            with assume: assert colorStatus == "icon node-icon icon-dev-5"
        elif devStatus == "Up" and devAlarmStatusCountList[0] == 0 and devAlarmStatusCountList[1] > 0: 
            with assume: assert colorStatus == "icon node-icon icon-dev-4"
        elif devStatus == "Up" and devAlarmStatusCountList[0] == 0 and devAlarmStatusCountList[1] == 0 and devAlarmStatusCountList[2] > 0: 
            with assume: assert colorStatus == "icon node-icon icon-dev-3"
        elif devStatus == "Up" and devAlarmStatusCountList[0] == 0 and devAlarmStatusCountList[1] == 0 and devAlarmStatusCountList[2] == 0 and devAlarmStatusCountList[3] > 0:
            with assume: assert colorStatus == "icon node-icon icon-dev-2"
        elif devStatus == "Up" and devAlarmStatusCountList == [0, 0, 0, 0]:
            with assume: assert colorStatus == "icon node-icon icon-dev-1"


