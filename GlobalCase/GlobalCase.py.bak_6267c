    # Maintenance / Schedule / Ont Reboot
    @pytest.mark.asyncio
    @pytest.mark.Unicase
    async def test_EMS1_6964_ontReboot(self):
        self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Schedule").click()
        self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
        time.sleep(3)
        Select(self.driver.find_element(By.ID, "schedule_type")).select_by_visible_text("ONT reboot")
        time.sleep(3)
        self.driver.find_element(By.ID, "ont_firmware_schedule_name").click()
        exeTime = (datetime.now()).strftime("%Y-%m-%d_%H:%M:%S")
        scheduleName = "$py_" + exeTime
        self.driver.find_element(By.ID, "ont_firmware_schedule_name").send_keys(scheduleName)
        self.driver.find_element(By.ID, "time").click()
        setTime = (datetime.now() + timedelta(seconds = 5)).strftime(self.dateFormat)
        self.driver.find_element(By.ID, "time").clear()
        self.driver.find_element(By.ID, "time").send_keys(setTime)
        self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
        self.driver.find_element(By.ID, "add_row").click()
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
        self.driver.find_element(By.XPATH, "//input[@value=\'Search ONT\']").click()
        exeOntList = []
        for index in range(self.ontCount):
            time.sleep(3)
            clickBySlotPortOnt(self, self.dutName, self.ontSlotIDList[index], self.ontPortIDList[index], self.ontOntIDList[index])
            exeOntList.append([self.ontSlotIDList[index], self.ontPortIDList[index], self.ontOntIDList[index]])
        exeOntListSort = sorted(exeOntList, key=lambda x: x[0])
        self.driver.find_element(By.CSS_SELECTOR, "#add_table .button").click()
        self.driver.find_element(By.CSS_SELECTOR, ".button_center").click()
        time.sleep(3)
        entryPosition = getPositionByCol(self, "schedule_table", "Name", scheduleName)
        waitScheduleSuccess (self, entryPosition)
        time.sleep(30)
        #Maintanence table detail 1 assert
        openScheduleResult(self, entryPosition)
        time.sleep(3)
        with assume: assert getScheduleResultByCol (self, "Index") == "1"
        with assume: assert getScheduleResultByCol (self, "Schedule Name") == scheduleName
        scheduleTime = getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleTime").text.removesuffix(self.timeZone) 
        minTime = datetime.strptime(setTime, self.dateFormat)
        maxTime = minTime + timedelta(seconds = 600)
        with assume: assert minTime <= datetime.strptime(getScheduleResultByCol (self, "Execute Time").removesuffix(self.timeZone) , self.dateFormat) <= maxTime
        resultSummary = getScheduleResultByCol (self, "Result Summary")
        resultSummaryList = resultSummary.split(",")
        resultSummaryList = [re.sub(r"^.*:", "", i,flags = re.DOTALL) for i in resultSummaryList]
        with assume: assert int(resultSummaryList[0]) >= 0
        with assume: assert int(resultSummaryList[1]) == 0
        #Maintanence table detail 2 assert
        detailScheduleNameList = getScheduleResultDetailListByCol (self, "ScheduleName")
        detailExecuteDateList = getScheduleResultDetailListByCol (self, "Date")
        detailDeviceNameList = getScheduleResultDetailListByCol (self, "DeviceName")
        detailSlotList = getScheduleResultDetailListByCol (self, "SlotID")
        detailPortList = getScheduleResultDetailListByCol (self, "PortID")
        detailONTList = getScheduleResultDetailListByCol (self, "OntID")
        detailResultList = getScheduleResultDetailListByCol (self, "Result ")
        detailCauseList = getScheduleResultDetailListByCol (self, "Cause ")
        with assume: assert checkAllElementInListAre (detailScheduleNameList, scheduleName)
        with assume: assert checkAllElementInListPartialMatch (detailExecuteDateList, scheduleTime)
        with assume: assert checkAllElementInListAre (detailDeviceNameList, self.dutName)
        expectedOntSlotList = [i[0] for i in exeOntListSort] if "OLT" not in self.dutType else ["--" for _ in exeOntListSort]
        with assume: assert detailSlotList == expectedOntSlotList
        with assume: assert detailPortList == [i[1]for i in exeOntListSort]
        with assume: assert detailONTList == [i[2]for i in exeOntListSort]
        with assume: assert checkAllElementInListAre (detailResultList, "Success")
        with assume: assert checkAllElementInListPartialMatch (detailCauseList, "Success")
        self.driver.find_element(By.CSS_SELECTOR, "#AddDevMagement span").click()
        #Maintanence table summary assert
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleStatus").text == "Finish"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Type").text == "ONT Reboot"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "ScheduleType").text == "Once"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Result_Hyperlink").text == "Success"
        with assume: assert getElementByPositionCol(self, "schedule_table", entryPosition , "Toggletype").text == "ONT Reset" 
        time.sleep(180)
        #Check the ont just reboot 
        for index in range(self.ontCount):
            time.sleep(3)
            with assume: assert await checkOntUptime(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.ontFlagList[index], [self.ontSlotIDList[index], self.ontPortIDList[index], self.ontOntIDList[index]]) <= 1200


