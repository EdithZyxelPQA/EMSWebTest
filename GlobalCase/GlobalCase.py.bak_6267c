    @pytest.mark.skip
    @pytest.mark.Unicase
    def test_EMS1_6392_maxUsrAccess(self):
        #maxUsrNum = 1000
        maxUsrNum = 10
        #maxOnlineNum = 300
        maxOnlineNum = 6
        for i in range(maxUsrNum): 
            if (i % 20) == 0: self.driver.refresh()
            kickUsr(self, "PyMax_"+ str(i+1))
        for i in range(maxUsrNum): 
            if (i % 20) == 0: self.driver.refresh()
            delEMSUsr (self, "PyMax_"+ str(i+1))
        for i in range(maxUsrNum):
            if (i % 20) == 0: self.driver.refresh()
            print ("Round" + str(i+1))
            if self.driver.find_element(By.LINK_TEXT, "System").get_attribute("className") == "":
                self.driver.find_element(By.LINK_TEXT, "System").click()
                time.sleep (3)
            if self.driver.find_element(By.LINK_TEXT, "Security").get_attribute("className") == "":
                self.driver.find_element(By.LINK_TEXT, "Security").click()
                time.sleep (3)
            if self.driver.find_element(By.ID, "user_user").get_attribute("className") == "":
                self.driver.find_element(By.ID, "user_user").click()
                time.sleep (3)
            if self.driver.find_element(By.ID, "admin").get_attribute("className") == "user_link":
                self.driver.find_element(By.ID, "admin").click()
                time.sleep (3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_user > a").click()
            time.sleep (3)
            self.driver.find_element(By.ID, "create_user_name").send_keys("PyMax_"+ str(i+1))
            self.driver.find_element(By.ID, "create_password").send_keys("PyMax_"+ str(i+1) + "PWD")
            self.driver.find_element(By.ID, "create_repeatpassword").send_keys("PyMax_"+ str(i+1) + "PWD")
            Select(self.driver.find_element(By.ID, "create_template")).select_by_visible_text("ReadWrite")
            self.driver.find_element(By.ID, "create_logout").clear()
            self.driver.find_element(By.ID, "create_logout").send_keys("0")
            self.driver.find_element(By.XPATH,"//*[@id=\"add_accesstree\"]/ul/li/div[2]").click()
            time.sleep (3)
            self.driver.find_element(By.CSS_SELECTOR, "#create_user .button").click()
            time.sleep (3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep (3)
            if i <= maxOnlineNum:
                self.driver.switch_to.new_window('windows')
                self.driver.get(self.emsURL)
                loginEMS (self, "PyMax_"+ str(i+1),"PyMax_"+ str(i+1) + "PWD")
                p = self.driver.window_handles[0]
                c = waitNewWindowHandle(self)
                self.driver.close()
                self.driver.switch_to.window(p)
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep (3)
        self.driver.find_element(By.LINK_TEXT, "Security").click()
        time.sleep (3)
        self.driver.find_element(By.ID, "user_online").click()
        time.sleep (3)
        self.driver.find_element(By.ID, "i_action_refresh").click()
        time.sleep (3)
        for i in range(maxOnlineNum):
            entryPosition = getPositionByColNext(self, "onlineUserTable", "userName", "PyMax_"+ str(i+1))
            with assume: assert getElementByPositionCol(self, "onlineUserTable", entryPosition , "loginIp").text == getLoginIP()


