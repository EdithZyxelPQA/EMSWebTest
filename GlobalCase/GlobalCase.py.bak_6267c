        for vopInd in range(2):
            elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//label[@for=\'ont_ont_voip_enable_checkbox" + str(vopInd + 1) + "\']"))
            self.driver.find_element(By.XPATH, "//label[@for=\'ont_ont_voip_enable_checkbox" + str(vopInd + 1) + "\']").click()
            self.driver.find_element(By.XPATH, "//label[@for=\'ont_ont_voip_activ_checkbox" + str(vopInd + 1) + "\']").click()
            self.driver.find_element(By.ID, "ont_ont_voip_vlan_text" + str(vopInd + 1)).send_keys("22")
            self.driver.find_element(By.ID, "ont_ont_voip_name_text" + str(vopInd + 1)).send_keys("pyUsr100" + str(vopInd + 1))
            self.driver.find_element(By.ID, "ont_ont_voip_password_text" + str(vopInd + 1)).send_keys("pyPwd100" + str(vopInd + 1))
            self.driver.find_element(By.ID, "ont_ont_voip_aor_text" + str(vopInd + 1)).send_keys("+8860300100" + str(vopInd + 1))
            elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_voip_displayname_text" + str(vopInd + 1)))
            self.driver.find_element(By.ID, "ont_ont_voip_displayname_text" + str(vopInd + 1)).send_keys("pyName100" + str(vopInd + 1))
            elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_voip_sipuri_text" + str(vopInd + 1)))
            self.driver.find_element(By.ID, "ont_ont_voip_sipuri_text" + str(vopInd + 1)).send_keys("200.0.10.3" + str(vopInd + 1))
            elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_voip_common_combobox" + str(vopInd + 1)))
            selectProfile(self,"ont_ont_voip_common_combobox" + str(vopInd + 1), "$py_Comn")
            #Select(self.driver.find_element(By.ID, "ont_ont_voip_common_combobox" + str(vopInd + 1))).select_by_visible_text("$py_Comn")
            elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_voip_sip_combobox" + str(vopInd + 1)))
            selectProfile(self,"ont_ont_voip_sip_combobox" + str(vopInd + 1), "$py_SIP")
            #Select(self.driver.find_element(By.ID, "ont_ont_voip_sip_combobox" + str(vopInd + 1))).select_by_visible_text("$py_SIP")
            elementScrolledIntoView(self, self.driver.find_element(By.ID, "ont_ont_voip_dialplan_combobox" + str(vopInd + 1)))
            selectProfile(self,"ont_ont_voip_dialplan_combobox" + str(vopInd + 1), "$py_Dial")
            #Select(self.driver.find_element(By.ID, "ont_ont_voip_dialplan_combobox" + str(vopInd + 1))).select_by_visible_text("$py_Dial")
        saveProfile (self)
        #For GPON ONT, create ONT UNI profile: "$py_ONTUNIVoIP"
        if self.serviceOntFlag != "xont":
            deleteFileIfExisted(self,"ONT UNI Profile","$py_ONTUNIVoIP")
            deleteAutoMaxFileIfTableFull(self,"ONT UNI Profile",3000)
            #Create ONT uni profile: "$py_ONTUNIVoIP"
            createProfile (self, "ONT UNI Profile", "$py_ONTUNIVoIP")
            # LAN interface
            elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//label[@for=\"ont_uni_lanport_interface_enable_checkbox\"]"))
            self.driver.find_element(By.XPATH, "//label[@for=\"ont_uni_lanport_interface_enable_checkbox\"]").click()
            # XLAN interface
            elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//label[@for=\"ont_uni_xlanport_interface_enable_checkbox\"]"))
            self.driver.find_element(By.XPATH, "//label[@for=\"ont_uni_xlanport_interface_enable_checkbox\"]").click()
            # VEIP interface
            elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//label[@for=\"ont_uni_veipport_interface_enable_checkbox\"]"))
            self.driver.find_element(By.XPATH, "//label[@for=\"ont_uni_veipport_interface_enable_checkbox\"]").click()
            # Pots interface
            elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//label[@for=\"ont_uni_potsport_interface_enable_checkbox\"]"))
            self.driver.find_element(By.XPATH, "//label[@for=\"ont_uni_potsport_interface_enable_checkbox\"]").click()
            saveProfile (self)
        #Create ONT temp profile: "$py_TempONTVoIP"
        createProfile (self, "ONT Template", "$py_TempONTVoIP")
        selectProfile(self,"ont_template_ONT_profile_combobox", "$py_ONTONTVoIP")
        #Select(self.driver.find_element(By.ID, "ont_template_ONT_profile_combobox")).select_by_visible_text("$py_ONTONTVoIP")
        if self.serviceOntFlag != "xont":
            selectProfile(self,"ont_template_uni_profile_combobox", "$py_ONTUNIVoIP")
            #Select(self.driver.find_element(By.ID, "ont_template_uni_profile_combobox")).select_by_visible_text("$py_ONTUNIVoIP")
        saveProfile (self)
        #Create service with "$py_TempONTVoIP"
        createServiceWithIpSnPwdProfile(self, self.dutIp, self.serviceOntSN, self.serviceOntPW, "$py_TempONTVoIP")
        #Wait service finished
        ontInfo = getOntInfoAfterServiceSuccess(self, self.serviceOntSN)
        #Wait DB update
        time.sleep(3)
        waitOntIdUpdate(self, self.serviceOntSN, ontInfo[2])
        #Check intentory result
        filterOntInventory(self, self.dutIp, self.ontInfo)
        entryPosition = [1,1]
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "SubmapName").text == "EMS"
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "DevName").text == self.dutName
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "IPAddress").text == self.dutIp
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "sn").text == self.serviceOntSN
        with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "password").text == self.serviceOntPW
        if self.serviceOntFlag == "xont":
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "$py_TempONTVoIP"
        else:
            with assume: assert getElementByPositionCol(self, "ont_inventory_div", entryPosition , "templateName").text == "--"
        #Check in CLI
        checkValue = []
        #Check ont or ont-14 config
        if self.serviceOntFlag != "xont":
            aid = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] if self.serviceOntFlag == "ont" else "ont-" + ontInfo[1] + "-" + ontInfo[2]
            aidVoip1 = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] + "-3-1" if self.serviceOntFlag == "ont" else "uniport-" + ontInfo[1] + "-" + ontInfo[2] + "-3-1"
            aidVoip2 = ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] + "-3-2" if self.serviceOntFlag == "ont" else "uniport-" + ontInfo[1] + "-" + ontInfo[2] + "-3-2"
            checkValue = [[aid, "no inactive", "sn " + self.serviceOntSN, "password " + self.serviceOntPW]
                        ,[aidVoip1, "no inactive", "voip-service mode sip vlan 22 common-profile $py_Comn sip-profile $py_SIP dial-plan $py_Dial aor +88603001001 disp-name pyName1001 vmail-uri 200.0.10.31"]
                        ,[aidVoip2, "no inactive", "voip-service mode sip vlan 22 common-profile $py_Comn sip-profile $py_SIP dial-plan $py_Dial aor +88603001002 disp-name pyName1002 vmail-uri 200.0.10.32"]]
            if self.serviceOntFlag == "ont":
                checkValue = [[aid, "no inactive", "sn " + self.serviceOntSN, "password " + self.serviceOntPW]
                            ,[aidVoip1, "no inactive", "voip-service mode sip vlan 22 common-profile $py_Comn sip-profile $py_SIP dial-plan $py_Dial aor +88603001001 disp-name pyName1001 vmail-uri 200.0.10.31 roh-timer 15"]
                            ,[aidVoip2, "no inactive", "voip-service mode sip vlan 22 common-profile $py_Comn sip-profile $py_SIP dial-plan $py_Dial aor +88603001002 disp-name pyName1002 vmail-uri 200.0.10.32 roh-timer 15"]]
            result = await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo)
            for checkInd, checkElem in enumerate(checkValue):
                for elem in checkElem:
                    with assume: assert elem in result[checkInd]
        #Check neox or ies xont config and profile
        else: 
            await setXponSnStyle(self.dutIp, self.dutAdminName, self.dutAdminPwd, "normal")
            serviceOntSNCLI = sn16To12 (self.serviceOntSN)
            #Check neox xont config
            if "NeoX" in self.dutType:
                checkValue = ["Active", "Enable", self.serviceOntPW, serviceOntSNCLI, "", "auto", "none", "$py_TempONTVoIP", "", "", "", "", ""]
            #Check ies xont config
            else:
                checkValue = ["Active", self.serviceOntPW, serviceOntSNCLI, "", "$py_TempONTVoIP", "", "", "", "", ""]
            with assume: assert await cliShowOntConfig(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, self.ontInfo) == checkValue
            #Check neox template profile
            if "NeoX" in self.dutType:
                checkValue = ["Template Name: \"$py_TempONTVoIP\"", "Ont Profile #1: Name \"$py_ONTONTVoIP\"", "QoS Downstream Option : ont", "MAC Learning : enable", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            #Check ies template profile
            else:
                checkValue = ["Template Name: \"$py_TempONTVoIP\"", "Ont Profile #1: Name \"$py_ONTONTVoIP\"", "QoS Downstream Option : ont", "DS PIR : -", "encryption algorithm: aes", "encryption scope: service"]
            with assume: assert await cliShowTempProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_TempONTVoIP") == checkValue
            #Check ont ont profile
            checkValue = [['Firewall', 'off', 'none', 'low']
                            , ['Upnp', 'off', 'off']
                            , ['Dmz', 'off', '0.0.0.0']
                            , ['Poe', 'off', 'reserved', 'manual']
                            , ['Service', 'off', 'lan', 'lan', '21', 'lan', '80', 'lan', '443', 'lan', '161', 'lan', '22', 'lan', '23']
                            , ['Roaming', 'off', '40'], ['Acs', 'off', '86400', 'off', 'off', '', '', '']
                            , ['Loopguard', 'off', 'off', '1', '180']
                            , ['Storm Control', 'off', 'off', '0']]
            result = await cliShowOntProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, "$py_ONTONTVoIP")
            for checkInd, checkElem in enumerate(checkValue):
                for elem in checkElem:
                    with assume: assert elem in result[checkInd]
        #Check ont voip-sip-profile profile in CLI
        checkValue = ['200.0.11.1', '200.0.11.2', '200.0.11.3', '200.0.11.4'
                        , '25200', '720', '200.0.11.5', '200.0.11.6', 'ALU'
                        , 'cal-num,cal-nam,cid-blo,cid-num,cid-nam,ACR', 'cal-wai,cid-ann'
                        , '3way,cal-tra,cal-hol,cal-par,not-dis,flash,origin,6way', 'spl-rin,dia-ton,vis-ind,cal-for'
                        , 'enable,dia-opt', '200.0.11.7', '200.0.11.8', '200.0.11.9']
        with assume: assert await cliShowSipProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, "$py_SIP") == checkValue
        #Check ont voip-common-profile profile in CLI
        checkValue = ['1', '65535', '63', 'enable', 'enable', 'enable', 'enable', '5000', '500', '999', 'voi-ann', 'enable', 'T38', 'G729'
                        , 'DVI4-22050', 'DVI4-11025', 'G728', '10', '15', '25', '30', 'enable', 'enable', 'enable', 'enable', 'enable', 'mul-par']
        with assume: assert await cliShowCmonProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, "$py_Comn") == checkValue
        #Check neox voip-dial-plan profile in CLI
        if "NeoX" in self.dutType:
            checkValue = [['256', '8000', '32000', 'h248'], ['+88603(X.)']]
        #Check ies voip-dial-plan profile in CLI
        else:
            checkValue = [['256', '8000', '32000', 'h248'], ['1', '+88603(X.)']]
        with assume: assert await cliShowDialProfile(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag, "$py_Dial") == checkValue


    @pytest.mark.asyncio
    @pytest.mark.Provision
    async def test_EMS1_5673_ontVoipSipPrfModify(self):
        if self.exeServiceOnt == "": return
        await setXponSnLegacy(self.dutIp, self.dutAdminName, self.dutAdminPwd, self.serviceOntFlag)
        #Modify ONT VoIP SIP Profile: "$py_SIP"
        modifyProfile (self, "ONT VoIP SIP Profile", "$py_SIP")
        elementScrolledIntoView(self, self.driver.find_element(By.XPATH, "//label[contains(.,\'dia-opt\')]"))
        self.driver.find_element(By.XPATH, "//label[contains(.,\'dia-opt\')]").click()
        self.driver.find_element(By.ID, "provision_profile_save_profile_btn").click()
        time.sleep(3)
        with assume: assert "can't modify it" in waitMessageText(self)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)        


