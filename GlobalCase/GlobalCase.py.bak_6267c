    # System/ Security/ Map Management
    # Not finished
    @pytest.mark.Unicase
    def test_EMS1_3480_mapManagementDelete(self):
        nodeSubmap = "A ~!@#$%^&*()_+{}|:<>a][=-.0123456789abcdefghijklmnopqrstuvwxyz0"
        nodeSubmapDescription = "B ~!@#$%^&*()_+{}|:<>a/][=-`,.;0123456789abcdefghijklmnopqrstuvw"
        nodeDev = "C ~!@#$%^&*()_+{}|:<>a][=-.0123456789abcdefghijklmnopqrstuvwxyz0"
        nodeDevDescription = "D ~!@#$%^&*()_+{}|:<>a/][=-`,.;0123456789abcdefghijklmnopqrstuvw"
        nodeDevIp = "255.255.255.255"
        nodeDevPort = "65535"
        #nodeDevName = "G ~!@#$%^&*()_+{}|:<>a/][=-`,.;0123456789abcdefghijklmnopqrstuvw"
        nodeDevName = "G ~!@#$%^&*()_+{}|:<>a/][=-`,.;0"
        #nodeDevPwd = "H ~!@#$%^&*()_+{}|:<>a/][=-`,.;0123456789abcdefghijklmnopqrstuvw"
        nodeDevPwd = "H ~!@#$%^&*()_+{}|:<>a/][=-`,.;0"
        nodeDevSet = "I ~!@#$%^&*()_+{}|:<>a/][=-`,.;0123456789abcdefghijklmnopqrstuvw"
        nodeDevGet = "J ~!@#$%^&*()_+{}|:<>a/][=-`,.;0123456789abcdefghijklmnopqrstuvw"
        nodeDevAddress = "K ~!@#$%^&*()_+{}|:<>a/][=-`,.;0123456789abcdefghijklmnopqrstuvwxyzABC"
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Security").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Map Management").click()
        time.sleep(3)
        # 3479 renames the submap to lower case and the device IP to 1.2.3.4: delete those when present
        if findMapNodeByName(self, [nodeSubmap]) is None and findMapNodeByName(self, ["a" + nodeSubmap[1:]]) is not None:
            nodeSubmap = "a" + nodeSubmap[1:]
        if not self.driver.find_elements(By.XPATH, "//small[contains(.,'(" + nodeDevIp + ")')]") and \
                self.driver.find_elements(By.XPATH, "//small[contains(.,'(1.2.3.4)')]"):
            nodeDevIp = "1.2.3.4"
        print(f"EMS1-3480: delete submap {nodeSubmap!r}, device {nodeDevIp}", flush=True)
        #Check the original submap existed
        submapLink = findMapNodeByName(self, [nodeSubmap])
        if submapLink is not None:
            submapLink.location_once_scrolled_into_view
            submapLink.click()
        else:
            self.driver.find_element(By.ID, "node_id_0").click()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_device > a").click()
            self.driver.find_element(By.CSS_SELECTOR, ".col-md-5:nth-child(2) span").click()
            self.driver.find_element(By.ID, "deviceName").clear()
            self.driver.find_element(By.ID, "deviceName").send_keys(nodeSubmap)
            self.driver.find_element(By.ID, "description").clear()
            self.driver.find_element(By.ID, "description").send_keys(nodeSubmapDescription)
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Apply\"]").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
        #Check the original dev existed
        try:
            self.driver.find_element(By.XPATH, "//small[contains(.,\'(" + nodeDevIp + ")\')]").location_once_scrolled_into_view
            self.driver.find_element(By.XPATH, "//small[contains(.,\'(" + nodeDevIp + ")\')]").click()
        except NoSuchElementException:
            findMapNodeByName(self, [nodeSubmap]).click()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_device > a").click()
            self.driver.find_element(By.CSS_SELECTOR, ".col-md-5:nth-child(1) span").click()
            self.driver.find_element(By.ID, "deviceName").clear()
            self.driver.find_element(By.ID, "deviceName").send_keys(nodeDev)
            self.driver.find_element(By.ID, "description").clear()
            self.driver.find_element(By.ID, "description").send_keys(nodeDevDescription)
            self.driver.find_element(By.ID, "deviceIP").clear()
            self.driver.find_element(By.ID, "deviceIP").send_keys(nodeDevIp)
            self.driver.find_element(By.ID, "userName").clear()
            self.driver.find_element(By.ID, "userName").send_keys(nodeDevName)
            self.driver.find_element(By.ID, "dev_password").clear()
            self.driver.find_element(By.ID, "dev_password").send_keys(nodeDevPwd)
            Select(self.driver.find_element(By.ID, "snmpVersion")).select_by_visible_text("SNMP V2C")
            self.driver.find_element(By.ID, "setCommunity").clear()
            self.driver.find_element(By.ID, "setCommunity").send_keys(nodeDevSet)
            self.driver.find_element(By.ID, "getCommunity").clear()
            self.driver.find_element(By.ID, "getCommunity").send_keys(nodeDevGet)
            Select(self.driver.find_element(By.ID, "snmpv3level")).select_by_visible_text("Authentication and privacy")
            Select(self.driver.find_element(By.ID, "snmpv3hash")).select_by_visible_text("SHA")
            Select(self.driver.find_element(By.ID, "snmpv3encrypt")).select_by_visible_text("AES")
            self.driver.find_element(By.ID, "dev_sshPort").clear()
            self.driver.find_element(By.ID, "dev_sshPort").send_keys(nodeDevPort)
            self.driver.find_element(By.ID, "geoPosition").clear()
            self.driver.find_element(By.ID, "geoPosition").send_keys(nodeDevAddress)
            time.sleep(3)
            try:
                self.driver.find_element(By.ID, "geoPositionSearch").click()
                time.sleep(3)
            except ElementNotInteractableException:
                pass
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Apply\"]").click()
            time.sleep(3)
            WebDriverWait(self.driver, 300).until (EC.alert_is_present())
            time.sleep(3)
            self.driver.switch_to.alert.accept()
            WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.ID, "message_text")))
            time.sleep(3)            
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
        # Delete device
        self.driver.find_element(By.XPATH, "//small[contains(.,\'(" + nodeDevIp + ")\')]").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//small[contains(.,\'(" + nodeDevIp + ")\')]").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Delete\"]").click()
        time.sleep(30)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        try:
            self.driver.find_element(By.XPATH, "//small[contains(.,\'(" + nodeDevIp + ")\')]").click()
            with assume: assert False
        except NoSuchElementException:
            with assume: assert True
        # Delete submap
        submapLink = findMapNodeByName(self, [nodeSubmap])
        submapLink.location_once_scrolled_into_view
        submapLink.click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Delete\"]").click()
        time.sleep(10)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        with assume: assert findMapNodeByName(self, [nodeSubmap]) is None, f"submap {nodeSubmap!r} still exists"


    # System/ Security/ Map Management
    @pytest.mark.skip
    @pytest.mark.Unicase
    def test_EMS1_6589_mapManagementSubmapChange(self):
        nodeSubmapA = "submapA"
        nodeSubmapB = "submapB"
        nodeDev = self.dutName
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Security").click()
        time.sleep(3)
        self.driver.find_element(By.LINK_TEXT, "Map Management").click()
        time.sleep(3)
        # Delete node
        try:
            nodeList = [nodeSubmapA, nodeSubmapB, nodeDev]
            for node in nodeList:
                if node == nodeDev:
                    self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").location_once_scrolled_into_view
                    self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").click()
                else:
                    self.driver.find_element(By.LINK_TEXT, node).location_once_scrolled_into_view
                    self.driver.find_element(By.LINK_TEXT, node).click()
                self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
                self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Delete\"]").click()
                time.sleep(3)
                self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
                time.sleep(3)
        except NoSuchElementException:
            pass
        # Create node
        self.driver.find_element(By.ID, "node_id_0").click()
        for node in nodeList:
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_device > a").click()
            self.driver.find_element(By.CSS_SELECTOR, ".col-md-5:nth-child(2) span").click()
            self.driver.find_element(By.ID, "deviceName").clear()
            self.driver.find_element(By.ID, "deviceName").send_keys(node)
            if node == nodeDev:
                self.driver.find_element(By.CSS_SELECTOR, ".col-md-5:nth-child(1) span").click()
                self.driver.find_element(By.ID, "description").clear()
                self.driver.find_element(By.ID, "description").send_keys(self.dutDesc)
                self.driver.find_element(By.ID, "deviceIP").clear()
                self.driver.find_element(By.ID, "deviceIP").send_keys(self.dutIp)
                self.driver.find_element(By.ID, "userName").clear()
                self.driver.find_element(By.ID, "userName").send_keys(self.dutAdminName)
                self.driver.find_element(By.ID, "dev_password").clear()
                self.driver.find_element(By.ID, "dev_password").send_keys(self.dutAdminPwd)
                Select(self.driver.find_element(By.ID, "snmpVersion")).select_by_visible_text(self.dutSnmpVer)
                self.driver.find_element(By.ID, "setCommunity").clear()
                self.driver.find_element(By.ID, "setCommunity").send_keys(self.dutSet)
                self.driver.find_element(By.ID, "getCommunity").clear()
                self.driver.find_element(By.ID, "getCommunity").send_keys(self.dutGet)
                Select(self.driver.find_element(By.ID, "snmpv3level")).select_by_visible_text(self.dutSnmp3Auth)
                Select(self.driver.find_element(By.ID, "snmpv3hash")).select_by_visible_text(self.dutSnmp3Hash)
                Select(self.driver.find_element(By.ID, "snmpv3encrypt")).select_by_visible_text(self.dutSnmp3Encrypt)
                self.driver.find_element(By.ID, "dev_sshPort").clear()
                self.driver.find_element(By.ID, "dev_sshPort").send_keys("22")
                self.driver.find_element(By.ID, "geoPosition").clear()
                self.driver.find_element(By.ID, "geoPosition").send_keys(self.dutAddr)
                time.sleep(3)
                try:
                    self.driver.find_element(By.ID, "geoPositionSearch").click()
                    time.sleep(3)
                except ElementNotInteractableException:
                    pass
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Apply\"]").click()
            time.sleep(10)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(3)
            if node == nodeDev:
                self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").click()
            else:
                self.driver.find_element(By.LINK_TEXT, node).click()
            time.sleep(3)
        # Modify the dev submap to submapA 
        self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
        self.driver.find_element(By.CSS_SELECTOR, ".comboTreeArrowBtnImg").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//label[@data-name=\'" + nodeSubmapA + "\']").click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Save\"]").click()
        time.sleep(10)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        # Check the dev submap became submapA
        self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").click()
        time.sleep(3)
        with assume: assert self.driver.find_element(By.ID, "submapNode").text == nodeSubmapA
        # Modify the submap submap to EMS 
        self.driver.find_element(By.LINK_TEXT, nodeSubmapB).location_once_scrolled_into_view
        self.driver.find_element(By.LINK_TEXT, nodeSubmapB).click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
        self.driver.find_element(By.CSS_SELECTOR, ".comboTreeArrowBtnImg").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//label[@data-name=\'EMS\']").click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Save\"]").click()
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)
        # Check the submap submap became EMS
        self.driver.find_element(By.LINK_TEXT, nodeSubmapB).location_once_scrolled_into_view
        self.driver.find_element(By.LINK_TEXT, nodeSubmapB).click()
        with assume: assert self.driver.find_element(By.ID, "submapNode").text == "EMS"
        # Device node back to original setting
        self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").location_once_scrolled_into_view
        self.driver.find_element(By.XPATH, "//small[text()=\'(" + self.dutIp + ")\']").click()
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
        self.driver.find_element(By.CSS_SELECTOR, ".comboTreeArrowBtnImg").click()
        time.sleep(3)
        self.driver.find_element(By.XPATH, "//label[@data-name=\'EMS\']").click()
        self.driver.find_element(By.ID, "deviceName").clear()
        self.driver.find_element(By.ID, "deviceName").send_keys(self.dutName)
        self.driver.find_element(By.ID, "description").clear()
        self.driver.find_element(By.ID, "description").send_keys(self.dutDesc)
        self.driver.find_element(By.ID, "deviceIP").clear()
        self.driver.find_element(By.ID, "deviceIP").send_keys(self.dutIp)
        self.driver.find_element(By.ID, "userName").clear()
        self.driver.find_element(By.ID, "userName").send_keys(self.dutAdminName)
        self.driver.find_element(By.ID, "dev_password").clear()
        self.driver.find_element(By.ID, "dev_password").send_keys(self.dutAdminPwd)
        Select(self.driver.find_element(By.ID, "snmpVersion")).select_by_visible_text(self.dutSnmpVer)
        self.driver.find_element(By.ID, "setCommunity").clear()
        self.driver.find_element(By.ID, "setCommunity").send_keys(self.dutSet)
        self.driver.find_element(By.ID, "getCommunity").clear()
        self.driver.find_element(By.ID, "getCommunity").send_keys(self.dutGet)
        Select(self.driver.find_element(By.ID, "snmpv3level")).select_by_visible_text(self.dutSnmp3Auth)
        Select(self.driver.find_element(By.ID, "snmpv3hash")).select_by_visible_text(self.dutSnmp3Hash)
        Select(self.driver.find_element(By.ID, "snmpv3encrypt")).select_by_visible_text(self.dutSnmp3Encrypt)
        self.driver.find_element(By.ID, "dev_sshPort").clear()
        self.driver.find_element(By.ID, "dev_sshPort").send_keys("22")
        self.driver.find_element(By.ID, "geoPosition").clear()
        self.driver.find_element(By.ID, "geoPosition").send_keys(self.dutAddr)
        time.sleep(3)
        try:
            self.driver.find_element(By.ID, "geoPositionSearch").click()
            time.sleep(3)
        except ElementNotInteractableException:
            pass
        self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Save\"]").click()
        time.sleep(10)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep(3)


    # System/ Security/ Map Management
    @pytest.mark.asyncio
    @pytest.mark.Unicase
    async def test_EMS1_7013_7012_unmanageForceManage(self):
        #Need make sure the device is managed in this EMS server
        #Check device status is UP
        self.driver.find_element(By.LINK_TEXT, "Inventory").click()
        WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.LINK_TEXT, "Device")))
        time.sleep(3)
        entryPosition = getPositionByColNext(self, "dev_inventory_div", "IPAddress", self.dutIp)
        waitFiledUpdate (self, "dev_inventory_div", entryPosition, "DevStatus", "Up", self.driver.find_element(By.ID, "i_action_refresh"))
        try:
            #Unmanage device
            #Edit device
            self.driver.find_element(By.LINK_TEXT, "System").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Security").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Map Management").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//small[contains(.,\'("+ self.dutIp +")\')]").location_once_scrolled_into_view
            self.driver.find_element(By.XPATH, "//small[contains(.,\'("+ self.dutIp +")\')]").click()
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
            time.sleep(3)
            unmanageTime = datetime.now().strftime("%Y/%m/%d %H:%M:%S")
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Unmanage\"]").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(180)
            #Check the device status is unmanage
            self.driver.find_element(By.LINK_TEXT, "Inventory").click()
            time.sleep(3)
            entryPosition = getPositionByColNext(self, "dev_inventory_div", "IPAddress", self.dutIp)
            with assume: assert getElementByPositionCol(self, "dev_inventory_div", entryPosition , "DevStatus").text == "Unmanaged"
            time.sleep(3)
            #Check the unmanage device in main page
            #Check in Dashboard (not in device status)
            self.driver.find_element(By.LINK_TEXT, "Dashboard").click()
            time.sleep(3)
            #Check each status number
            for status in range(1, self.deviceStatusCount +1):
                self.driver.find_element(By.XPATH, "//div[@id=\'devStatus\']/div[" + str(status) + "]/div[2]/a").click()
                with assume: assert getPositionByColNext(self, "All_devStatusTable", "IPAddress", self.dutIp) == [-1,-1]
                time.sleep(3)
            #Check in Map
            self.driver.find_element(By.LINK_TEXT, "Map").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "navside_icon").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//li[contains(.,\'" + self.dutNodeName + "\')]").click()
            time.sleep(3)
            with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"UnmanagedDev\"]/div/div[1]").text == "Device unmanaged"
            with assume: assert self.driver.find_element(By.ID, "unmanagedDevText").text == "This device is managed by other EMS server (None)."
            time.sleep(3)
            #Check in Active Alarm
            filterTime = datetime.now().strftime("%Y/%m/%d %H:%M:%S")
            await cliCommandList (self.dutIp, self.dutAdminName, self.dutAdminPwd, ["show system"])
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Alarm").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Active").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "fault_active_clear_btn").click()
            self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .arrow").click()
            self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .collapsed").click()
            try:
                self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
                self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
                assert False
            except NoSuchElementException:
                pass
            self.driver.find_element(By.ID, "alarm_datepickerFrom_filter").click()
            self.driver.find_element(By.ID, "alarm_datepickerFrom_filter").clear()
            self.driver.find_element(By.ID, "alarm_datepickerFrom_filter").send_keys(filterTime)
            self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
            self.driver.find_element(By.ID, "fault_active_btn").click()
            time.sleep(3)
            if tableIsEmpty (self, "alarm_activeAlarmTable"):
                assert True
            else:
                with assume: assert self.dutIp not in getListByCol(self, "alarm_activeAlarmTable", "DevIP")
            #with assume: assert self.driver.find_element(By.ID, "alarm_total").text == "0"
            time.sleep(3)
            #Check in History Alarm
            self.driver.find_element(By.LINK_TEXT, "Alarm").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "History").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "fault_history_clear_btn").click()
            self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .arrow").click()
            self.driver.find_element(By.CSS_SELECTOR, "li:nth-child(1) > .collapsed").click()
            try:
                self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
                self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
                assert False
            except NoSuchElementException:
                pass
            self.driver.find_element(By.ID, "alarm_datepickerFrom_history").click()
            self.driver.find_element(By.ID, "alarm_datepickerFrom_history").clear()
            self.driver.find_element(By.ID, "alarm_datepickerFrom_history").send_keys(filterTime)
            self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
            self.driver.find_element(By.ID, "fault_history_btn").click()
            time.sleep(3)
            if tableIsEmpty (self, "alarm_historyAlarmTable"):
                assert True
            else:
                with assume: assert self.dutIp not in getListByCol(self, "alarm_historyAlarmTable", "DevIP")
            time.sleep(3)
            #Check in Inventory (no data in card, port, ont)
            #Card
            self.driver.find_element(By.LINK_TEXT, "Inventory").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Card").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "inventory_slot_clear_btn").click()
            self.driver.find_element(By.ID, "deviceName2").send_keys(self.dutName)
            self.driver.find_element(By.ID, "ip2").send_keys(self.dutIp)
            self.driver.find_element(By.ID, "inventory_slot_btn").click()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_refresh > a").click()
            time.sleep(3)
            with assume: assert totalData (self, "card_inventory_div") == 0
            #Port
            self.driver.find_element(By.LINK_TEXT, "Port").click()
            time.sleep(3)
            self.driver.find_element(By.ID, "AllPort").click()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            self.driver.find_element(By.ID, "inventory_allport_clear_btn").click()
            self.driver.find_element(By.ID, "deviceName_all").send_keys(self.dutName)
            self.driver.find_element(By.ID, "ip_all").send_keys(self.dutIp)
            self.driver.find_element(By.ID, "inventory_allport_btn").click()
            time.sleep(3)
            with assume: assert totalData (self, "port_inventory_div") == 0
            #Ont
            self.driver.find_element(By.LINK_TEXT, "ONT").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            self.driver.find_element(By.ID, "inventory_allont_clear_btn").click()
            self.driver.find_element(By.ID, "deviceName_Allont").send_keys(self.dutName)
            self.driver.find_element(By.ID, "ip_Allont").send_keys(self.dutIp)
            self.driver.find_element(By.ID, "inventory_allont_btn").click()
            time.sleep(3)
            with assume: assert totalData (self, "ont_inventory_div") == 0
            #Transceiver
            self.driver.find_element(By.LINK_TEXT, "Transceiver").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            self.driver.find_element(By.ID, "inventory_transceiver_clear_btn").click()
            self.driver.find_element(By.ID, "deviceName_transceiver").send_keys(self.dutName)
            self.driver.find_element(By.ID, "ip_transceiver").send_keys(self.dutIp)
            self.driver.find_element(By.ID, "inventory_transceiver_btn").click()
            time.sleep(3)
            with assume: assert totalData (self, "transceiver_inventory_div") == 0
            #Check in Performance
            self.driver.find_element(By.LINK_TEXT, "Performance").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_demand > a").click()
            time.sleep(3)
            if self.driver.find_element(By.XPATH, "//*[@id=\"tree_demand\"]/ul/li/div[1]").get_attribute("className") == "arrow collapsed":
                self.driver.find_element(By.XPATH, "//*[@id=\"tree_demand\"]/ul/li/div[1]").click()
            time.sleep(3)
            try:
                self.driver.find_element(By.XPATH, "//*[@id=\"tree_demand\"]/ul/li//label[contains(.,\'("+ self.dutIp +")\')]").location_once_scrolled_into_view
                self.driver.find_element(By.XPATH, "//*[@id=\"tree_demand\"]/ul/li//label[contains(.,\'("+ self.dutIp +")\')]").click()
                assert False
            except NoSuchElementException:
                pass
            #Check in Maintanence
            self.driver.find_element(By.LINK_TEXT, "Maintenance").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
            time.sleep(3)
            Select(self.driver.find_element(By.ID, "schedule_type")).select_by_visible_text("Configuration backup")
            time.sleep(3)
            try:
                self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
                with assume: assert False
            except NoSuchElementException:
                with assume: assert True
            #Check in Provision
            self.driver.find_element(By.LINK_TEXT, "Provision").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Configuration").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//*[@id=\'navMenuTree\']/ul/li[contains(.,\'" + self.dutNodeName + "\')]").click()
            time.sleep(3)
            with assume: assert self.driver.find_element(By.XPATH, "//*[@id=\"provision_configure_devicedown\"]/div/div[1]").text.strip() == "Device down"
            #Check in Script
            defaultTagList = ["IES42XX Series", "IES52XX Series", "NeoX Series", "OLT14XX Series"]
            scriptName = "$py_Unmanage"
            createScriptSelectTag (self, scriptName, "show system", defaultTagList)
            entryPosition = getPositionByCol(self, "script_table", "Name", scriptName)
            getElementByPositionCol(self, "script_table", entryPosition , "Checkbox").find_element(By.TAG_NAME, "label").location_once_scrolled_into_view
            getElementByPositionCol(self, "script_table", entryPosition , "Checkbox").find_element(By.TAG_NAME, "label").click()
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_applytodev > a").click()
            time.sleep (3)
            self.driver.find_element(By.XPATH, "//*[@id=\"apply_script_background\"]/div[1]/div[4]/div[2]/div[2]/input[1]").click()
            time.sleep (3)
            if self.driver.find_element(By.XPATH, "//*[@id=\"tree\"]/ul/li/div[1]").get_attribute("className") == "arrow collapsed":
                self.driver.find_element(By.XPATH, "//*[@id=\"tree\"]/ul/li/div[1]").click()
                time.sleep (3)
            try:
                self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").location_once_scrolled_into_view
                self.driver.find_element(By.XPATH, "//label[contains(.,\'" + self.dutNodeName + "\')]").click()
                assert False
            except NoSuchElementException:
                pass
            self.driver.find_element(By.XPATH, "//*[@id=\"selectNode\"]/div/div/div[1]/button").click()
            time.sleep (3)
            #Check in Access Log
            self.driver.find_element(By.LINK_TEXT, "System").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Security").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Access Log").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//*[@id=\"filter_background\"]/div[2]/input[@value=\"Reset\"]").click()
            self.driver.find_element(By.ID, "keyword").send_keys("Force unmanage device : " + self.dutName)
            self.driver.find_element(By.ID, "accesslog_datepickerFrom_filter").clear()
            self.driver.find_element(By.ID, "accesslog_datepickerFrom_filter").send_keys(unmanageTime)
            self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
            self.driver.find_element(By.XPATH, "//*[@id=\"filter_background\"]/div[2]/input[@value=\"Query\"]").click()
            time.sleep(3)
            entryPosition = getPositionByColNext(self, "accessLog_table", "Description", "Force unmanage device : " + self.dutName)
            with assume: assert entryPosition != [-1,-1]
            #Back to original status
            #Force management device
            self.driver.find_element(By.LINK_TEXT, "System").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Security").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Map Management").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//small[contains(.,\'("+ self.dutIp +")\')]").location_once_scrolled_into_view
            self.driver.find_element(By.XPATH, "//small[contains(.,\'("+ self.dutIp +")\')]").click()
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
            time.sleep(3)
            forceManageTime = datetime.now().strftime("%Y/%m/%d %H:%M:%S")
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Force Manage\"]").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
            time.sleep(180)
            #Check the device status is Up
            self.driver.find_element(By.LINK_TEXT, "Inventory").click()
            time.sleep(3)
            entryPosition = getPositionByColNext(self, "dev_inventory_div", "IPAddress", self.dutIp)
            with assume: assert getElementByPositionCol(self, "dev_inventory_div", entryPosition , "DevStatus").text == "Up"
            time.sleep(3)
            #Check in Access Log
            self.driver.find_element(By.LINK_TEXT, "System").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Security").click()
            time.sleep(3)
            self.driver.find_element(By.LINK_TEXT, "Access Log").click()
            time.sleep(3)
            self.driver.find_element(By.CSS_SELECTOR, "#i_action_filter > a").click()
            time.sleep(3)
            self.driver.find_element(By.XPATH, "//*[@id=\"filter_background\"]/div[2]/input[@value=\"Reset\"]").click()
            self.driver.find_element(By.ID, "keyword").send_keys("Force manage device : " + self.dutName)
            self.driver.find_element(By.ID, "accesslog_datepickerFrom_filter").clear()
            self.driver.find_element(By.ID, "accesslog_datepickerFrom_filter").send_keys(forceManageTime)
            self.driver.find_element(By.CSS_SELECTOR, ".ui-datepicker-close").click()
            self.driver.find_element(By.XPATH, "//*[@id=\"filter_background\"]/div[2]/input[@value=\"Query\"]").click()
            time.sleep(3)
            entryPosition = getPositionByColNext(self, "accessLog_table", "Description", "Force manage device : " + self.dutName)
            with assume: assert entryPosition != [-1,-1]
        finally:
            # Always give the device back to this EMS, even when a step above failed
            ensureDeviceManaged(self)


