def openOntServicePage (self):
    openMenu(self, "Provision")
    openMenu(self, "Service")
    openTab(self, (By.ID, "service_tab_ont"))

def openOntInventoryPage (self, timeout=60):
    # Other pages (e.g. Provision > Service) also have an active "ONT" link, so
    # only stop when the Inventory ONT table itself is shown.
    openMenu(self, "Inventory")
    lastClick = {"time": 0.0}
    def onOntInventory(driver):
        if isPageLoading(self):
            return False
        try:
            if _firstUsable(driver, (By.ID, "ont_inventory_div")) is not None:
                return True
            if time.monotonic() - lastClick["time"] < 3:
                return False
            for link in driver.find_elements(By.LINK_TEXT, "ONT"):
                if link.is_displayed() and link.is_enabled() and link.get_attribute("className") == "":
                    link.click()
                    lastClick["time"] = time.monotonic()
                    break
            return False
        except _RETRY_EXCEPTIONS:
            return False
    try:
        WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(onOntInventory)
    except TimeoutException as exc:
        raise AssertionError(f"Inventory > ONT page did not open after {timeout}s") from exc
    waitPageIdle(self)

def closeServiceResultDialog (self):
    # The close click is sometimes ignored while the dialog is still fading in; retry it.
    closeLocator = (By.ID, "alarm_detail_close_btn")
    for attempt in range(3):
        closeButton = _firstUsable(self.driver, closeLocator)
        if closeButton is None:
            return
        try:
            if attempt < 2:
                clickElementWhenReady(self, closeButton)
            else:
                self.driver.execute_script("arguments[0].click();", closeButton)
            waitHidden(self, closeLocator, 15)
            return
        except (AssertionError, StaleElementReferenceException):
            print(f"Close service result dialog retry: attempt={attempt + 1}", flush=True)
    waitHidden(self, closeLocator, 15)

def ensureDeviceManaged (self):
    # Restore the DUT to "managed" if a case left it Unmanaged; an Unmanaged
    # device stops EMS inventory sync and breaks every later ONT case.
    try:
        self.driver.switch_to.default_content()
    except Exception:
        pass
    openMenu(self, "Inventory")
    openMenu(self, "Device")
    time.sleep(2)
    entryPosition = getPositionByColNext(self, "dev_inventory_div", "IPAddress", self.dutIp)
    if entryPosition != [-1, -1] and getElementByPositionCol(self, "dev_inventory_div", entryPosition, "DevStatus").text != "Unmanaged":
        return
    print(f"Device {self.dutIp} is Unmanaged; Force Manage it", flush=True)
    openMenu(self, "System")
    openMenu(self, "Security")
    openMenu(self, "Map Management")
    nodeLocator = (By.XPATH, "//small[contains(.,\'(" + self.dutIp + ")\')]")
    waitClick(self, nodeLocator)
    waitClick(self, (By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]"))
    time.sleep(3)
    waitClick(self, (By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Force Manage\"]"))
    clickUntilHidden(self, (By.CSS_SELECTOR, "#message_diag .button"), None, 120)
    openMenu(self, "Inventory")
    openMenu(self, "Device")
    entryPosition = getPositionByColNext(self, "dev_inventory_div", "IPAddress", self.dutIp)
    waitFiledUpdate(self, "dev_inventory_div", entryPosition, "DevStatus", "Up", waitUsable(self, (By.ID, "i_action_refresh")))

