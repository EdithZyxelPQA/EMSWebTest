retryCount = 2

# ---------------------------------------------------------------------------
# Generic wait helpers: the EMS web UI draws pages/modals asynchronously and
# shows a "loadind_*" overlay while loading.  These helpers poll until the
# element is really usable instead of relying on fixed time.sleep().
# ---------------------------------------------------------------------------
_LOADING_OVERLAY_JS = """
return Array.from(document.querySelectorAll("[id^='loadind'], [id^='configure_loader']")).some(function (e) {
    var s = window.getComputedStyle(e);
    return s.display !== 'none' && s.visibility !== 'hidden' && e.getClientRects().length > 0;
});
"""

_RETRY_EXCEPTIONS = (
    NoSuchElementException,
    ElementClickInterceptedException,
    ElementNotInteractableException,
    StaleElementReferenceException,
)

def isPageLoading (self):
    try:
        return bool(self.driver.execute_script(_LOADING_OVERLAY_JS))
    except Exception:
        return False

def waitPageIdle (self, timeout=120):
    # Wait until the loading overlay disappears; do not fail here, the next
    # action will raise a clear error if the page is still blocked.
    try:
        WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(
            lambda driver: not isPageLoading(self)
        )
    except TimeoutException:
        print(f"Loading overlay still visible after {timeout}s", flush=True)

def _firstUsable (driver, locator):
    for element in driver.find_elements(*locator):
        if element.is_displayed() and element.is_enabled():
            return element
    return None

def waitUsable (self, locator, timeout=60):
    def usable(driver):
        try:
            if isPageLoading(self):
                return False
            return _firstUsable(driver, locator) or False
        except StaleElementReferenceException:
            return False
    try:
        return WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(usable)
    except TimeoutException as exc:
        raise AssertionError(f"Element not visible/enabled after {timeout}s: {locator}") from exc

def waitHidden (self, locator, timeout=60):
    def hidden(driver):
        try:
            return not any(element.is_displayed() for element in driver.find_elements(*locator))
        except StaleElementReferenceException:
            return False
    try:
        WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(hidden)
    except TimeoutException as exc:
        raise AssertionError(f"Element still visible after {timeout}s: {locator}") from exc

def clickUntilHidden (self, buttonLocator, hiddenLocator=None, timeout=60):
    # Click a dialog button and make sure the dialog really closes; the first
    # click is sometimes ignored while the dialog is still opening.
    hiddenLocator = hiddenLocator or buttonLocator
    waitClick(self, buttonLocator, timeout)
    for attempt in range(3):
        try:
            waitHidden(self, hiddenLocator, 15)
            return
        except AssertionError:
            print(f"Dialog still visible, click again: {buttonLocator} attempt={attempt + 1}", flush=True)
        button = _firstUsable(self.driver, buttonLocator)
        if button is None:
            continue
        try:
            if attempt < 2:
                clickElementWhenReady(self, button)
            else:
                self.driver.execute_script("arguments[0].click();", button)
        except StaleElementReferenceException:
            pass
    waitHidden(self, hiddenLocator, 30)

def clickElementWhenReady (self, element):
    # Click an element that was already located; retry while the page is busy.
    self.driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", element)
    def tryClick(driver):
        if isPageLoading(self):
            return False
        try:
            element.click()
            return True
        except (ElementClickInterceptedException, ElementNotInteractableException):
            return False
    try:
        WebDriverWait(self.driver, 60, poll_frequency=0.5).until(tryClick)
    except TimeoutException:
        self.driver.execute_script("arguments[0].click();", element)

def waitClick (self, locator, timeout=60):
    lastError = {"error": None}
    def tryClick(driver):
        if isPageLoading(self):
            return False
        try:
            element = _firstUsable(driver, locator)
            if element is None:
                return False
            driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", element)
            element.click()
            return True
        except _RETRY_EXCEPTIONS as exc:
            lastError["error"] = exc
            return False
    try:
        WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(tryClick)
    except TimeoutException as exc:
        raise AssertionError(
            f"Element not clickable after {timeout}s: {locator}; last error={lastError['error']!r}"
        ) from exc

def waitInput (self, locator, text, timeout=60):
    # Clear the field (Ctrl+A, Delete) and type text, like the original test steps.
    lastError = {"error": None}
    def tryInput(driver):
        if isPageLoading(self):
            return False
        try:
            element = _firstUsable(driver, locator)
            if element is None:
                return False
            element.send_keys(Keys.CONTROL + "a")
            element.send_keys(Keys.DELETE)
            element.send_keys(str(text))
            return True
        except _RETRY_EXCEPTIONS as exc:
            lastError["error"] = exc
            return False
    try:
        WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(tryInput)
    except TimeoutException as exc:
        raise AssertionError(
            f"Cannot input {text!r} after {timeout}s: {locator}; last error={lastError['error']!r}"
        ) from exc

def waitSelect (self, locator, text, timeout=60):
    # Wait until the <select> is usable and contains the option, then select it.
    lastError = {"error": None}
    def trySelect(driver):
        if isPageLoading(self):
            return False
        try:
            for element in driver.find_elements(*locator):
                if not element.is_displayed():
                    continue
                Select(element).select_by_visible_text(text)
                selectedText = driver.execute_script(
                    "var s = arguments[0]; return s.selectedIndex < 0 ? null : s.options[s.selectedIndex].text;",
                    element,
                )
                if selectedText is not None and selectedText.strip() == text.strip():
                    return True
            return False
        except _RETRY_EXCEPTIONS as exc:
            lastError["error"] = exc
            return False
    try:
        WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(trySelect)
    except TimeoutException as exc:
        raise AssertionError(
            f"Cannot select {text!r} after {timeout}s: {locator}; last error={lastError['error']!r}"
        ) from exc

def openTab (self, locator, timeout=60):
    # Click a menu/tab only when it is not active yet (className == "").
    def openWhenReady(driver):
        if isPageLoading(self):
            return False
        try:
            element = _firstUsable(driver, locator)
            if element is None:
                return False
            if element.get_attribute("className") == "":
                element.click()
                return "clicked"
            return "active"
        except _RETRY_EXCEPTIONS:
            return False
    try:
        result = WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(openWhenReady)
    except TimeoutException as exc:
        raise AssertionError(f"Cannot open menu/tab after {timeout}s: {locator}") from exc
    if result == "clicked":
        time.sleep(1)
        waitPageIdle(self)

def openMenu (self, linkText, timeout=60):
    openTab(self, (By.LINK_TEXT, linkText), timeout)

def openGeServicePage (self):
    openMenu(self, "Provision")
    openMenu(self, "Service")
    openTab(self, (By.ID, "service_tab_ge"))

def openGeServiceFilter (self):
    # "#provision_service_filter > a" toggles the filter panel; only click it when closed.
    for attempt in range(3):
        if _firstUsable(self.driver, (By.ID, "provision_geservice_filter_reset_btn")) is not None:
            return
        waitClick(self, (By.CSS_SELECTOR, "#provision_service_filter > a"))
        try:
            waitUsable(self, (By.ID, "provision_geservice_filter_reset_btn"), 10)
            return
        except AssertionError:
            print(f"Open GE service filter panel retry: attempt={attempt + 1}", flush=True)
    waitUsable(self, (By.ID, "provision_geservice_filter_reset_btn"), 30)

def queryGeServiceBy (self, conditions):
    # conditions: [(checkboxFor, textId, value), ...]
    openGeServicePage(self)
    openGeServiceFilter(self)
    waitClick(self, (By.ID, "provision_geservice_filter_reset_btn"))
    for checkboxFor, textId, value in conditions:
        waitClick(self, (By.XPATH, "//label[@for=\"" + checkboxFor + "\"]"))
        waitInput(self, (By.ID, textId), value)
    waitClick(self, (By.ID, "provision_geservice_filter_query_btn"))
    time.sleep(2)
    waitPageIdle(self)
    time.sleep(1)

