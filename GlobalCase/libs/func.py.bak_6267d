    self.driver.find_element(By.XPATH,"//*[@id=\"user_accesstree\"]/ul/li/div[2]").click()
    time.sleep (1)
    self.driver.find_element(By.XPATH,"//*[@id=\"user_accesstree\"]/ul/li/div[2]").click()
    time.sleep (1)
    for nodename in node:
        try:
            self.driver.find_element(By.XPATH,"//*[@id=\"user_accesstree\"]/ul/li//label[contains(.,\'"+ nodename +"\')]/../div[2]").click()
            time.sleep (3)
        except NoSuchElementException:
            pass
    #for nodename in node:
    #    allnodeCount = self.driver.find_elements(By.XPATH,"//*[@id=\"create_accessDeviceTree\"]/ul/li/ul/li")
    #    for count in range(len(allnodeCount)):
    #        i = str(count + 1)
    #        xpathStr = "//*[@id=\"create_accessDeviceTree\"]/ul/li/ul/li[" + i + "]/label"
    #        if nodename == self.driver.find_element(By.XPATH, xpathStr).text:
    #            nodePath = "//*[@id=\"create_accessDeviceTree\"]/ul/li/ul/li[" + i + "]/div[2]"
    #            self.driver.find_element(By.XPATH, nodePath).location_once_scrolled_into_view
    #            self.driver.find_element(By.XPATH, nodePath).click()
    #            break
    self.driver.find_element(By.CSS_SELECTOR, "#tab_content_User .button:nth-child(4)").click()
    WebDriverWait(self.driver, 300).until(EC.visibility_of_element_located((By.CSS_SELECTOR, "#message_diag .button")))
    self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
    time.sleep (3)
    return

# Delete EMS User
# Provision/Service/ONT create: open the service config dialog of the "{}" cell
def openServiceConfigDialog(self, attempts=3, timeout=10):
    # The dialog opens on a double click of the Service Config cell; the test's two separate
    # clicks are not seen as a double click on a slow page.  Double click the cell and wait for
    # the dialog (Active checkbox) to show; try again if it does not.
    activeLabel = (By.XPATH, "//label[@for=\"provision_service_active_checkbox\"]")
    def dialogShown():
        return any(e.is_displayed() for e in self.driver.find_elements(*activeLabel))
    for attempt in range(1, attempts + 1):
        if dialogShown():
            return
        waitPageIdle(self)
        cells = [e for e in self.driver.find_elements(By.CSS_SELECTOR, ".highlight-selected") if e.is_displayed()]
        if not cells:
            cells = [e for e in self.driver.find_elements(By.XPATH, "//td[contains(.,'{}')]") if e.is_displayed()]
        if cells:
            try:
                ActionChains(self.driver).move_to_element(cells[0]).double_click(cells[0]).perform()
            except Exception as exc:
                print(f"openServiceConfigDialog: double click failed ({exc.__class__.__name__})", flush=True)
        try:
            WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(lambda _: dialogShown())
            return
        except TimeoutException:
            print(f"openServiceConfigDialog: dialog not shown after try {attempt}/{attempts}", flush=True)
    raise AssertionError("Service config dialog did not open (Active checkbox not shown)")


# System/Security/User: switch the selected user into edit mode
def enterUserEditMode(self, attempts=3, timeout=10):
    # The user details are loaded after the user link is clicked; an Edit click made before
    # that finishes is undone when the page re-renders (Delete/Save stay hidden, fields read-only).
    # Click Edit and wait until the Delete button is shown; click again if it is not.
    def visible(css):
        return [e for e in self.driver.find_elements(By.CSS_SELECTOR, css) if e.is_displayed()]
    for attempt in range(1, attempts + 1):
        waitPageIdle(self)
        if visible("#tab_content_User .button_red"):
            return
        edit = visible("#tab_content_User .button_center")
        if edit:
            edit[0].click()
        try:
            WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(
                lambda _: visible("#tab_content_User .button_red")
            )
            time.sleep(1)
            if visible("#tab_content_User .button_red"):
                return
        except TimeoutException:
            pass
        print(f"enterUserEditMode: not in edit mode after Edit click {attempt}/{attempts}, retry", flush=True)
    raise AssertionError("User page did not switch to edit mode (Delete/Save buttons not shown)")


def delEMSUsr (self, usr, kickIfOnline=True):
    if self.driver.find_element(By.LINK_TEXT, "System").get_attribute("className") == "":
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep (3)
    if self.driver.find_element(By.LINK_TEXT, "Security").get_attribute("className") == "":
        self.driver.find_element(By.LINK_TEXT, "Security").click()
        time.sleep (3)
    if self.driver.find_element(By.ID, "user_user").get_attribute("className") == "":
        self.driver.find_element(By.ID, "user_user").click()
        time.sleep (3)
    try:
        if self.driver.find_element(By.ID, usr).get_attribute("className") == "user_link":
            self.driver.find_element(By.ID, usr).click()
            time.sleep (3)
        enterUserEditMode(self)
        self.driver.find_element(By.CSS_SELECTOR, "#tab_content_User .button_red").click()
        time.sleep (3)
        message = waitMessageText(self)
        self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
        time.sleep (3)
    except NoSuchElementException:
        return
    # EMS refuses to delete a user that is still online (its session can stay after logout):
    # kick the user from Online User, then delete again
    if "online user" in (message or "").lower():
        if not kickIfOnline:
            raise AssertionError(f"Delete user {usr} failed: {message}")
        print(f"delEMSUsr: {message!r}; kick {usr} from Online User and delete again", flush=True)
        kickUsr(self, usr)
        time.sleep (3)
        self.driver.find_element(By.ID, "user_user").click()
        time.sleep (3)
        delEMSUsr(self, usr, kickIfOnline=False)
    return

# Delete EMS Group
def delEMSGroup (self, group):
    if self.driver.find_element(By.LINK_TEXT, "System").get_attribute("className") == "":
        self.driver.find_element(By.LINK_TEXT, "System").click()
        time.sleep (3)
    if self.driver.find_element(By.LINK_TEXT, "Security").get_attribute("className") == "":
