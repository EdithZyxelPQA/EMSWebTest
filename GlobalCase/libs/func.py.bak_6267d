#Map Management: nodes left by the 3478 -> 3479 -> 3480 chain
def findMapNodeByName(self, names):
    # Exact (case-sensitive) match on the visible tree link text; By.LINK_TEXT fails on these
    # special-character names, so compare the text of every node link instead.
    for link in self.driver.find_elements(By.CSS_SELECTOR, "a.device_link"):
        try:
            if link.text.strip() in names and link.is_displayed():
                return link
        except Exception:
            continue
    return None


def deleteSelectedMapNode(self):
    self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Edit\"]").click()
    self.driver.find_element(By.XPATH, "//*[@id=\"tab_content_tool\"]/div/div/div[2]/div[2]/input[@value=\"Delete\"]").click()
    WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID, "message_text")))
    message = waitMessageText(self)
    self.driver.find_element(By.CSS_SELECTOR, "#message_diag .button").click()
    WebDriverWait(self.driver, 30).until(EC.invisibility_of_element_located((By.ID, "message_diag")))
    WebDriverWait(self.driver, 180).until(EC.visibility_of_element_located((By.ID, "node_id_0")))
    time.sleep(3)
    return message


def cleanupMapManagementNodes(self, submapNames, deviceIps):
    # Delete devices (by IP) first, then the submaps (EMS checks submap names case-insensitively,
    # so both the original and the 3479-modified name must be removed before 3478 creates it again)
    for ip in deviceIps:
        nodes = self.driver.find_elements(By.XPATH, f"//small[contains(.,'({ip})')]")
        if nodes:
            nodes[0].location_once_scrolled_into_view
            nodes[0].click()
            time.sleep(2)
            print(f"cleanupMapManagementNodes: delete device {ip}: {deleteSelectedMapNode(self)}", flush=True)
    for _ in range(len(submapNames)):
        link = findMapNodeByName(self, submapNames)
        if link is None:
            break
        name = link.text.strip()
        link.location_once_scrolled_into_view
        link.click()
        time.sleep(2)
        print(f"cleanupMapManagementNodes: delete submap {name!r}: {deleteSelectedMapNode(self)}", flush=True)


#Schedule Result Summary Table
def waitNewWindowHandle (self, timeout=30):
    # A click that opens a new tab/window: wait for it instead of reading window_handles[1] at once
    try:
        WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(lambda driver: len(driver.window_handles) > 1)
    except TimeoutException:
        pass
    return self.driver.window_handles[1]

def setScheduleName (self, name):
    # Changing schedule_type redraws the form and may wipe a name typed too early;
    # type it, wait a moment and re-type until the value stays.
    locator = (By.ID, "schedule_name")
    for attempt in range(5):
        waitInput(self, locator, name)
        time.sleep(1.5)
        element = _firstUsable(self.driver, locator)
        if element is not None and element.get_attribute("value") == name:
            return
        print(f"Schedule name was cleared, type again: attempt={attempt + 1}", flush=True)
    raise AssertionError(f"Cannot keep schedule name {name!r} in the schedule form")

def waitMessageText (self, timeout=30):
    # The message dialog text is filled in asynchronously; wait until it has content.
    def visibleText(driver):
        for element in driver.find_elements(By.ID, "message_text"):
            try:
                if element.is_displayed() and element.text.strip():
                    return element.text
            except StaleElementReferenceException:
                continue
        return False
    try:
        return WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(visibleText)
    except TimeoutException:
        return self.driver.find_element(By.ID, "message_text").text

def getScheduleResultByCol (self, colName):
    path = "//*[@id=\"modal_main_pane\"]/div[1]/table/thead/tr/th"
    # Wait until the schedule result table header (with this column) is rendered
    try:
        WebDriverWait(self.driver, 60, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(
            lambda driver: any(th.text.strip() == colName for th in driver.find_elements(By.XPATH, path))
        )
    except TimeoutException:
        pass
    tableCols = self.driver.find_elements(By.XPATH,path)
    colIndex = 0
    for tableCol in range(len(tableCols)):
        testCol = self.driver.find_element(By.XPATH, path+"[" + str(tableCol+1) + "]").text.strip()
        if testCol == colName:
            colIndex = tableCol + 1
            break
    element = self.driver.find_element(By.XPATH, "//*[@id=\"modal_main_pane\"]/div[1]/table/tbody/tr/td[" + str(colIndex) + "]")
    returnValue = element.text
    return returnValue

#Schedule Result Detail Table
def getScheduleResultDetailListByCol (self, colName):
    returnList = []
    tableRows = self.driver.find_elements(By.XPATH, "//*[@id=\"schedule_result_detail_table\"]/tbody/tr")
    rowInd = 0
    rowCount = len(tableRows)
    for rowInd in range(rowCount):
        value = self.driver.find_element(By.XPATH, "//*[@id=\'schedule_result_detail_table\']/tbody/tr[" + str(rowInd+1) + "]/td[@class=\'" + colName + "\']").text.strip()
        returnList.append(value)
    return returnList

