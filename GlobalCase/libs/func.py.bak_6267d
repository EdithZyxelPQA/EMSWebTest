def clickByColsPage (self, tableId, pageBoxId, colDic):
    pageTotalId = pageBoxId.replace("pageControl", "pageTotal") 
    btnNextPageId = pageBoxId.replace("pageControl", "btnNextPage") 
    tableCols = self.driver.find_elements(By.XPATH,"//div[@id=\'" + tableId + "\']/div[@class=\"zy_tr zy_tr_title\"]/div")
    tableColsCount = len(tableCols)
    rowIndex = 0
    colMatchIndexList = []
    testColMatchElementTextList = []    
    for tableCol in range(tableColsCount):
        testCol = tableCols[tableCol].text
        if testCol in colDic.keys():
            colMatchIndexList.append(tableCol + 1)
            pageCount = int(self.driver.find_element(By.ID, pageTotalId).text)          
    for pageIndex in range(1,pageCount+1):
        tableRows = self.driver.find_elements(By.XPATH,"//div[@id=\'" + tableId + "\']/div")
        tableRowsCount = len(tableRows)
        for tableRow in range(tableRowsCount):
            rowIndex = tableRow + 2
            testColMatchElementTextList = []
            for colMatchIndex in colMatchIndexList:
                testColMatchElement = self.driver.find_element(By.XPATH, "//div[@id=\'" + tableId + "\']/div[" + str(rowIndex) + "]/div[" + str(colMatchIndex) + "]")
                testColMatchElementText = testColMatchElement.text
                testColMatchElementTextList.append(testColMatchElementText)
            if testColMatchElementTextList == list(colDic.values()):
                self.driver.find_element(By.XPATH, "//label[@for=\'" + tableId + "_checkbox" + str(tableRow+1) + "\']").click()
                break
                #return [pageIndex, rowIndex]
        self.driver.find_element(By.ID, btnNextPageId).click()
    return [-1, -1]   



# ---------------------------------------------------------------------------
# Table lookups read many cells one by one; when EMS redraws/refreshes the table
# in the middle, a cell goes stale.  Retry the whole lookup in that case.
# ---------------------------------------------------------------------------
def _retryTableLookup (fn):
    import functools

    @functools.wraps(fn)
    def wrapper(self, *args, **kwargs):
        for attempt in range(5):
            try:
                return fn(self, *args, **kwargs)
            except StaleElementReferenceException:
                if attempt == 4:
                    raise
                print(f"{fn.__name__}: table was redrawn while reading, retry {attempt + 1}/4", flush=True)
                time.sleep(2)
                waitPageIdle(self)
    return wrapper

for _tableLookupName in (
    "getPositionByCols", "getPositionByColsNext", "getPositionsByColsNext",
    "getLocatorXpathStrByPositionCol", "getPositionByCol", "getPositionByColNextSort",
    "getPositionByColNext", "getPositionByColClassNext", "getElementByPositionCol",
    "getPositionByColNoPage", "getElementByPositionColNoPage", "getListByCol",
    "totalData", "pageCount", "pageCurrent",
):
    if _tableLookupName in globals():
        globals()[_tableLookupName] = _retryTableLookup(globals()[_tableLookupName])


async def restoreDeviceSnmp (self):
    # Put the DUT SNMP version/user and the EMS device settings back to the
    # configured values.  Cases that change SNMP (v2c/v3 auth level/method) call
    # this in "finally"; otherwise a failure leaves EMS unable to reach the DUT
    # ("Connection test is failed") and every later case fails.
    level = {
        "Authentication and privacy": "priv",
        "Authentication and no privacy": "auth",
        "No authentication and no privacy": "noauth",
    }.get(self.dutSnmp3Auth, "priv")
    version = "v3" if "3" in str(self.dutSnmpVer) else "v2c"
    if "OLT" in self.dutType:
        usrCmd = ("snmp-server username " + self.dutAdminName + " sec-level " + level + " auth " + self.dutSnmp3Hash.lower()
                  + " auth-password " + self.dutAdminPwd + " priv " + self.dutSnmp3Encrypt.lower()
                  + " priv-password " + self.dutAdminPwd + " group readwrite")
    else:
        usrCmd = "snmp-server username " + self.dutAdminName + " sec-level " + level + " auth " + self.dutSnmp3Hash.lower() + " priv " + self.dutSnmp3Encrypt.lower()
    try:
        await cliCommandList(self.dutIp, self.dutAdminName, self.dutAdminPwd, ["config", "snmp-server version " + version, usrCmd])
    except Exception as exc:
        print(f"restoreDeviceSnmp: CLI restore failed: {exc!r}", flush=True)
    try:
        from libs.ems_map_management import default_device_settings, ensure_device_exists, update_device_settings_by_ip
        try:
            self.driver.switch_to.alert.dismiss()
        except Exception:
            pass
        self.driver.switch_to.default_content()
        self.driver.get(self.emsURL)
        time.sleep(3)
        settings = default_device_settings(self)
        # Some cases delete and re-create the device node; add it back first if it is gone
        ensure_device_exists(self.driver, settings)
        update_device_settings_by_ip(self.driver, self.dutIp, settings)
        openMenu(self, "Inventory")
        openMenu(self, "Device")
        entryPosition = getPositionByColNext(self, "dev_inventory_div", "IPAddress", self.dutIp)
        waitFiledUpdate(self, "dev_inventory_div", entryPosition, "DevStatus", "Up", waitUsable(self, (By.ID, "i_action_refresh")))
    except Exception as exc:
        print(f"restoreDeviceSnmp: EMS device settings restore failed: {exc!r}", flush=True)


def openScheduleResult (self, entryPosition):
    # Click the "Result" link of a schedule row and wait for the result dialog.
    # Clicking the table cell itself sometimes misses the <a> inside it.
    for attempt in range(3):
        cell = getElementByPositionCol(self, "schedule_table", entryPosition, "Result_Hyperlink")
        links = cell.find_elements(By.TAG_NAME, "a")
        clickElementWhenReady(self, links[0] if links else cell)
        try:
            WebDriverWait(self.driver, 20, poll_frequency=0.5).until(
                lambda driver: any(e.is_displayed() for e in driver.find_elements(By.ID, "modal_main_pane"))
            )
            time.sleep(1)
            return
        except TimeoutException:
            print(f"Schedule result dialog did not open, click again: attempt={attempt + 1}", flush=True)


def ensureGePortSetting (self, slotId, portId, speed, linkTimeout=60):
    # Make the GE (Ethernet Access) port match the environment file before a case
    # checks it: other cases (e.g. GE template provisioning) may leave it at 1G or
    # disabled, which keeps a 10G link down.  NeoX CLI only.
    import re
    from libs.device_cli import run_ssh_commands
    if "NeoX" not in str(self.dutType):
        print(f"ensureGePortSetting: skip, CLI for {self.dutType} not supported", flush=True)
        return
    clean = lambda text: re.sub(r"\x1b\[[0-9;]*[A-Za-z]|\[J", "", text)
    speedCmd = "speed " + str(speed).lower()
    print(f"ensureGePortSetting: ge {slotId}-{portId} -> {speedCmd}, enable", flush=True)
    run_ssh_commands(self.dutIp, self.dutAdminName, self.dutAdminPwd,
                     ["configure", f"interface ge {slotId}-{portId}", speedCmd, "enable"])
    portLine = re.compile(r"^\s*" + re.escape(str(portId)) + r"\s*\|")
    endTime = time.time() + linkTimeout
    status = ""
    while time.time() < endTime:
        time.sleep(5)
        output = clean(run_ssh_commands(self.dutIp, self.dutAdminName, self.dutAdminPwd,
                                        [f"show interface ge {slotId}-{portId} status"]))
        lines = [line for line in output.splitlines() if portLine.match(line)]
        status = lines[0] if lines else ""
        if "linkup" in status:
            print(f"ensureGePortSetting: ge {slotId}-{portId} {status.strip()}", flush=True)
            time.sleep(20)  # let EMS receive the link-up and refresh the port inventory
            return
    print(f"ensureGePortSetting: ge {slotId}-{portId} is not linkup after {linkTimeout}s: {status.strip()!r}", flush=True)


def parseOntBankVersions (output):
    # Return the two image versions of an ONT from its CLI status output.
    #  NeoX / IES xont : "FW version 1 |  V V544ACNM1b1" / "FW version 2 | V544ACNM1C0"
    #  IES ont (table) : "... Active |    1         V541ACBB1b6v1 | ..."
    #                    "...     IS |    2      V  V541ACBB1C0v1 | ..."
    # A leading "V" only marks the active image and is not part of the version.
    import re
    versions = []
    for line in output.splitlines():
        match = re.match(r"\s*FW version [12]\s*\|\s*(.*)$", line)
        if match and match.group(1).split():
            versions.append(match.group(1).split()[-1])
    if versions:
        return versions
    for line in output.splitlines():
        match = re.search(r"\|\s*([12])\s+(?:V\s+)?([A-Za-z0-9._-]+)\s*\|", line)
        if match:
            versions.append(match.group(2))
    return versions


def selectUpgradeOntFW (self):
    # The ONT keeps two images (bank 1/2).  Upgrading with an image that is already
    # in a bank does nothing (no reboot), so pick the first candidate from
    # ZYXEL_DUT.<node>.ONT.<exe_upgrade_ont>.fw_image_list that is in neither bank.
    import re
    from libs.device_cli import run_ssh_commands
    candidates = list(getattr(self, "upgradeOntFWList", None) or [self.upgradeOntFW])
    flag = str(self.upgradeOntFlag).lower()
    match flag:
        case "xont" | "ont":
            aid = f"{self.upgradeOntSlotID}-{self.upgradeOntPortID}-{self.upgradeOntOntID}"
            showCommand = f"show interface remote {flag} {aid} status"
        case "ont-14":
            aid = f"ont-{self.upgradeOntPortID}-{self.upgradeOntOntID}"
            showCommand = f"show remote ont {aid}"
        case _:
            raise AssertionError(f"selectUpgradeOntFW: unsupported ONT flag {self.upgradeOntFlag!r}")
    output = re.sub(r"\x1b\[[0-9;]*[A-Za-z]|\[J", "", run_ssh_commands(
        self.dutIp, self.dutAdminName, self.dutAdminPwd, [showCommand]))
    bankVersions = parseOntBankVersions(output)
    if not bankVersions:
        raise AssertionError(
            f"selectUpgradeOntFW: cannot read the image versions of ONT {aid} ({showCommand}):\n{output[-800:]}")
    for image in candidates:
        if re.sub(r"\..*$", "", image) not in bankVersions:
            print(f"selectUpgradeOntFW: ONT {aid} banks={bankVersions}, use {image}", flush=True)
            self.upgradeOntFW = image
            return image
    raise AssertionError(
        f"selectUpgradeOntFW: every candidate {candidates} is already in ONT {aid} banks {bankVersions}; "
        "add another image to fw_image_list"
    )
