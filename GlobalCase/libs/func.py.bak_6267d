# Wait the ont id update in DB
def waitOntIdUpdate (self, sn, ontid):
    def clickFresh(locator, timeout=30):
        def clickWhenReady(driver):
            try:
                element = next((
                    candidate
                    for candidate in driver.find_elements(*locator)
                    if candidate.is_displayed() and candidate.is_enabled()
                ), None)
                if element is None:
                    return False
                element.click()
                return True
            except (
                NoSuchElementException,
                ElementNotInteractableException,
                StaleElementReferenceException,
            ):
                return False

        WebDriverWait(self.driver, timeout, poll_frequency=0.5).until(
            clickWhenReady
        )

    def openMenuIfInactive(linkText):
        def openWhenReady(driver):
            try:
                element = next((
                    candidate
                    for candidate in driver.find_elements(By.LINK_TEXT, linkText)
                    if candidate.is_displayed() and candidate.is_enabled()
                ), None)
                if element is None:
                    return False
                if element.get_attribute("className") == "":
                    element.click()
                return True
            except (
                NoSuchElementException,
                ElementNotInteractableException,
                StaleElementReferenceException,
            ):
                return False

        WebDriverWait(self.driver, 30, poll_frequency=0.5).until(openWhenReady)

    openOntInventoryPage(self)

    filterPanelState = {
        "click_count": 0,
        "last_click_time": 0.0,
    }

    def ensureFilterPanelOpen(driver):
        try:
            serialInputs = [
                element
                for element in driver.find_elements(By.ID, "serial_Allont")
                if element.is_displayed() and element.is_enabled()
            ]
            if serialInputs:
                return True

            # The EMS page occasionally ignores the first Filter click while
            # its table is still being redrawn.  Re-locate and retry the
            # toggle instead of waiting forever after a single click.
            now = time.monotonic()
            if now - filterPanelState["last_click_time"] < 3:
                return False
            filterToggle = next((
                element
                for element in driver.find_elements(
                    By.CSS_SELECTOR, "#i_action_filter > a"
                )
                if element.is_displayed() and element.is_enabled()
            ), None)
            if filterToggle is None:
                return False
            try:
                filterToggle.click()
            except (
                ElementClickInterceptedException,
                ElementNotInteractableException,
            ):
                driver.execute_script("arguments[0].click();", filterToggle)
            filterPanelState["click_count"] += 1
            filterPanelState["last_click_time"] = now
            print(
                "Open Inventory ONT filter panel: "
                f"attempt={filterPanelState['click_count']}",
                flush=True,
            )
            return False
        except (
            NoSuchElementException,
            ElementClickInterceptedException,
            ElementNotInteractableException,
            StaleElementReferenceException,
        ):
            return False

    try:
        WebDriverWait(self.driver, 45, poll_frequency=0.5).until(
            ensureFilterPanelOpen
        )
    except TimeoutException as exc:
        raise AssertionError(
            "Inventory ONT filter panel did not open: "
            f"serial input 'serial_Allont' was not visible after "
            f"{filterPanelState['click_count']} Filter click attempts"
        ) from exc

    def enterSerialNumber(driver):
        try:
            element = next((
                candidate
                for candidate in driver.find_elements(By.ID, "serial_Allont")
                if candidate.is_displayed() and candidate.is_enabled()
            ), None)
            if element is None:
                return False
            element.clear()
            element.send_keys(sn)
            return element.get_attribute("value") == sn
        except (
            NoSuchElementException,
            ElementNotInteractableException,
            StaleElementReferenceException,
        ):
            return False

    WebDriverWait(self.driver, 30, poll_frequency=0.5).until(enterSerialNumber)
    clickFresh((By.ID, "inventory_allont_btn"))
    time.sleep (3)
    expectedOntId = str(ontid)
    lastObserved = {
        "count": None,
        "sn": None,
        "ontid": None,
    }

    def uniqueSnWithExpectedOntId(driver):
        try:
            rowCount = totalData(self, "ont_inventory_div")
            lastObserved["count"] = rowCount
            lastObserved["sn"] = None
            lastObserved["ontid"] = None
            if rowCount == 1:
                entryPosition = [1, 1]
                actualSn = getElementByPositionCol(
                    self, "ont_inventory_div", entryPosition, "sn"
                ).text.strip()
                actualOntId = getElementByPositionCol(
                    self, "ont_inventory_div", entryPosition, "ONT"
                ).text.strip()
                lastObserved["sn"] = actualSn
                lastObserved["ontid"] = actualOntId
                if actualSn == sn and actualOntId == expectedOntId:
                    return True
        except (
            NoSuchElementException,
            ElementNotInteractableException,
            StaleElementReferenceException,
        ):
            # Inventory is being redrawn while the database update is in progress.
            pass

        refreshButtons = [
            element
            for element in driver.find_elements(By.ID, "i_action_refresh")
            if element.is_displayed() and element.is_enabled()
        ]
        if refreshButtons:
            refreshButtons[0].click()
        return False

    try:
        WebDriverWait(self.driver, 300, poll_frequency=3).until(
            uniqueSnWithExpectedOntId
        )
    except TimeoutException as exc:
        raise AssertionError(
            "Inventory/ONT did not converge to one unique matching row. "
            f"expected sn={sn!r}, ontid={expectedOntId!r}; "
            f"last observed count={lastObserved['count']}, "
            f"sn={lastObserved['sn']!r}, ontid={lastObserved['ontid']!r}"
        ) from exc
    return

# Wait Ont service success with sn
def getOntInfoAfterServiceSuccess (self, sn):
    queryOntServiceBy(self, "provision_filter_ont_sn_checkbox", "provision_filter_ont_sn_text", sn)
    serviceResultLocatorStr = getLocatorXpathStrByPositionCol(self, "provision_service_table", [1,1] , "state")
    waitElementTextWithRefresh(self, (By.XPATH, serviceResultLocatorStr), "Success", waitUsable(self, (By.ID, "provision_service_refresh")), 300 )
    waitPageIdle(self)
    waitClick(self, (By.XPATH, serviceResultLocatorStr))
    time.sleep (3)
    # Wait until the result dialog is filled in
    try:
        WebDriverWait(self.driver, 60, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(
            lambda driver: driver.find_element(By.ID, "provision_service_result_ont").get_attribute("value") not in ("", None)
        )
    except TimeoutException:
        print(f"Service result dialog of sn={sn!r} has no ONT ID after 60s", flush=True)
    ontSlot = self.driver.find_element(By.ID, "provision_service_result_slot").get_attribute("value")
    ontPort = self.driver.find_element(By.ID, "provision_service_result_port").get_attribute("value")
    ontID = self.driver.find_element(By.ID, "provision_service_result_ont").get_attribute("value")
    closeServiceResultDialog(self)
    ontInfo = [ontSlot, ontPort, ontID]
    return ontInfo

def waitGeServiceSuccess (self, dutIp, geInfo):
    queryGeServiceBy(self, geServicePortConditions(dutIp, geInfo))
    serviceResultLocatorStr = getLocatorXpathStrByPositionCol(self, "provision_service_table", [1,1] , "state")
    waitElementTextWithRefresh(self, (By.XPATH, serviceResultLocatorStr), "Success", waitUsable(self, (By.ID, "provision_service_refresh")), 300 )
    waitPageIdle(self)
    waitClick(self, (By.XPATH, serviceResultLocatorStr))
    time.sleep (3)
    closeServiceResultDialog(self)
    return

def filterOntInventory(self, dutIp, ontInfo):
    openOntInventoryPage(self)
    # "#i_action_filter > a" toggles the filter panel; only click it when closed.
    for attempt in range(3):
        if _firstUsable(self.driver, (By.ID, "ip_Allont")) is not None:
            break
        waitClick(self, (By.CSS_SELECTOR, "#i_action_filter > a"))
        try:
            waitUsable(self, (By.ID, "ip_Allont"), 10)
            break
        except AssertionError:
            print(f"Open Inventory ONT filter panel retry: attempt={attempt + 1}", flush=True)
    waitClick(self, (By.ID, "inventory_allont_clear_btn"))
    waitInput(self, (By.ID, "ip_Allont"), dutIp)
    if ontInfo[0] == "--": waitInput(self, (By.ID, "slot_Allont"), "0")
    else: waitInput(self, (By.ID, "slot_Allont"), ontInfo[0])
    waitInput(self, (By.ID, "port_Allont"), ontInfo[1])
    waitInput(self, (By.ID, "ontid_Allont"), ontInfo[2])
    waitClick(self, (By.ID, "inventory_allont_btn"))
    time.sleep(2)
    waitPageIdle(self)
    return

def modifyProfile (self, prfType, fileName):
    if self.driver.find_element(By.LINK_TEXT, "Provision").get_attribute("className") == "":
        self.driver.find_element(By.LINK_TEXT, "Provision").click()
        time.sleep (3)
    if self.driver.find_element(By.LINK_TEXT, "Profile").get_attribute("className") == "":
        self.driver.find_element(By.LINK_TEXT, "Profile").click()
        time.sleep (3)
    if self.driver.find_element(By.XPATH, "//option[. = \'" + prfType + "\']").is_selected() != True:
        Select(self.driver.find_element(By.ID, "profile_filtertype")).select_by_visible_text(prfType)
        time.sleep (3)
    try:
        entryPosition = getPositionByCol(self, "profile_table", "Name", fileName)
        getElementByPositionCol(self, "profile_table", entryPosition , "Modify").click()
        time.sleep(3)
    except NoSuchElementException:
        pass
    return

def createProfile (self, prfType, fileName, _loadAttempt=0):
    print(f"Create profile: type={prfType}, name={fileName}", flush=True)
    openMenu(self, "Provision")
    openMenu(self, "Profile")
    waitSelect(self, (By.ID, "profile_filtertype"), prfType)
    waitPageIdle(self)
    waitClick(self, (By.CSS_SELECTOR, "#i_action_create_collector > a"))
    profileNameInput = WebDriverWait(self.driver, 60).until(
        lambda driver: next((
            element
            for element in driver.find_elements(By.ID, "profile_name")
            if element.is_displayed() and element.is_enabled()
        ), False)
    )
    profileNameInput.clear()
    profileNameInput.send_keys(fileName)

    requiredFieldsByProfileType = {
        "ONT QoS Bandwidth Profile": (
            "bwprofile_sir",
            "bwprofile_air",
            "bwprofile_pir",
        ),
    }
    requiredFieldNames = requiredFieldsByProfileType.get(prfType, ())
    if requiredFieldNames:
        try:
            WebDriverWait(self.driver, 60, poll_frequency=0.5).until(
                lambda driver: all(
                    any(
                        element.is_displayed() and element.is_enabled()
                        for element in driver.find_elements(By.NAME, fieldName)
                    )
                    for fieldName in requiredFieldNames
                )
            )
        except TimeoutException:
            if _loadAttempt >= 1:
                raise AssertionError(
                    f"Profile form did not finish loading: type={prfType}, "
                    f"name={fileName}, missing/unavailable fields="
                    f"{', '.join(requiredFieldNames)}"
                )
            print(
                f"Profile form load timeout; refresh and retry once: "
                f"type={prfType}, name={fileName}",
                flush=True,
            )
            self.driver.refresh()
            WebDriverWait(self.driver, 60).until(
                lambda driver: driver.execute_script(
                    "return document.readyState"
                ) == "complete"
            )
            return createProfile(self, prfType, fileName, _loadAttempt + 1)
    return

def createProfileTest (self, prfType, fileName):
    #deleteFileIfExisted (self, prfType, fileName)
    if self.driver.find_element(By.LINK_TEXT, "Provision").get_attribute("className") == "":
        self.driver.find_element(By.LINK_TEXT, "Provision").click()
        time.sleep (3)
    if self.driver.find_element(By.LINK_TEXT, "Profile").get_attribute("className") == "":
        self.driver.find_element(By.LINK_TEXT, "Profile").click()
        time.sleep (3)
    if self.driver.find_element(By.XPATH, "//option[. = \'" + prfType + "\']").is_selected() != True:
        Select(self.driver.find_element(By.ID, "profile_filtertype")).select_by_visible_text(prfType)
        time.sleep (3)
    self.driver.find_element(By.CSS_SELECTOR, "#i_action_create_collector > a").click()
    time.sleep(3)
    #self.driver.find_element(By.ID, "provistion_profile_panel").screenshot("./report/CreateProf.png")
    self.driver.find_element(By.ID, "profile_name").send_keys(fileName)

def saveProfile (self):
    profileName = next((
        element.get_attribute("value") or element.text
        for element in self.driver.find_elements(By.ID, "profile_name")
        if element.is_displayed()
    ), "<unknown>")
    print(f"Save profile: name={profileName}", flush=True)

    saveButton = WebDriverWait(self.driver, 30).until(
        lambda driver: next((
            element
            for element in driver.find_elements(By.XPATH, "//input[@value='Save']")
            if element.is_displayed() and element.is_enabled()
        ), False)
    )
    self.driver.execute_script(
        "arguments[0].scrollIntoView({block: 'center'});", saveButton
    )
    try:
        saveButton.click()
    except ElementNotInteractableException:
        self.driver.execute_script("arguments[0].click();", saveButton)

    messageText = WebDriverWait(self.driver, 30).until(
        lambda driver: next((
            element.text.strip()
            for element in driver.find_elements(By.ID, "message_text")
            if element.is_displayed() and element.text.strip()
        ), False)
    )
    print(
        f"Save profile result: name={profileName}, message={messageText!r}",
        flush=True,
    )
    messageButton = WebDriverWait(self.driver, 30).until(
        lambda driver: next((
            element
            for element in driver.find_elements(By.CSS_SELECTOR, "#message_diag .button")
            if element.is_displayed() and element.is_enabled()
        ), False)
    )
    self.driver.execute_script(
        "arguments[0].scrollIntoView({block: 'center'});", messageButton
    )
    try:
        messageButton.click()
    except ElementNotInteractableException:
        self.driver.execute_script("arguments[0].click();", messageButton)
    WebDriverWait(self.driver, 30).until(
        lambda driver: not any(
            element.is_displayed()
            for element in driver.find_elements(By.CSS_SELECTOR, "#message_diag .button")
        )
    )
    return "Success" in messageText


async def cliShowOntConfig(dutIp, dutAdminName, dutAdminPwd, serviceOntFlag, ontInfo):
    returnList = []
    reader, writer = await telnetlib3.open_connection(dutIp, 23)
    resultOutput = await reader.readuntil(b": ")
    writer.write(dutAdminName + "\n")
    await writer.drain()
    resultOutput = await reader.readuntil(b"Password: ")
    writer.write(dutAdminPwd + "\n")
    await writer.drain()
    resultOutput = await reader.readuntil(b"# ")
    if serviceOntFlag == "xont":
        showCommand = "show in remote xont " + ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] +" config\n"
        writer.write(showCommand)
        await writer.drain()
        resultOutput = await reader.readuntil(b"# ")
        writer.close()
        resultStr = resultOutput.decode()
        resultList = resultStr.splitlines()
        resultList = [re.sub(r"^.* :", "", i,flags = re.DOTALL) for i in resultList]
        resultList = [i.strip() for i in resultList]
        del resultList [0:3]
        del resultList [-1]
        returnList = resultList
    else:
        if serviceOntFlag == "ont":
            showCommand = "show in remote ont " + ontInfo[0] + "-" + ontInfo[1] + "-" + ontInfo[2] +" config\n"
        else :
            showCommand = "show remote ont ont-" + ontInfo[1] + "-" + ontInfo[2] + " config\n"
        writer.write(showCommand)
        await writer.drain()
        resultOutput = await reader.readuntil(b"# ")
        writer.close()
        resultStr = resultOutput.decode()
        resultList = resultStr.split("----------------------+------------------------------------------------------------------------------------------------------")
        del resultList [0:2]
        del resultList [-1]
        resultList = [i.split("|") for i in resultList]
        resultList = [[j.strip() for j in i] for i in resultList]
        resultList = [[re.sub(r"\r\n +", "", j,flags = re.DOTALL) for j in i] for i in resultList]
        returnList = resultList
    return returnList

