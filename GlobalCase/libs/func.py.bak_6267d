# Create provision service with service ont sn pwd and profile
def createServiceWithIpSnPwdProfile (self, ip, sn, pwd, profileName):
    openOntServicePage(self)
    waitClick(self, (By.CSS_SELECTOR, "#provision_service_create > a"))
    waitClick(self, (By.XPATH, "//input[@value='Select ONT']"))
    waitClick(self, (By.XPATH, "//label[@for=\"provision_select_ont_ip_checkbox\"]"))
    waitInput(self, (By.ID, "provision_select_ont_ip_text"), ip)
    waitClick(self, (By.ID, "provision_select_ont_search_unregister_ont_btn"))
    time.sleep (3)
    waitPageIdle(self, 300)

    # The unregistered ONT list is loaded asynchronously; poll until the ONT row is clicked.
    def selectOntRow(driver):
        if isPageLoading(self):
            return False
        try:
            return clickBySNPW(self, sn, pwd)
        except _RETRY_EXCEPTIONS:
            return False
    try:
        WebDriverWait(self.driver, 120, poll_frequency=2).until(selectOntRow)
    except TimeoutException as exc:
        raise AssertionError(
            f"ONT sn={sn!r} pwd={pwd!r} not found in Select ONT list of {ip}"
        ) from exc
    waitPageIdle(self, 300)
    waitClick(self, (By.CSS_SELECTOR, "#modal_select_ont .modal-footer > .button"), 300)
    waitHidden(self, (By.ID, "modal_select_ont"))
    waitPageIdle(self)
    time.sleep(2)
    waitClick(self, (By.XPATH, "//td[contains(.,'{}')]"))
    time.sleep(3)
    waitClick(self, (By.CSS_SELECTOR, ".highlight-selected"))
    time.sleep(3)
    waitClick(self, (By.CSS_SELECTOR, ".highlight-selected"))
    time.sleep(3)
    waitClick(self, (By.XPATH, "//label[@for=\"provision_service_active_checkbox\"]"))
    waitSelect(self, (By.ID, "provision_service_onttemplate_combbox"), profileName)
    time.sleep(3)
    waitPageIdle(self)
    waitClick(self, (By.ID, "provision_save_service_btn"))
    time.sleep(3)
    waitClick(self, (By.XPATH, "//input[@value='Save' and not(@id='provision_save_service_btn')]"))
    clickUntilHidden(self, (By.CSS_SELECTOR, "#message_diag .button"), None, 120)
    time.sleep(3)
    waitPageIdle(self)
    return

