def navigate_to(driver, first_menu, second_menu=None, tab_id=None):
    _click_menu_if_inactive(driver, By.LINK_TEXT, first_menu)
    if second_menu:
        _click_menu_if_inactive(driver, By.LINK_TEXT, second_menu)
        if (first_menu, second_menu) == ("Inventory", "ONT"):
            # Provision > Service also has an active "ONT" tab; make sure the
            # Inventory ONT table itself is shown.
            _wait_page_shown(driver, "ont_inventory_div", By.LINK_TEXT, "ONT")
    if tab_id:
        _click_menu_if_inactive(driver, By.ID, tab_id)


def _wait_page_shown(driver, probe_id, by, value, timeout=60):
    last_click = [0.0]

    def shown(_):
        if _is_loading(driver):
            return False
        if _first_usable(driver, By.ID, probe_id) is not None:
            return True
        if time.time() - last_click[0] >= 3:
            for link in driver.find_elements(by, value):
                try:
                    if link.is_displayed() and link.get_attribute("className") == "":
                        link.click()
                        last_click[0] = time.time()
                        break
                except _RETRY_EXCEPTIONS:
                    continue
        return False

    WebDriverWait(driver, timeout, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(shown)
    _wait_idle(driver)


def _open_filter_panel(driver, toggle_css, probe_id):
    # The filter toggle opens/closes the panel; only click it when it is closed.
    for _attempt in range(3):
        if _first_usable(driver, By.ID, probe_id) is not None:
            return
        _click(driver, By.CSS_SELECTOR, toggle_css)
        try:
            WebDriverWait(driver, 10, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(
                lambda _: _first_usable(driver, By.ID, probe_id) is not None
            )
            return
        except TimeoutException:
            continue
    WebDriverWait(driver, 30, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(
        lambda _: _first_usable(driver, By.ID, probe_id) is not None
    )


