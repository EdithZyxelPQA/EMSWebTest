def _filter_ont_service_by_sn_candidates(driver, sn):
    last_rows = []
    for candidate in _sn_candidates(sn):
        filter_ont_service_by_sn(driver, candidate)
        rows = table_rows(driver, "provision_service_table")
        matched_rows = [
            row for row in rows
            if row.get("sn", "") in set(_sn_candidates(sn)) or candidate in row.get("sn", "")
        ]
        if matched_rows:
            return matched_rows
        last_rows = rows
    return last_rows


