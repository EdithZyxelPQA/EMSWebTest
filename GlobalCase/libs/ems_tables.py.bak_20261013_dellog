def assert_sort_direction_extremes(ascending_values, descending_values, column_name=None, context="", **sort_rule):
    # Whole-table sort check that only needs the first page of each direction:
    # the first ascending value is the minimum of the table, so it must not be greater than
    # any value on the first descending page, and the first descending value (the maximum)
    # must not be smaller than any value on the first ascending page.  Rows added while the
    # test runs only affect the last pages, so this stays reliable on large, changing tables.
    if not ascending_values or not descending_values:
        return
    if sort_rule.get("grouped_only"):
        # Grouped columns only promise that equal values stay together.  The first group of the
        # ascending order is the last group of the descending order, so the descending page may
        # start with the same value only when the column has a single value.
        groups = {_normalize_sort_text(v) for v in ascending_values + descending_values}
        if len(groups) > 1 and _normalize_sort_text(ascending_values[0]) == _normalize_sort_text(descending_values[0]):
            raise AssertionError(
                f"{context}: ascending and descending both start with {ascending_values[0]!r}; "
                f"ascending page={ascending_values}, descending page={descending_values}"
            )
        return
    rule = {k: v for k, v in sort_rule.items() if k != "grouped_only"}
    minimum, maximum = ascending_values[0], descending_values[0]
    for value in descending_values:
        if _first_sort_violation_index([minimum, value], column_name, False, None, **rule) is not None:
            raise AssertionError(
                f"{context}: first ascending value {minimum!r} is greater than {value!r} on the first descending page; "
                f"ascending page={ascending_values}, descending page={descending_values}"
            )
    for value in ascending_values:
        if _first_sort_violation_index([maximum, value], column_name, True, None, **rule) is not None:
            raise AssertionError(
                f"{context}: first descending value {maximum!r} is smaller than {value!r} on the first ascending page; "
                f"ascending page={ascending_values}, descending page={descending_values}"
            )


def assert_values_sorted(values, descending=False, context="", column_name=None, driver=None, **sort_rule):
    bad_index = _first_sort_violation_index(values, column_name, descending, driver, **sort_rule)
    if bad_index is not None:
        raise AssertionError(
            f"{context} values are not sorted. descending={descending}, "
            f"first bad pair row {bad_index + 1}->{bad_index + 2}: "
            f"{values[bad_index]!r} then {values[bad_index + 1]!r}; values={values}"
        )


def _first_sort_violation_index(values, column_name=None, descending=False, driver=None,
                                text_case="insensitive", numeric_natural=False, empty_first=False,
                                empty_values=(), empty_always_first=False, _empty_on_top=None,
                                grouped_only=False):
    if grouped_only:
        seen = set()
        for index in range(len(values) - 1):
            current = _normalize_sort_text(values[index])
            following = _normalize_sort_text(values[index + 1])
            seen.add(current)
            if following != current and following in seen:
                return index
        return None
    if descending and empty_always_first and _empty_on_top is None:
        rule = dict(text_case=text_case, numeric_natural=numeric_natural, empty_first=empty_first,
                    empty_values=empty_values, empty_always_first=True)
        on_top = _first_sort_violation_index(values, column_name, descending, driver, _empty_on_top=True, **rule)
        if on_top is None:
            return None
        return _first_sort_violation_index(values, column_name, descending, driver, _empty_on_top=False, **rule)
    # Different EMS tables sort differently, so each case chooses its rule:
    #   text_case       "insensitive": compare lower-cased text (original behaviour)
    #                   "sensitive"  : compare text as-is (upper case before lower case)
    #   numeric_natural True: a column whose values are all numbers is compared by value (9 < 10)
    #   empty_first     True: empty values ("--" / blank) are the smallest value
    #   empty_values    extra values that mean "empty" for this column (e.g. Slot "0" = no slot)
    #   empty_always_first True: in descending order empty values may also stay on top
    #                   (either on top or at the bottom is accepted)
    #   grouped_only    True: only check that equal values are next to each other (columns
    #                   EMS sorts by an internal code, e.g. Enable/Disable); compare the
    #                   ascending/descending group order with column_value_group_order()
    if column_name in {"IPAddress", "DevType", "DevAlarmStatus"}:
        keys = [_sort_key(value, column_name=column_name) for value in values]
    else:
        empties = {"--", *(str(value) for value in empty_values)}
        normalized = [_normalize_sort_text(value) for value in values]
        filled = [value for value in normalized if value not in empties]
        all_numeric = numeric_natural and filled and all(re.fullmatch(r"-?\d+(\.\d+)?", value) for value in filled)

        def key(value):
            text = _normalize_sort_text(value)
            if empty_first and text in empties:
                # _empty_on_top in descending order: empty is the largest key so it comes first
                return (2, 0, "") if (descending and _empty_on_top) else (0, 0, "")
            if all_numeric and text not in empties:
                return (1, float(text), "")
            if text_case == "sensitive":
                return (1, 0, text)
            return (1, 0, _ems_text_sort_key(text))

        keys = [key(value) for value in values]

    for index in range(len(keys) - 1):
        current_key = keys[index]
        next_key = keys[index + 1]
        if (not descending and current_key > next_key) or (descending and current_key < next_key):
            return index
    return None


def page_count(driver, table_id):
    try:
        page_input = driver.find_element(By.CSS_SELECTOR, f"#{table_id} .pagination > input")
    except NoSuchElementException:
        return 1
    match = re.search(r"Page\s+\d+\s+of\s+(\d+)", page_input.get_attribute("value") or "")
    return int(match.group(1)) if match else 1


def page_current(driver, table_id):
    try:
        page_input = driver.find_element(By.CSS_SELECTOR, f"#{table_id} .pagination > input")
    except NoSuchElementException:
        return 1
    match = re.search(r"Page\s+(\d+)\s+of\s+\d+", page_input.get_attribute("value") or "")
    return int(match.group(1)) if match else 1


def total_data(driver, table_id):
    try:
        text = driver.find_element(By.ID, f"table_total_data_{table_id}").text
    except NoSuchElementException:
        return len(table_rows(driver, table_id))
    match = re.search(r"(\d+)", text)
    return int(match.group(1)) if match else 0


def _table_headers(driver, table_id):
    headers = []
    for th in driver.find_elements(By.XPATH, f"//table[@id='{table_id}_head']/thead/tr/th"):
        headers.append(th.get_attribute("name") or th.text.strip())
    return headers


def _sort_key(value, column_name=None):
    if column_name == "IPAddress":
        return _ip_sort_key(value)
    if column_name == "DevType":
        return _device_type_sort_key(value)
    if column_name == "DevAlarmStatus":
        return _alarm_status_sort_key(value)
    return _normalize_sort_text(value)


DEVICE_TYPE_SORT_ORDER = {
    "unknown": 0,
    "IES6000": 8,
    "IES5206": 12,
    "IES4204": 19,
    "IES5212": 22,
    "IES6217": 23,
    "OLT1404": 25,
    "OLT1408": 27,
    "OLT1408A-C": 28,
    "OLT1404B-IA": 31,
    "OLT1408B-IA": 32,
    "NeoX-06": 33,
    "NeoX-03": 34,
}


def _device_type_sort_key(value):
    text = _normalize_sort_text(value)
    return (DEVICE_TYPE_SORT_ORDER.get(text, 999), text)


ALARM_STATUS_SORT_ORDER = {
    "None": 0,
    "Critical": 1,
    "Major": 2,
    "Minor": 3,
    "Info": 4,
}


def _alarm_status_sort_key(value):
    text = _normalize_sort_text(value)
    return (ALARM_STATUS_SORT_ORDER.get(text, 999), text)


def _ip_sort_key(value):
    text = _normalize_sort_text(value)
    parts = text.split(".")
    if len(parts) == 4 and all(part.isdigit() for part in parts):
        return tuple(int(part) for part in parts)
    return (999, 999, 999, 999, text)


def _normalize_sort_text(value):
    text = " ".join(str(value or "").split())
    return text if text else "--"


def _ems_text_sort_key(value):
    text = _normalize_sort_text(value)
    return text.lower().replace("_", "{")

def _div_col_index(header_cells, title):
    for index, cell in enumerate(header_cells, start=1):
        if cell.text.strip() == title:
            return index
    raise NoSuchElementException(f"Cannot find column title: {title}")


_LOADING_OVERLAY_JS = """
return Array.from(document.querySelectorAll("[id^='loadind'], [id^='configure_loader']")).some(function (e) {
    var s = window.getComputedStyle(e);
    return s.display !== 'none' && s.visibility !== 'hidden' && e.getClientRects().length > 0;
});
"""

_RETRY_EXCEPTIONS = (
    NoSuchElementException,
    ElementClickInterceptedException,
    ElementNotInteractableException,
    StaleElementReferenceException,
)


def _is_loading(driver):
    try:
        return bool(driver.execute_script(_LOADING_OVERLAY_JS))
    except Exception:
        return False


def _wait_idle(driver, timeout=120):
    try:
        WebDriverWait(driver, timeout, poll_frequency=0.5).until(lambda _: not _is_loading(driver))
    except TimeoutException:
        pass


def _first_usable(driver, by, value):
    # Same ids exist on several (hidden) pages; use the first visible one.
    for element in driver.find_elements(by, value):
        try:
            if element.is_displayed() and element.is_enabled():
                return element
        except StaleElementReferenceException:
            continue
    return None


def _click_menu_if_inactive(driver, by, value, timeout=60):
    def open_when_ready(_):
        if _is_loading(driver):
            return False
        element = _first_usable(driver, by, value)
        if element is None:
            return False
        if element.get_attribute("className") == "":
            element.click()
            return "clicked"
        return "active"

    result = WebDriverWait(driver, timeout, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(open_when_ready)
    if result == "clicked":
        time.sleep(1)
        _wait_idle(driver)


def _type(driver, by, value, text, timeout=60):
    def type_when_ready(_):
        if _is_loading(driver):
            return False
        element = _first_usable(driver, by, value)
        if element is None:
            return False
        element.send_keys(Keys.CONTROL + "a")
        element.send_keys(Keys.DELETE)
        element.send_keys(text)
        return True

    WebDriverWait(driver, timeout, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(type_when_ready)


def _click(driver, by, value, timeout=60):
    def click_when_ready(_):
        if _is_loading(driver):
            return False
        element = _first_usable(driver, by, value)
        if element is None:
            return False
        driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", element)
        element.click()
        return True

    try:
        WebDriverWait(driver, timeout, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(click_when_ready)
    except TimeoutException:
        # Still covered (e.g. by a leftover backdrop): fall back to a JS click on the visible element
        element = _first_usable(driver, by, value)
        if element is None:
            raise
        print(f"ems_tables: normal click kept failing, use JS click: {by}={value}", flush=True)
        driver.execute_script("arguments[0].click();", element)
    time.sleep(1)


def _select(driver, by, value, text, timeout=60):
    def select_when_ready(_):
        if _is_loading(driver):
            return False
        element = _first_usable(driver, by, value)
        if element is None:
            return False
        Select(element).select_by_visible_text(text)
        selected = driver.execute_script(
            "var s = arguments[0]; return s.selectedIndex < 0 ? null : s.options[s.selectedIndex].text;",
            element,
        )
        return selected is not None and selected.strip() == text.strip()

    WebDriverWait(driver, timeout, poll_frequency=0.5, ignored_exceptions=_RETRY_EXCEPTIONS).until(select_when_ready)


def _click_until_hidden(driver, button_locator, hidden_locator, timeout=60):
    _click(driver, *button_locator, timeout=timeout)
    for attempt in range(3):
        try:
            WebDriverWait(driver, 15, poll_frequency=0.5, ignored_exceptions=(StaleElementReferenceException,)).until(
                lambda _: not any(e.is_displayed() for e in driver.find_elements(*hidden_locator))
            )
            return
        except TimeoutException:
            button = _first_usable(driver, *button_locator)
            if button is None:
                continue
            try:
                if attempt < 2:
                    button.click()
                else:
                    driver.execute_script("arguments[0].click();", button)
            except _RETRY_EXCEPTIONS:
                pass
    WebDriverWait(driver, 30, poll_frequency=0.5, ignored_exceptions=(StaleElementReferenceException,)).until(
        lambda _: not any(e.is_displayed() for e in driver.find_elements(*hidden_locator))
    )


def _safe_click(driver, by, value):
    try:
        driver.find_element(by, value).click()
    except NoSuchElementException:
        pass


def _go_first_page(driver, table_id):
    if page_count(driver, table_id) <= 1 or page_current(driver, table_id) == 1:
        return
    _click_page_button(driver, table_id, "first")
    WebDriverWait(driver, 30).until(lambda _: page_current(driver, table_id) == 1)


def _go_to_page(driver, table_id, target_page):
    # Jump straight to a page (type the page number into the pagination box)
    # instead of clicking previous/next page by page.
    target_page = max(1, int(target_page))
    if page_current(driver, table_id) == target_page:
        return
    before_body = _table_body_text(driver, table_id)
    box = driver.find_element(By.CSS_SELECTOR, f"#{table_id} .pagination > input")
    driver.execute_script("arguments[0].scrollIntoView({block:'center', inline:'nearest'});", box)
    box.click()
    box.send_keys(Keys.CONTROL + "a")
    box.send_keys(str(target_page))
    box.send_keys(Keys.ENTER)
    try:
        WebDriverWait(driver, 60).until(lambda _: page_current(driver, table_id) == target_page)
    except TimeoutException:
        # the table was refreshed while jumping (page box reset); try once more
        box = driver.find_element(By.CSS_SELECTOR, f"#{table_id} .pagination > input")
        box.click()
        box.send_keys(Keys.CONTROL + "a")
        box.send_keys(str(min(target_page, page_count(driver, table_id))))
        box.send_keys(Keys.ENTER)
        target_page = min(target_page, page_count(driver, table_id))
        WebDriverWait(driver, 60).until(lambda _: page_current(driver, table_id) == target_page)
    _wait_current_page_table_ready(driver, table_id, previous_body=before_body)


def wait_table_total_stable(driver, table_id, quiet_seconds=8, timeout=180):
    # The table keeps loading rows in chunks after it is shown (Total data grows step by step),
    # so wait until Total data stops changing before reading counts or jumping to pages.
    end = time.time() + timeout
    last, since = None, time.time()
    while time.time() < end:
        try:
            current = (total_data(driver, table_id), page_count(driver, table_id))
        except Exception:
            current = None
        if current != last:
            last, since = current, time.time()
        elif time.time() - since >= quiet_seconds:
            return last[0] if last else None
        time.sleep(2)
    return last[0] if last else None


def table_rows_first_last_pages(driver, table_id):
    # Rows of the first and the last page only (large tables have hundreds of pages)
    _go_to_page(driver, table_id, 1)
    _wait_current_page_table_ready(driver, table_id)
    page_total = page_count(driver, table_id)
    first_rows = table_rows(driver, table_id)
    last_rows = first_rows
    if page_total > 1:
        _go_to_page(driver, table_id, page_total)
        last_rows = table_rows(driver, table_id)
        _go_to_page(driver, table_id, 1)
    return first_rows, last_rows, page_total


def _go_first_page_by_prev(driver, table_id):
    while page_count(driver, table_id) > 1 and page_current(driver, table_id) > 1:
        target_page = page_current(driver, table_id) - 1
        _click_page_button(driver, table_id, "previous")
        WebDriverWait(driver, 30).until(lambda _: page_current(driver, table_id) == target_page)


def _click_page_button(driver, table_id, class_name):
    button = _page_button(driver, table_id, class_name, timeout=30)
    driver.execute_script("arguments[0].scrollIntoView({block:'center', inline:'nearest'});", button)
    ActionChains(driver).move_to_element(button).pause(0.1).click(button).perform()
    time.sleep(1)


def _go_next_page(driver, table_id, target_page):
    before_body = _table_body_text(driver, table_id)
    _click_page_button(driver, table_id, "next")
    WebDriverWait(driver, 30).until(lambda _: page_current(driver, table_id) == target_page)
    _wait_current_page_table_ready(driver, table_id, previous_body=before_body)


def _page_button(driver, table_id, class_name, timeout=10):
    def visible_enabled_button(_):
        buttons = driver.find_elements(
            By.XPATH,
            f"//*[@id='{table_id}']//*[contains(concat(' ', normalize-space(@class), ' '), ' {class_name} ')]",
        )
        for button in buttons:
            classes = (button.get_attribute("class") or "").lower()
            if button.is_displayed() and button.is_enabled() and "disabled" not in classes:
                return button
        return False

    return WebDriverWait(driver, timeout).until(visible_enabled_button)


def _table_state(driver, table_id):
    try:
        return (
            page_current(driver, table_id),
            driver.find_element(By.ID, f"{table_id}_body").text,
        )
    except NoSuchElementException:
        return (page_current(driver, table_id), "")


def _wait_table_state_change(driver, table_id, before_state, timeout=10):
    try:
        WebDriverWait(driver, timeout).until(lambda _: _table_state(driver, table_id) != before_state)
    except TimeoutException:
        time.sleep(2)


def _wait_current_page_table_ready(driver, table_id, previous_body=None):
    try:
        WebDriverWait(driver, 30).until(lambda _: _table_has_rows(driver, table_id, previous_body))
    except TimeoutException as exc:
        try:
            body_text = driver.find_element(By.ID, f"{table_id}_body").text[:500]
        except NoSuchElementException:
            body_text = "<missing body>"
        raise TimeoutException(
            f"Timed out waiting for table rows. table={table_id}, "
            f"page={page_current(driver, table_id)} of {page_count(driver, table_id)}, body={body_text!r}"
        ) from exc


def _table_has_rows(driver, table_id, previous_body=None):
    cells = driver.find_elements(By.XPATH, f"//table[@id='{table_id}_body']/tbody/tr/td")
    if not cells:
        return False
    body_text = _table_body_text(driver, table_id)
    if not body_text:
        return False
    if previous_body is not None and body_text == previous_body:
        return False
    time.sleep(0.5)
    return bool(driver.find_elements(By.XPATH, f"//table[@id='{table_id}_body']/tbody/tr/td")) and bool(
        _table_body_text(driver, table_id)
    )


def _table_body_text(driver, table_id):
    try:
        return driver.find_element(By.ID, f"{table_id}_body").text
    except NoSuchElementException:
        return ""


def _ensure_checked(driver, by, value):
    _click(driver, by, value)


def _confirm_message(driver, require_success=False):
    locators = [
        (By.CSS_SELECTOR, "#modal_provision_service_message .button"),
        (By.CSS_SELECTOR, "#modal_provision_service_message button"),
        (By.CSS_SELECTOR, "#message_diag .button"),
        (By.CSS_SELECTOR, "#message_diag button"),
    ]
    message_locators = [
        (By.CSS_SELECTOR, "#modal_provision_service_message .modal-body"),
        (By.ID, "message_text"),
        (By.CSS_SELECTOR, "#message_diag .modal-body"),
    ]

    def visible_message_text():
        texts = []
        for by, value in message_locators:
            for element in driver.find_elements(by, value):
                if element.is_displayed() and element.text.strip():
                    texts.append(element.text.strip())
        return "\n".join(dict.fromkeys(texts))

    WebDriverWait(driver, 30, poll_frequency=0.2).until(
        lambda _: visible_message_text()
        or any(
            element.is_displayed()
            for by, value in locators
            for element in driver.find_elements(by, value)
        )
    )
    message = visible_message_text()
    clicked = _click_first_present(
        driver,
        locators,
        timeout=3,
    )
    if not clicked:
        raise TimeoutException("Cannot close EMS message dialog.")
    try:
        WebDriverWait(driver, 10, poll_frequency=0.2).until(
            lambda _: not any(
                element.is_displayed()
                for by, value in locators
                for element in driver.find_elements(by, value)
            )
        )
    except TimeoutException:
        pass
    if require_success and "success" not in message.casefold():
        raise AssertionError(
            f"EMS ONT service operation did not report success: {message!r}"
        )
    return message


def _wait_for_table(driver, table_id):
    time.sleep(1)
    _wait_idle(driver)
    WebDriverWait(driver, 60).until(EC.presence_of_element_located((By.ID, f"{table_id}_body")))


def _select_filter_option(driver, select_id, expected_text):
    element = WebDriverWait(driver, 30).until(EC.presence_of_element_located((By.ID, select_id)))
    selector = Select(element)
    for option in selector.options:
        if option.text.strip() == str(expected_text).strip():
            selector.select_by_visible_text(option.text)
            return
    for option in selector.options:
        if str(expected_text).strip() in option.text.strip():
            selector.select_by_visible_text(option.text)
            return
    available = [option.text for option in selector.options]
    raise NoSuchElementException(f"Cannot select {expected_text!r} from {select_id}; available={available}")


def _value_if_present(driver, element_id):
    try:
        return driver.find_element(By.ID, element_id).get_attribute("value").strip()
    except NoSuchElementException:
        return ""


def _click_first_present(driver, locators, timeout=5):
    def click_first_clickable(_):
        for by, value in locators:
            for element in driver.find_elements(by, value):
                try:
                    if element.is_displayed() and element.is_enabled():
                        element.click()
                        return True
                except (StaleElementReferenceException, ElementClickInterceptedException):
                    continue
        return False

    try:
        return bool(
            WebDriverWait(driver, timeout, poll_frequency=0.2).until(click_first_clickable)
        )
    except TimeoutException:
        return False
