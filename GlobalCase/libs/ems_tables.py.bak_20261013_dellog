def assert_column_sorted_each_page(driver, table_id, column_name, descending=False, context="", page_scope="all", **sort_rule):
    # sort_rule: text_case="insensitive"|"sensitive", numeric_natural=bool, empty_first=bool
    # (defaults keep the original behaviour; see _first_sort_violation_index)
    # page_scope: "all" = every page (original), "first_last" = first and last page,
    #             "first" = first page only (use assert_sort_direction_extremes for the whole table)
    failures = _sorted_failures_each_page(driver, table_id, column_name, descending, context, page_scope=page_scope, **sort_rule)
