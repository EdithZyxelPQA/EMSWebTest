    header_cell = WebDriverWait(driver, 30).until(EC.presence_of_element_located((By.XPATH, header_xpath)))
    _scroll_once_into_view(header_cell)

    def visible_header(_):
        size = header_cell.size or {}
        return header_cell if header_cell.is_displayed() and size.get("width", 0) > 0 and size.get("height", 0) > 0 else False

    return WebDriverWait(driver, 30).until(visible_header)


def _scroll_once_into_view(element):
    _ = element.location_once_scrolled_into_view
    time.sleep(0.3)


def _visible_sort_icon(driver, table_id, column_index, column_name=None):
    icon_xpaths = []
    if column_name:
        icon_xpaths.append(f"//*[@id='{table_id}_head']/thead/tr/th[{column_index}]/img[@date-value='{column_name}']")
        icon_xpaths.append(f"//*[@id='{table_id}_head']/thead/tr/th[{column_index}]/img[@data-value='{column_name}']")
    icon_xpaths.append(f"//*[@id='{table_id}_head']/thead/tr/th[{column_index}]/img")

    def visible_icon(_):
        for xpath in icon_xpaths:
            for icon in driver.find_elements(By.XPATH, xpath):
                size = icon.size or {}
                if icon.is_displayed() and size.get("width", 0) > 0 and size.get("height", 0) > 0:
                    return icon
        return False

    return WebDriverWait(driver, 30).until(visible_icon)


def _wait_sort_click_effect(driver, table_id, column_index, column_name, before_state, before_type):
    def sort_changed(_):
        try:
            icon = _visible_sort_icon(driver, table_id, column_index, column_name)
            current_type = icon.get_attribute("date-type") or icon.get_attribute("data-type") or ""
            return current_type != before_type or _table_state(driver, table_id) != before_state
        except (NoSuchElementException, TimeoutException):
            return False

    try:
        WebDriverWait(driver, 10).until(sort_changed)
    except TimeoutException:
        time.sleep(2)


def _sorted_failures_first_last_page(driver, table_id, column_name, descending=False, context="", last_page=True, **sort_rule):
