def click_table_sort_until(driver, table_id, column_index, column_name, descending=False, context="", max_clicks=2, page_scope="all", **sort_rule):
    last_failures = []
    for _ in range(max_clicks):
        _go_first_page_by_prev(driver, table_id)
        click_table_sort(driver, table_id, column_index)
        last_failures = _sorted_failures_each_page(driver, table_id, column_name, descending, context, page_scope=page_scope, **sort_rule)
        if not last_failures:
            return
    assert not last_failures, last_failures[0]


def _sorted_failures_each_page(driver, table_id, column_name, descending=False, context="", page_scope="all", **sort_rule):
    if page_scope in ("first", "first_last"):
        return _sorted_failures_first_last_page(driver, table_id, column_name, descending, context,
                                                last_page=(page_scope == "first_last"), **sort_rule)
    _go_first_page_by_prev(driver, table_id)
    page_total = page_count(driver, table_id)
    failures = []
    for page_index in range(1, page_total + 1):
        _wait_current_page_table_ready(driver, table_id)
        values = [row.get(column_name, "") for row in table_rows(driver, table_id)]
        try:
            assert_values_sorted(
                values,
                descending=descending,
                context=f"{context}/page {page_index} of {page_total}",
                column_name=column_name,
                driver=driver,
                **sort_rule,
            )
        except AssertionError as exc:
            failures.append(str(exc))
        if page_index < page_total:
            _go_next_page(driver, table_id, page_index + 1)
    _go_first_page_by_prev(driver, table_id)
    return failures


