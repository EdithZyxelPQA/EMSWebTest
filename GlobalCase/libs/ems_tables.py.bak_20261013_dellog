def available_ont_ids_from_inventory(
    driver,
    slot_id,
    port_id,
    preferred_ont_id,
    dut_ip=None,
    max_ont_id_attempts=16,
):
    preferred_ont_id = int(preferred_ont_id)
    candidate_ids = [str(index) for index in range(preferred_ont_id, preferred_ont_id + max_ont_id_attempts)]
    filter_inventory_ont_by_slot_port(driver, slot_id, port_id, dut_ip=dut_ip)
    occupied_ids = set()
    for row in table_rows(driver, "ont_inventory_div"):
        row_ip = row.get("IPAddress", row.get("IP Address", ""))
        if dut_ip and row_ip != str(dut_ip):
            continue
        if not _inventory_ont_slot_matches(row.get("Slot", ""), slot_id):
            continue
        if str(row.get("Port", "")).strip() != str(port_id).strip():
            continue
        ont_id = row.get("ONT", "")
        if ont_id and ont_id not in {"--", "Unregistered"}:
            occupied_ids.add(ont_id)
    available_ids = [ont_id for ont_id in candidate_ids if ont_id not in occupied_ids]
    if not available_ids:
        raise RuntimeError(
            f"No available ONT ID in Inventory/ONT for IP={dut_ip}, "
            f"slot={slot_id}, port={port_id}. "
            f"Checked={candidate_ids}, occupied={sorted(occupied_ids)}"
        )
    return available_ids


def _inventory_ont_slot_matches(row_slot, configured_slot):
    row_slot = str(row_slot or "").strip()
    configured_slot = str(configured_slot or "").strip()
    if configured_slot == "0":
        return row_slot in {"", "0", "-", "--"}
    return row_slot == configured_slot


def close_inventory_status_dialog(driver, timeout=15):
    message = WebDriverWait(driver, timeout).until(
        EC.visibility_of_element_located((By.ID, "inventory_status_message"))
    )
    dialogs = message.find_elements(
        By.XPATH,
        "./ancestor::*["
        "@role='dialog' or "
        "contains(concat(' ', normalize-space(@class), ' '), ' ui-dialog ') or "
        "contains(concat(' ', normalize-space(@class), ' '), ' modal ')"
        "][1]",
    )
    dialog = dialogs[0] if dialogs else None
    close_locators = [
        (By.CSS_SELECTOR, "button.ui-dialog-titlebar-close"),
        (By.XPATH, ".//button[contains(concat(' ', normalize-space(@class), ' '), ' close ')]"),
        (By.XPATH, ".//*[@data-dismiss='modal']"),
        (By.XPATH, ".//*[self::button or self::input or self::a][normalize-space()='Close' or @value='Close']"),
        (By.XPATH, ".//button[.//span]"),
    ]

    close_button = None
    search_roots = [dialog] if dialog is not None else []
    if not search_roots:
        # Some EMS versions do not give this popup a dialog/modal class. Walk
        # outward from the message and use the nearest container that owns a
        # visible Close control instead of depending on an absolute body XPath.
        search_roots = list(reversed(message.find_elements(By.XPATH, "./ancestor::*")))

    for root in search_roots:
        for by, value in close_locators:
            visible_buttons = [
                element for element in root.find_elements(by, value)
                if element.is_displayed() and element.is_enabled()
            ]
            if visible_buttons:
                close_button = visible_buttons[0]
                dialog = root
                break
        if close_button is not None:
            break
    if close_button is None:
        raise NoSuchElementException("Cannot find Close button in Inventory Status dialog.")

    driver.execute_script("arguments[0].scrollIntoView({block:'center'});", close_button)
    try:
        close_button.click()
    except ElementClickInterceptedException:
        driver.execute_script("arguments[0].click();", close_button)
    WebDriverWait(driver, timeout, poll_frequency=0.2).until(
        EC.invisibility_of_element(message)
    )


def wait_inventory_ont_id(driver, sn, predicate, timeout=300):
    sn_candidates = {sn, sn[-12:]}
    end_time = time.time() + timeout
    last_state = ""
    filter_inventory_ont_by_sn(driver, sn)
    while time.time() < end_time:
        rows = table_rows(driver, "ont_inventory_div")
        matched_rows = [row for row in rows if row.get("sn") in sn_candidates]
        if len(matched_rows) == 1:
            ont_id = matched_rows[0].get("ONT", "")
            last_state = f"ONT ID={ont_id}, row={matched_rows[0]}"
            if _call_inventory_predicate(predicate, ont_id, matched_rows[0]):
                return matched_rows[0]
        else:
            last_state = f"matched rows={len(matched_rows)}, rows={rows}"
        _safe_click(driver, By.ID, "i_action_refresh")
        time.sleep(3)
    raise TimeoutError(f"ONT inventory state did not match before timeout. SN={sn}, last_state={last_state}")


def wait_inventory_description(driver, sn, expected_description, timeout=300):
    return wait_inventory_ont_id(
        driver,
        sn,
        lambda _ont_id, row: row.get("description") == expected_description,
        timeout,
    )


def wait_inventory_ont_absent(driver, sn, timeout=300):
    candidates = [sn, sn[-12:]]
    end_time = time.time() + timeout
    last_state = ""
    while time.time() < end_time:
        all_absent = True
        states = []
        for candidate in candidates:
            filter_inventory_ont_by_sn(driver, candidate)
            rows = table_rows(driver, "ont_inventory_div")
            matched_rows = [row for row in rows if row.get("sn") in {sn, sn[-12:]}]
            states.append(f"{candidate}: matched={len(matched_rows)}, rows={rows}")
            if matched_rows:
                all_absent = False
                _safe_click(driver, By.ID, "i_action_refresh")
                time.sleep(3)
                break
        last_state = " | ".join(states)
        if all_absent:
            return True
    raise TimeoutError(f"ONT inventory still exists before timeout. SN={sn}, last_state={last_state}")


_CLOSE_CANNOT_DELETE_JS = r"""
// "<SN> : this ONT can not delete." - EMS refuses to delete a service that is still Processing.
// Close that dialog (its OK button) and return its text; null when it is not shown.
for (const box of document.querySelectorAll('.modal, [id*=diag], [role=dialog]')) {
  if (!box.offsetWidth || !/can not delete/i.test(box.innerText || '')) continue;
  const ok = [...box.querySelectorAll('button, input[type=button], .button')]
    .find(b => b.offsetWidth && /^\s*ok\s*$/i.test(b.value || b.innerText || ''));
  if (ok) ok.click();
  return (box.innerText || '').trim();
}
return null;
"""


def _delete_selected_ont_services(driver, candidate, timeout=300):
    # Delete the services shown for this SN; while EMS answers "this ONT can not delete"
    # (service still Processing), close the message, wait and try again.
    end_time = time.time() + timeout
    while True:
        _click(driver, By.XPATH, "//label[@for='myCheckbox_title_provision_service_table']")
        _click(driver, By.CSS_SELECTOR, "#provision_service_delete > a")
        try:
            _confirm_message(driver)
            return
        except TimeoutException:
            refused = driver.execute_script(_CLOSE_CANNOT_DELETE_JS)
            if not refused or time.time() >= end_time:
                raise
            print(f"delete ONT service: {refused!r}; wait for the service to finish processing", flush=True)
            time.sleep(15)
            filter_ont_service_by_sn(driver, candidate)
            if total_data(driver, "provision_service_table") < 1:
                return


def delete_ont_service_if_exists(driver, sn):
    deleted = False
    for candidate in _sn_candidates(sn):
        filter_ont_service_by_sn(driver, candidate)
        found = total_data(driver, "provision_service_table")
        print(f"delete ONT service: filter {candidate!r} found={found}", flush=True)
        if found < 1:
            continue
        _delete_selected_ont_services(driver, candidate)
        deleted = True
        # EMS removes the service asynchronously; wait until it is really gone,
        # otherwise creating it again reports "<SN> is already exist."
        end_time = time.time() + 120
        while time.time() < end_time:
            filter_ont_service_by_sn(driver, candidate)
            if total_data(driver, "provision_service_table") < 1:
                break
            time.sleep(3)
        print(f"delete ONT service: after delete {candidate!r} remaining={total_data(driver, 'provision_service_table')}", flush=True)
    return deleted


