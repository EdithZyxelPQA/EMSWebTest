def assert_ont_service_wait_for_duration(driver, sn, duration=180):
    end_time = time.time() + duration
    last_state = ""
    filter_ont_service_by_sn(driver, sn)
    while time.time() < end_time:
        rows = table_rows(driver, "provision_service_table")
        if not rows:
            rows = _filter_ont_service_by_sn_candidates(driver, sn)
        if len(rows) != 1:
            raise AssertionError(f"Expected one ONT service row while waiting. rows={rows}")
        status = rows[0].get("state", "")
        last_state = f"state={status}, row={rows[0]}"
        if status != "Wait":
            raise AssertionError(f"ONT service should stay Wait for {duration}s. {last_state}")
        _safe_click(driver, By.ID, "provision_service_refresh")
        time.sleep(5)
    return last_state


